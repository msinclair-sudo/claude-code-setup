<script>
// No inline onclick anywhere. Nested quoting inside an HTML attribute inside a
// JS string inside a Python string is three levels of escaping, and it silently
// produced a script that would not parse at all -- a blank page, served 200.
// One delegated listener removes the whole class of fault.
const esc = s => String(s ?? '').replace(/[&<>"]/g, c =>
  ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

const EDITING = new Set();

// What is open, and what has been folded away, kept in localStorage rather
// than in the DOM: the page redraws every three seconds, and a panel that
// remembers its state only in the markup closes itself while you are reading
// it.
const FKEY = 'harness.featopen';
const load = k => { try { return JSON.parse(localStorage.getItem(k) || '[]'); }
                    catch (e) { return []; } };
const save = (k, s) => { try { localStorage.setItem(k, JSON.stringify([...s])); }
                         catch (e) {} };

// ── the charter outline ────────────────────────────────────────────────────
// Collapse state by feature key, the one destructive click waiting for its
// second, and the refusal the CLI last gave. Kept out of the poll's way: the
// page redraws every three seconds and state that lives only in the DOM is
// state that resets itself while you are reading it.
const OPENF = new Set(load(FKEY));
let FSEEDED = localStorage.getItem(FKEY) !== null;
let ARMED = null;
let CHMSG = '';

// Slug and feature stay two attributes rather than one packed id. There is no
// separator that a feature name cannot contain, and picking one that "probably
// won't appear" is a bug waiting for the first feature called "read/write".
function cact(slug, feat, act, glyph, title, cls) {
  const armed = ARMED === act + '\n' + slug + '\n' + feat;
  return '<span class="cact ' + (cls || '') + (armed ? ' armed' : '') +
    '" data-cact="' + act + '" data-cslug2="' + esc(slug) + '" data-cfeat="' +
    esc(feat) + '" title="' + esc(title) + '">' + (armed ? '?' : glyph) + '</span>';
}

// The swap happens in the DOM rather than through a re-render, so the textarea
// is created once and keeps its cursor, its selection and its scroll. Cancel
// puts back exactly what was there, which is why the original HTML is stashed
// rather than rebuilt.
function beginEdit(el, opts) {
  const box = opts.cnew ? null : el;
  const raw = box ? (box.dataset.raw || '') : '';
  const key = opts.slug + ':' + (opts.feature || '');
  if (EDITING.has(key)) return;
  EDITING.add(key);
  const host = opts.cnew ? el : box;
  host.dataset.stash = host.innerHTML;
  host.classList.add('editing');
  const nameField = opts.cnew
    ? '<input class="cname" placeholder="feature name" />' : '';
  const ph = opts.cnew ? 'what this feature is, in plain prose'
                       : 'what this is, written to be understood';
  host.innerHTML = nameField +
    '<textarea class="cta" placeholder="' + ph + '">' +
    esc(raw) + '</textarea>' +
    '<div class="crow"><span class="cbtn csave">save</span>' +
    '<span class="cbtn ccancel">cancel</span><span class="cmsg"></span></div>';
  host.dataset.ckey = key;
  host.dataset.cslug = opts.slug;
  host.dataset.cfeature = opts.feature || '';
  host.dataset.cnew = opts.cnew ? '1' : '';
  const ta = host.querySelector('.cta');
  ta.focus();
  ta.setSelectionRange(ta.value.length, ta.value.length);
}

function endEdit(host) {
  EDITING.delete(host.dataset.ckey);
  host.classList.remove('editing');
  host.innerHTML = host.dataset.stash || '';
  // Every marker goes, not just the stash. A left-behind data-ckey makes an
  // element that is no longer being edited answer a query for one that is.
  ['stash', 'ckey', 'cslug', 'cfeature', 'cnew']
    .forEach(k => delete host.dataset[k]);
}

document.addEventListener('click', e => {
  const ca = e.target.closest('.cact');
  if (ca) {
    e.stopPropagation();
    const act = ca.dataset.cact;
    const slug = ca.dataset.cslug2, feature = ca.dataset.cfeat;
    const k = act + '\n' + slug + '\n' + feature;
    // Deleting is absolute, which is the whole reason it takes two clicks. The
    // warning says what does NOT happen, because everything else the harness
    // removes leaves a closed row behind and this leaves nothing.
    if (act === 'delete' && ARMED !== k) {
      ARMED = k;
      CHMSG = 'Click the ? again to delete "' + feature + '". Nothing is kept — ' +
              'no record, no reason, no way back — and any sub-features under it ' +
              'go too.';
      LAST = ''; tick(); return;
    }
    ARMED = null; CHMSG = '';
    fetch('/api/charter', { method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Harness-Local': '1' },
      body: JSON.stringify({ slug: slug, feature: feature, action: act }) })
      .then(r => r.json())
      .then(j => { CHMSG = j.ok ? '' : (j.message || 'refused'); LAST = ''; tick(); })
      .catch(() => { CHMSG = 'could not reach the server'; LAST = ''; tick(); });
    return;
  }
  const ct = e.target.closest('[data-ftog]');
  if (ct) {
    e.stopPropagation();
    const id = ct.dataset.ftog;
    OPENF.has(id) ? OPENF.delete(id) : OPENF.add(id);
    save(FKEY, OPENF); ARMED = null; CHMSG = ''; LAST = ''; tick(); return;
  }
  // An armed delete disarms itself the moment you look somewhere else.
  if (ARMED) { ARMED = null; CHMSG = ''; LAST = ''; tick(); }
  const ce = e.target.closest('.cedit');
  if (ce) {
    e.stopPropagation();
    const cnew = ce.dataset.cnew === '1';
    const host = cnew ? ce.closest('.feats')
                      : ce.closest('.charter').querySelector(
                          ce.dataset.cfeature
                            ? '.feat .cbody[data-raw]' : '.ctext.cbody');
    // A feature's box is the one in its own .feat block, not the first on the page.
    const target = (!cnew && ce.dataset.cfeature)
      ? ce.closest('.feat').querySelector('.cbody') : host;
    beginEdit(target, { slug: ce.dataset.cslug, feature: ce.dataset.cfeature,
                        cnew: cnew });
    return;
  }
  const cc = e.target.closest('.ccancel');
  if (cc) { e.stopPropagation(); endEdit(cc.closest('[data-ckey]')); return; }
  const cs = e.target.closest('.csave');
  if (cs) {
    e.stopPropagation();
    const host = cs.closest('[data-ckey]');
    const ta = host.querySelector('.cta'), msg = host.querySelector('.cmsg');
    const nm = host.querySelector('.cname');
    const text = ta.value.trim();
    const feature = host.dataset.cnew === '1'
      ? (nm ? nm.value.trim() : '') : host.dataset.cfeature;
    if (!text) { msg.textContent = 'nothing to save'; return; }
    if (host.dataset.cnew === '1' && !feature) {
      msg.textContent = 'name it first'; return; }
    msg.textContent = 'saving...';
    fetch('/api/charter', { method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Harness-Local': '1' },
      body: JSON.stringify({ slug: host.dataset.cslug, feature: feature,
                             text }) })
      .then(r => r.json())
      .then(j => {
        if (!j.ok) { msg.textContent = 'refused: ' + (j.message || ''); return; }
        EDITING.delete(host.dataset.ckey);
        host.classList.remove('editing');
        ['stash', 'ckey', 'cslug', 'cfeature', 'cnew']
          .forEach(k => delete host.dataset[k]);
        LAST = ''; tick();
      })
      .catch(() => { msg.textContent = 'could not reach the server'; });
    return;
  }
  const cp = e.target.closest('.cp');
  if (cp) {
    e.stopPropagation();
    // Either an element to read, or the text itself. A one-line signal on a
    // card has nowhere to hide a <pre>, and inventing one to satisfy the older
    // form would put the command on screen twice.
    const el = cp.dataset.c ? document.getElementById(cp.dataset.c) : null;
    navigator.clipboard.writeText(el ? el.textContent : (cp.dataset.copy || '')).then(
      () => { cp.textContent = 'copied'; },
      () => { cp.textContent = 'select and copy'; });
    return;
  }
  if (e.target.dataset.close) { closeModal(); return; }
  const tk = e.target.closest('[data-task]');
  if (tk) { openTask(tk.dataset.slug, tk.dataset.task); return; }
});
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

// ── task modal ─────────────────────────────────────────────────────────────
let MODAL = null;   // {slug, task}
let LAST = '';            // last payload rendered, to avoid pointless redraws

function closeModal() { MODAL = null; document.getElementById('modal').innerHTML = ''; }

async function openTask(slug, task) {
  MODAL = { slug, task };
  const d = await (await fetch('/api/task?p=' + encodeURIComponent(slug) +
                              '&t=' + encodeURIComponent(task))).json();
  if (d.error) { closeModal(); return; }
  const cs = (d.brief_comments || []).concat(d.comments || []).map(c =>
    '<div class="cmt"><div class="cmt-h">' + esc(c.by) + ' &middot; ' +
    esc(String(c.at || '').slice(0, 16).replace('T', ' ')) + '</div>' +
    '<div class="cmt-b">' + esc(c.text) + '</div></div>').join('')
    || '<div class="ln q">no comments yet</div>';
  document.getElementById('modal').innerHTML =
    '<div class="veil" data-close="1"><div class="sheet">' +
      '<div class="sheet-h"><b>' + esc(d.task) + '</b>' +
        '<span class="x" data-close="1">close</span></div>' +
      '<dl>' +
        '<dt>node</dt><dd>' + (d.node ? esc(d.node) +
            (d.branch ? ' <span class="q">(' + esc(d.branch) + ')</span>' : '')
          : '<span class="dup">names no node &mdash; it predates the field</span>') + '</dd>' +
        '<dt>state</dt><dd>' + (
            d.closed ? '<b>signed off</b> <span class="q">by ' + esc(d.closed_by || '?') +
              ' &middot; ' + esc(String(d.closed).slice(0, 19).replace('T', ' ')) + '</span>'
          : d.presented_at ? '<b class="dup">presented &mdash; waiting on its lead</b> ' +
              '<span class="q">by ' + esc(d.presented_by || '?') + ' &middot; ' +
              esc(String(d.presented_at).slice(0, 19).replace('T', ' ')) + '</span>'
          : d.marked ? 'open' : '<span class="q">briefed, not started</span>') + '</dd>' +
        (d.opened ? '<dt>opened</dt><dd>' +
          esc(String(d.opened).slice(0, 19).replace('T', ' ')) +
          ' <span class="q">session ' + esc(d.session) + '</span></dd>' : '') +
        '<dt>brief' + (d.brief_rev ? ' <span class="q">rev ' + esc(d.brief_rev) +
            '</span>' : '') + '</dt><dd>' +
          (d.brief ? '<div class="brief">' + esc(d.brief) + '</div>' +
             '<div class="ln q">' + esc(d.brief_by) + ' &middot; ' +
             esc(String(d.brief_at || '').slice(0, 19).replace('T', ' ')) + '</div>'
           : '<span class="q">no brief written &mdash; its lead writes one with ' +
             'harness brief ' + esc(d.task) + ' --for &lt;node&gt; --write</span>') + '</dd>' +
        (d.suggestions.length ? '<dt>suggestions</dt><dd>' + d.suggestions.map((sg, i) =>
          '<div class="cmt"><div class="cmt-h">#' + (i + 1) + ' ' +
          (sg.resolved_at ? 'resolved' : '<b class="dup">open</b>') + ' &middot; ' +
          esc(sg.by) + ' &middot; against rev ' + esc(sg.against_revision) + '</div>' +
          '<div class="cmt-b">' + esc(sg.text) + '</div></div>').join('') + '</dd>' : '') +
        '<dt>comments</dt><dd>' + cs + '</dd>' +
      '</dl>' +
      '<textarea id="cbox" placeholder="context for whoever works on this..."></textarea>' +
      '<div class="row"><button id="csend">comment</button>' +
      '<span class="ln q" id="cmsg">' + (d.brief_rev
        ? 'appended to the brief, never edited. It does not change the instruction: '
          + 'the node and its lead see it at their next harness command, and the lead '
          + 'rewrites the brief if it should change.'
        : 'appended to the task record, never edited') + '</span></div>' +
    '</div></div>';
  document.getElementById('csend').onclick = sendComment;
}

async function sendComment() {
  const box = document.getElementById('cbox');
  const msg = document.getElementById('cmsg');
  const text = box.value.trim();
  if (!text || !MODAL) return;
  msg.textContent = 'saving...';
  try {
    const r = await fetch('/api/comment', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Harness-Local': '1' },
      body: JSON.stringify({ slug: MODAL.slug, task: MODAL.task, text })
    });
    const j = await r.json();
    if (!j.ok) { msg.textContent = 'refused: ' + (j.message || r.status); return; }
    box.value = '';
    openTask(MODAL.slug, MODAL.task);
  } catch (e) { msg.textContent = 'failed: ' + e; }
}

// null sessions means the roster could not be read. That is a THIRD state, and
// rendering it as an empty node is the bug this view had.
// Briefed but not marked: work its lead has handed down that it has not picked
// up. A separate line, because "assigned" and "under way" are different facts.
// The queue in the lead's order, with the head named. A coupled task is drawn
// hanging off the one it runs with rather than as a queue position of its own,
// because it has none: it is reached through its predecessor or not at all.
function briefedChips(n) {
  if (!n.briefed || !n.briefed.length) return '';
  const head = n.briefed.filter(b => !b.coupled_to);
  const chip = (b, cls) =>
    '<span class="chip ' + cls + '" data-task="' + esc(b.task) + '" data-slug="' +
    esc(n._slug) + '" title="' + esc(b.coupled_why || '') + '">' + esc(b.label || b.task) +
    (b.open_suggestions ? ' <b class="dup">!' + b.open_suggestions + '</b>' : '') +
    '</span>';
  const chain = t => n.briefed.filter(b => b.coupled_to === t)
    .map(b => ' <span class="q">+</span> ' + chip(b, 'pending coupled')).join('');
  const open = (n.tasks || []).some(t => !t.presented);
  return '<div class="ln q">' +
    head.map((b, i) => (i === 0 && !open ? '<b class="nextlbl">next</b> ' : '') +
                       chip(b, 'pending') + chain(b.task)).join(' ') +
    '</div>';
}

// Segments this node broke up. Drawn apart from the queue and never as a
// pending chip, because they are opposite facts: a queued task is work about to
// happen and a split one is work that already left. Ticked when every part has
// come back, which is the moment it can finally be marked off.
// Withdrawn, and kept visible. A brief that disappeared entirely has the next
// lead propose the same thing and get the same silence back.
function goneChips(n) {
  if (!n.gone || !n.gone.length) return '';
  return '<div class="ln q"><span class="splitlbl">gone</span> ' +
    n.gone.map(g =>
      '<span class="chip out" data-task="' + esc(g.task) + '" data-slug="' +
      esc(n._slug) + '" title="' + esc('superseded: ' + (g.gone || '') +
        (g.gone_for ? '\nreplaced by ' + g.gone_for : '')) + '">' +
      esc(g.label || g.task) + '</span>').join(' ') + '</div>';
}

function splitChips(n) {
  if (!n.split || !n.split.length) return '';
  return '<div class="ln q"><span class="splitlbl">split</span> ' +
    n.split.map(s =>
      '<span class="chip sp' + (s.ready ? ' ready' : '') + '" data-task="' +
      esc(s.task) + '" data-slug="' + esc(n._slug) + '" title="' +
      esc(s.ready
          ? 'every part closed — harness mark ' + s.task + ' --close'
          : s.children.map(c => c.task + ' (' + c.node + ') ' + c.state).join('\n')) +
      '">' + (s.ready ? '&#10003; ' : '') + esc(s.task) +
      ' <b>' + s.done + '/' + s.total + '</b></span>').join(' ') + '</div>';
}

// How long since this session did anything, and what picking it back up would
// cost. Idle is free; RESUMING is not. Past the cache lifetime the next turn
// re-reads the whole conversation at full rate, so a cold node carrying 340k is
// a bill waiting for you to say hello to it.
function tokf(n) {
  if (!n) return '';
  return n >= 1e6 ? (n / 1e6).toFixed(1) + 'M' : n >= 1e3 ? Math.round(n / 1e3) + 'k' : n;
}
function age(s) {
  if (s.status === 'busy' || !s.idle) return '';
  const m = Math.floor(s.idle / 60);
  const t = m < 60 ? m + 'm' : Math.floor(m / 60) + 'h' + String(m % 60).padStart(2, '0');
  return s.cold
    ? ' &middot; <span class="cold">idle ' + t + ' &middot; COLD' +
      (s.carry ? ' &middot; ' + tokf(s.carry) + ' to re-read' : '') + '</span>'
    : ' &middot; idle ' + t;
}

// Context and uptime, one line per running session.
function hm(sec) {
  const m = Math.floor(sec / 60);
  return m < 60 ? m + 'm' : Math.floor(m / 60) + 'h' + String(m % 60).padStart(2, '0');
}
function meter(s) {
  const bits = [];
  if (s.carry) bits.push('context <b>' + tokf(s.carry) + '</b>');
  if (s.up != null) bits.push('up <b>' + hm(s.up) + '</b>');
  return bits.length ? '<div class="ln mt">' + bits.join(' &middot; ') + '</div>' : '';
}

// 'claude-opus-5-5[1m]' -> 'opus 5.5'; 'claude-haiku-4-5-20251001' -> 'haiku 4.5'.
function modelName(m) {
  if (!m) return '';
  const x = String(m).replace(/\[.*\]$/, '').replace(/^claude-/, '').replace(/-\d{8}$/, '');
  const k = x.match(/^([a-z]+)-(\d+)-(\d+)$/);
  return k ? k[1] + ' ' + k[2] + '.' + k[3] : x;
}
// What runs the node: the live session's model, else the assignment, dimmed.
function modelLine(n, s) {
  const a = n.assigned || [];
  const eff = a[1] ? ' &middot; ' + esc(a[1]) : '';
  if (s && s.model) return '<div class="ln md" title="assigned ' + esc((a[0] || '?') + ' ' +
      (a[1] || '')) + '">' + esc(modelName(s.model)) + eff + '</div>';
  return a[0] ? '<div class="ln q">assigned ' + esc(a[0]) + eff + '</div>' : '';
}

function card(n) {
  const unknown = n.sessions === null;
  const ss = n.sessions || [];
  // A stopped session outranks every other class here. It reports status 'idle',
  // so without this the one card that needs a human is painted the same as the
  // cards that need nobody — which is how a lead sat halted for forty minutes on
  // a board that was open the whole time.
  // Most stops are a finished turn waiting on someone; those are drawn as a
  // wait, below. Only a permission prompt, or a stop the transcript can't
  // place, needs the keyboard.
  const halted = ss.some(s => s.stopped && !(s.stop && s.stop.kind === 'reply'));
  const cls = unknown ? 'unknown'
            : halted ? 'dup'
            : (ss.some(s => s.status === 'busy') ? 'busy' : (ss.length ? 'idle' : ''));
  let who;
  if (unknown)            who = '<div class="ln u">occupancy unknown</div>';
  else if (ss.length > 1) who = '<div class="ln dup">' + ss.length +
      ' sessions in one worktree</div>';
  else if (halted)        who = modelLine(n, ss[0]) + '<div class="ln dup">' + (ss[0].stop
      ? 'permission prompt &middot; ' + esc(ss[0].stop.tool) + '</div>' +
        (ss[0].stop.what ? '<div class="ln q">' + esc(ss[0].stop.what) + '</div>' : '')
      : 'stopped &mdash; a prompt or a reply</div>') +
      '<div class="ln q">claude attach ' + esc(ss[0].id) + '</div>' + meter(ss[0]);
  else if (ss.length)     who = modelLine(n, ss[0]) +
      '<div class="ln" title="session ' + esc(ss[0].name) + '">' +
      // "idle · idle 5m" said it twice: the age already says idle.
      (ss[0].status === 'idle' && age(ss[0])
        ? age(ss[0]).replace(/^ &middot; /, '') : esc(ss[0].status) + age(ss[0])) +
      '</div>' + meter(ss[0]);
  else if (n.claimed)     who = '<div class="ln dup">claimed, no session</div>' + modelLine(n);
  else                    who = '<div class="ln q">no session</div>' + modelLine(n);
  // "unassigned" read as "nothing is there", which is the opposite of what it
  // means: the session is working, the HARNESS just has no record of on what.
  const task = n.tasks.length ? '<div class="ln">' + n.tasks.map(x =>
                 '<span class="chip' + (x.presented ? ' presented' : '') +
                 '" data-task="' + esc(x.task) + '" data-slug="' + esc(n._slug) +
                 '" title="' + (x.presented ? 'presented — waiting on its lead to sign off'
                                            : 'open') + '">' +
                 (x.presented ? '&#10003; ' : '') + esc(x.task) + '</span>').join(' ') +
                 '</div>' + briefedChips(n)
             : (!unknown && ss.length
                ? '<div class="ln q" title="no harness mark — run harness mark ' +
                  '&lt;task&gt; in that session">no task record</div>' + briefedChips(n)
                : briefedChips(n));
  const coldc = ss.some(s => s.cold) ? ' coldc' : '';
  // Asked and stopped. Drawn on the node because it is the node's state and
  // its lead's to clear. The count of children stopped on THIS node
  // sits on the same card, so a lead can see what it owes without reading its
  // children's cards one at a time.
  const w = n.waiting;
  const wait = w
    ? '<span class="wto" hidden data-on="' + esc(w.parent || '') + '"></span>' +
      '<div class="wt"' + (w.inferred ? ' title="read off its transcript: it finished ' +
        'its turn and no harness waiting record says on what"' : '') +
      '>waiting on ' + ((w.chain && w.chain.length ? w.chain : [w.parent || 'its lead'])
        .map(x => '<b>' + esc(x) + '</b>').join(' &rarr; ')) + ' &middot; ' +
      esc(w.age || '') + '</div>' +
      '<div class="wt q">' + esc(w.asked || (w.inferred ? 'finished its turn'
                                                        : 'nothing recorded')) + '</div>' +
      (w.still_moving ? '<div class="wt s">still moving: ' + esc(w.still_moving) +
                        '</div>' : '')
    : '';
  // Direct waiters, then the longer paths that end here, as a ← b ← c.
  // Held: its next task is gated on another node's task, or a clock. Violet,
  // dashed: not a wait (nobody owes it an answer) and not a warning.
  const held = (n.held || []).map(h => h.by
      ? '<span class="hto" hidden data-on="' + esc(h.by) + '"></span>' +
        '<div class="hd">held by <b>' + esc(h.by) + '</b> &middot; ' + esc(h.task) +
        (h.worker
          ? ' starts after ' + esc(h.worker) + '&rsquo;s <b>' + esc(h.after) +
            '</b>, presented and waiting on ' + esc(h.by) + '&rsquo;s sign-off</div>'
          : ' starts after its <b>' + esc(h.after) + '</b> (' + esc(h.state) + ')</div>')
      : '<div class="hd">held until <b>' + esc(h.until) + '</b> &middot; ' + esc(h.task) + '</div>'
    ).join('');
  const holding = (n.holding || []).map(h => '<div class="hd o"><b>' + esc(h.node) +
      '</b> held on <b>' + esc(n.name) + '</b>' + (h.signoff
        ? ' signing off ' + esc(h.signoff) + '&rsquo;s ' + esc(h.after)
        : '\'s ' + esc(h.after)) + '</div>').join('');
  const owes = ((n.awaited_by || []).map(c => '<div class="wt o"><b>' + esc(c) +
        '</b> waiting on <b>' + esc(n.name) + '</b></div>').join('')) +
      ((n.chains || []).map(path => '<div class="wt o">' +
        path.slice().reverse().map(x => '<b>' + esc(x) + '</b>').join(' &larr; ') +
        ' waiting on <b>' + esc(n.name) + '</b></div>').join(''));
  // Beside the node it is directed AT, naming where it came FROM. One line, the
  // point first, the command behind a click -- rich about what it is, short
  // about saying it.
  const VERB = {approval: 'approve', unanswered: 'spawn'};
  const sigs = (n.signals || []).map(g =>
    '<div class="sig" title="' + esc(g.do) + '">' +
      '<span class="frm">&larr; ' + esc(g.frm || '?') + '</span>' +
      '<span class="kind">' + esc(g.kind) + '</span>' +
      '<span class="txt">' + esc(g.text) + '</span>' +
      '<span class="act cp" data-copy="' + esc(g.do) + '">' +
        esc(VERB[g.kind] || 'copy') + '</span>' +
    '</div>').join('');
  return '<div class="card ' + cls + coldc + (w ? ' waitc' : (n.held || []).length ? ' heldc' : '') +
    '" data-live="card:' + esc(n._slug + ':' + n.name) + '">' +
    '<div class="hdr"><span class="dot"></span><span class="nm">' + esc(n.name) +
    '</span><span class="kd">' + esc(n.role || '') +
    '</span></div>' +
    (n.branch && n.branch !== n.name || !n.indexed
      ? '<div class="ln q">' + (n.branch && n.branch !== n.name ? 'branch ' + esc(n.branch) : '') +
        (n.indexed ? '' : ' (not indexed)') + '</div>' : '') +
    who + mailLine(n, ss) + wait + held + owes + holding + sigs + task + splitChips(n) +
    goneChips(n) + '</div>';
}

// Doorbell mail waiting for the node's session. Hooks hand it over at its next
// tool call, turn end or prompt; an idle session wakes for it only if its
// doorbell is armed, so say when nothing will wake it.
function mailLine(n, ss) {
  if (!n.mail) return '';
  const idle = !ss.some(s => s.status === 'busy');
  return '<div class="ln mail">&#9993; ' + n.mail + ' unread' +
    (!ss.length ? ' &middot; no session' :
     !idle ? ' &middot; at its next tool call' :
     n.bell ? ' &middot; waking it' : ' &middot; nothing armed to wake it') + '</div>';
}

// The project's intermediary, as a card off to the side of its tree. Not a
// tree node: nothing in the tree reports to it, and drawing it under the root
// would say otherwise.
// Runs chosen per project, kept here so a poll's repaint doesn't reset the menu.
const DOCRUNS = {}, DOCMSG = {};
function documenterDo(slug, action) {
  DOCMSG[slug] = action === 'start' ? 'starting…' : 'stopping…'; LAST = ''; tick();
  fetch('/api/documenter', { method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-Harness-Local': '1' },
    body: JSON.stringify({ slug: slug, action: action, runs: DOCRUNS[slug] || 1 }) })
    .then(r => r.json())
    .then(j => { DOCMSG[slug] = j.message || (j.ok ? 'done' : 'refused'); LAST = ''; tick(); })
    .catch(() => { DOCMSG[slug] = 'could not reach the server'; LAST = ''; tick(); });
}
document.addEventListener('click', e => {
  const s = e.target.closest('[data-docstart]'), t = e.target.closest('[data-docstop]');
  if (s) documenterDo(s.dataset.docstart, 'start');
  else if (t) documenterDo(t.dataset.docstop, 'stop');
});
document.addEventListener('change', e => {
  const m = e.target.closest('[data-docruns]');
  if (m) DOCRUNS[m.dataset.docruns] = +m.value;
});

// The intermediary's start button and attach line: Start wakes it in the
// background, and once it is up the line is the command to open it here.
const IMMSG = {};
function itemSession(slug, a) {
  const s = a.session || {};
  const k = akey(slug, a.id);
  const msg = IMMSG[k] ? ' <span class="q">' + esc(IMMSG[k]) + '</span>' : '';
  const st = s.state === 'working' ? 'working'
    : s.state === 'idle' ? 'idle' + (s.idle != null ? ' ' + dur(s.idle) : '')
    : s.state === 'queued' ? 'queued to start'
    : s.state === 'asleep' ? 'asleep &mdash; a message wakes it' : 'unknown';
  const wait = a.waiting_on ? ' &middot; waiting on <b>' + esc(a.waiting_on) + '</b>' : '';
  const ctl = s.sid
    ? '<code>' + esc('claude attach ' + s.sid.slice(0, 8)) + '</code> <button data-acopy="' +
      esc('claude attach ' + s.sid.slice(0, 8)) + '">Copy</button>'
    : (s.state === 'asleep' || s.state === 'queued')
      ? '<button data-istart="' + esc(k) + '">Start</button>' : '';
  return '<div class="ln docctl imctl isess"><span class="q">intermediary</span> ' + st +
    (s.context ? ' &middot; ' + tokf(s.context) : '') + wait + ' ' + ctl + msg + '</div>';
}
document.addEventListener('click', e => {
  const b = e.target.closest('[data-istart]');
  if (!b) return;
  const k = b.dataset.istart, i = k.indexOf(':');
  IMMSG[k] = 'starting…'; b.disabled = true;
  fetch('/api/intermediary', { method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-Harness-Local': '1' },
    body: JSON.stringify({ slug: k.slice(0, i), id: k.slice(i + 1), action: 'start' }) })
    .then(r => r.json())
    .then(j => {
      // The roster lists it a moment after it starts; say so until it does.
      IMMSG[k] = j.ok ? 'started; the attach command appears here' : (j.message || 'refused');
      if (j.ok) setTimeout(() => { delete IMMSG[k]; LAST = ''; tick(); }, 8000);
      LAST = ''; tick();
    })
    .catch(() => { IMMSG[k] = 'could not reach the server'; LAST = ''; tick(); });
});

// The project's documenter (T18): a run per job, so the card says what it did
// last and what is pending, not whether a session is up.
// The owner halted the tree (owner, 2026-10-06): nothing new starts until they
// resume it, so the board says so above everything else.
function haltBanner(p) {
  const h = p.halt;
  if (!h) return '';
  return '<div class="halt" data-live="halt:' + esc(p.slug) + '">HALTED at ' +
    esc((h.at || '').slice(11, 16)) + ' &middot; ' + esc(h.why || '') +
    ' &middot; nothing new starts. <code>harness resume</code> ends it.</div>';
}

function docCard(p) {
  // Laid out like the other cards: one status line saying what it is doing or
  // waiting on, then the budget it works against, then the latest batch only.
  const d = p.documenter || {};
  const lt = d.latest;
  const root = d.root || 'main';
  const rv = d.review || [];
  const on = '<span class="ito" data-on="' + esc(root) + '"><b>' + esc(root) + '</b></span>';
  const status = {
    working: d.doc && d.doc.doc ? 'working through <code>' + esc(d.doc.doc) + '</code>' +
             (d.doc.words ? ' &middot; ' + Number(d.doc.words).toLocaleString() + ' words' : '')
             : 'measuring, before it picks a doc',
    waiting: 'waiting on ' + on + '&rsquo;s review of <code>' + esc(rv[0] || '') + '</code>',
    review: 'its batch <code>' + esc(rv[0] || '') + '</code> waits on ' + on + '&rsquo;s review',
    finishing: 'run over &middot; its session is closing',
    between: d.remaining ? 'between runs &middot; ' + d.remaining + ' more to come'
                         : 'idle &middot; no run going',
  }[d.state] || 'unknown &mdash; the roster could not be read';
  const cls = d.state === 'working' ? 'busy' : d.state === 'waiting' || d.state === 'review'
    ? 'waitc' : d.state === null ? 'unknown' : '';
  let budget = '<div class="ln q">no CLAUDE.md</div>';
  if (d.words != null) {
    const over = d.budget && d.words > d.budget;
    const pct = d.budget ? Math.min(100, Math.round(d.words / d.budget * 100)) : 0;
    budget = '<div class="ln mt">CLAUDE.md <b class="' + (over ? 'over' : '') + '">' +
      d.words.toLocaleString() + '</b>' + (d.budget ? ' of ' + Number(d.budget).toLocaleString() +
      ' words' + (over ? ' &middot; ' + (d.words - d.budget).toLocaleString() + ' over' : '')
      : ' words &middot; no budget set') + '</div>' +
      (d.budget ? '<div class="dbar"><i class="' + (over ? 'over' : '') + '" style="width:' +
        pct + '%"></i></div>' : '');
  }
  let last = '<div class="ln q">no batches yet</div>';
  if (lt && lt.outcome === 'applied')
    last = '<div class="ln">last batch applied <code>' + esc(lt.sha) + '</code>' +
      (lt.claude_md ? ' &middot; CLAUDE.md ' + lt.claude_md[0].toLocaleString() + ' &rarr; ' +
        lt.claude_md[1].toLocaleString() : '') + '</div>';
  else if (lt && lt.outcome === 'declined')
    last = '<div class="ln" title="' + esc(lt.why || '') + '">last batch declined: <span class="q">' +
      esc(String(lt.why || '').replace(/^declined by \w+: /, '').slice(0, 90)) + '</span></div>';
  else if (lt) last = '';
  const ak = d.asks ? '<div class="ln"><a href="#issues">' + d.asks + ' open item' +
      (d.asks > 1 ? 's' : '') + '</a></div>' : '';
  const n = DOCRUNS[p.slug] || 1;
  const busy = d.state === 'working' || d.state === 'waiting';
  const left = d.remaining && d.state !== 'between' ? '<div class="ln q">' + d.remaining +
      ' more run' + (d.remaining > 1 ? 's' : '') + ' after this &middot; <span class="act" ' +
      'data-docstop="' + esc(p.slug) + '">stop after this one</span></div>' : '';
  const ctl = '<div class="ln docctl"><select data-docruns="' + esc(p.slug) + '">' +
      [1, 2, 3, 5, 10].map(k => '<option value="' + k + '"' + (k === n ? ' selected' : '') + '>' +
        k + (busy ? ' more' : '') + ' run' + (k > 1 ? 's' : '') + '</option>').join('') +
      '</select> <button data-docstart="' + esc(p.slug) + '">' +
      (busy ? 'queue after this' : 'start') + '</button></div>' + left;
  const msg = DOCMSG[p.slug] ? '<div class="ln q">' + esc(DOCMSG[p.slug]) + '</div>' : '';
  return '<div class="card interm doc ' + cls + '" data-live="doc:' + esc(p.slug) + '">' +
    '<div class="hdr"><span class="dot"></span><span class="nm">' + esc(p.project) +
    '</span><span class="kd">documenter</span></div>' +
    '<div class="ln">' + status + '</div>' + budget + last + ak + ctl + msg + '</div>';
}

// The project's test queue (obs 81): one job runs, in a copy of its commit;
// the rest wait their turn, priority first, then first in, first out. Whoever
// asked for the running job is marked (.tto), so drawWaits runs a line from
// this card to that node.
function testCard(p) {
  const t = p.tests || {};
  const jobs = t.jobs || [];
  const run = jobs.find(j => j.state === 'running');
  const q = jobs.filter(j => j.state === 'queued');
  const what = j => j.kind === 'check'
    ? (j.arms ? esc(j.arms.join(', ')) + ' of ' : 'check ') + '<code>' + esc(j.sha) + '</code>'
    : '<code>' + esc(j.command) + '</code>';
  const tag = j => j.queue === 'priority' ? '<b class="prio">priority</b> ' : '';
  const who = (j, mark) => j.who.map(n => mark
    ? '<span class="tto" data-on="' + esc(n) + '"><b>' + esc(n) + '</b></span>'
    : esc(n)).join(', ');
  const head = run
    ? '<div class="ln">running: ' + tag(run) + who(run, true) + ' &middot; ' + what(run) +
      (run.total ? ' &middot; arm ' + ((run.done || 0) + 1) + '/' + run.total +
        (run.arm ? ' <span class="q">' + esc(run.arm) + '</span>' : '') : '') +
      ' &middot; ' + esc(run.since || '') +
      (run.eta != null ? ' &middot; done in ~' + dur(run.eta) : '') + '</div>'
    : '<div class="ln q">nothing running</div>';
  const list = q.length
    ? '<div class="tq"><div class="tqh">queue &middot; ' + q.length + '</div>' +
      q.map((j, i) => '<div class="ln"><span class="tqn">' + (i + 1) + '</span>' + tag(j) +
        who(j, false) + ' &middot; ' + what(j) + ' <span class="q">&middot; waiting ' +
        esc(j.since || '') + (j.eta != null ? ', done in ~' + dur(j.eta) : '') +
        '</span></div>').join('') + '</div>'
    : '<div class="ln q">queue empty</div>';
  const last = t.last ? '<div class="ln q">last: ' + esc(t.last.id) + ' ' +
    esc(t.last.state) + (t.last.at ? ' at ' + esc(t.last.at) : '') + '</div>' : '';
  return '<div class="card interm doc ' + (run ? 'busy' : '') + '" data-live="tests:' +
    esc(p.slug) + '"><div class="hdr"><span class="dot"></span><span class="nm">' +
    esc(p.project) + '</span><span class="kd">tests</span></div>' + head + list + last + '</div>';
}

function intermCard(p) {
  // One intermediary per open item. The card lists the items whose session is
  // up, and each item waiting on a node marks it, so drawWaits can run a
  // dotted line from that row to the node's card.
  const im = p.intermediary || {};
  const asks = p.asks || [];
  const yours = asks.filter(a => a.runs || a.state === 'ready' || a.state === 'drafted').length;
  const up = asks.filter(a => a.session && a.session.sid);
  const cls = im.running === null ? 'unknown'
            : up.some(a => a.session.state === 'working') ? 'busy' : up.length ? 'idle' : '';
  const row = a => '<div class="ln">' + esc(a.id) + ' &middot; ' +
    (a.session.state === 'working' ? 'working' : 'idle') +
    (a.waiting_on ? ' &middot; asked <span class="ito" data-on="' + esc(a.waiting_on) + '"><b>' +
      esc(a.waiting_on) + '</b></span>' : '') + '</div>';
  // An item waiting on a node draws its line even while its session sleeps.
  const asleep = asks.filter(a => a.waiting_on && !(a.session && a.session.sid));
  const who = im.running === null
    ? '<div class="ln u">unknown &mdash; the roster could not be read</div>'
    : '<div class="ln q">' + im.running + ' of ' + im.cap + ' item sessions running</div>' +
      up.map(row).join('') +
      asleep.map(a => '<div class="ln q">' + esc(a.id) + ' &middot; asleep, asked ' +
        '<span class="ito" data-on="' + esc(a.waiting_on) + '"><b>' + esc(a.waiting_on) +
        '</b></span></div>').join('');
  const n = asks.length;
  const ask = '<div class="ln"><a href="#issues">' +
    (n ? n + ' open item' + (n === 1 ? '' : 's') + ' &middot; ' +
         '<span class="' + (yours ? 'yours' : '') + '">' + yours + ' yours</span>'
       : 'no open items') + '</a></div>';
  return '<div class="card interm ' + cls + '" data-live="interm:' + esc(p.slug) + '">' +
    '<div class="hdr"><span class="dot"></span><span class="nm">' + esc(p.project) +
    '</span><span class="kd">intermediary</span></div>' + who + ask + '</div>';
}

function tree(nodes, side) {
  const by = {}, kids = {}, roots = [];
  nodes.forEach(n => by[n.name] = n);
  nodes.slice().sort((a, b) => a.name.localeCompare(b.name)).forEach(n => {
    if (n.parent && by[n.parent]) (kids[n.parent] = kids[n.parent] || []).push(n);
    else roots.push(n);
  });
  const li = n => '<li>' + card(n) +
    (kids[n.name] ? '<ul>' + kids[n.name].map(li).join('') + '</ul>' : '') + '</li>';
  // The side cards share the tree's scrolling space, on its left, so a line
  // from one to a node is drawn in the same coordinates as the tree's own.
  return '<div class="treerow"><div class="scroll"><div class="tspace">' +
         (side ? '<div class="sidecol">' + side + '</div>' : '') +
         '<div class="tree"><ul>' + roots.map(li).join('') + '</ul></div></div></div></div>';
}

async function tick() {
  let raw, d;
  try {
    raw = await (await fetch('/api/state')).text();
    d = JSON.parse(raw);
  }
  catch (e) { document.getElementById('age').textContent = 'disconnected'; return; }
  document.getElementById('age').textContent = new Date().toLocaleTimeString();
  // Every tick, before the no-change return: the count and the tab title are
  // the only notification the owner gets, so they must never be a poll behind.
  const N = (d.owner && d.owner.count) || 0;
  document.title = N ? '(' + N + ') harness' : 'harness';
  tabs(N);
  LASTD = d;
  // First visit: the project description is open, its features shut. That is
  // what this panel looked like before it could fold at all, so nobody arrives
  // to find their charter apparently empty.
  if (!FSEEDED) {
    (d.projects || []).forEach(p => OPENF.add(p.slug + '::'));
    FSEEDED = true; save(FKEY, OPENF);
  }
  // `generated` changes every poll and nothing else usually does, so it is
  // excluded from the comparison: redrawing identical content is what loses a
  // text selection mid-copy.
  const sig = ROUTE() + raw.replace(/"generated":"[^"]*",/, '');
  if (sig === LAST) return;
  LAST = sig;
  // Above everything, including the banners: it is the same reference whatever
  // state the trees are in, and one row of it is cheaper than looking it up.
  let h = '';
  if (d.stale_server) {
    h += '<div class="banner"><b>This server is older than the code on disk</b> ' +
         '&mdash; it started at ' + esc(d.started) + ' and the page you are looking ' +
         'at was loaded then. Reloading the browser will not change it.<br>' +
         'Stop it (ctrl-c) and run <code>harness gui</code> again.</div>';
  }
  if (d.roster_error) {
    h += '<div class="banner"><b>Occupancy unknown</b> &mdash; the session roster ' +
         'could not be read, so every node below is shown as unknown rather than ' +
         'empty.<br><code>' + esc(d.roster_error) + '</code></div>';
  }
  if (d.stale_install) {
    h += '<div class="banner"><b>The installed harness is stale</b> &mdash; ' +
         esc(d.stale_install) + '<br>Every session is reading older instructions ' +
         'than the source. Run <code>bash install.sh</code> from the source tree.</div>';
  }
  if (ROUTE() === 'issues') { paint(h + ownerView(d)); return; }
  h += d.projects.map((p, pi) => {
    p.nodes.forEach(n => n._slug = p.slug);
    return '<div class="proj"><h2>' + esc(p.project) + '</h2>' +
      '<div class="repo">' + esc(p.repo) + '</div>' + haltBanner(p) +
      // No side panel (owner, 2026-10-05): the tree and its side cards take the
      // width. The charter is still edited with `harness charter`.
      '<div class="treecol">' +
      '<div class="ln q" style="margin:0 0 6px">click a task chip to read its brief ' +
      'and comment on it</div>' +
      (p.orphan_marks.length ? '<div class="ln dup">' + p.orphan_marks.length +
        ' open task record(s) name no node in this tree</div><ul class="orph">' +
        p.orphan_marks.map(o => '<li><span class="chip" data-task="' + esc(o.task) +
          '" data-slug="' + esc(p.slug) + '">' + esc(o.task) + '</span>' +
          (o.named ? ' <span class="q">named ' + esc(o.named) + ', trimmed</span>'
                   : ' <span class="q">names no node</span>') +
          (o.at ? ' <span class="q">&middot; ' + esc(o.at) + '</span>' : '') +
          '</li>').join('') + '</ul>' : '') +
      tree(p.nodes, intermCard(p) + docCard(p) + testCard(p)) + '</div></div>';
  }).join('');
  if (!d.projects.length) h += '<div class="empty">no enrolled projects on this machine</div>';
  paint(h);
}

// The charter: what the project is, and the features in scope. Read by every
// node and required of none -- a member does not need the purpose to execute a
// complete brief, and handing it one would be giving back the context its task
// was scoped to exclude. It is here so that "why are we doing this" has an
// answer that does not depend on a lead being awake.
//
// It is also the only thing on this page the operator EDITS rather than
// comments on, and that is the point of it: the charter exists to be argued
// with by the person who knows what the project is for. A description that can
// only be corrected somewhere else is one that goes stale where nobody looks.
// A feature is a dropdown: its name always, its prose when you open it. The
// controls indent, reorder and delete it, and they are the same four you would
// use on any outline -- up and down stay among siblings, promote and demote are
// the only way a feature crosses between one heading and another.
// A control that does not apply here: shown, so the pair reads as a pair, but inert.
const coff = (glyph, title) => '<span class="cact off" title="' + esc(title) + '">' +
  glyph + '</span>';
function feat(p, f, firstTop) {
  const key = p.slug + '::' + f.key;
  const open = OPENF.has(key);
  return '<div class="feat' + (f.depth ? ' sub' : '') + '">' +
    '<div class="chead fname" data-ftog="' + esc(key) + '">' +
      '<span class="tri">' + (open ? '&#9660;' : '&#9654;') + '</span>' +
      '<b>' + esc(f.name) + '</b>' +
      '<span class="cacts">' +
        cact(p.slug, f.name, 'up', '&#9650;', 'move up') +
        cact(p.slug, f.name, 'down', '&#9660;', 'move down') +
        // Both always shown: promote up a heading level, demote under the one
        // above. The outline is two levels deep, so each applies on one side.
        (f.depth ? cact(p.slug, f.name, 'promote', '&#9664;',
                        'promote — up a heading level')
                 : coff('&#9664;', 'already at the top level')) +
        (!f.depth && !firstTop ? cact(p.slug, f.name, 'demote', '&#9654;',
                                      'demote — file it under the section above')
                 : coff('&#9654;', f.depth ? 'the outline is two levels deep'
                                           : 'nothing above it to sit under')) +
        cact(p.slug, f.name, 'delete', '&#10005;',
             'delete — nothing is kept', 'del') +
      '</span></div>' +
    (open
      ? '<div class="frow"><span class="cedit" data-cslug="' + esc(p.slug) +
        '" data-cfeature="' + esc(f.name) + '">edit</span></div>' +
        '<div class="ftext cbody" data-raw="' + esc(f.text) + '">' +
        esc(f.text) + '</div>'
      : '') +
    '</div>';
}

function charter(p) {
  const c = p.charter || { description: '', features: [] };
  const dkey = p.slug + '::';
  const dopen = OPENF.has(dkey);
  // "Project" rather than "what this project is". The panel is plainly about
  // the project; saying so twice is a heading spent on nothing.
  const head = '<h3 class="chead" data-ftog="' + esc(dkey) + '">' +
    '<span class="tri">' + (dopen ? '&#9660;' : '&#9654;') + '</span>Project' +
    '<span class="cedit" data-cslug="' + esc(p.slug) + '" data-cfeature="">edit</span>' +
    '</h3>';
  const body = !dopen ? ''
    : c.description
      ? '<div class="ctext cbody" data-raw="' + esc(c.description) + '">' +
        esc(c.description) + '</div>'
      : '<div class="ctext cbody none" data-raw="">Nothing states what this project ' +
        'is for. Until something does, the only work visible to the head lead is ' +
        'whatever happens to be broken — and a backlog is not a plan.</div>';
  const fs = (c.features || []);
  const list = fs.length
    ? fs.map((f, i) => feat(p, f, !f.depth && !fs.slice(0, i).some(g => !g.depth))).join('')
    : '<div class="ln q">no docs listed</div>';
  return '<div class="charter" data-live="charter:' + esc(p.slug) + '">' + head + body +
    (CHMSG ? '<div class="cmsg2">' + esc(CHMSG) + '</div>' : '') +
    '<div class="feats"><h3>Docs' +
    '<span class="cedit" data-cslug="' + esc(p.slug) + '" data-cnew="1">+ add</span>' +
    '</h3>' + list + '</div></div>';
}

// ── the Owner page ─────────────────────────────────────────────────────────
// The tree page is for watching sessions; this one is for ruling. Only asks the
// intermediary has briefed are the owner's move, and only the owner's button
// signs one: the draft is the intermediary's, the signature is not.
//
// Which items are open is kept like the charter's folds, out of the DOM, so a
// poll does not close the briefing you are reading.
const AKEY = 'harness.askopen';
const OPENA = new Set(load(AKEY));
const AMSG = {};          // ask key -> the CLI's last refusal, shown on the item
let FILTER = '';          // the rulings filter, applied client-side
let LASTD = null;         // the last state read, so a keystroke can re-filter
// The pages, in tab order. The first is the default (no hash).
const TABS = [{route: 'agents', label: 'Agents'}, {route: 'issues', label: 'Issues'}];
// Old addresses, kept so a bookmark still lands.
const ALIAS = {owner: 'issues', tree: 'agents'};
const ROUTE = () => {
  const h = ALIAS[location.hash.slice(1)] || location.hash.slice(1);
  return TABS.some(t => t.route === h) ? h : TABS[0].route;
};
function tabs(N) {
  document.getElementById('tabs').innerHTML = TABS.map((t, i) => {
    const n = t.route === 'issues' && N ? ' (' + N + ')' : '';
    const cls = (t.route === ROUTE() ? 'on' : '') + (n ? ' due' : '');
    const tip = t.route === 'issues'
      ? (N ? N + ' ask(s) waiting on your ruling' : 'nothing waiting on you') : '';
    return '<a class="' + cls + '" href="#' + t.route + '" title="' + tip +
           '">' + t.label + n + '</a>';
  }).join('');
}
const akey = (slug, id) => slug + ':' + id;

function dur(s) {
  if (s == null) return '';
  const m = Math.floor(s / 60);
  return m < 60 ? m + 'm' : Math.floor(m / 60) + 'h' + String(m % 60).padStart(2, '0');
}

function ownerHead(p) {
  const im = p.intermediary || {};
  const body = im.running === null
    ? '<span class="ln u">unknown &mdash; the session roster could not be read</span>'
    : '<span>' + im.running + ' of ' + im.cap + ' item sessions running</span> ' +
      '<span class="q">&mdash; one per open item; each sleeps after an hour quiet and wakes ' +
      'for a message</span>';
  return '<div class="ohead" data-live="owner:head:' + esc(p.slug) + '"><b>intermediary</b>' +
    body + '</div>';
}

// A briefing field may arrive as prose or as a list; either reads as lines.
const lines = v => Array.isArray(v) ? v.map(x => typeof x === 'string' ? x
                                       : JSON.stringify(x)).join('\n') : String(v ?? '');

// Everything said about an item, by anyone, and the box to add to it.
function threadOf(a) {
  return (a.thread || []).map(t => {
    const who = t.by === 'owner' ? 'you' : esc(t.by);
    const to = t.to ? ' &rarr; ' + esc(t.to) : '';
    return '<div class="athr ' + (t.by === 'owner' ? 'me' : t.by === 'intermediary' ? 'im' : 'nd') +
      '"><b>' + who + to + ' &middot; ' + esc(String(t.at || '').slice(11, 16)) + '</b> ' +
      esc(t.text) + '</div>';
  }).join('');
}
function chatRow(k) {
  return '<div class="row"><textarea class="achat" data-akey="' + esc(k) + '" ' +
    'placeholder="message this item&rsquo;s intermediary &mdash; it wakes for it">' +
    '</textarea><button data-amsg="' + esc(k) + '">Send</button></div>';
}

// How a request reached the owner, read by the harness off the transcripts,
// origin first (owner, 2026-10-06): each session, what it was working on and for
// which feature, what reached it and what it concluded.
function chainBlock(a) {
  const ch = a.chain || [];
  if (!ch.length) return '';
  return '<details class="achain"' + (a.kind === 'action' ? ' open' : '') + '><summary>How this ' +
    'reached you &middot; ' + ch.length + ' step' + (ch.length > 1 ? 's' : '') + ' from ' +
    esc(ch[0].from || '?') + '</summary>' + ch.map(h =>
      '<div class="ahop"><b>' + esc(h.node || '?') + '</b> <span class="q">' +
      esc((h.at || '').slice(11, 16)) + ' &middot; ' + (h.task ? esc(h.task) + (h.feature
        ? ' &rarr; ' + esc(h.feature) : ' <span class="untr">untraced</span>') : 'no open task') +
      '</span>' + (h.received ? '<div class="ahq">from ' + esc(h.from || '?') + ': &ldquo;' +
        esc(h.received) + '&rdquo;</div>' : '') +
      (h.concluded ? '<div class="ahc">concluded: &ldquo;' + esc(h.concluded) + '&rdquo;</div>' : '') +
      '</div>').join('') + '</details>';
}

function askItem(slug, a) {
  const k = akey(slug, a.id);
  const open = OPENA.has(k);
  const runs = Array.isArray(a.runs) && a.runs.length ? a.runs : null;
  const mine = runs || a.state === 'ready' || a.state === 'drafted';
  const note = a.kind === 'note';
  const move = a.query_open ? 'intermediary looking'
    : a.waiting_on ? 'asking ' + a.waiting_on
    : note ? 'conversation' : runs ? 'yours to run' : (mine ? 'yours' : 'being briefed');
  const row = '<div class="arow" data-atog="' + esc(k) + '">' +
    '<span class="akind ' + esc(a.kind || '') + '">' + esc(a.kind || '?') + '</span>' +
    '<span class="aq" title="' + esc(a.question) + '">' + esc(a.question) + '</span>' +
    '<span class="ameta">' + esc(a.asker_node || a.asked_by || '?') +
      (a.age ? ' &middot; ' + esc(a.age) : '') +
      ((a.evidence || []).length ? ' &middot; <span class="aev">' + a.evidence.length +
        ' evidence</span>' : '') + '</span>' +
    '<span class="amove' + (mine ? ' yours' : '') + '">' + move + '</span></div>';
  let body = '';
  if (open) {
    const b = a.brief || {};
    const sec = (t, v) => '<dt>' + t + '</dt><dd>' +
      (v ? esc(v) : '<span class="q">&mdash;</span>') + '</dd>';
    const opts = Array.isArray(b.options) && b.options.length
      ? '<ol>' + b.options.map(o => '<li>' + esc(lines(o)) + '</li>').join('') + '</ol>'
      : '<span class="q">&mdash;</span>';
    const msg = AMSG[k] ? '<span class="amsg">refused: ' + esc(AMSG[k]) + '</span>' : '';
    // The URL names the copied file, so it is stable across polls (no re-download
    // when the item is repainted) and never stands for a file dropped since.
    const evs = (a.evidence || []).map((e, i) => {
      const u = '/api/evidence?p=' + encodeURIComponent(slug) + '&id=' +
        encodeURIComponent(a.id) + '&n=' + (i + 1) + '&f=' + encodeURIComponent(e.file);
      const cap = e.caption ? esc(e.caption) : '';
      return e.kind === 'image'
        ? '<div class="evimg"><a href="' + esc(u) + '" target="_blank" rel="noopener" title="' +
          esc(e.name) + ' &mdash; open full size"><img src="' + esc(u) + '" alt="' +
          esc(e.caption || e.name) + '" loading="lazy"></a>' +
          (cap ? '<div class="evcap">' + cap + '</div>' : '') + '</div>'
        : '<div class="evtxt"><a href="' + esc(u) + '" target="_blank" rel="noopener">' +
          esc(e.name) + '</a>' + (cap ? ' &mdash; ' + cap : '') + '</div>';
    }).join('');
    const meta = '<div class="ln q">task ' + esc(a.task || '?') +
      (a.node ? ' &middot; node ' + esc(a.node) : '') +
      ' &middot; asked by ' + esc(a.asked_by || '?') + ' &middot; ' + esc(a.state) + '</div>';
    if (runs) {
      // Commands to run: copy, run, click Done. Or ask the intermediary first.
      const cmds = runs.map((c, i) => '<div class="arun"><pre>' + esc(c) + '</pre>' +
        '<button class="cp" data-acopy="' + esc(c) + '">Copy</button></div>').join('');
      body = meta + cmds + (evs ? '<div style="margin-top:6px">' + evs + '</div>' : '') +
        '<div class="row"><input class="anote" data-akey="' + esc(k) + '" ' +
          'placeholder="note for the asker (optional)">' +
        '<button data-adone="' + esc(k) + '">Done</button>' +
        '<button class="rej" data-arej="' + esc(k) + '">Won&rsquo;t do</button>' + msg + '</div>';
    } else if (note) {
      body = '<div class="row"><button data-adone="' + esc(k) + '">Close</button>' + msg + '</div>';
    } else if (!mine) {
      body = meta + '<div class="ln q" style="margin-top:6px">being briefed by the ' +
        'intermediary</div>' +
        '<div class="row"><button class="rej" data-arej="' + esc(k) + '">Reject</button>' +
        msg + '</div>';
    } else {
      body = meta + '<dl>' +
        sec('Question', b.question || a.question) +
        sec('Background', b.background) +
        sec('Why yours', b.why) +
        sec('Checked', lines(b.checked)) +
        '<dt>Options</dt><dd>' + opts + '</dd>' +
        (evs ? '<dt>Evidence</dt><dd style="white-space:normal">' + evs + '</dd>' : '') +
        sec('Recommendation', b.recommendation) +
        sec('Waiting', b.waiting) +
        '<dt>Draft ruling</dt><dd style="white-space:normal">' +
        '<textarea class="adraft" rows="1" readonly data-akey="' + esc(k) + '" data-raw="' +
        esc(a.draft || '') + '" placeholder="no draft yet &mdash; Edit to write your own">' +
        esc(a.draft || '') + '</textarea></dd></dl>' +
        '<div class="row"><button data-aacc="' + esc(k) + '"' +
          (a.draft ? '' : ' disabled') + '>Accept</button>' +
        '<button data-aedit="' + esc(k) + '">Edit</button>' +
        '<button class="rej" data-arej="' + esc(k) + '">Reject</button>' + msg + '</div>';
    }
    // Every item: its session, everything said about it, and a box to add to it.
    body = '<div class="abody">' + chainBlock(a) + itemSession(slug, a) + body +
      '<div data-live="thread:' + esc(k) + '">' + threadOf(a) +
      (a.query_open ? '<div class="ln q">the intermediary is looking into it&hellip;</div>' : '') +
      '</div>' + chatRow(k) + '</div>';
  }
  return '<div class="ask' + (open ? ' open' : '') + '" data-live="ask:' + esc(k) + '">' +
    row + body + '</div>';
}

function rulingsList(d) {
  const f = FILTER.trim().toLowerCase();
  const all = [];
  (d.projects || []).forEach(p => (p.rulings || []).forEach(r =>
    all.push(Object.assign({ _project: p.project }, r))));
  all.sort((a, b) => String(b.ruled_at || '').localeCompare(String(a.ruled_at || '')));
  const hit = f ? all.filter(r => [r._project, r.task, r.kind, r.question, r.answer,
                                   r.asked_by].join('\n').toLowerCase().includes(f))
                : all;
  const rows = hit.map(r =>
    '<div class="rul"><div class="rh">' +
      esc(String(r.ruled_at || '').slice(0, 10)) + ' &middot; ' + esc(r._project) +
      ' &middot; ' + esc(r.task) + ' &middot; ' + esc(r.kind || '') + '</div>' +
    '<div class="rq">Q: ' + esc(r.question) + '</div>' +
    '<div class="ra">A: ' + esc(r.answer) + '</div></div>').join('');
  return rows || '<div class="ln q">' + (all.length ? 'no ruling matches'
                                                     : 'no rulings yet') + '</div>';
}

// A conversation the owner starts: a note item, with its own session.
function newNote(p) {
  const m = IMMSG['note:' + p.slug] ? '<div class="amsg">refused: ' +
    esc(IMMSG['note:' + p.slug]) + '</div>' : '';
  return '<div class="ichat"><div data-live="note:' + esc(p.slug) + '">' + m + '</div>' +
    '<div class="row"><textarea class="ichatin" data-islug="' + esc(p.slug) + '" ' +
    'placeholder="start a conversation &mdash; it opens an item with its own intermediary">' +
    '</textarea><button data-inote="' + esc(p.slug) + '">Start</button></div></div>';
}
document.addEventListener('click', e => {
  const b = e.target.closest('[data-inote]');
  if (!b) return;
  const slug = b.dataset.inote;
  const ta = b.closest('.ichat').querySelector('.ichatin');
  const t = ta.value.trim();
  if (!t) { ta.focus(); return; }
  b.disabled = true;
  fetch('/api/intermediary', { method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-Harness-Local': '1' },
    body: JSON.stringify({ slug: slug, action: 'note', text: t }) })
    .then(r => r.json())
    .then(j => {
      b.disabled = false;
      if (j.ok) { ta.value = ''; delete IMMSG['note:' + slug]; EDITING.delete('chat:' + slug); }
      else IMMSG['note:' + slug] = j.message || 'refused';
      LAST = ''; tick();
    })
    .catch(() => { b.disabled = false; IMMSG['note:' + slug] = 'could not reach the server';
                   LAST = ''; tick(); });
});
document.addEventListener('focusin', e => {
  if (e.target.classList.contains('ichatin')) EDITING.add('chat:' + e.target.dataset.islug);
});
document.addEventListener('focusout', e => {
  if (e.target.classList.contains('ichatin') && !e.target.value.trim())
    EDITING.delete('chat:' + e.target.dataset.islug);
});

function ownerView(d) {
  // Every project gets its intermediary's line, asks or not: the line is how
  // the owner learns which one to start before anything is waiting on it.
  const groups = (d.projects || []).map(p =>
    '<div class="oproj"><h2>' + esc(p.project) + '</h2>' + ownerHead(p) + newNote(p) +
    (p.asks || []).map(a => askItem(p.slug, a)).join('') + '</div>').join('');
  const none = !(d.projects || []).some(p => (p.asks || []).length);
  return '<div class="owner">' +
    '<h3 class="osec">open asks</h3>' + groups +
    (none ? '<div class="ln q" style="margin-bottom:18px">nothing open &mdash; ' +
      'asks reach this page once an asker raises one</div>' : '') +
    '<h3 class="osec" style="margin-top:26px">rulings' +
    '<input class="ofilter" placeholder="filter" value="' + esc(FILTER) + '" /></h3>' +
    '<div data-live="owner:rulings">' + rulingsList(d) + '</div></div>';
}

// The textarea is the one thing on this page a poll must not touch, so it is
// held in EDITING from the moment it can hold the owner's words -- unlocked by
// Edit, or simply focused -- until it is sent, reverted, or left untouched.
function holdDraft(ta) { EDITING.add('ask:' + ta.dataset.akey); }
function freeDraft(k) { EDITING.delete('ask:' + k); }
function syncAccept(ta) {
  const btn = ta.closest('.abody').querySelector('[data-aacc]');
  if (btn) btn.disabled = !(ta.dataset.raw || ta.value.trim());
}

function ruleAsk(k, action, text) {
  const i = k.indexOf(':');
  const body = { slug: k.slice(0, i), id: k.slice(i + 1), action: action };
  if (text) body.text = text;
  fetch('/api/ask', { method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-Harness-Local': '1' },
    body: JSON.stringify(body) })
    .then(r => r.json())
    .then(j => {
      if (j.ok) {
        delete AMSG[k];
        if (action !== 'msg') { OPENA.delete(k); save(AKEY, OPENA); }
        freeDraft(k); LAST = ''; tick(); return;
      }
      refused(k, j.message || 'refused');
    })
    .catch(() => refused(k, 'could not reach the server'));
}

// A refusal leaves the owner's edited text where it was: it is written into the
// item in place, and the hold on the draft is kept, so nothing typed is lost to
// the redraw a refusal would otherwise trigger.
function refused(k, m) {
  AMSG[k] = m;
  const it = document.querySelector('[data-live="ask:' + k + '"]');
  if (!it || !EDITING.has('ask:' + k)) { LAST = ''; tick(); return; }
  const row = it.querySelector('.row');
  let s = row.querySelector('.amsg');
  if (!s) { s = document.createElement('span'); s.className = 'amsg'; row.appendChild(s); }
  s.textContent = 'refused: ' + m;
  const ta = it.querySelector('.adraft');
  if (ta) syncAccept(ta);
}

document.addEventListener('click', e => {
  const tg = e.target.closest('[data-atog]');
  if (tg) {
    const k = tg.dataset.atog;
    // Folding an item away while its draft is unlocked would orphan the hold.
    if (EDITING.has('ask:' + k)) return;
    OPENA.has(k) ? OPENA.delete(k) : OPENA.add(k);
    save(AKEY, OPENA); LAST = ''; tick(); return;
  }
  const ed = e.target.closest('[data-aedit]');
  if (ed) {
    const ta = ed.closest('.abody').querySelector('.adraft');
    if (ta.readOnly) {
      ta.readOnly = false; holdDraft(ta); ed.textContent = 'Revert'; ta.focus();
    } else {
      ta.value = ta.dataset.raw || ''; ta.readOnly = true; ed.textContent = 'Edit';
      freeDraft(ed.dataset.aedit); syncAccept(ta); fitDraft(ta);
    }
    return;
  }
  const ac = e.target.closest('[data-aacc]');
  if (ac) {
    if (ac.disabled) return;
    const ta = ac.closest('.abody').querySelector('.adraft');
    const t = ta.value.trim();
    // The edited text is sent only when it differs: an unchanged accept signs
    // the intermediary's draft as written, which is what the record should say.
    ac.disabled = true;
    ruleAsk(ac.dataset.aacc, 'accept', t && t !== (ta.dataset.raw || '').trim() ? t : '');
    return;
  }
  const cp = e.target.closest('[data-acopy]');
  if (cp) {
    const ok = () => { cp.textContent = 'Copied'; setTimeout(() => cp.textContent = 'Copy', 1500); };
    if (navigator.clipboard) navigator.clipboard.writeText(cp.dataset.acopy).then(ok, () => {});
    else {
      const r = document.createRange(); r.selectNodeContents(cp.previousElementSibling);
      getSelection().removeAllRanges(); getSelection().addRange(r);
    }
    return;
  }
  const dn = e.target.closest('[data-adone]');
  if (dn) {
    const n = dn.closest('.abody').querySelector('.anote');
    dn.disabled = true;
    ruleAsk(dn.dataset.adone, 'done', n ? n.value.trim() : '');
    return;
  }
  const qy = e.target.closest('[data-amsg]');
  if (qy) {
    const ta = qy.closest('.row').querySelector('.achat');
    const t = ta ? ta.value.trim() : '';
    if (!t) { ta && ta.focus(); return; }
    qy.disabled = true;
    ruleAsk(qy.dataset.amsg, 'msg', t);
    return;
  }
  const rj = e.target.closest('[data-arej]');
  if (rj) {
    if (!confirm('Reject this ask? It is removed, and its asker is told you ' +
                 'rejected it. Nothing else is kept.')) return;
    ruleAsk(rj.dataset.arej, 'reject', '');
    return;
  }
});
// A browser without field-sizing sizes the draft by hand: shrink, then grow to
// the text. Run after every paint and keystroke; a collapsed item has no body.
const FIELD_SIZING = window.CSS && CSS.supports && CSS.supports('field-sizing', 'content');
function fitDraft(ta) {
  if (FIELD_SIZING || !ta) return;
  ta.style.height = 'auto';
  ta.style.height = (ta.scrollHeight + 2) + 'px';
}
function fitDrafts() { document.querySelectorAll('.adraft').forEach(fitDraft); }
window.addEventListener('resize', fitDrafts);
document.addEventListener('input', e => {
  if (e.target.classList.contains('adraft')) { syncAccept(e.target); fitDraft(e.target); }
  if (e.target.classList.contains('ofilter')) {
    FILTER = e.target.value;
    // Polls are held while the filter has focus, so it re-filters by hand.
    const el = document.querySelector('[data-live="owner:rulings"]');
    if (el && LASTD) el.innerHTML = rulingsList(LASTD);
  }
});
document.addEventListener('focusin', e => {
  if (e.target.classList.contains('adraft')) holdDraft(e.target);
  if (e.target.matches('.anote, .achat')) holdDraft(e.target);
  if (e.target.classList.contains('ofilter')) EDITING.add('owner:filter');
});
document.addEventListener('focusout', e => {
  // A read-only draft that was only looked at is not being written; let go.
  if (e.target.classList.contains('adraft') && e.target.readOnly)
    freeDraft(e.target.dataset.akey);
  // A note or question half-written is held; an empty one is let go.
  if (e.target.matches('.anote, .achat')) {
    const b = e.target.closest('.abody');
    if (b && ![...b.querySelectorAll('.anote, .achat')].some(x => x.value.trim()))
      freeDraft(e.target.dataset.akey);
  }
  if (e.target.classList.contains('ofilter')) {
    EDITING.delete('owner:filter'); LAST = ''; tick();
  }
});
window.addEventListener('hashchange', () => {
  // Leaving a view abandons whatever was half-typed in it; holding the other
  // view hostage to it would be worse.
  EDITING.clear(); closeModal(); LAST = ''; tick();
});

// Targeted update, not a repaint. The page is built once; after that a poll may
// only replace elements that carry data-live, and only when their content has
// actually changed. Anything not on that list -- a textarea mid-sentence, an
// expanded panel, a text selection, the scroll position -- survives by
// construction rather than by being remembered and put back.
//
// An include list is the maintainable direction: a new volatile field is opted
// IN by tagging it, and forgetting to tag one shows up as a stale number, which
// is visible. The exclude list it replaces failed the other way -- forgetting to
// exempt something ate your work silently.
// The path from each waiting card up to its lead's card: up from the child,
// across, and down into the lead, over the tree's own connectors.
function drawWaits() {
  document.querySelectorAll('.tspace').forEach(t => {
    t.querySelectorAll('svg.waits').forEach(x => x.remove());
    const box = t.getBoundingClientRect(), ds = [];
    t.querySelectorAll('.wto, .hto').forEach(m => {
      const c = m.closest('.card');
      const key = c && c.dataset.live || '';
      const slug = key.split(':')[1];
      const lead = m.dataset.on &&
        t.querySelector('[data-live="card:' + slug + ':' + m.dataset.on + '"]');
      if (!lead) return;
      const a = c.getBoundingClientRect(), b = lead.getBoundingClientRect();
      // Three shapes, by where the waited-on card sits. Each runs along the
      // tree's own branch bar, 22px above the lower row, and never through a card.
      //   above (its lead):   waiting card's top -> bar -> lead's bottom
      //   below (its child):  waiting card's bottom -> bar over the child -> child's top
      //   same row (sibling): both tops, bar above the higher of the two
      const x1 = a.left + a.width / 2 - box.left, x2 = b.left + b.width / 2 - box.left;
      let y1, y2, ym;
      if (b.bottom <= a.top + 4) {
        y1 = a.top - box.top; y2 = b.bottom - box.top; ym = y1 - 22;
      } else if (b.top >= a.bottom - 4) {
        y1 = a.bottom - box.top; y2 = b.top - box.top; ym = y2 - 22;
      } else {
        y1 = a.top - box.top; y2 = b.top - box.top; ym = Math.min(y1, y2) - 22;
      }
      ds.push([m.classList.contains('hto') ? 'held' : '',
               'M' + x1 + ' ' + y1 + 'V' + ym + 'H' + x2 + 'V' + y2]);
    });
    // The intermediary messaged a node and waits on its reply, or the test
    // queue is running a node's job: a dotted line from the card's right edge,
    // along the gutter, over the node's row and down into it.
    t.querySelectorAll('.ito, .tto').forEach(m => {
      const c = m.closest('.card');
      const slug = (c && c.dataset.live || '').split(':')[1];
      const n = t.querySelector('[data-live="card:' + slug + ':' + m.dataset.on + '"]');
      if (!n) return;
      const a = c.getBoundingClientRect(), b = n.getBoundingClientRect();
      const mr = m.getBoundingClientRect();
      const x1 = a.right - box.left, y1 = mr.top + mr.height / 2 - box.top, gx = x1 + 13;
      const x2 = b.left + b.width / 2 - box.left, y2 = b.top - box.top;
      ds.push([m.classList.contains('tto') ? 'test' : 'msg', 'M' + x1 + ' ' + y1 + 'H' + gx + 'V' + (y2 - 11) + 'H' + x2 + 'V' + y2]);
    });
    if (!ds.length) return;
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('class', 'waits');
    svg.setAttribute('width', t.scrollWidth); svg.setAttribute('height', t.scrollHeight);
    svg.innerHTML = ds.map(([c, d]) => '<path class="' + c + '" d="' + d + '"/>').join('');
    t.appendChild(svg);
  });
}
window.addEventListener('resize', drawWaits);

function paint(h) {
  // Nothing is replaced while prose is being written into this page. The
  // include list protects a textarea that the poll knows about; it cannot
  // protect one against the shape-change rebuild, and losing a paragraph
  // someone was halfway through writing is not a fault worth risking to keep a
  // busy dot current for three more seconds.
  if (EDITING.size) return;
  const root = document.getElementById('root');
  const tpl = document.createElement('div');
  tpl.innerHTML = h;
  const keys = el => Array.prototype.map.call(
    el.querySelectorAll('[data-live]'), e => e.dataset.live).join(',');

  // The shape changed -- a node appeared, an item cleared -- so there is nothing
  // to patch into. This is the only path that rebuilds, and it is rare.
  if (keys(tpl) !== keys(root)) {
    root.innerHTML = h;
    drawWaits(); fitDrafts();
    return;
  }
  Array.prototype.forEach.call(tpl.querySelectorAll('[data-live]'), fresh => {
    const cur = root.querySelector('[data-live="' + fresh.dataset.live + '"]');
    if (!cur) return;
    if (cur.className !== fresh.className) cur.className = fresh.className;
    if (cur.innerHTML !== fresh.innerHTML) cur.innerHTML = fresh.innerHTML;
  });
  drawWaits(); fitDrafts();
}
tick(); setInterval(tick, 3000);
</script></body></html>"""


def _project_dir(slug):
    """Whitelist, not sanitise. The slug must BE one of the directories that
    exist; nothing is joined from user input, so there is no path to traverse."""
    for p in CLI.HOME_STATE.glob("*"):
        if p.is_dir() and p.name == slug and (p / "binding.json").exists():
            return p
    return None


def task_detail(slug, task):
    pdir = _project_dir(slug)
    if pdir is None:
        return None
    md, bd = pdir / "marks", pdir / "briefs"
    # Same whitelist: the file must already be in the listing.
    hit = next((f for f in md.glob("*.json") if f.stem == task), None) if md.is_dir() else None
    bhit = next((f for f in bd.glob("*.json") if f.stem == task), None) if bd.is_dir() else None
    if hit is None and bhit is None:
        return None
    rec, brief = {}, None
    for src, into in ((hit, "rec"), (bhit, "brief")):
        if src is None:
            continue
        try:
            v = json.loads(src.read_text())
        except Exception:
            continue
        if into == "rec":
            rec = v
        else:
            brief = v
    repo = ""
    try:
        repo = json.loads((pdir / "binding.json").read_text()).get("repo", "")
    except Exception:
        pass
    return {"task": task, "slug": slug, "repo": repo,
            "node": rec.get("_node") or (brief or {}).get("node"),
            "branch": rec.get("_branch"),
            "opened": rec.get("_at"), "closed": rec.get("_closed_at"),
            "session": (rec.get("_session") or "")[:8],
            "marked": hit is not None,
            "presented_at": rec.get("_presented_at"),
            "presented_by": rec.get("_presented_by"),
            "closed_by": rec.get("_closed_by"),
            "brief": (brief or {}).get("text") or "",
            "brief_by": (brief or {}).get("written_by") or "",
            "brief_rev": (brief or {}).get("revision"),
            "brief_at": (brief or {}).get("written_at"),
            "suggestions": (brief or {}).get("suggestions") or [],
            "brief_comments": (brief or {}).get("comments") or [],
            "mark_note": rec.get("_note") or "",
            "comments": rec.get("_comments") or []}


def add_comment(slug, task, text):
    """The one write, and it is delegated.

    The server runs `harness note --add` in the project rather than editing the
    record itself, so the viewer gains no ability the CLI does not already grant
    and there is exactly one implementation of what a comment is. If the CLI
    refuses, so does this.
    """
    d = task_detail(slug, task)
    if d is None or not d["repo"]:
        return False, "no such task"
    exe = Path(__file__).resolve().with_name("harness")
    # A comment typed into this page was typed by a PERSON. The server may have
    # been launched from inside a session and would otherwise inherit its id and
    # sign the comment with it, which is a false attribution in the one record
    # that exists to be trusted.
    env = {k: v for k, v in os.environ.items() if k != "CLAUDE_CODE_SESSION_ID"}
    # The BRIEF when there is one: it is what gets rewritten, so the reasoning
    # belongs beside it, and its unread cursor is what makes a lane look. The
    # mark is the fallback for tasks that predate briefs.
    argv = ([str(exe), "brief", task, "--comment", text] if d.get("brief_rev")
            else [str(exe), "note", task, "--add", text])
    r = subprocess.run([sys.executable] + argv,
                       cwd=d["repo"], capture_output=True, text=True, timeout=20, env=env)
    return r.returncode == 0, (r.stdout or r.stderr).strip()[:300]


def shape_charter(slug, feature, action):
    """Reorder, nest or delete a feature — delegated, like every other write.

    The viewer does not open charter.json. What a charter is, what may change
    it, and what an order even means all live in the CLI; a second
    implementation here would be a second answer to those questions, and the
    one the operator sees would be whichever they happened to use last.
    """
    flag = {"up": ["--move", "up"], "down": ["--move", "down"],
            "promote": ["--promote"], "demote": ["--demote"],
            "delete": ["--delete"]}.get(action)
    if not flag:
        return False, f"unknown action {action!r}"
    if not feature:
        return False, "which feature?"
    return _charter_cli(slug, ["--feature", feature] + flag)


def _charter_cli(slug, args):
    pdir = _project_dir(slug)
    if pdir is None:
        return False, "no such project"
    try:
        repo = json.loads((pdir / "binding.json").read_text()).get("repo", "")
    except Exception:
        return False, "unreadable binding"
    exe = Path(__file__).resolve().with_name("harness")
    # The session id is stripped because prose typed into a page, and a button
    # clicked on one, were both done by a person — and the CLI gates charter
    # writes on rank, which a person does not have.
    env = {k: v for k, v in os.environ.items() if k != "CLAUDE_CODE_SESSION_ID"}
    r = subprocess.run([sys.executable, str(exe), "charter"] + args, cwd=repo,
                       capture_output=True, text=True, timeout=20, env=env)
    return r.returncode == 0, (r.stdout or r.stderr).strip()[:300]


def save_charter(slug, feature, text):
    """This is the one object the operator is expected to EDIT rather than
    comment on, which is why it is the one place the viewer offers a full text
    box. The charter is the artefact whose whole purpose is to be argued with by
    the person who knows what the project is for, and a description nobody can
    correct in the place they read it is one that goes stale silently."""
    return _charter_cli(slug, (["--feature", feature] if feature else []) +
                        ["--write", text])


def _ask_cli(slug, args):
    """Sign or reject an ask — delegated, like every other write.

    The CLI refuses `--accept` from inside a session, as it does `sweep`, so the
    only signatures are the owner's. The session id is stripped for the same
    reason a comment's is: a button clicked on this page was clicked by a person,
    even when the server happened to be started from inside a session.
    """
    pdir = _project_dir(slug)
    if pdir is None:
        return False, "no such project"
    try:
        repo = json.loads((pdir / "binding.json").read_text()).get("repo", "")
    except Exception:
        return False, "unreadable binding"
    exe = Path(__file__).resolve().with_name("harness")
    env = {k: v for k, v in os.environ.items() if k != "CLAUDE_CODE_SESSION_ID"}
    try:
        r = subprocess.run([sys.executable, str(exe), "ask"] + args, cwd=repo,
                           capture_output=True, text=True, timeout=20, env=env)
    except Exception as e:
        return False, f"{type(e).__name__}: {e}"[:300]
    return r.returncode == 0, (r.stdout or r.stderr).strip()[:300]


def documenter_action(slug, action, runs=1):
    """Start runs or stop the chain — delegated to the CLI like every write, with
    the session id stripped: the button was pressed by a person."""
    pdir = _project_dir(slug)
    if pdir is None:
        return False, "no such project"
    try:
        repo = json.loads((pdir / "binding.json").read_text()).get("repo", "")
    except Exception:
        return False, "unreadable binding"
    if action == "start":
        try:
            n = max(1, min(int(runs), 20))
        except (TypeError, ValueError):
            return False, "runs must be a number"
        args = ["--runs", str(n)]
    elif action == "stop":
        args = ["--stop"]
    else:
        return False, "unknown action"
    exe = Path(__file__).resolve().with_name("harness")
    env = {k: v for k, v in os.environ.items() if k != "CLAUDE_CODE_SESSION_ID"}
    try:
        r = subprocess.run([sys.executable, str(exe), "documenter", f"--project={pdir.name}"] + args,
                           cwd=repo, capture_output=True, text=True, timeout=60, env=env)
    except Exception as e:
        return False, f"{type(e).__name__}: {e}"[:300]
    return r.returncode == 0, (r.stdout or r.stderr).strip()[:300]


def intermediary_action(slug, action="start", text="", ask_id=""):
    """Start (or wake) an ask's intermediary session, or open a conversation (a
    note ask) with the owner's first message. Through the CLI with the session
    id stripped: a person pressed it."""
    pdir = _project_dir(slug)
    if pdir is None:
        return False, "no such project"
    if action == "note":
        if not (text or "").strip():
            return False, "say something"
        return _ask_cli(slug, [CLI.OWNER_TASK, "--kind", "note", "--question", text])
    if action != "start":
        return False, "unknown action"
    ad = pdir / "asks"
    if not ask_id or not ad.is_dir() or not any(f.stem == ask_id for f in ad.glob("*.json")):
        return False, "no such ask"
    try:
        repo = json.loads((pdir / "binding.json").read_text()).get("repo", "")
    except Exception:
        return False, "unreadable binding"
    exe = Path(__file__).resolve().with_name("harness")
    env = {k: v for k, v in os.environ.items() if k != "CLAUDE_CODE_SESSION_ID"}
    try:
        r = subprocess.run([sys.executable, str(exe), "intermediary", f"--project={pdir.name}",
                            "--ask", ask_id],
                           cwd=repo, capture_output=True, text=True, timeout=60, env=env)
    except Exception as e:
        return False, f"{type(e).__name__}: {e}"[:300]
    return r.returncode == 0, (r.stdout or r.stderr).strip()[:300]


def rule_ask(slug, ask_id, action, text):
    """Accept or reject one open ask. Same whitelist as a task: the id must be a
    file already in that project's asks/, so nothing is joined from input."""
    pdir = _project_dir(slug)
    if pdir is None:
        return False, "no such project"
    ad = pdir / "asks"
    if not ask_id or not ad.is_dir() or not any(f.stem == ask_id for f in ad.glob("*.json")):
        return False, "no such ask"
    if action == "accept":
        return _ask_cli(slug, [ask_id, "--accept"] + (["--text", text] if text else []))
    if action == "reject":
        return _ask_cli(slug, [ask_id, "--reject"])
    if action == "done":
        return _ask_cli(slug, [ask_id, "--done"] + (["--text", text] if text else []))
    if action in ("msg", "query"):
        if not (text or "").strip():
            return False, "say something"
        return _ask_cli(slug, [ask_id, "--msg", text])
    return False, f"unknown action {action!r}"


EVIDENCE_TYPES = {".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg",
                  ".gif": "image/gif", ".webp": "image/webp", ".svg": "image/svg+xml"}


def ask_evidence(slug, ask_id, n, fname=None):
    """One attached file -> (bytes, content type), or None. Every part is
    whitelisted: the project dir exists, the ask id is a file already in its
    asks/, n indexes that record's evidence, and the resolved file must sit
    directly in that ask's evidence dir, so nothing in the record can point out."""
    pdir = _project_dir(slug)
    if pdir is None:
        return None
    ad = pdir / "asks"
    af = next((f for f in ad.glob("*.json") if f.stem == ask_id), None) if ad.is_dir() else None
    if af is None:
        return None
    try:
        ev = json.loads(af.read_text()).get("evidence") or []
        i = int(n)
    except Exception:
        return None
    if not 1 <= i <= len(ev) or not isinstance(ev[i - 1], dict):
        return None
    e = ev[i - 1]
    name = str(e.get("file") or "")
    if not name or (fname is not None and fname != name):
        return None
    base = (ad / "evidence" / af.stem).resolve()
    try:
        f = (base / name).resolve()
    except Exception:
        return None
    if f.parent != base or not f.is_file():
        return None
    ext = f.suffix.lower()
    if ext in EVIDENCE_TYPES:
        ctype = EVIDENCE_TYPES[ext]
    elif ext in CLI.EVIDENCE_TEXT:
        ctype = "text/plain; charset=utf-8"
    else:
        return None
    try:
        return f.read_bytes(), ctype
    except Exception:
        return None


class H(BaseHTTPRequestHandler):
    def _send(self, body, ctype):
        # A page polling every 3s abandons requests routinely: navigate away, or
        # reload, and the socket is gone before the response lands. That is the
        # CLIENT's business, not an error here. Swallowing it also stops the
        # second, uglier failure -- the old handler caught the write error and
        # then tried to report it down the same dead socket, so one closed tab
        # printed two tracebacks.
        b = body.encode()
        try:
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            # The page is a prototype that changes often; a cached copy of it is
            # a bug report waiting to happen.
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(b)))
            self.end_headers()
            self.wfile.write(b)
        except (BrokenPipeError, ConnectionResetError):
            self.close_connection = True

    def _send_evidence(self, b, ctype):
        # An SVG is a document that can script; the CSP stops it running anything
        # even when opened on its own in a tab, and nosniff stops a text file
        # being read as HTML. The URL names the file, so it may be cached.
        try:
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Security-Policy",
                             "default-src 'none'; style-src 'unsafe-inline'")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Cache-Control", "private, max-age=3600")
            self.send_header("Content-Length", str(len(b)))
            self.end_headers()
            self.wfile.write(b)
        except (BrokenPipeError, ConnectionResetError):
            self.close_connection = True

    def do_GET(self):
        if self.path.startswith("/api/evidence?"):
            q = parse_qs(urlparse(self.path).query)
            g = lambda k: (q.get(k) or [""])[0]
            hit = ask_evidence(g("p"), g("id"), g("n"), q["f"][0] if "f" in q else None)
            if hit is None:
                self.send_error(404); return
            self._send_evidence(*hit)
        elif self.path.startswith("/api/state"):
            # Built before it is sent, so a failure to READ the state and a
            # failure to WRITE the response stay distinguishable.
            try:
                body = json.dumps(read_state())
            except Exception as e:
                body = json.dumps({"error": f"{type(e).__name__}: {e}",
                                   "projects": []})
            self._send(body, "application/json")
        elif self.path.startswith("/api/task?"):
            q = parse_qs(urlparse(self.path).query)
            d = task_detail((q.get("p") or [""])[0], (q.get("t") or [""])[0])
            self._send(json.dumps(d or {"error": "not found"}), "application/json")
        elif self.path in ("/", "/index.html"):
            self._send(PAGE, "text/html; charset=utf-8")
        else:
            self.send_error(404)

    def do_POST(self):
        # This server has no authentication, so a page you merely VISIT could POST
        # here. A custom header forces a CORS preflight cross-origin, and no OPTIONS
        # is answered, so a browser blocks it before it is sent; Origin is checked
        # too, for anything that is not a browser following the rules.
        if self.headers.get("X-Harness-Local") != "1":
            self.send_error(403, "missing X-Harness-Local"); return
        origin = self.headers.get("Origin")
        if origin and not origin.startswith(("http://127.0.0.1:", "http://localhost:")):
            self.send_error(403, "cross-origin"); return
        if not self.path.startswith(("/api/comment", "/api/charter", "/api/ask",
                                     "/api/documenter", "/api/intermediary")):
            self.send_error(404); return
        try:
            n = int(self.headers.get("Content-Length") or 0)
            body = json.loads(self.rfile.read(min(n, 64_000)) or b"{}")
        except Exception:
            self.send_error(400, "bad JSON"); return
        text = (body.get("text") or "").strip()
        if self.path.startswith("/api/documenter"):
            ok, msg = documenter_action(str(body.get("slug") or ""),
                                        (body.get("action") or "").strip(), body.get("runs", 1))
            self._send(json.dumps({"ok": ok, "message": msg}), "application/json")
            return
        if self.path.startswith("/api/intermediary"):
            ok, msg = intermediary_action(str(body.get("slug") or ""),
                                          (body.get("action") or "start").strip(), text,
                                          str(body.get("id") or ""))
            self._send(json.dumps({"ok": ok, "message": msg}), "application/json")
            return
        if self.path.startswith("/api/ask"):
            ok, msg = rule_ask(str(body.get("slug") or ""), str(body.get("id") or ""),
                               (body.get("action") or "").strip(), text)
            self._send(json.dumps({"ok": ok, "message": msg}), "application/json")
            return
        if self.path.startswith("/api/charter"):
            # Shaping and writing go down the same route because they are the
            # same object; an action arrives instead of text, never as well as.
            act = (body.get("action") or "").strip()
            if act:
                ok, msg = shape_charter(body.get("slug", ""),
                                        body.get("feature") or "", act)
            elif not text:
                self.send_error(400, "empty charter"); return
            else:
                ok, msg = save_charter(body.get("slug", ""),
                                       body.get("feature") or "", text)
            self._send(json.dumps({"ok": ok, "message": msg}), "application/json")
            return
        if not text:
            self.send_error(400, "empty comment"); return
        ok, msg = add_comment(body.get("slug", ""), body.get("task", ""), text)
        self._send(json.dumps({"ok": ok, "message": msg}), "application/json")

    def log_message(self, *a):
        pass          # a poll every 3 seconds would bury anything worth reading


def open_browser(url):
    """Under WSL the browser is on the other side of the kernel.

    `webbrowser` resolves to xdg-open, which finds no Linux browser on a headless
    WSL install and either fails or opens nothing at all. Windows reaches
    127.0.0.1 in the VM directly, so handing the URL to the Windows shell is both
    correct and the only thing that works. `explorer.exe` exits non-zero on
    success, so its return code is deliberately not consulted.
    """
    wsl = False
    try:
        wsl = "microsoft" in Path("/proc/version").read_text().lower()
    except Exception:
        pass
    if wsl:
        for exe in ("wslview", "explorer.exe"):
            try:
                subprocess.run([exe, url], timeout=10,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return
            except Exception:
                continue
        print("  (could not reach a Windows browser — open the URL yourself)")
        return
    try:
        webbrowser.open(url)
    except Exception:
        pass


def main():
    ap = argparse.ArgumentParser(prog="harness-gui", description=__doc__.splitlines()[0])
    ap.add_argument("--port", type=int, default=DEFAULT_PORT,
                    help=f"default {DEFAULT_PORT}, walking upward if taken; "
                         f"an explicit --port is honoured exactly or refused")
    # Opt-in, not opt-out. A viewer that seizes the browser every time it starts
    # is one that interrupts whatever was on screen, and it starts often — from
    # `harness gui`, from a restart after an edit, from a second port when the
    # first is taken. The URL is printed; that is enough to click.
    ap.add_argument("--open", dest="open_browser", action="store_true",
                    help="also open it in a browser")
    ap.add_argument("--no-open", action="store_true",
                    help=argparse.SUPPRESS)      # accepted and ignored; now the default
    ap.add_argument("--once", action="store_true", help="print the JSON and exit")
    a = ap.parse_args()
    if a.once:
        print(json.dumps(read_state(), indent=2)); return
    # An explicit --port is honoured exactly: if you named one, being quietly
    # moved somewhere else is worse than being told. Only the DEFAULT wanders.
    wander = a.port == DEFAULT_PORT
    srv, port = None, a.port
    for cand in range(a.port, a.port + (12 if wander else 1)):
        try:
            # 127.0.0.1, never 0.0.0.0: this exposes worktree paths, session names
            # and every open block, and it is a prototype with no authentication.
            srv, port = ThreadingHTTPServer(("127.0.0.1", cand), H), cand
            break
        except OSError:
            continue
    if srv is None:
        where = (f"127.0.0.1:{a.port}-{a.port + 11}" if wander else f"127.0.0.1:{a.port}")
        print(f"harness-gui: nothing free on {where}.\n"
              f"             `ss -ltn` will show what has it; --port picks another.",
              file=sys.stderr)
        sys.exit(4)
    # flush: the next call blocks forever in serve_forever, and stdout to a pipe
    # or a log file is block-buffered, so without this the URL never appears at
    # all for anyone who redirected it.
    if port != a.port:
        print(f"harness-gui: {a.port} was taken, using {port}", flush=True)
    url = f"http://127.0.0.1:{port}/"
    print(f"harness-gui  {url}   (read-only; ctrl-c to stop)", flush=True)
    if a.open_browser:
        open_browser(url)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")


if __name__ == "__main__":
    main()
