    bk.add_argument("--why", help="what it is for, in one line")
    bk.add_argument("--still-moving", dest="still_moving",
                    help="what continues without it — this is how urgent gets judged")
    bk.add_argument("--resolve", action="store_true",
                    help="close it; rank 0 may close any block in the tree")
    bk.add_argument("--task", metavar="TASK", action="append",
                    help="the task the answer produced; repeatable, and works on a "
                         "block already closed")
