#!/usr/bin/env python3
"""harness — position and occupancy for the Agent Workstream Harness.

Reads Claude's internal state; never writes it. Every dependency on that state
is asserted before anything else runs (R8), and a failed assertion refuses to
operate rather than degrading: a mis-identified session is how two of them end
up holding one node, which is the failure the lock exists to prevent.

This tool does no reasoning. The agent gathers liveness with ListAgents and
passes it in; this only asserts, derives and writes atomically.
"""
import argparse, datetime, difflib, fnmatch, gzip, json, os, re, shlex, shutil, socket, subprocess, sys, time
from pathlib import Path

OK, CONTRACT, NOT_ENROLLED, REFUSED, MISMATCH = 0, 2, 3, 4, 5
# doctor's failures used to exit 2 alongside the platform contract, and 2 tells
# a session that Claude's internals have changed and not to work around it. A
# stale hook is not Claude state and the remedy is `harness scaffold`, so the
# table sent whoever met it to stop and report the wrong thing — and read as a
# prohibition on the one command that fixes it. Two conditions, one symbol,
# reading identically at the call site and diverging only when something acts
# on them. That is the fault this codebase writes up as one word, two contracts.
UNGUARDED = 6

HOME_STATE = Path.home() / ".claude" / "harness"
TEMPLATES = Path.home() / ".claude" / "harness" / "templates"
PROJECTS = Path.home() / ".claude" / "projects"
SESSIONS = Path.home() / ".claude" / "sessions"
JOBS = Path.home() / ".claude" / "jobs"
ENDED_NAG = 20          # ended sessions on the list before rank 0 is told
UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
SLUG_RE = re.compile(r"^[A-Za-z0-9-]+$")


QUIET = False

# What a spawned or recycled session is told. It must say to WORK: a prompt that
# ended at "claim your node" produced leads that claimed and stopped (obs 18, 48).
LAUNCH_PROMPT = ("Use the harness skill: establish your position from git, verify "
                 "the platform contract, and claim your node. Then work your queue "
                 "until you are blocked on your lead or the operator.")


def die(code, msg):
    if not QUIET:
        print(f"harness: {msg}", file=sys.stderr)
    sys.exit(code)


def slug(p):
    return re.sub(r"[^A-Za-z0-9]", "-", str(p))


def git(*args, cwd=None):
    r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    return r.returncode, r.stdout.strip(), r.stderr.strip()


# ── R8: the platform contract ────────────────────────────────────────────────

def agents_json(override=None):
    """`claude agents --json` — the supported session query.

    Returns cwd, kind, name, pid, sessionId and status for every session it
    knows about — NOT only live ones. Exited sessions are retained with `pid`
    null, so anything asking "is this node occupied?" must pass rows through
    live_rows() first. Preferred over globbing ~/.claude/sessions/ wherever
    correctness matters; that directory is internal and undocumented.
    """
    if override is not None:
        try:
            return json.loads(override)
        except json.JSONDecodeError:
            raise ValueError("roster override is not valid JSON")
    r = subprocess.run(["claude", "agents", "--json"], capture_output=True,
                       text=True, timeout=20)
    if r.returncode != 0:
        raise ValueError(f"`claude agents --json` failed: {r.stderr.strip()[:120]}")
    try:
        d = json.loads(r.stdout)
    except json.JSONDecodeError:
        raise ValueError("`claude agents --json` did not return JSON — "
                         "its output format has changed")
    if not isinstance(d, list):
        raise ValueError("`claude agents --json` no longer returns a JSON array")
    return d


def live_rows(rows):
    """The subset that is actually running.

    Occupancy has to mean a live process. `claude agents --json` keeps exited
    sessions with a null pid, and counting them made a node whose session had
    ended read as permanently occupied — `spawn` skipped it as "occupied by"
    a session that no longer existed, so it could never be refilled.
    """
    out = []
    for r in rows:
        pid = r.get("pid")
        if not isinstance(pid, int):
            continue                      # exited, or not a local process
        try:
            os.kill(pid, 0)
        except (OSError, ProcessLookupError):
            continue
        out.append(r)
    return out


def pid_alive(pid):
    """A pid on this host that is running and is Claude (a reused pid is not)."""
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except OSError:
        pass                              # exists, not ours to signal
    try:
        return b"claude" in Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return True                       # no /proc: trust the signal


def holder_alive(held, rows=None):
    """Is a lock's holder running? True, False, or None when this host cannot know.

    The one liveness reading (obs 1-4, 16, 40). Never the roster's row alone: it
    outlives its process. On this host: the lock's pid, else a live session file
    for the same id (a resumed session keeps its id and changes pid), else a
    live roster row if `rows` is given.
    """
    if held.get("host") and held["host"] != socket.gethostname():
        return None
    if pid_alive(held.get("pid")):
        return True
    ref = held.get("ref")
    if any(d.get("sessionId") == ref and pid_alive(d.get("pid"))
           for d in live_sessions()):
        return True
    if rows:
        return ref in {r.get("sessionId") for r in live_rows(rows)}
    return False


def last_write(sid):
    """Epoch of a session's last transcript write, or None."""
    t = transcript_for(sid) if sid else None
    try:
        return t.stat().st_mtime if t else None
    except OSError:
        return None


# The runtime's own word for it is `blocked`, and this codebase already spends
# that word on something else: `harness blocked` is a record asking the OPERATOR
# to widen a permission, raised deliberately by a session that is still running
# and often still working on other things. A session the runtime has halted at a
# prompt is a different fact about a different thing. One word over two
# contracts is a fault this project has already written up and paid for, so the
# roster's value is read at exactly one boundary and everything a human reads
# says `stopped`.
STOPPED_STATE = "blocked"


def is_stopped(row):
    """Is this session waiting on the operator?

    ONE runtime state, at least two situations, and they have different
    remedies. Measured on a live tree 2026-09-08: `biblion2-main` reported
    `blocked` because it had ended its turn and was waiting for a REPLY —
    prompting it cleared it instantly and attaching did nothing, because there
    was nothing to approve. `biblion2-dev` reported the same value while
    genuinely halted on a permission prompt for a compound `cd ... && harness
    note ...` command.

    The first draft of everything below called both "halted at a prompt" and
    told the operator to attach. That was wrong for the commoner of the two and
    sent them at the wrong remedy twice. The roster can't tell the cases apart;
    `stop_detail` reads them off the transcript, and where it can't, every
    surface says WAITING ON YOU and offers both, cheapest first. A queue that confidently prescribes the wrong action is
    worse than one that says it does not know.

    Why it is read at all — a measurement taken 2026-08-31 found that the roster
    carried `status` and `state` (working/done) and nothing that could tell a
    session stopped dead on a refused permission from one that was working.

    The runtime has since grown the distinction, and nothing here looked. Cost,
    measured on a live tree 2026-09-08: a lead sat at a prompt for forty minutes
    holding three briefs written for it, while every surface in this CLI
    rendered it `idle` — the same word as free. `recycle` would not even have
    refused it, so the remedy was reachable the whole time and nothing could see
    the condition.

    That is I13 arriving in the worst available place. A measurement written into
    prose ages silently; this one aged into a PREMISE, and nothing re-derives a
    premise. C6 asserts the field, so the next expiry is loud.
    """
    return row.get("state") == STOPPED_STATE


def stopped_rows(rows):
    return [r for r in rows if is_stopped(r)]


LAUNCHED = "@launch"     # a stop whose turn began from the harness's own launch prompt


def job_intent(row):
    """The prompt a background session was launched with, from its job record."""
    try:
        return (json.loads((JOBS / (row.get("id") or "") / "state.json").read_text())
                .get("intent") or "").strip()
    except Exception:
        return ""


FROM_NAME = re.compile(r'<cross-session-message[^>]*\bfrom-name="([^"]+)"')


def ctx_parent(idx, node):
    """A node's lead, from an index's nodes table."""
    return ((idx.get("nodes") or {}).get(node) or {}).get("parent")


def stop_detail(row, rows=None, tail=256 * 1024):
    """Which of the two stops this is, read off the session's own transcript.

    The roster can't tell them apart; the transcript can. A turn that ended
    (`end_turn`, then the `turn_duration` record) is a session waiting for a
    reply: `{"kind": "reply", "on": <session name, or "" for the operator>,
    "said": <its last message's summary>}`. Measured on a live tree 2026-10-05,
    every stopped session was this one. A tool call with nothing after it is a
    permission prompt, the one only a keyboard clears: `{"kind": "permission",
    "tool": ..., "what": ...}`. None when not stopped, or when the tail says
    neither, so a caller falls back to naming both.

    Who a reply-wait is on: whoever its last `SendMessage` in the final turn
    went to, else whoever sent the prompt that opened the turn.
    """
    if not is_stopped(row):
        return None
    t = transcript_for(row.get("sessionId") or "")
    if t is None:
        return None
    try:
        with open(t, "rb") as fh:
            fh.seek(0, 2)
            whole = tail is None or fh.tell() <= tail
            fh.seek(0 if tail is None else max(0, fh.tell() - tail))
            lines = fh.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return None
    kind, on, said = None, None, ""
    for line in reversed(lines):
        try:
            e = json.loads(line)
        except Exception:
            continue                       # the first line of the chunk may be cut
        typ, m = e.get("type"), e.get("message") or {}
        c = m.get("content")
        if typ == "system" and e.get("subtype") in ("turn_duration", "stop_hook_summary"):
            kind = kind or "reply"
            continue
        if typ == "assistant":
            calls = [x for x in (c if isinstance(c, list) else [])
                     if isinstance(x, dict) and x.get("type") == "tool_use"]
            if kind is None:
                if not calls:
                    kind = "reply"
                else:
                    i = calls[-1].get("input") or {}
                    return {"kind": "permission", "tool": calls[-1].get("name") or "?",
                            "what": str(i.get("command") or i.get("file_path")
                                        or i.get("to") or "")[:120]}
            for x in reversed(calls):
                if on is None and x.get("name") == "SendMessage":
                    i = x.get("input") or {}
                    on, said = str(i.get("to") or ""), str(i.get("summary") or "")
            continue
        if typ == "user":
            if kind is None:
                return None                # prompted or mid-turn: neither stop
            if isinstance(c, list) and any(isinstance(x, dict) and
                                           x.get("type") == "tool_result" for x in c):
                continue
            if on is None:
                text = c if isinstance(c, str) else " ".join(
                    x.get("text") or "" for x in c or [] if isinstance(x, dict))
                hit = FROM_NAME.search(text)
                if not hit and e.get("isMeta"):
                    continue               # injected context, not the prompt
                on = hit.group(1) if hit else ""
                if not hit and text.strip() and text.strip() == job_intent(row):
                    # The harness's own launch prompt, not the owner's words: a
                    # lane started by spawn or recycle answers to its lead
                    # (2026-10-05: dev_tests_1 read "waiting on you").
                    on = LAUNCHED
            break
    if kind == "reply" and on is None and not whole:
        # The turn began before the tail: a lane that worked its whole queue in
        # one turn. Reading the start is what tells its lead from the owner.
        return stop_detail(row, rows, tail=None)
    if kind != "reply":
        return None
    if (on or "").startswith("uds:"):
        # Sent by socket address. A message that came in on it carries the
        # name; failing that, the socket is named for its session's pid.
        hit = re.search(r'from="' + re.escape(on) + r'"[^>]*\bfrom-name="([^"]+)"',
                        "\n".join(lines))
        pid = re.search(r"/(\d+)\.sock$", on)
        by_pid = next((r.get("name") for r in rows or []
                       if pid and str(r.get("pid")) == pid.group(1)), None)
        on = hit.group(1) if hit else by_pid or "an exited session"
    return {"kind": "reply", "on": on or "", "said": said}


def self_row(rows):
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    return next((a for a in rows if a.get("sessionId") == sid), None)


def transcript_for(sid):
    if not PROJECTS.is_dir():
        return None
    hits = list(PROJECTS.glob(f"*/{sid}.jsonl"))
    return hits[0] if len(hits) == 1 else None


def check_contract(roster_text=None):
    """Returns a list of (id, reason). Empty means the contract holds."""
    f = []
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    if not UUID_RE.fullmatch(sid):
        f.append(("C1", "CLAUDE_CODE_SESSION_ID is unset or not a UUID"))
        return f  # everything downstream keys off it

    t = transcript_for(sid)
    if t is None:
        f.append(("C2", f"no unique transcript ~/.claude/projects/*/{sid}.jsonl"))

    pid = os.environ.get("CLAUDE_PID", "")
    if not pid.isdigit():
        f.append(("C3", "CLAUDE_PID is unset or not numeric"))
    else:
        try:
            os.kill(int(pid), 0)
        except (OSError, ProcessLookupError):
            f.append(("C3", f"CLAUDE_PID {pid} is not live"))

    if t is not None and not SLUG_RE.fullmatch(t.parent.name.lstrip("-")):
        f.append(("C4", f"project dir '{t.parent.name}' no longer matches the slug rule"))

    try:
        rows = agents_json(roster_text)
        me = self_row(rows)
        if me is None:
            f.append(("C5", "`claude agents --json` does not list this session"))
        elif not {"cwd", "name", "pid", "status", "sessionId"} <= set(me):
            f.append(("C5", "`claude agents --json` is missing expected fields"))
        elif "state" not in me:
            # Its OWN id, not part of C5, because it is its own contract and
            # collapsing the two would send whoever meets it after the wrong
            # fault. C5 failing means the harness cannot identify a session at
            # all and must stop. C6 failing means it can, but has gone blind to
            # the one condition only a human can clear — a session halted at a
            # prompt. That is not a smaller problem, it is a different one, and
            # naming it separately is the same rule this file applies to exit
            # codes: one word, two contracts is the fault.
            f.append(("C6", "`claude agents --json` rows no longer carry `state`, so a "
                            "session\n           stopped at a prompt is once again "
                            "indistinguishable from an idle one"))
    except Exception as e:
        f.append(("C5", str(e)))
    return f


def require_contract(roster_text=None):
    f = check_contract(roster_text)
    if f:
        cid, why = f[0]
        die(CONTRACT, f"platform contract {cid} failed: {why}\n"
                      f"           refusing to operate. Claude's internals may have changed.")


# ── liveness roster (ListAgents output, verbatim) ────────────────────────────

def read_roster(path):
    if path is None:
        return None
    return sys.stdin.read() if path == "-" else Path(path).read_text()


# ── R1: position, derived from git ───────────────────────────────────────────

def documenter_repo():
    """The documenter runs outside every repository (a project CLAUDE.md would
    load the very file it trims), so its project comes from its launch env."""
    if os.environ.get("HARNESS_DOCUMENTER") != "1" or not os.environ.get("HARNESS_PROJECT"):
        return None
    try:
        return json.loads((HOME_STATE / os.environ["HARNESS_PROJECT"] / "binding.json")
                          .read_text()).get("repo")
    except Exception:
        return None


class Ctx:
    def __init__(self):
        at = None
        rc, common, _ = git("rev-parse", "--path-format=absolute", "--git-common-dir")
        if rc:
            at = documenter_repo()
            if not at:
                die(NOT_ENROLLED, "not inside a git worktree")
            rc, common, _ = git("rev-parse", "--path-format=absolute", "--git-common-dir",
                                cwd=at)
        self.repo = Path(common).parent
        rc, wt, _ = git("rev-parse", "--show-toplevel", cwd=at)
        self.worktree = Path(wt)
        rc, br, _ = git("rev-parse", "--abbrev-ref", "HEAD", cwd=at)
        self.branch = br
        self.slug = slug(self.repo)
        self.state = HOME_STATE / self.slug
        self.binding_path = self.state / "binding.json"
        self.tree_path = self.repo / ".harness" / "tree.json"

    # R9 — enrolment takes two keys
    def require_enrolled(self):
        if not self.tree_path.exists():
            die(NOT_ENROLLED, f"no role tree at {self.tree_path} — this project defines none")
        if not self.binding_path.exists():
            die(NOT_ENROLLED, f"this machine has not joined {self.repo.name} "
                              f"(run: harness enrol {self.repo})")
        self.tree = json.loads(self.tree_path.read_text())
        validate_tree(self.tree, self.tree_path)
        self.binding = json.loads(self.binding_path.read_text())

    def node(self):
        for name, spec in self.tree["nodes"].items():
            if spec.get("branch") == self.branch:
                return name, spec
        die(NOT_ENROLLED, f"branch '{self.branch}' is not a node in the role tree")

    def rank(self, name):
        r, seen = 0, set()
        while True:
            p = self.tree["nodes"][name].get("parent")
            if p is None or p in seen:
                return r
            seen.add(name); name = p; r += 1

    def children(self, name):
        return sorted(n for n, s in self.tree["nodes"].items() if s.get("parent") == name)

    def state_file(self, kind, name, ext):
        """A name from a tree, a task record or argv becomes a FILENAME here, so
        it is sanitised in exactly one place. `mark` skipped this and could write
        into a sibling directory — `mark '../locks/main'` overwrote a live node
        lock, exit 0, silently. Collisions after sanitising are possible and
        surface as 'already marked', which is the safe direction."""
        return self.state / kind / (re.sub(r"[^A-Za-z0-9]", "_", name) + ext)

    def lock_path(self, node):
        return self.state_file("locks", node, ".lock")


def validate_tree(tree, path):
    """Git refs are files, so 'dev' and 'dev/ui' cannot both exist:
    fatal: cannot lock ref 'refs/heads/dev/ui': 'refs/heads/dev' exists.
    Catch it in the tree rather than at the first worktree add."""
    branches = {n: s.get("branch") for n, s in tree.get("nodes", {}).items() if s.get("branch")}
    for na, ba in branches.items():
        for nb, bb in branches.items():
            if na != nb and bb.startswith(ba + "/"):
                die(CONTRACT,
                    f"tree is not constructible: branch '{ba}' ({na}) is a path prefix of "
                    f"'{bb}' ({nb}).\n           Git refs are files — 'refs/heads/{ba}' "
                    f"blocks 'refs/heads/{bb}'.\n           Use a separator that is not '/', "
                    f"e.g. '{bb.replace('/', '_')}'.  Fix {path}")
    # A misspelt effort would be passed to `claude` and rejected there, after the
    # session had already been spawned detached — refuse it here instead.
    for n, sp in tree.get("nodes", {}).items():
        e = sp.get("effort")
        if e is not None and e not in EFFORTS:
            die(CONTRACT, f"node '{n}' has effort '{e}', which is not one of "
                          f"{', '.join(EFFORTS)}.  Fix {path}")
        m = sp.get("model")
        if m is not None and (not isinstance(m, str) or not m.strip()):
            die(CONTRACT, f"node '{n}' has an empty model.  Fix {path}")


def skills_for(ctx, name):
    s = ["harness"]
    if ctx.tree["nodes"][name].get("parent"):
        s.append("harness-upward")
    if ctx.children(name):
        s.append("harness-downward")
    if ctx.rank(name) == 0:
        s.append("harness-root")
    return s


# ── R12: a node's model and effort travel with the tree ──────────────────────

EFFORTS = ("low", "medium", "high", "xhigh", "max")

# Defaults by role, not by name — a tree can rename every node and still get
# these. Overridden per node in tree.json with "model"/"effort".
#
# Context follows the view, not the rank. A lead accumulates: every child's
# report, both sides of a conflict it did not create, the seams between siblings.
# That is the whole reason a document climbs through ranks instead of jumping to
# rank 0, so a lead is exactly where a wide window earns its cost. A member is
# the opposite by construction — one short task ([[#I8]]) in one worktree, ending
# at a commit — and it is recycled rather than allowed to accumulate ([[#R13]]).
#
# Effort falls with rank because the judgement falls with rank, by design: a
# leaf is handed its scope ([[#T1]]), has its approach approved before the first
# commit ([[#T11]]), does not own the seams ([[#I9]]) and escalates conflicts
# rather than resolving them ([[#T7]]). What is left is bounded work and honest
# reporting. The lead carries what was taken out.
# Levels are Anthropic's measured curves, not taste (cost-optimization guide,
# "Effort and budgets"). Long-horizon coding is the ONE workload where the curve
# is steep: Opus 5 gives up ~2 points of pass rate at `medium` for half the cost,
# but ~8 points at `low` for a quarter. A member is a long-horizon coder whose
# output nothing reviews, so `low` spends the wrong currency — see R12.
# Review and diagnosis behave like knowledge work, where the curve is nearly
# flat and `medium` matches the default at 70-85% of its cost.
ROLE_DEFAULTS = {
    "root":     ("opus", "high"),        # rank 0: applies documents, writes rulings
    "lead":     ("opus", "medium"),      # no 1M: a wider window is a measured null at equal occupancy
    # Sonnet, and the reason is the plan rather than the work. On a subscription
    # Opus has its own weekly window that resets separately, so a member on Opus
    # is not spending "less" than a lead — it is spending the SAME scarce pool
    # the lead and rank 0 need. Moving members off it does not reduce tokens; it
    # moves them to a pool nothing else in the tree competes for.
    # Effort stays medium: coding is the one steep effort curve, `low` costs
    # ~8 points, and effort is a different dial from tier.
    "member":   ("sonnet",   "medium"),
}


def escalate(effort):
    """The next level up, for re-running a failure. Anthropic's cheapest measured
    configuration is not a lower effort but a retried one, so this is the dial a
    lead reaches for when a child's check set fails ([[#I5]]). Saturates at max
    rather than wrapping — a third attempt is a finding, not a budget problem."""
    try:
        return EFFORTS[min(EFFORTS.index(effort) + 1, len(EFFORTS) - 1)]
    except ValueError:
        return effort


def role_of(ctx, name):
    if ctx.rank(name) == 0:
        return "root"
    return "lead" if ctx.children(name) else "member"


# Context per role (obs 60): when the parent is told, and where Claude Code's own
# auto-compaction is set at launch. Members are recycled every task, so neither.
ROLE_CONTEXT = {"root": 400_000, "lead": 300_000, "member": None}
ROLE_AUTOCOMPACT = {"root": "500k", "lead": "350k", "member": None}


def reset_path(ctx, node):
    return ctx.state_file("resets", node, ".json")


def _ktok_arg(v):
    """'400k' / '1.2m' / '400000' → tokens."""
    m = re.fullmatch(r"\s*([\d.]+)\s*([kKmM]?)\s*", str(v or ""))
    if not m:
        die(REFUSED, f"--by {v}: say it in tokens, e.g. 400k")
    return int(float(m.group(1)) * {"": 1, "k": 1e3, "m": 1e6}[m.group(2).lower()])


def _minutes_arg(v):
    m = re.fullmatch(r"\s*(\d+)\s*(m|min|h)?\s*", str(v or ""))
    if not m:
        die(REFUSED, f"--within {v}: say it in minutes or hours, e.g. 60m")
    return int(m.group(1)) * (60 if m.group(2) == "h" else 1)


def reset_ceiling(r):
    """The reset's ceiling as words, for status and the request (obs 66)."""
    t = time.strftime("%H:%M", time.localtime(r["deadline"])) if r.get("deadline") else "?"
    return f"forced at {ktok(r.get('by_tokens'))} or {t}"


def request_reset(ctx, nodes, by=None, within=None, dry_run=False, cancel=False):
    """`recycle <node> --at-quiet` (obs 60): recorded here, carried out by the
    node's own Stop hook, which flushes first and resets at a quiet turn end.
    `--dry-run` writes nothing (obs 72); `--cancel-reset` withdraws one."""
    if not nodes:
        die(REFUSED, "which node? harness recycle <node> --at-quiet")
    if cancel:
        for n in nodes:
            p = reset_path(ctx, n)
            if dry_run:
                print(f"would cancel the pending reset of {n}" if p.exists()
                      else f"no reset pending for {n}")
            elif p.exists():
                p.unlink(); print(f"cancelled the pending reset of {n}")
            else:
                print(f"no reset pending for {n}")
        return
    me = next((n for n, sp in ctx.tree["nodes"].items()
               if sp.get("branch") == ctx.branch), None)
    for n in nodes:
        if n not in ctx.tree["nodes"]:
            die(REFUSED, f"'{n}' is not a node")
        if ctx.rank(n) == 0:
            die(REFUSED, "rank 0 is never reset; it compacts at its --autocompact threshold")
        p = reset_path(ctx, n)
        p.parent.mkdir(parents=True, exist_ok=True)
        # A ceiling, because a busy lead never ends a turn quiet: dev's reset,
        # queued at 303k, had not fired an hour and 42k tokens later (obs 66).
        warn = context_limits(ctx, n)[0] or 300_000
        rec = {"by": me or "operator", "flushed": False,
               "at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
               "by_tokens": _ktok_arg(by) if by else warn + 100_000,
               "deadline": time.time() + 60 * (_minutes_arg(within) if within else 60)}
        if dry_run:
            print(f"would set a reset pending for {n}, {reset_ceiling(rec)}. "
                  f"Nothing written (--dry-run).")
            continue
        p.write_text(json.dumps(rec) + "\n")
        print(f"reset pending for {n}. At its next turn end it is asked to write what it "
              f"holds only in\n  context into the records; at the next quiet one after "
              f"that it is replaced, or regardless\n  once it is "
              f"{reset_ceiling(rec)}.\n"
              f"  Hold non-urgent messages to {n} until then: each one restarts the quiet clock.\n"
              f"  `harness status` shows it; cancel it with "
              f"harness recycle {n} --cancel-reset")


def reset_step(ctx, node, launch_only=False):
    """The Stop hook's part in a pending reset. True when it acted."""
    p = reset_path(ctx, node)
    if not p.exists():
        return False
    r = json.loads(p.read_text())
    if not r.get("flushed") and not launch_only:
        r["flushed"] = True
        p.write_text(json.dumps(r) + "\n")
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "Stop", "decision": "block", "reason":
            f"A reset of this node is pending (requested by {r.get('by')}). A fresh "
            f"session replaces you from the records at your next quiet turn end. Write "
            f"anything you hold only in context into them now: a promise to a child, a "
            f"seam you are watching, a held recycle (`harness note <task> --add -`, "
            f"`harness brief`, `--after`). Then end your turn."}}))
        return True
    if r.get("flushed") and (reset_quiet(ctx, node) or reset_due(ctx, node, r)):
        # The record stays until a recycle succeeds (obs 73): deleted here, a
        # launch that found the lead busy dropped the reset, twice. In flight,
        # it is not launched again; a skip clears the mark and the next turn
        # end retries.
        if time.time() - (r.get("launched_at") or 0) < RESET_INFLIGHT:
            return False
        r["launched_at"] = time.time()
        p.write_text(json.dumps(r) + "\n")
        launch_reset(ctx, node)
        return True
    return False


RESET_INFLIGHT = 300       # seconds a launched reset is left to finish


def reset_outcome(ctx, node, why=None):
    """A launched reset's result, written back by `recycle`: success removes the
    record; a skip keeps it, says why, and lets the next turn end retry."""
    p = reset_path(ctx, node)
    if not p.exists():
        return
    if why is None:
        p.unlink(); return
    try:
        r = json.loads(p.read_text())
    except Exception:
        return
    r.pop("launched_at", None)
    r["skipped_at"], r["skipped_why"] = time.time(), why
    p.write_text(json.dumps(r) + "\n")


def reset_due(ctx, node, r):
    """Past the ceiling: launch at this turn end, quiet or not (obs 66). Only the
    quiet test is skipped; `recycle` keeps its own guards."""
    if r.get("deadline") and time.time() >= r["deadline"]:
        return True
    try:
        ref = json.loads(ctx.lock_path(node).read_text()).get("ref")
    except Exception:
        return False
    size = context_size(ref) if ref else None
    return bool(size and r.get("by_tokens") and size >= r["by_tokens"])


def reset_quiet(ctx, node):
    """No sign-off owed, no child waiting on an answer, nothing of its own unpresented."""
    if any(o[0] == "sign off" for o in lead_owes(ctx, node)):
        return False
    if any(r.get("parent") == node for r in open_waits(ctx).values()):
        return False
    return not any(r.get("_node") == node and not r.get("_presented_at")
                   for r in open_marks(ctx).values())


def launch_reset(ctx, node):
    """Detached, so it outlives the turn that launched it, and without a session
    id, so it acts as the operator would from the repository root."""
    log = ctx.state_file("resets", node, ".log")
    env = {k: v for k, v in os.environ.items() if k != "CLAUDE_CODE_SESSION_ID"}
    with open(log, "a") as fh:
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "recycle", node,
                          "--when-idle"], cwd=str(ctx.repo), env=env, stdout=fh,
                         stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                         start_new_session=True)


def wait_until_idle(idx, nodes, limit=120, step=3):
    """Poll until no session in these nodes' worktrees reads busy, or give up."""
    wts = {(idx["nodes"].get(n) or {}).get("worktree") for n in nodes}
    end = time.time() + limit
    while time.time() < end:
        try:
            rows = live_rows(agents_json())
        except Exception:
            return
        if not any(r.get("cwd") in wts and r.get("status") == "busy" for r in rows):
            return
        time.sleep(step)


def context_limits(ctx, name):
    """(warn tokens, autocompact flag value) for a node; tree.json wins."""
    spec, role = ctx.tree["nodes"][name], role_of(ctx, name)
    return (spec.get("context_warn", ROLE_CONTEXT.get(role)),
            spec.get("autocompact", ROLE_AUTOCOMPACT.get(role)))


def assignment_for(ctx, name):
    """(model, effort) for a node. tree.json wins; role default otherwise."""
    spec = ctx.tree["nodes"][name]
    model, effort = ROLE_DEFAULTS[role_of(ctx, name)]
    return spec.get("model", model), spec.get("effort", effort)


# ── R7: the name asserts, git proves ─────────────────────────────────────────

def check_name(ctx, node, self_name, strict=False):
    """A warning, not a gate. Claude Code owns the name: it derives one from the
    directory, auto-titles from content, and reissues it on resume. Position
    comes from git and occupancy from the worktree; neither needs the name."""
    expected = f"{ctx.tree.get('project', ctx.repo.name)}-{node}"
    if self_name == expected:
        return
    msg = (f"session is named '{self_name}' but stands in '{node}' "
           f"(expected '{expected}')")
    if strict:
        die(MISMATCH, msg + ".\n           --strict-name was given, so this is a refusal.")
    print(f"harness: {msg} — cosmetic only; Claude Code owns the name and "
          f"reissues it on resume.", file=sys.stderr)


# ── commands ─────────────────────────────────────────────────────────────────

def cmd_contract(a):
    f = check_contract(read_roster(a.roster))
    if f:
        for cid, why in f:
            print(f"  {cid}  FAIL  {why}")
        sys.exit(CONTRACT)
    print("contract holds (C1 C2 C3 C4 C5)")


def cmd_whoami(a):
    """--quiet is the hook contract: in a project that is not enrolled, print
    nothing, write nothing to stderr, and exit 0 — so a SessionStart hook injects
    no context at all rather than injecting an error."""
    # --delta is orientation without the orientation: what has changed since
    # this session was last told, and silence otherwise. Cheap enough for a
    # per-turn hook because it reads local JSON and nothing else.
    if a.__dict__.get("delta"):
        global QUIET
        QUIET = True
        print_delta()
        return
    if not a.quiet:
        return _whoami(a)
    QUIET = True
    try:
        _whoami(a)
    except SystemExit as e:
        if e.code not in (0, None):
            sys.exit(0)
    except Exception:
        sys.exit(0)


def _whoami(a):
    ctx = Ctx(); ctx.require_enrolled()
    node, spec = ctx.node()
    if not a.no_check:
        try:
            me = self_row(agents_json(read_roster(a.roster)))
            if me and me.get("name"):
                check_name(ctx, node, me["name"])
        except Exception:
            pass
    parent = spec.get("parent")
    kids = ctx.children(node)
    print(f"node     {node}")
    print(f"branch   {ctx.branch}")
    print(f"worktree {ctx.worktree}")
    print(f"rank     {ctx.rank(node)}")
    print(f"parent   {parent or '—'}")
    print(f"children {', '.join(kids) or '—'}")
    model, effort = assignment_for(ctx, node)
    print(f"skills   {', '.join(skills_for(ctx, node))}")
    print(f"run as   {model}, effort {effort}   ({role_of(ctx, node)})")
    _warn, _ac = context_limits(ctx, node)
    _size = context_size(os.environ.get("CLAUDE_CODE_SESSION_ID", ""))
    if _size:
        print(f"context  {ktok(_size)}"
              + (f" — over this rank's {ktok(_warn)}; write state into records"
                 if _warn and _size > _warn else ""))
    # The CLI and the skills are installed together and loaded apart: a session
    # holds the skill text it read at startup and calls a binary that may have
    # been replaced under it since. One node closed five segments tonight using
    # behaviour its loaded skill said did not exist — it worked, and only
    # because the mismatch happened to fall the safe way round. The other
    # direction is a session confidently running a command that is not there.
    # Printing it costs a line and makes the mismatch checkable.
    try:
        v = json.loads((HOME_STATE / "VERSION").read_text())
        print(f"cli      {str(v.get('commit'))[:8]} installed "
              f"{str(v.get('installed_at'))[:16]}   "
              f"(if the skills you loaded disagree with it, /reload-skills)")
    except Exception:
        pass

    # Rank 0 only, and only when there is something. Orientation runs on every
    # start, resume and compact, so a line that is usually absent costs nothing
    # and a line that appears is worth the tokens. Unclaimed task records and
    # open blocks are rank 0's housekeeping, and nothing else tells it they exist.
    try:
        ub = unread_block_comments(ctx, node)
        if ub:
            n = sum(len(v) for v in ub.values())
            print(f"discuss  {n} comment(s) on open block(s) in this tree "
                  f"— harness blocked --list")
    except Exception:
        pass
    try:
        u = unread_brief_comments(ctx, node)
        if u:
            n = sum(len(v) for v in u.values())
            print(f"unread   {n} comment(s) on brief(s) you write: "
                  f"{', '.join(sorted(u))} — harness brief <task>")
    except Exception:
        pass
    # Both directions of a wait, because orientation is the one moment either
    # party is reachable. A child that asked and stopped is the state the
    # R-table could not tell apart from working, and a lead that never learns
    # of it is how a stopped lane stays stopped across a whole session.
    try:
        waits = open_waits(ctx)
        me = waits.get(node)
        if me:
            print(f"waiting  you are marked as waiting on "
                  f"{me.get('parent') or 'your lead'} "
                  f"({wait_age(me.get('since'))}) — {me.get('asked')}")
            print(f"         If it has been answered, say so: harness waiting --clear")
        stopped = sorted((r for r in waits.values() if r.get("parent") == node),
                         key=lambda r: r.get("since") or "")
        if stopped:
            print(f"answer   {len(stopped)} child(ren) stopped waiting on YOU — "
                  f"harness waiting --list")
            for r in stopped:
                print(f"         {r['node']} ({wait_age(r.get('since'))}): "
                      f"{r.get('asked')}")
                if r.get("still_moving"):
                    print(f"           still moving: {r['still_moving']}")
    except Exception:
        pass
    # A child halted at a prompt. NOT in `lead_owes` and not a Stop-hook block,
    # because a lead cannot clear this one either — only a human at the keyboard
    # can, and blocking a lead's stop over work it may not do is the trap that
    # rule already refuses. But it is the answer to "why has that child not
    # moved", and a lead that does not have it will recycle the node, which
    # restarts the session into the same prompt.
    #
    # It is deliberately not the `waiting` list above: that is a child that
    # ASKED, which takes a turn. This one got no turn to ask in.
    #
    # It costs one `claude agents --json` (~0.55s) and it is paid only by a node
    # that HAS children — a leaf pays nothing, and there is nothing it could do
    # with the answer. That is the same 0.55s `--no-check` exists to avoid at
    # every session start, and the trade is deliberately different: that one
    # bought a cosmetic name warning, this one buys the only condition in the
    # tree that halts a lane with nobody able to say so. It prints only when
    # something is halted, so the token cost is zero on the normal path.
    #
    # NOT wrapped in a bare `except` around an undefined name: the first draft
    # of this used `idx` before whoami builds it, so it raised NameError, the
    # except swallowed it, and the arm could never fire. A check that cannot
    # fail is the fault this file keeps finding; here it would have been a check
    # that could never fire, which reads identically from outside.
    try:
        _idx = load_index(ctx)
        _kids = set(_idx["nodes"].get(node, {}).get("children") or [])
        if _kids:
            _rows = live_rows(agents_json(read_roster(a.roster)))
            _bw = _idx.get("byWorktree") or {}
            for r in stopped_rows(_rows):
                child = _bw.get(r.get("cwd", ""))
                if child not in _kids or child in open_waits(ctx):
                    continue        # a recorded wait is listed above (obs 68)
                st = stop_detail(r, _rows)
                if st and st["kind"] == "reply":
                    # A finished turn: a wait nobody recorded. Yours only when
                    # its last word went to you.
                    on = (node if st["on"] == LAUNCHED else
                          next((_bw.get(x.get("cwd", "")) for x in _rows
                                if x.get("name") == st["on"]), None))
                    if on == node:
                        print(f"WAITING  {child} finished its turn and is waiting on "
                              f"you" + (f": {st['said']}" if st["said"] else "")
                              + ". Reply, or it sits.")
                    continue
                print(f"WAITING  {child} is stopped at a prompt — it reads as idle "
                      f"and is not.")
                print(f"         Not yours to clear: it wants a reply or a permission "
                      f"answered, and\n         both are at a keyboard. Do not recycle "
                      f"it into the same prompt.")
    except Exception:
        pass
    # A held resource reaches every lane here, before its next `check` (obs 66).
    try:
        for h in live_holds(ctx):
            print(f"hold     {h['path']} — {h['why']} (by {h['by']}"
                  + (f", until {h['until']}" if h.get("until") else "")
                  + "). `harness check` skips the arms that read it.")
    except Exception:
        pass
    # Segments this node split. Discharged for queueing the moment they were
    # broken up, and then nowhere: no mark, no presentation, no close, and a
    # chip on the board forever. The ones whose parts have all come back are
    # finished work waiting to be written down, which is the only kind of
    # backlog worth interrupting orientation for.
    try:
        deleg = [x for x in delegated(ctx, node) if not x["closed_at"]]
        ready = [x for x in deleg if x["ready"]]
        if ready:
            # "every part settled" read as "every part done", and `settled`
            # counts a SUPERSEDED part -- terminal, never worked. A segment
            # whose parts were all abandoned rendered identically to one whose
            # parts were all delivered, and the difference is the whole question
            # the close is answering.
            print(f"close    {len(ready)} segment(s) you split have no part still "
                  f"outstanding:")
            for x in ready:
                _g = x.get("gone") or 0
                _tail = (f"   — but {_g} of {len(x['children'])} part(s) were "
                         f"superseded, not done" if _g else "")
                print(f"         harness mark {x['task']} --close{_tail}")
        if len(deleg) - len(ready):
            print(f"split    {len(deleg) - len(ready)} more still out with your "
                  f"children — harness queue {node}")
    except Exception:
        pass
    # Two states nobody can report, because in both of them nobody believes
    # there is anything to report: a mark whose opener is dead, and a child that
    # stopped without asking. Both are derived from the roster the CLI already
    # reads, so neither costs anyone any discipline.
    try:
        rows = live_rows(agents_json(read_roster(a.roster)))
        live_ids = {r.get("sessionId") for r in rows}
        idx = load_index(ctx)
        here = {n: any(r.get("cwd") == sp.get("worktree") for r in rows)
                for n, sp in (idx.get("nodes") or {}).items()}
        mine = [x for x in inherited_marks(ctx, live_ids) if x["node"] == node]
        for x in mine:
            print(f"inherit  '{x['task']}' was opened by session {x['session']}, "
                  f"which is gone.")
            print(f"         It is not your work and its cost is not your spend. "
                  f"Measure what is\n         actually left before resuming — if the "
                  f"answer is nothing, say so:")
            print(f"           harness mark {x['task']} --abandon \"nothing was "
                  f"left of it\"")
            print(f"           harness mark {x['task']} --force   "
                  f"(you are doing it, from here)")
        stuck = [k for k in ctx.children(node)
                 if stopped_without_asking(ctx, k, rows, here.get(k, False))]
        if stuck:
            print(f"stalled  {len(stuck)} child(ren) are up, holding nothing, with "
                  f"nothing queued: {', '.join(stuck)}")
            print(f"         They did not ask, because they do not think they are "
                  f"stuck. Brief one,\n         or recycle it — a live session with "
                  f"an empty queue waits forever.")
    except Exception:
        pass
    try:
        # Every rank below 0 starts cold. A child with nothing in flight is a
        # session accumulating context for no reason — and since its knowledge
        # now lives in records rather than its own transcript, replacing it
        # loses nothing. Only the parent can do it, so only the parent is told.
        kids = ctx.children(node)
        if kids:
            busy = {r.get("_node") for r in open_marks(ctx).values()
                    if not r.get("_presented_at")}
            # A lead whose lanes hold open work is waiting on them, not idle.
            spare = [k for k in kids if not busy & {k, *subtree(ctx, k)}]
            # Two different states, and they had one message. Recycling a child
            # with an empty queue buys a fresh session with nothing to open,
            # which is the state T15 exists to prevent — the advice was wrong,
            # not merely coarse.
            ready = [k for k in spare
                     if [b for b in queue(ctx, k) if not b.get("coupled_to")]]
            bare = [k for k in spare if k not in ready]
            if ready:
                print(f"recycle  {', '.join(ready)} — idle with work queued. "
                      f"harness recycle --idle")
            if bare:
                print(f"brief    {', '.join(bare)} — idle with an EMPTY queue. "
                      f"Nothing to recycle onto;")
                print(f"         write the work or leave the node down. "
                      f"harness queue")
    except Exception:
        pass
    try:
        mine = {t: r for t, r in open_marks(ctx).items() if r.get("_node") == node}
        up = ctx.tree["nodes"].get(node, {}).get("parent")
        for t, r in sorted(mine.items()):
            lbl = mark_label(r, t)
            if r.get("_presented_at"):
                print(f"open     {lbl} — presented, waiting on {up or 'rank 0'} to "
                      f"sign it off")
                # A session spawned onto a node whose mark is already presented
                # has nothing to do at orientation, and if the lead has since
                # integrated a sibling this node is now BEHIND — which is the
                # thing blocking its own sign-off, and nobody tells it. Its
                # predecessor cannot: it presented and released, which is what
                # it was told to do.
                if up:
                    pb = ctx.tree["nodes"].get(up, {}).get("branch")
                    rc, bh, _ = (git("rev-list", "--count",
                                     f"{ctx.branch}..{pb}") if pb else (1, "", ""))
                    if rc == 0 and bh.strip().isdigit() and int(bh.strip()) > 0:
                        print(f"         and {bh.strip()} commit(s) BEHIND {up}, which "
                              f"is why it cannot be\n         fast-forwarded. That is a "
                              f"catch-up (T2) and it is yours to run, here:\n"
                              f"           git merge {pb}\n"
                              f"         then present again. Your predecessor cannot "
                              f"— it released.")
            elif up:
                print(f"open     {lbl} — finishing it means presenting UP to {up}, "
                      f"not to the operator:")
                print(f"           harness mark {lbl} --done      "
                      f"then {up} closes it")
            else:
                print(f"open     {lbl} — you are rank 0 and close your own: "
                      f"harness mark {lbl} --close")
    except Exception:
        pass
    try:
        kids = set(ctx.children(node))
        waiting = sorted(mark_label(r, t) for t, r in open_marks(ctx).items()
                         if r.get("_presented_at") and r.get("_node") in kids)
        if waiting:
            print(f"sign off {len(waiting)} presented task(s) waiting on you: "
                  f"{', '.join(waiting)}")
            # Named as a first act, not as advice. A lead learns this at
            # orientation and then holds a long exchange with its own lead, and
            # the debt is gone from its head long before it is gone from the
            # ledger -- observed on a live tree. Its todo list is the only thing
            # in the session that survives that conversation.
            for w in waiting:
                print(f"         TaskCreate: \"sign off {w}\"  →  harness mark "
                      f"{w} --close")
    except Exception:
        pass
    try:
        # A presentation is a record with no delivery: the lead learns of it at
        # its next harness command, and a lead that is idle or absent runs none.
        # So a finished hand-off can sit unnoticed while the member that finished
        # it stands in the node. Nothing can push ([[R4]]) — but the rank ABOVE
        # the lead is running, and recycling that lead is what makes it orient
        # and see the queue it owes.
        grand = {}
        for t, r in open_marks(ctx).items():
            n = r.get("_node")
            lead = ctx.tree["nodes"].get(n, {}).get("parent")
            if not r.get("_presented_at") or lead not in kids:
                continue
            then = _epoch(r.get("_presented_at"))
            if then is None:
                continue
            age = time.time() - then
            if age > STALLED_SIGNOFF:
                grand.setdefault(lead, []).append((mark_label(r, t), n, age))
        _marks = open_marks(ctx)
        for lead, items in sorted(grand.items()):
            names = ", ".join(f"{t} ({n}, {human_age(age)})" for t, n, age in items)
            print(f"unsigned {names}")
            # `harness recycle {lead}` was printed here unconditionally, which is
            # both the wrong remedy and a destructive one. Wrong, because a
            # sign-off is owed after the lead's last turn and a fresh session
            # orients and stops with the same debt -- observed twice on
            # 2026-09-08 before the operator prompted it by hand. Destructive,
            # because a lead holding an unpresented mark loses that work, and
            # the line fired without looking.
            _addr, _ = lead_address(ctx, lead)
            _holding = [t for t, r in _marks.items()
                        if r.get("_node") == lead and not r.get("_presented_at")]
            if _addr:
                print(f"         {lead} has not signed off and nothing will tell it — "
                      f"the debt was")
                print(f"         created after its last turn. It is running as "
                      f"'{_addr}': message it.")
            elif _holding:
                print(f"         {lead} is not running and left '{_holding[0]}' open "
                      f"and unpresented.")
                print(f"         Recycling discards that — read it first:  "
                      f"harness queue {lead}")
            else:
                print(f"         {lead} is not running and holds nothing open:  "
                      f"harness recycle {lead}")
    except Exception:
        pass
    try:
        fnd = open_findings(ctx, node)
        if fnd:
            print(f"findings {len(fnd)} handed up to you: "
                  f"{', '.join(sorted(r.get('name', k) for k, r in fnd.items()))}")
            print(f"         potential work nobody has scoped — brief it "
                  f"(--from-finding) or\n         decline it. harness finding --list")
    except Exception:
        pass
    try:
        gated = sorted(t for t, gb in pending_approvals(ctx).items()
                       if gb.get("node") == node
                       or ctx.tree["nodes"].get(gb.get("node"), {}).get("parent") == node)
        if gated:
            print(f"gated    {len(gated)} brief(s) waiting on approval: "
                  f"{', '.join(gated)}  — not staffable; rank 0 approves with "
                  f"harness brief <task> --approve")
    except Exception:
        pass
    try:
        # Grounding, not an instruction. A member does not need the project's
        # purpose to execute a complete brief, so this is one line and a pointer,
        # never a demand to go and read. Rank 0 with no charter is the one case
        # that is a problem, and it is told plainly.
        _, ch = load_charter(ctx)
        txt = ((ch.get("description") or {}).get("text") or "").strip()
        if txt:
            head = txt.splitlines()[0]
            n = len(charter_features(ch))
            print(f"charter  {head[:64]}{'…' if len(head) > 64 else ''}"
                  + (f"  ({n} feature(s))" if n else "")
                  + "  — harness charter")
        elif ctx.rank(node) == 0:
            print("charter  none written — nothing states what this project is for, "
                  "so the only\n         work visible from here is whatever happens to "
                  "be broken. harness charter")
    except Exception:
        pass
    try:
        # Work handed to you that has gone nowhere. For a member that means a
        # brief with no mark; for a lead it also means a brief it has not split,
        # which is the one place a cascade stops silently — the rank below never
        # learns the work exists, and nothing else in the harness would say so.
        q = queue(ctx, node)
        head = [b for b in q if not b.get("coupled_to")]
        fam = focus_family(ctx)
        if fam is not None:
            print(f"focus    {', '.join(focus_tasks(ctx))}"
                  f" — the owner's priority")
            # Focus orders and labels; it never empties a queue (obs 55). A lead
            # sees in-focus work first; a member keeps its lead's order.
            if ctx.children(node):
                head = sorted(head, key=lambda b: not in_focus(fam, b["task"]))
        def outside(b):
            return ("  (outside the owner's focus; your lead ordered it)"
                    if fam is not None and not in_focus(fam, b["task"]) else "")
        openm = [t for t, r in open_marks(ctx).items() if r.get("_node") == node]
        # Briefs that wait on another task are not "next" (obs 59).
        wait = [b for b in head if waits_on(ctx, b)]
        head = [b for b in head if b not in wait]
        for b in wait[:3]:
            print(f"waiting  {b['task']} — {'; '.join(waits_on(ctx, b))}")
        # A LEAD used to get a bare list here and no order — "handed 3 briefs" —
        # which names no first thing and does not say to begin. So it asked, and
        # having nobody in the tree obviously to ask, it asked the operator. The
        # line is the same at every rank now; only the verb changes.
        if head and ctx.children(node) and not openm:
            b0 = head[0]
            print(f"next     {b0['task']}{outside(b0)} — your brief is the instruction, "
                  f"not a proposal. Read it,")
            print(f"         then split it for {', '.join(ctx.children(node))} or "
                  f"open it yourself:")
            print(f"           harness brief {b0['task']}")
            rest = head[1:]
            if rest:
                print(f"queue    {len(rest)} after it, in {parent or 'your lead'}'s "
                      f"order: {', '.join(b['task'] for b in rest)}")
        elif head and ctx.children(node):
            print(f"queue    {len(head)} after your open task: "
                  f"{', '.join(b['task'] for b in head)}")
        elif head and not openm:
            # The line that answers "shall I start?" before it is asked. A member
            # arriving to four briefs and no order holds an ambiguity at the top
            # of its session, and an ambiguity there gets resolved by asking —
            # which ends the session on a question and idles the node. One task,
            # named, with the two commands that begin it.
            b0 = head[0]
            print(f"next     {b0['task']}{outside(b0)} — the brief is your instruction, "
                  f"not a proposal.")
            print(f"         Nothing further is coming and nobody is waiting to be "
                  f"asked. Begin:")
            print(f"           harness brief {b0['task']}    then    "
                  f"harness mark {b0['task']}")
            rest = head[1:]
            if rest:
                print(f"queue    {len(rest)} after it, in order: "
                      f"{', '.join(b['task'] for b in rest)}  — not yours to start")
        elif head:
            print(f"queue    {len(head)} after your open task: "
                  f"{', '.join(b['task'] for b in head)}")
        elif wait and not openm:
            print(f"         nothing you can start until then — stop, and say so to "
                  f"{parent or 'your lead'}.")
        elif not openm and ctx.rank(node) != 0:
            # Genuinely nothing. The one case where asking is right — and the
            # answer is that it is not the operator's to give. A node with an
            # empty queue is its LEAD's problem, and the lead is told the same
            # thing from the other side at its own orientation.
            print(f"empty    nothing queued and nothing open. That is "
                  f"{parent or 'your lead'}'s to fix, not")
            print(f"         the operator's — do not ask them. Say it in your report "
                  f"to {parent or 'your lead'}")
            print(f"         and stop; it sees the same gap when it next orients.")
    except Exception:
        pass
    if ctx.rank(node) == 0:
        try:
            stale_m, unattr_m = orphan_marks(ctx)
            nb = sum(1 for r in open_blocks(ctx).values() if not answered(r))
            nd = len(decided_blocks(ctx))
            if nd:
                print(f"decide   {nd} answered block(s) with no task written "
                      f"— harness blocked --decided")
            if stale_m or unattr_m:
                print(f"unclaimed {len(stale_m) + len(unattr_m)} open task record(s) "
                      f"claimed by no node — harness status")
            if nb:
                print(f"blocked  {nb} open block(s) — harness blocked --list")
        except Exception:
            pass
    try:
        for line in ask_notices(ctx, node).values():
            print(f"owner    {line}")
    except Exception:
        pass
    # Orientation has just said all of it, so record it as told. Without this
    # the very next harness command would repeat the lot as "new" — and a
    # notice that arrives twice in a row is one a reader learns to skip, which
    # is the whole failure the delta exists to avoid.
    try:
        delta(ctx, node, os.environ.get("CLAUDE_CODE_SESSION_ID", ""), update=True)
    except Exception:
        pass


def cmd_behind(a):
    ctx = Ctx(); ctx.require_enrolled()
    node, spec = ctx.node()
    parent = spec.get("parent")
    if not parent:
        print("0  (rank 0 has no parent)"); return
    pb = ctx.tree["nodes"][parent]["branch"]
    rc, out, err = git("rev-list", "--count", f"HEAD..{pb}")
    if rc:
        die(1, f"could not count against {pb}: {err}")
    print(f"{out}  commits behind {parent} ({pb})")


def cmd_claim(a):
    roster = read_roster(a.roster)
    require_contract(roster)
    rows = agents_json(roster)
    me = self_row(rows)
    self_name = me.get("name") or ""
    self_ref = me["sessionId"]
    ctx = Ctx(); ctx.require_enrolled()
    node, _ = ctx.node()
    check_name(ctx, node, self_name, strict=a.strict_name)
    lock = ctx.lock_path(node)
    lock.parent.mkdir(parents=True, exist_ok=True)
    rec = {"node": node, "ref": self_ref, "name": self_name,
           "session_id": self_ref,
           "pid": int(os.environ.get("CLAUDE_PID") or 0), "worktree": str(ctx.worktree),
           "host": socket.gethostname(), "claimed_at": time.strftime("%Y-%m-%dT%H:%M:%S%z")}
    # Who is actually standing in this worktree right now? A session id does not
    # survive a resume — it is reissued, along with the pid, name and kind — so
    # occupancy is derived from cwd, which does.
    # live_rows, not the raw list, and it took four `claude stop` invocations
    # across two sessions to find out. `claude agents --json` retains an exited
    # session as a row with a null pid; counted as occupancy it made a node
    # permanently claimable by nobody, and `claude stop` on it reported success
    # and changed nothing. live_rows already excluded those — its docstring is
    # about this exact failure — and this one call site did not use it.
    #
    # A missing pid is stronger evidence than absence from a roster, which is
    # why this may infer death where `claim --force` may not: absence only says
    # the local roster does not mention it, and the holder may be alive on
    # another host. A row that names NO process is the roster asserting that
    # nothing runs under it anywhere.
    here = [r for r in live_rows(rows) if r.get("cwd") == str(ctx.worktree)]
    others = [r for r in here if r["sessionId"] != self_ref]
    if others:
        # Named with pids, because a bare count is what made hand-filtering the
        # roster look like the only move. A session that edits the evidence its
        # own guard reads succeeds identically whether the row it removed was a
        # corpse or a live peer — and in the second case two sessions hold one
        # node and nothing anywhere says so.
        who = "\n".join(f"             {(r.get('name') or '?')}  "
                         f"{str(r.get('sessionId'))[:8]}  pid {r.get('pid')}  "
                         f"{r.get('status') or '?'}"
                         for r in others)
        die(REFUSED, f"{len(others)} other live session(s) are in this worktree:\n"
                     f"{who}\n"
                     f"           One session per worktree — that is the invariant, "
                     f"and it is the only\n           guard between this design and "
                     f"two sessions on one node.\n\n"
                     f"           Each named above has a live process. Stop it "
                     f"(`claude stop <short-id>`;\n           the full uuid is not "
                     f"matched) or use its worktree. Do NOT pass a hand-edited\n"
                     f"           roster to --roster: that flag exists to replay a "
                     f"recorded roster in tests,\n           and using it here means "
                     f"a session choosing what its own guard is allowed\n"
                     f"           to see.")
    # Interactive sessions are not in the roster (obs 4). Warned, not refused:
    # the owner often has a chat open in the repository directory.
    for r in interactive_in(ctx.worktree, exclude={self_ref}):
        print(f"warning: interactive session {r.get('name') or '?'} "
              f"[{str(r.get('sessionId'))[:8]}] pid {r.get('pid')} is in this worktree "
              f"— two sessions on one index")
    try:
        fd = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    except FileExistsError:
        held = json.loads(lock.read_text())
        if held["ref"] == self_ref:
            print(f"already held by this session ({node})"); return
        if holder_alive(held, rows):
            die(REFUSED, f"'{node}' is held by {held['name']} [{held['ref']}], "
                         f"which is live elsewhere. Not taking it.")
        # The recorded holder is not live and no other session is in this
        # worktree, so taking the lock is safe. That much is checked above.
        #
        # It used to `return` here and everything below was unreachable, which
        # quietly disabled the ONE check that still mattered: a lock claimed on
        # another host. Absence from a LOCAL roster is not evidence about a
        # remote process, and taking a node held by a live session elsewhere is
        # exactly the two-sessions-one-branch failure the lock exists to stop.
        if held.get("host") and held["host"] != socket.gethostname() and not a.force:
            die(REFUSED,
                f"'{node}' was claimed on host '{held['host']}', and this is "
                f"'{socket.gethostname()}'.\n"
                f"           It is absent from THIS machine's roster, which says "
                f"nothing about whether\n           it is running there. --force if you "
                f"have checked.")
        rec["taken_from"] = {"ref": held["ref"], "name": held.get("name"),
                             "host": held.get("host"),
                             "claimed_at": held.get("claimed_at")}
        lock.write_text(json.dumps(rec, indent=2))
        # Deliberately not "resumed": a resumed conversation and a fresh session
        # replacing a stopped one are indistinguishable from here, and only one
        # of them was true. Say what was observed instead of picking.
        print(f"claimed {node} — the recorded holder {held.get('name')} "
              f"[{held['ref'][:8]}] is not running and nobody else is in this worktree")
        return
    with os.fdopen(fd, "w") as fh:
        json.dump(rec, fh, indent=2)
    print(f"claimed {node} as {self_name} [{self_ref}]")


def cmd_release(a):
    ctx = Ctx(); ctx.require_enrolled()
    node, _ = ctx.node()
    lock = ctx.lock_path(node)
    if not lock.exists():
        print(f"{node} was not claimed"); return
    held = json.loads(lock.read_text())
    mine = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if held.get("session_id") != mine and not a.force:
        die(REFUSED, f"'{node}' is held by another session ({held['name']}). "
                     f"Use --force only after checking liveness.")
    lock.unlink()
    # A released node is not waiting on anything. Leaving the record behind
    # would have the next session inherit a question the last one asked, and a
    # lead answering into an empty worktree.
    if clear_wait(ctx, node):
        print(f"  cleared the wait on this node — it was released, not answered")
    print(f"released {node}")


def cmd_status(a):
    ctx = Ctx(); ctx.require_enrolled()
    peers = {}
    try:
        # live_rows, not the raw list: an exited session is retained with a null
        # pid, and a lock whose holder had exited still read "live" — which is
        # exactly backwards, since a stale lock is the thing this command exists
        # to surface so it can be forced.
        rows = live_rows(agents_json(read_roster(a.roster)))
        # A finished turn waiting on a reply is a session at rest, not one
        # stuck at a prompt: only the latter is WAITING here.
        peers = {r["sessionId"]: {"name": r.get("name") or "?",
                                 "stopped": is_stopped(r) and (stop_detail(r, rows)
                                            or {}).get("kind") != "reply"}
                 for r in rows}
    except Exception:
        peers, rows = {}, []
    # A claim is not an assignment. A node can be claimed, live, and holding
    # nothing to do — and an idle session with a live counterparty spends that
    # capacity on elective correspondence, which no transaction terminates.
    tasks, tasks_rec = {}, {}
    for task, rec in open_marks(ctx).items():
        tasks.setdefault(rec.get("_node") or "?", []).append(task)
        tasks_rec[task] = rec

    _waits = open_waits(ctx)
    d = ctx.state / "locks"
    locks = sorted(d.glob("*.lock")) if d.is_dir() else []
    claimed, unassigned = set(), []
    for p in locks:
        h = json.loads(p.read_text())
        live = {True: "live", False: "gone", None: "unknown"}[holder_alive(h, rows)]
        # A stopped session is live, and calling it `live` is true and useless.
        # It reports `status: idle` — the same word as a session with nothing to
        # do — so the one state that needs a human at the keyboard rendered as
        # the state that needs nobody.
        # Unless the harness's own record says what it waits on (obs 68): then it
        # is waiting on its lead, and the owner is not the one to act.
        if peers.get(h["ref"], {}).get("stopped") and h["node"] not in _waits:
            live = "WAITING"
        claimed.add(h["node"])
        open_here = tasks.get(h["node"], [])
        pres = [x for x in open_here if tasks_rec.get(x, {}).get("_presented_at")]
        run = [x for x in open_here if x not in pres]
        bits = []
        if run:
            bits.append(", ".join(sorted(run)))
        if pres:
            bits.append(f"{', '.join(sorted(pres))} (awaiting sign-off)")
        work = "   ".join(bits) if bits else "no task record"
        if live in ("live", "WAITING"):
            work += f"   ctx {ktok(context_size(h['ref']))}"
        if reset_path(ctx, h["node"]).exists():
            try:
                _r = json.loads(reset_path(ctx, h["node"]).read_text())
                work += (f"   reset pending ({'flushed; ' if _r.get('flushed') else ''}"
                         f"{reset_ceiling(_r)}) — hold non-urgent messages")
            except Exception:
                work += "   reset pending"
        act = node_activity(ctx, h["node"], _waits)
        if act:
            work += f"   {act}"
        if live == "gone" and last_write(h["ref"]):
            work += time.strftime("   (process gone, last write %H:%M)",
                                  time.localtime(last_write(h["ref"])))
        nc = sum(len(tasks_rec.get(x, {}).get("_comments") or []) for x in open_here)
        if nc:
            work += f"   ({nc} comment(s) — harness note <task>)"
        if live == "live" and not open_here:
            unassigned.append(h["node"])
        print(f"  {h['node']:<12} {h['name']:<22} [{h['ref']}]  {live:<8}{work}")
        if live == "WAITING":
            print(f"  {'':<12} WAITING ON YOU — not idle. The runtime reports one state "
                  f"for two\n  {'':<12} things and they have different remedies: send it "
                  f"a prompt if it is\n  {'':<12} waiting on a reply, or attach and answer "
                  f"if it is on a permission\n  {'':<12} prompt.  claude attach {h['ref'][:8]}")

    if not locks:
        print("no nodes claimed")

    # The state that follows a release: the lock is gone, the session is not.
    # `release` drops a claim; it does not end a session, so a released node can
    # still be standing there, addressable, constrained by no rule in the tree.
    try:
        idx = load_index(ctx, refresh=True)
        for r in live_rows(agents_json(read_roster(a.roster))):
            n = idx["byWorktree"].get(r.get("cwd", ""))
            if n and n not in claimed:
                print(f"  {n:<12} {(r.get('name') or '?'):<22} [{r['sessionId']}]  "
                      f"OCCUPIED but unclaimed — released the node, kept the session")
    except Exception:
        pass

    blocked = open_blocks(ctx)
    if blocked:
        print(f"\n  {len(blocked)} blocked:")
        for r in blocked.values():
            need = (r.get("need") or "").strip().splitlines()[0][:90] if r.get("need") else ""
            print(f"    {r.get('node', '?'):<12} {need}")
        print("  Nobody is unblocked by a session with looser settings:")
        print("  `harness grant <node> <path>` from rank 0 or a shell, then recycle it.")

    stale_m, unattr_m = orphan_marks(ctx)
    if stale_m or unattr_m:
        print()
        if stale_m:
            print(f"  {len(stale_m)} open task record(s) name a node the tree no longer has: "
                  f"{', '.join(sorted(stale_m))}")
            print("  `harness trim` closes those.")
        if unattr_m:
            print(f"  {len(unattr_m)} open task record(s) name no node at all "
                  f"(they predate the field): {', '.join(sorted(unattr_m))}")
            print("  They cannot be attributed, only closed: "
                  "harness mark <task> --close --force")

    if unassigned:
        print(f"\n  {len(unassigned)} live node(s) with no open task RECORD: "
              f"{', '.join(sorted(unassigned))}")
        print("  That is not the same as doing nothing — it means the harness cannot")
        print("  tell what they are doing, and cannot price it (I10). Mark the task,")
        print("  or if the work is done: close it at T10 and  harness recycle --idle")


def cmd_enrol(a):
    repo = Path(a.repo).resolve()
    rc, common, _ = git("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=repo)
    if rc:
        die(NOT_ENROLLED, f"{repo} is not a git repository")
    repo = Path(common).parent
    state = HOME_STATE / slug(repo)
    (state / "locks").mkdir(parents=True, exist_ok=True)
    (state / "binding.json").write_text(json.dumps(
        {"repo": str(repo), "host": socket.gethostname(),
         "enrolled_at": time.strftime("%Y-%m-%dT%H:%M:%S%z")}, indent=2))
    print(f"enrolled {repo.name} on this machine")
    if not (repo / ".harness" / "tree.json").exists():
        print(f"note: {repo}/.harness/tree.json does not exist yet — "
              f"enrolment takes two keys, and this is only one.")


def live_sessions():
    """The on-disk session table, filtered to live pids.

    ~/.claude/sessions/<pid>.json carries name, cwd, kind and status. Unlike
    ListAgents it has cwd, which is what maps a session to a worktree. Dead
    files accumulate, so every pid is checked; procStart guards against reuse.
    """
    out = []
    if not SESSIONS.is_dir():
        return out
    for f in SESSIONS.glob("*.json"):
        try:
            d = json.loads(f.read_text())
            os.kill(d["pid"], 0)
        except Exception:
            continue
        out.append(d)
    return out


def interactive_in(worktree, exclude=()):
    """Live interactive sessions whose cwd is this worktree or inside it."""
    wt = str(worktree)
    return [d for d in live_sessions()
            if d.get("kind") == "interactive" and d.get("sessionId") not in exclude
            and (d.get("cwd") == wt or str(d.get("cwd") or "").startswith(wt + "/"))]


def build_index(ctx):
    nodes, by_branch, by_wt = {}, {}, {}
    rc, porc, _ = git("worktree", "list", "--porcelain", cwd=ctx.repo)
    wt_of = {}
    cur = None
    for line in porc.splitlines():
        if line.startswith("worktree "):
            cur = line.split(" ", 1)[1]
        elif line.startswith("branch ") and cur:
            wt_of[line.split(" ", 1)[1].replace("refs/heads/", "")] = cur
    for name, spec in ctx.tree["nodes"].items():
        br = spec.get("branch")
        parent = spec.get("parent")
        sibs = sorted(n for n, s in ctx.tree["nodes"].items()
                      if s.get("parent") == parent and n != name) if parent else []
        nodes[name] = {"branch": br, "worktree": wt_of.get(br), "parent": parent,
                       "rank": ctx.rank(name), "siblings": sibs,
                       "children": ctx.children(name), "kind": spec.get("kind"),
                       "model": assignment_for(ctx, name)[0],
                       "effort": assignment_for(ctx, name)[1]}
        if br:
            by_branch[br] = name
        if wt_of.get(br):
            by_wt[wt_of[br]] = name
    idx = {"generated": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "repo": str(ctx.repo),
           "project": ctx.tree.get("project", ctx.repo.name),
           "nodes": nodes, "byBranch": by_branch, "byWorktree": by_wt}
    ctx.state.mkdir(parents=True, exist_ok=True)
    (ctx.state / "index.json").write_text(json.dumps(idx, indent=2))
    return idx


def load_index(ctx, refresh=False):
    p = ctx.state / "index.json"
    if refresh or not p.exists() or p.stat().st_mtime < ctx.tree_path.stat().st_mtime:
        return build_index(ctx)
    return json.loads(p.read_text())


def cmd_index(a):
    ctx = Ctx(); ctx.require_enrolled()
    idx = build_index(ctx)
    print(f"indexed {len(idx['nodes'])} nodes → {ctx.state / 'index.json'}")
    for n, s in sorted(idx["nodes"].items(), key=lambda kv: (kv[1]["rank"], kv[0])):
        held = "  (no worktree)" if not s["worktree"] else ""
        print(f"  r{s['rank']}  {n:<12} {s['branch']:<14} ↑{s['parent'] or '—':<10} "
              f"⇄{','.join(s['siblings']) or '—':<14} ↓{','.join(s['children']) or '—'}{held}")


MARK = {"busy": "•", "idle": "◦", None: "·"}


def cmd_position(a):
    """--quiet is the statusline contract: never speak, never fail, in a project
    that is not enrolled. Absence of a segment must cost the caller nothing."""
    if not a.quiet:
        return _position(a)
    global QUIET
    QUIET = True
    try:
        _position(a)
    except SystemExit as e:
        if e.code not in (0, None):
            sys.exit(0)
    except Exception:
        sys.exit(0)


def _position(a):
    ctx = Ctx(); ctx.require_enrolled()
    idx = load_index(ctx, refresh=a.refresh)
    node = idx["byBranch"].get(ctx.branch)
    if node is None:
        die(NOT_ENROLLED, f"branch '{ctx.branch}' is not a node")
    me = idx["nodes"][node]
    occ = {}
    for s in live_sessions():
        n = idx["byWorktree"].get(s.get("cwd", ""))
        if n:
            occ.setdefault(n, []).append(s)
    def mark(n):
        ss = occ.get(n, [])
        if not ss:
            return f"{n}·"
        if len(ss) > 1:
            return f"{n}!{len(ss)}"     # more than one session in one worktree
        return f"{n}{MARK.get(ss[0].get('status'), '?')}"
    parent = me["parent"]
    sibs = " ".join(mark(s) for s in me["siblings"]) or "—"
    kids = " ".join(mark(c) for c in me["children"])
    if a.format == "json":
        print(json.dumps({"node": node, **me, "occupancy":
              {k: [{"name": s.get("name"), "status": s.get("status")} for s in v]
               for k, v in occ.items()}}, indent=2))
        return
    bits = []
    if parent:
        bits.append(f"↑{mark(parent)}")
    own = occ.get(node, [])
    bits.append(f"[{node}]" + (f"!{len(own)}" if len(own) > 1 else ""))
    if me["siblings"]:
        bits.append(f"⇄ {sibs}")
    if me["children"]:
        bits.append(f"↓ {kids}")
    line = "  ".join(bits)
    if a.behind and parent:
        pb = idx["nodes"][parent]["branch"]
        rc, out, _ = git("rev-list", "--count", f"HEAD..{pb}")
        if rc == 0 and out != "0":
            line += f"   ⇩{out}"
    print(line)


def cmd_spawn(a):
    """Launch one correctly-named background session per unoccupied node.

    Uses `claude --bg -n <project>-<node>`: a real session with its own id and
    lock, not a subagent. Each one derives its own position from git — nothing
    is told where it is. Attach later with `claude attach <id>`.
    """
    ctx = Ctx(); ctx.require_enrolled()
    idx = load_index(ctx, refresh=True)
    rows = live_rows(agents_json(read_roster(a.roster)))
    by_wt = idx["byWorktree"]
    occupied = {}
    for r in rows:
        n = by_wt.get(r.get("cwd", ""))
        if n:
            occupied.setdefault(n, []).append(r)
    # "This session" must mean a SESSION, not a directory. `here` is derived from
    # the branch of the cwd, so an operator standing in a node's worktree in a
    # plain shell was told "skip main — this session" about a node whose session
    # they had just stopped, and could not start a replacement from the one place
    # it is natural to try. When there is no session id there is no this-session.
    here = idx["byBranch"].get(ctx.branch) if os.environ.get("CLAUDE_CODE_SESSION_ID") else None
    # A node starts its OWN children and nobody else's. There was no parentage
    # test here at all -- bare `spawn` took every node in the tree with a
    # worktree -- so a rank-1 lead ran it and started a member two ranks away
    # under a sibling lead. Measured 2026-09-08: dev ran bare `spawn` and
    # started panel_1, which is panel's child and has never been dev's business.
    #
    # Every other downward command is already gated this way; `brief --for`
    # refuses a node that is not yours. Spawn is the one that starts a SESSION,
    # so it is where the gate mattered most and it was the one that had none.
    #
    # `here` is the caller's node, and it is None exactly when there is no
    # session id -- the operator, who is not a node, legitimately drives the
    # whole tree, and is the one caller that should keep the old behaviour.
    mine = set(ctx.children(here)) if here else None
    if a.node:
        targets = a.node
    elif mine is not None:
        targets = sorted(n for n in mine
                         if (idx["nodes"].get(n) or {}).get("worktree"))
    else:
        targets = sorted(n for n, sp in idx["nodes"].items() if sp["worktree"])
    launched = skipped = 0
    for n in targets:
        sp = idx["nodes"].get(n)
        if sp is None:
            print(f"  skip {n:<12} not a node"); skipped += 1; continue
        if not sp["worktree"]:
            print(f"  skip {n:<12} no worktree — create one first"); skipped += 1; continue
        if n == here:
            print(f"  skip {n:<12} this session — it cannot spawn into its own worktree")
            skipped += 1; continue
        if mine is not None and n not in mine:
            _p = (ctx.tree["nodes"].get(n) or {}).get("parent")
            print(f"  skip {n:<12} not your child — "
                  + (f"{_p} starts it, and only {_p} knows what it is for"
                     if _p else "it is rank 0; the operator starts it"))
            skipped += 1; continue
        if n in occupied:
            who = occupied[n][0].get("name") or "?"
            print(f"  skip {n:<12} occupied by {who}"); skipped += 1; continue
        name = f"{idx['project']}-{n}"
        model, effort = assignment_for(ctx, n)
        model, effort = a.model or model, a.effort or effort
        # This was a note printed in the same breath as the spawn it was warning
        # about, which is a caption, not a warning: the session is already
        # starting by the time anyone reads it. The spec states the rule for the
        # holder check and states it generally -- any path that spawns treats a
        # doubt about a node as fatal to THAT NODE, never as a note -- and this
        # was the same command family with the same shape, left standing.
        #
        # Standing up an empty node stays legitimate, and it keeps a command.
        # What it no longer is, is the default outcome of a bare `spawn` that
        # meant "start my lanes on their work".
        nq = startable(ctx, n)
        # Rank 0 is exempt, and the gate was wrong about it twice over. The
        # refusal exists to stop a node starting with nothing to open and then
        # asking its lead what to do; rank 0 has no lead, and writing the queue
        # is its job rather than a precondition of it. A fresh rank-0 session
        # reads the charter and briefs the tree, so requiring a brief first asks
        # the operator to do rank 0's work before rank 0 exists to do it -- and
        # `spawn main` is the ordinary way to start a project. The remedy it
        # printed was wrong too: rank 0's self-write is `harness brief <task>
        # --write`, with no `--for`, the only self-write in the tree.
        try:
            _rank0 = ctx.rank(n) == 0
        except Exception:
            _rank0 = False                 # unresolvable rank: keep the gate
        _below = set(subtree(ctx, n)) | {n}     # its own open mark is work to resume (obs 64)
        _lead_work = sum(1 for r in open_marks(ctx).values() if r.get("_node") in _below)
        _waiting = [b for b in queue(ctx, n) if not b.get("coupled_to") and waits_on(ctx, b)]
        if not nq and _waiting and not _lead_work:
            print(f"  skip {n:<12} every queued task waits: "
                  + "; ".join(f"{b['task']} {waits_on(ctx, b)[0]}" for b in _waiting[:2]))
            skipped += 1; continue
        if not nq and _lead_work:
            _own = [t for t, r in open_marks(ctx).items()
                    if r.get("_node") == n and not r.get("_presented_at")]
            print(f"       {n:<12} " + (f"resumes {_own[0]} — its open task" if _own else
                                         f"starts on {_lead_work} open task(s) below it"))
        elif not nq and not a.empty and not _rank0:
            print(f"  skip {n:<12} nothing briefed — it would have no task to open.")
            print(f"  {'':<17} harness brief <task> --for {n} --write \"...\"   "
                  f"then spawn it")
            print(f"  {'':<17} or start it empty on purpose:  harness spawn {n} --empty")
            skipped += 1; continue
        elif not nq and _rank0:
            print(f"       {n:<12} nothing queued — it writes its own briefs")
        elif not nq:
            print(f"  note {n:<12} nothing briefed — starting it empty, as asked.")
        else:
            print(f"       {n:<12} starts on {nq[0]['task']}"
                  + (f", then {len(nq) - 1} more" if len(nq) > 1 else ""))
        gr = grants_for(ctx, n)
        reach = f"  +{len(gr)} grant(s)" if gr else ""
        cmd = launch_cmd(ctx, n, name, gr, model, effort, a.prompt)
        if a.dry_run:
            print(f"  would spawn {name:<18} {model}/{effort:<7} in {sp['worktree']}{reach}")
        else:
            subprocess.Popen(cmd, cwd=sp["worktree"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(f"  spawned {name:<18} {model}/{effort:<7} in {sp['worktree']}{reach}")
        launched += 1
    verb = "would spawn" if a.dry_run else "spawned"
    print(f"{verb} {launched}, skipped {skipped}"
          + ("" if a.dry_run else "   —  `claude agents` to view, `claude attach <id>` to join"))


def cmd_doctor(a):
    """Prove the guard refuses, rather than reading config and trusting it.

    Config that looks right and hooks that ARE right are different claims. This
    demands the behaviour: a known document must be refused and a known code path
    must be allowed, run through the same file git would execute.
    """
    ctx = Ctx(); ctx.require_enrolled()
    node, spec = ctx.node()
    fails = []
    # Whether the reader of this report is the one who may repair it. Every
    # remedy line below branches on it — the arm, and the failure text at the
    # end. Fixing only the arm is what left the same rank-blind instruction in
    # the sentence underneath it.
    mine = ctx.rank(node) == 0 or not os.environ.get("CLAUDE_CODE_SESSION_ID")

    # Installed-versus-source, first, because a stale install makes every arm
    # below a measurement of the wrong thing. Three times in one day the copy
    # that is actually read was left behind while its source moved on.
    vf = HOME_STATE / "VERSION"
    if vf.exists():
        try:
            v = json.loads(vf.read_text())
            src = Path(v.get("source", ""))
            rc, head, _ = git("rev-parse", "HEAD", cwd=src) if src.is_dir() else (1, "", "")
            if rc == 0 and head.strip() != v.get("commit"):
                print(f"  WARN installed from {str(v.get('commit'))[:8]}, "
                      f"{src.name} is now at {head.strip()[:8]} — re-run install.sh")
                print(f"       skills and the CLI you are running are older than their source")
            elif rc == 0:
                print(f"  ok   installed at {str(v.get('commit'))[:8]}, level with {src.name}")
        except Exception:
            pass
    else:
        print("  note no ~/.claude/harness/VERSION — cannot tell whether this install "
              "is current")

    def arm(label, ok, detail=""):
        print(f"  {'ok  ' if ok else 'FAIL'} {label}{('  ' + detail) if detail else ''}")
        if not ok:
            fails.append(label)

    def wiring_failed(fs):
        """Every exit from this command goes through here. There used to be one
        that did not, and it was the one a document node took."""
        if fs:
            print()
            die(UNGUARDED,
                f"{len(fs)} check(s) failed — this worktree is NOT guarded as "
                f"configured.\n           Do not trust config that looks right. "
                f"Failed: {', '.join(fs)}\n\n"
                f"           Exit 6, not 2. This is not the platform contract: "
                f"nothing about Claude has\n           changed. Read which arm "
                f"failed.\n"
                + (f"           A hook that drifted is `harness scaffold`, after you "
                   f"have read the diff\n           it prints."
                   if mine else
                   f"           Repairing it is NOT yours: hooksPath is absolute into "
                   f"the document node's\n           checkout, so a scaffold from here "
                   f"rewrites the hooks every node runs.\n           Report which arm "
                   f"failed to your lead and carry on with your task."))

    # 1. wiring — necessary, not sufficient
    rc, hp, _ = git("config", "--get", "core.hooksPath")
    guard = Path(hp) / "_guard" if hp else None
    arm("core.hooksPath is set", bool(hp), hp or "")
    arm("hooksPath is absolute", bool(hp) and hp.startswith("/"),
        "" if (hp or "").startswith("/") else "relative paths vanish on branches lacking the dir")
    arm("_guard exists and is executable", bool(guard and guard.exists() and os.access(guard, os.X_OK)))
    for h in ("pre-commit", "pre-merge-commit", "reference-transaction", "pre-push"):
        f = Path(hp) / h if hp else None
        arm(f"{h} present", bool(f and f.exists() and os.access(f, os.X_OK)))
    # the fileMode trap: git records the index mode, not the disk mode
    rel = os.path.relpath(hp, ctx.repo) if hp else ""
    rc, modes, _ = git("ls-files", "-s", "--", rel)
    tracked = [l for l in modes.splitlines() if l.strip()]
    if tracked:
        bad = [l.split("\t")[-1] for l in tracked if not l.startswith("100755")]
        arm("hooks are 100755 in git's index", not bad,
            "" if not bad else f"{len(bad)} at 100644 — inert in every fresh clone")

    # The hooks in this REPO against the ones that were installed. Every arm
    # above asks whether a hook is present, executable and wired; none asked
    # whether it is the current one, and the first line of this command reports
    # the CLI's version — which reads, to anyone who has just updated, as "your
    # guards are current". A repo can run guards several releases behind while
    # every arm here is green, and doctor is the one instrument this design
    # calls proof that a guard fires. Content, not mtime: a hook copied about
    # or re-saved is not a hook that changed.
    tpl = HOME_STATE / "templates" / "hooks"
    if hp and tpl.is_dir():
        drift, missing = [], []
        for t in sorted(tpl.glob("*")):
            if not t.is_file():
                continue
            here = Path(hp) / t.name
            if not here.exists():
                missing.append(t.name)
            elif here.read_bytes() != t.read_bytes():
                drift.append(t.name)
        # The remedy depends on who is reading it. This printed `harness
        # scaffold <path>` to whoever ran it, at any rank, and a leaf meets this
        # arm on claim before it has done anything else — so the most junior
        # session in the tree was handed the most tree-wide command in the CLI,
        # with --force in the obvious invocation. One did exactly that.
        fix = (f"  — re-scaffold: harness scaffold {ctx.repo}" if mine
               else "  — NOT yours to fix: report it to your lead")
        arm("hooks match the installed templates", not (drift or missing),
            "" if not (drift or missing) else
            ", ".join(([f"differs: {', '.join(drift)}"] if drift else [])
                      + ([f"absent: {', '.join(missing)}"] if missing else []))
            + fix)
        if (drift or missing) and not mine:
            print(f"       The guards this repo runs are not the ones installed, and "
                  f"repairing them\n       is rank 0's: hooksPath is absolute into the "
                  f"document node's checkout, so\n       a scaffold from here would "
                  f"rewrite the hooks EVERY node executes, with no\n       commit and "
                  f"no review. Say which files differ and carry on with your task.")
        elif drift or missing:
            print(f"       The guards this repo actually runs are not the ones that "
                  f"were installed.\n"
                  f"       Nothing above notices that, because every other arm asks "
                  f"whether a hook\n"
                  f"       is THERE. Read the diff before you re-scaffold — guard "
                  f"changes alter what\n"
                  f"       is refused, and a live tree is the wrong place to find "
                  f"that out:\n"
                  f"         diff -u {tpl}/_guard {hp}/_guard")

    if fails and not (guard and guard.exists()):
        die(UNGUARDED, "hooksPath does not contain a usable _guard — this worktree "
                       "is UNGUARDED.\n           Failed: " + ", ".join(fails))
    if spec.get("kind") == "doc":
        print(f"\n  '{node}' is the document node; there is nothing for the guard to refuse here.")
        # ...but everything ABOVE this line still had to pass. The wiring arms
        # are not about what the guard refuses, they are about whether it is
        # installed and current, and they apply to every node. Returning here
        # without consulting them printed FAIL and exited 0 — and the skill's
        # contract for this command is "non-zero means unguarded; stop", so a
        # session doing exactly what it was told read an unguarded tree as
        # guarded. A red that exits 0 is visible to a person and invisible to
        # everything that automates, which is the whole class of fault this
        # command exists to close.
        wiring_failed(fails)
        # Nothing to refuse here, so prove the guard where it refuses: in each
        # child's worktree (obs 9).
        nodes = load_index(ctx)["nodes"]
        bad = 0
        for k in ctx.children(node):
            wt = (nodes.get(k) or {}).get("worktree")
            if not wt:
                print(f"  {k:<12} no worktree"); continue
            try:
                r = subprocess.run([sys.executable, str(Path(__file__).resolve()), "doctor"],
                                   cwd=wt, capture_output=True, text=True, timeout=120)
                rc, why = r.returncode, (r.stderr or r.stdout).strip().splitlines()
            except Exception as e:
                rc, why = 1, [str(e)]
            bad += rc != 0
            print(f"  {k:<12} " + ("guarded" if rc == 0 else
                                   f"UNGUARDED (exit {rc}): {(why or ['?'])[-1][:90]}"))
        if bad:
            die(UNGUARDED, f"{bad} child worktree(s) failed doctor — run it there to read why")
        return

    # 2. behaviour — the part that matters
    doc_branch = next((v["branch"] for v in ctx.tree["nodes"].values()
                       if v.get("kind") == "doc"), None)

    def classify(paths):
        """Ask _guard. Never reimplement its matcher — that drift is what made
        the code-path arm select a document and pass for the wrong reason."""
        r = subprocess.run([str(guard), "--classify"], input="\n".join(paths) + "\n",
                           capture_output=True, text=True,
                           env=dict(os.environ, HARNESS_BRANCH=ctx.branch),
                           cwd=str(ctx.worktree))
        out = {"doc": [], "code": []}
        for line in r.stdout.splitlines():
            k, _, v = line.partition(" ")
            if k in out:
                out[k].append(v)
        return out

    # Documents come from the document node. CODE MUST COME FROM THIS WORKTREE:
    # the document node may track no code at all, and drawing the code sample
    # from it means the arm can never fail.
    doc_cls = classify(git("ls-tree", "-r", "--name-only", doc_branch)[1].splitlines() or [""])
    own_cls = classify(git("ls-tree", "-r", "--name-only", "HEAD")[1].splitlines() or [""])
    doc_sample = doc_cls["doc"][0] if doc_cls["doc"] else None
    code_sample = next((c for c in own_cls["code"] if not c.startswith(".harness/")), None)

    def run_guard(path, rev=""):
        env = dict(os.environ, HARNESS_BRANCH=ctx.branch, HARNESS_REV=rev)
        try:
            r = subprocess.run([str(guard)], input=path + "\n", capture_output=True,
                               text=True, env=env, cwd=str(ctx.worktree))
        except OSError as e:
            return 127, str(e)
        return r.returncode, (r.stderr or "").strip()

    def probe(path, content):
        """Stage novel content in a THROWAWAY index and ask the guard."""
        blob = subprocess.run(["git", "hash-object", "-w", "--stdin"], input=content,
                              capture_output=True, text=True, cwd=str(ctx.worktree)).stdout.strip()
        tmp = ctx.state / "doctor.index"
        env = dict(os.environ, GIT_INDEX_FILE=str(tmp))
        subprocess.run(["git", "read-tree", "HEAD"], env=env, cwd=str(ctx.worktree), capture_output=True)
        subprocess.run(["git", "update-index", "--add", "--cacheinfo", f"100644,{blob},{path}"],
                       env=env, cwd=str(ctx.worktree), capture_output=True)
        try:
            r = subprocess.run([str(guard)], input=path + "\n", capture_output=True, text=True,
                               env=dict(env, HARNESS_BRANCH=ctx.branch, HARNESS_REV=""),
                               cwd=str(ctx.worktree))
            rc = r.returncode
        except OSError:
            rc = 127
        tmp.unlink(missing_ok=True)
        return rc

    if doc_sample:
        # same path in both arms, different blob — that IS authorship semantics
        rc_ok, _ = run_guard(doc_sample, doc_branch)
        arm(f"allows a document holding {doc_branch}'s content", rc_ok == 0, doc_sample)
        # A genuine negative: synthesise content the document node has never held
        # and stage it in a THROWAWAY index, so the real index is untouched.
        blob = subprocess.run(["git", "hash-object", "-w", "--stdin"],
                              input=f"harness doctor probe {time.time()}\n",
                              capture_output=True, text=True, cwd=str(ctx.worktree)).stdout.strip()
        tmp_index = ctx.state / "doctor.index"
        env = dict(os.environ, GIT_INDEX_FILE=str(tmp_index))
        subprocess.run(["git", "read-tree", "HEAD"], env=env, cwd=str(ctx.worktree),
                       capture_output=True)
        subprocess.run(["git", "update-index", "--add", "--cacheinfo",
                        f"100644,{blob},{doc_sample}"], env=env, cwd=str(ctx.worktree),
                       capture_output=True)
        genv = dict(env, HARNESS_BRANCH=ctx.branch, HARNESS_REV="")
        try:
            r = subprocess.run([str(guard)], input=doc_sample + "\n", capture_output=True,
                               text=True, env=genv, cwd=str(ctx.worktree))
            rc_bad = r.returncode
        except OSError:
            rc_bad = 127
        tmp_index.unlink(missing_ok=True)
        arm("refuses that same document with content it has never held", rc_bad != 0,
            doc_sample if rc_bad != 0 else "GUARD ALLOWED IT — this worktree is unguarded")
    else:
        arm("found a document to test with", False, "no manifest doc glob matches any tracked path")
    # The arm most worth having on a code node: novel code must pass. A guard
    # that over-refuses would block every commit here and, drawn from the
    # document node's tree, this arm could never have caught it.
    if code_sample:
        rc_code = probe(code_sample, f"# harness doctor probe {time.time()}\n")
        arm("allows NOVEL content on a code path", rc_code == 0,
            code_sample if rc_code == 0 else f"{code_sample} — guard over-refuses code")
    else:
        arm("found a code path in this worktree to test with", False,
            "nothing here classifies as code")

    print()
    wiring_failed(fails)
    print(f"guarded: {node} ({ctx.branch}) — refusal demonstrated, not inferred")


def cmd_stop(a):
    """Stop the sessions occupying given nodes. `claude stop` is a full teardown:
    the process dies, the session file is removed, and it leaves the table."""
    ctx = Ctx(); ctx.require_enrolled()
    idx = load_index(ctx)
    rows = live_rows(agents_json())
    by_wt = idx["byWorktree"]
    mine = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    here = idx["byBranch"].get(ctx.branch)
    if a.children:
        if here is None:
            die(NOT_ENROLLED, "not standing in a node, so --children has no meaning")
        targets = idx["nodes"][here]["children"]
        if not targets:
            print(f"'{here}' has no children"); return
    else:
        targets = a.node
    if not targets:
        die(REFUSED, "name at least one node, or pass --children")
    occ = {}
    for r in rows:
        n = by_wt.get(r.get("cwd", ""))
        if n:
            occ.setdefault(n, []).append(r)
    stopped = 0
    for n in targets:
        if n not in idx["nodes"]:
            print(f"  skip {n:<12} not a node"); continue
        sessions = occ.get(n, [])
        if not sessions:
            print(f"  skip {n:<12} nobody there"); continue
        for r in sessions:
            if r["sessionId"] == mine:
                print(f"  skip {n:<12} that is this session"); continue
            label = f"{r.get('name') or '?'} [{r['sessionId'][:8]}]"
            # Its work, not just the conversation (obs 80): the process tree is
            # read before the stop, while its parent links are intact.
            pid = r.get("pid") if isinstance(r.get("pid"), int) else None
            tree = [p for p in proc_tree(pid) if p != pid] if pid else []
            if a.dry_run:
                print(f"  would stop {n:<12} {label}"
                      + (f" and {len(tree)} process(es) under it" if tree else ""))
            else:
                res = subprocess.run(["claude", "stop", r["sessionId"][:8]],
                                     capture_output=True, text=True)
                if res.returncode:
                    print(f"  FAILED {n:<12} {label}: {res.stderr.strip()[:80]}"); continue
                print(f"  stopped {n:<12} {label}")
                time.sleep(1)
                alive = [p for p in tree if _pid_exists(p)]
                for p in alive:
                    kill_tree(p)
                if alive:
                    print(f"           and killed {len(alive)} process(es) it left running: "
                          + ", ".join(_proc_name(p) for p in alive[:5]))
                for j in testq_jobs(ctx, ("queued",)):
                    if [x.get("node") for x in j["requested_by"]] == [n]:
                        testq_cancel(ctx, j)
                        print(f"           and cancelled its queued test job {j['id']}")
            stopped += 1
    verb = "would stop" if a.dry_run else "stopped"
    print(f"{verb} {stopped}")
    if not a.dry_run and stopped:
        print("  their locks remain until each node is claimed again — "
              "`harness status` shows them as stale")


# ── I10: the denominator, measured rather than apportioned ───────────────────

# The unit is TOKENS, never money. A dollar figure is this multiplied by a
# price table the harness would have to hold per model and keep correct, and
# every node may run a different one. A drifted rate produces a figure that
# looks authoritative and cannot be checked from the record it sits in.
TOKEN_KINDS = ("input", "cache_write", "cache_read", "output")

# The bands of I10, as ranges rather than letters, so an estimate and its actual
# are finally the same unit. XL is a refusal and not a size: it is the
# operational definition of I8, and the only number here that decides whether
# work may be issued at all.
BANDS = {"S": (0, 40_000), "M": (40_000, 120_000), "L": (120_000, 300_000)}


# The prompt cache holds for an hour on a subscription, and five minutes once
# you are drawing on usage credits. Past it, the next thing you say to a session
# re-processes its whole context.
CACHE_TTL = 60 * 60

# How long a presented task may sit unsigned before the rank above its lead is
# told. Long enough that a lead mid-review is not reported as absent.
STALLED_SIGNOFF = 20 * 60      # a lead has not signed off presented work
STALLED_IDLE = 20 * 60         # a child stands idle with work already written
STALLED_APPROVAL = 60 * 60     # rank 0 has not decided a gated brief
DOC_REVIEW_AFTER = 5 * 60      # a documenter batch rank 0 has not reviewed
WAIT_STALL = 10 * 60          # a grandchild's wait the lead in between has not answered (obs 68)
# Three contracts, three constants, and for a while one number doing all of it.
# A presentation twenty minutes old is a lead mid-review; a child idle twenty
# minutes is one being recycled; a gated brief twenty minutes old is nothing at
# all -- it is unrequested work waiting on a decision nobody promised to make
# quickly, and reporting it on the same clock as a stalled hand-off teaches the
# reader that the clock means nothing. They are set equal for the first two on
# purpose, and that is a JUDGEMENT rather than an accident of sharing a name:
# when one of them wants tuning it can move without dragging the others.


def last_turn(sid):
    """When a session last did anything, and how much context it is carrying.

    Both come off its own transcript. The file's mtime is the last turn; the
    last usage record's cache-read count is what that turn handed back, which is
    the closest honest proxy for what the NEXT turn would have to re-read.
    """
    t = transcript_for(sid)
    if t is None:
        return None, None
    try:
        age = time.time() - t.stat().st_mtime
    except OSError:
        return None, None
    return age, context_size(sid, t)


def session_model(sid, t=None, tail=256 * 1024):
    """The model a session last answered with, off its transcript: the one that
    actually ran, whatever the node was assigned."""
    t = t or (transcript_for(sid) if sid else None)
    if t is None:
        return None
    try:
        with open(t, "rb") as fh:
            fh.seek(0, 2)
            fh.seek(max(0, fh.tell() - tail))
            chunk = fh.read().decode("utf-8", "replace")
    except OSError:
        return None
    for line in reversed(chunk.splitlines()):
        if '"model"' not in line or '"assistant"' not in line:
            continue
        try:
            m = (json.loads(line).get("message") or {}).get("model")
        except Exception:
            continue
        if m and m != "<synthetic>":
            return m
    return None


def context_size(sid, t=None, tail=256 * 1024):
    """Context occupancy on the session's last turn: input + cache read + cache
    creation from the last usage block (obs 60). Read from the TAIL, because a
    lead's transcript runs to megabytes and this runs on every prompt."""
    t = t or (transcript_for(sid) if sid else None)
    if t is None:
        return None
    try:
        with open(t, "rb") as fh:
            fh.seek(0, 2)
            size = fh.tell()
            fh.seek(max(0, size - tail))
            chunk = fh.read().decode("utf-8", "replace")
    except OSError:
        return None
    for line in reversed(chunk.splitlines()):
        if '"usage"' not in line:
            continue
        try:
            u = (json.loads(line).get("message") or {}).get("usage")
        except Exception:
            continue                       # the first line of the chunk may be cut
        if u:
            return (u.get("cache_read_input_tokens", 0)
                    + u.get("cache_creation_input_tokens", 0)
                    + u.get("input_tokens", 0))
    return None


def ktok(n):
    return "?" if n is None else f"{round(n / 1000)}k"


def human_age(sec):
    if sec is None:
        return "?"
    m = int(sec // 60)
    return f"{m}m" if m < 60 else f"{m // 60}h{m % 60:02d}m"


def cmd_idle(a):
    """Sessions holding a node and not doing anything, oldest first.

    An idle session costs nothing while it is idle. It costs when you speak to
    it: every turn resends the whole conversation, and past the cache lifetime
    that resend is charged as new work rather than as a cache read. So a node
    you walked away from three hours ago is not free to pick up — the first
    thing you say to it pays for its entire history at full rate.

    Which makes the answer the one [[R13]] already gives for a different reason.
    A member is stateless by design: position comes from git, orientation from
    the hook, scope from the task record. Replacing a cold session costs its
    orientation. Resuming one costs everything it was carrying, and carries the
    accumulated errors too.
    """
    rows = live_rows(agents_json(read_roster(a.roster)))
    by_cwd = {}
    for r in rows:
        by_cwd.setdefault(r.get("cwd"), []).append(r)
    out = []
    for pdir in sorted(p for p in HOME_STATE.glob("*")
                       if p.is_dir() and (p / "binding.json").exists()):
        try:
            repo = json.loads((pdir / "binding.json").read_text()).get("repo", "")
            idx = json.loads((pdir / "index.json").read_text())
        except Exception:
            continue
        marks = {}
        md = pdir / "marks"
        for f in (sorted(md.glob("*.json")) if md.is_dir() else []):
            try:
                m = json.loads(f.read_text())
            except Exception:
                continue
            if not m.get("_closed_at"):
                marks.setdefault(m.get("_node"), []).append(
                    (m.get("_task") or f.stem, bool(m.get("_presented_at"))))
        for node, sp in (idx.get("nodes") or {}).items():
            for r in by_cwd.get(sp.get("worktree"), []):
                if r.get("status") == "busy" and not a.all:
                    continue
                age, carry = last_turn(r.get("sessionId") or "")
                held = marks.get(node, [])
                st = stop_detail(r, rows)
                reply = bool(st and st["kind"] == "reply")
                out.append({"project": Path(repo).name, "repo": repo, "node": node,
                            "name": r.get("name"), "age": age, "carry": carry,
                            "held": held, "sid": (r.get("sessionId") or "")[:8],
                            "stopped": is_stopped(r) and not reply, "stop": st,
                            "on": ((ctx_parent(idx, node) or "its lead") if st["on"] == LAUNCHED
                                   else st["on"] or "you") if reply else None})
    if not out:
        print("no idle sessions holding a node"); return
    # Stopped first and unconditionally, whatever their age. Every other row
    # here is a judgement about cost; this one is a lane that has halted, and
    # sorting it in among sessions that are merely quiet buries the only row
    # that is not working as intended.
    out.sort(key=lambda x: (not x["stopped"], -(x["age"] or 0)))
    cold = 0
    for x in out:
        is_cold = (x["age"] or 0) > CACHE_TTL
        cold += is_cold
        work = ", ".join(t for t, pres in x["held"] if not pres)
        pres = ", ".join(t for t, pres in x["held"] if pres)
        print(f"{x['project']} · {x['node']:<10} "
              # The header token and the line under it have to agree. They did
              # not: the header said STOPPED while the body said WAITING ON YOU,
              # which is two names for one condition in three lines of output.
              + ("WAITING" if x["stopped"] else "idle")
              + f" {human_age(x['age']):>7}"
              + ("   COLD" if is_cold and not x["stopped"] else "")
              + (f"   carrying {tok(x['carry'])}" if x["carry"] else ""))
        if x["stopped"] and x["stop"]:
            print(f"  {'':<12} WAITING ON YOU at a permission prompt "
                  f"({x['stop']['tool']}: {x['stop']['what']}): claude attach {x['sid']}")
            continue
        if x["stopped"]:
            print(f"  {'':<12} WAITING ON YOU, not resting. Send it a prompt, or attach "
                  f"and answer\n  {'':<12} if it is on a permission prompt: claude attach "
                  f"{x['sid']}")
            continue
        if x["on"]:
            print(f"  {'':<12} finished its turn, waiting on {x['on']}")
        if work:
            print(f"  {'':<12} mid-task: {work} — do not recycle, it has not presented")
        elif pres:
            print(f"  {'':<12} presented {pres}, waiting on its lead to sign off")
        elif is_cold:
            print(f"  {'':<12} (cd {shlex.quote(x['repo'])} && harness recycle "
                  f"{x['node']})")
    if cold:
        print(f"\n{cold} past the {CACHE_TTL // 60}m cache lifetime. The next thing "
              f"you say to one of those\nre-processes everything it is carrying, at "
              f"full rate. A fresh session on the\nsame node costs its orientation "
              f"instead — and R13 wanted it replaced anyway.")
    else:
        print(f"\nnone past the {CACHE_TTL // 60}m cache lifetime — their context is "
              f"still cached.")


def read_spend_or_none(sid):
    """`read_spend`, but a measurement failure is a null rather than a death.

    `mark` called `read_spend` directly, which exits CONTRACT when the
    transcript is missing or its shape has moved. That coupled OPENING A TASK to
    MEASURING ITS COST: a transcript-format change would have made it impossible
    to open a task anywhere in any tree, and position-recording is the thing the
    ledger is actually for.

    It is the same judgement T10 already makes at the other end -- a task closed
    in a different session records `_delta: null` and says why, because refusing
    the close over an unmeasurable cost would leave the task open forever and
    destroy the one signal the record exists to give. Refusing the OPEN is
    worse: there is no record at all to be imperfect.

    `harness spend` still refuses outright, and should. There the number IS the
    output, and a spend command that returns nothing rather than refusing would
    be reporting 0 as a measurement.
    """
    global QUIET
    was = QUIET
    try:
        # `die()` writes to stderr before it raises, so a refusal the CALLER
        # recovers from still printed "cannot measure spend (C2)" over a command
        # that then succeeded. A scary line above a success is how a reader
        # learns to distrust both.
        QUIET = True
        return read_spend(sid), None
    except SystemExit as e:
        return None, f"cost cannot be measured here (exit {e.code})"
    finally:
        QUIET = was


def read_spend(sid):
    """Cumulative billed tokens for a session, from its own transcript.

    Every assistant record carries a `usage` object; summing them gives what was
    billed, which is NOT the same quantity as context occupancy. A session that
    reports "339,295 tokens" is almost certainly reporting the latter. Recording
    both under one word in a ledger is how a figure acquires an owner it never
    had, so this function names its unit and refuses to emit a single number.

    Fails loud (R8): no transcript, or a usage shape it does not recognise, is a
    contract failure — never a zero.
    """
    if not UUID_RE.fullmatch(sid):
        die(CONTRACT, f"CLAUDE_CODE_SESSION_ID is not a UUID (C1) — refusing to use "
                      f"it as a path component")
    t = transcript_for(sid)
    if t is None:
        die(CONTRACT, f"no transcript for session {sid} — cannot measure spend (C2)")
    tot = {"input": 0, "cache_write": 0, "cache_read": 0, "output": 0}
    seen = 0
    last = None
    for line in t.open(errors="replace"):
        try:
            d = json.loads(line)
        except Exception:
            continue
        u = (d.get("message") or {}).get("usage")
        if not u:
            continue
        seen += 1
        last = d.get("timestamp") or last
        tot["input"] += u.get("input_tokens", 0)
        tot["cache_write"] += u.get("cache_creation_input_tokens", 0)
        tot["cache_read"] += u.get("cache_read_input_tokens", 0)
        tot["output"] += u.get("output_tokens", 0)
    if seen == 0:
        die(CONTRACT, f"{t.name} carries no usage records — the transcript format "
                      f"has changed; refusing to report 0 as a measurement (R8)")
    tot["_records"] = seen
    tot["_at"] = last
    tot["_session"] = sid
    return tot


def tok(n):
    """A token count a person can read. Three significant figures at most: a
    measurement of billed tokens printed to the digit implies a precision the
    quantity does not have."""
    n = int(n or 0)
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n / 1_000:.0f}k"
    return str(n)


def split(t):
    """Up, down, and resent — and they are three quantities, not one.

    UP is what was newly sent: the prompt, plus whatever was written into the
    cache for the first time. DOWN is what was generated. RESENT is cache reads,
    which is the conversation being handed back on every turn, and it is the
    reason a session bills hundreds of millions of tokens while doing a few
    hundred thousand tokens of work.

    Adding resent into a headline is what made the raw total useless: a task
    inside a band of 40k measured 261.7M, and the two were never the same
    quantity. So they are never summed here. NEW (up + down) is the figure that
    is comparable to a band; resent is printed beside it and stays there.
    """
    up = (t.get("input", 0) or 0) + (t.get("cache_write", 0) or 0)
    down = t.get("output", 0) or 0
    return up, down, (t.get("cache_read", 0) or 0)


def spend_line(t):
    up, down, resent = split(t)
    return (f"↑{tok(up)} ↓{tok(down)}  = {tok(up + down)} new"
            + (f", {tok(resent)} resent" if resent else ""))


def band_of(n):
    for k, (lo, hi) in BANDS.items():
        if lo <= n < hi:
            return k
    return "XL"


def mark_label(rec, stem):
    """The id its lead typed, not the filename it became. A mark is stored under
    the sanitised name, so a reader printing the key hands back `specter2_embed`
    for a task everyone else calls `specter2-embed` — including in a command it
    tells someone to run."""
    return (rec or {}).get("_task") or stem


def open_marks(ctx):
    """Task records that were opened and never closed, keyed by task.

    A mark with no `_closed_at` is an OPEN task. This is the only mechanical
    answer to "does this node still have an object?", and without it a node that
    has finished is indistinguishable from one still working — which is how a
    session ends up holding capacity with nothing to spend it on.
    """
    d = ctx.state / "marks"
    out = {}
    for p in (sorted(d.glob("*.json")) if d.is_dir() else []):
        try:
            rec = json.loads(p.read_text())
        except Exception:
            continue
        if rec.get("_closed_at"):
            continue
        out[p.stem] = rec
    return out


def orphan_marks(ctx):
    """Open task records that name no node this tree has.

    Two kinds, and they are not the same problem. A mark whose `_node` names a
    node that has been trimmed away is stale and can be closed. A mark with NO
    `_node` at all predates the field: it cannot be attributed, only reported,
    because guessing which node it belonged to is exactly the kind of inference
    that makes a ledger untrustworthy. Both were previously dropped in silence,
    so their nodes read as having no task while their sessions worked on one.
    """
    stale, unattributable = {}, {}
    for task, rec in open_marks(ctx).items():
        n = rec.get("_node")
        if n is None:
            unattributable[task] = rec
        elif n not in ctx.tree["nodes"]:
            stale[task] = rec
    return stale, unattributable


def unreported(ctx, node):
    """Open marks on this node that were never presented AND have work to show.

    Evidence matters. A mark opened and not started is a member that has not
    begun — blocking on that would trap a lane that is waiting on something. A
    mark whose HEAD has moved, or whose worktree is dirty, is work that exists
    and that its lead has not been told about, which is the whole failure: the
    member finished and stopped, and the record said nothing.
    """
    out = []
    head = git("rev-parse", "HEAD", cwd=ctx.worktree)[1].strip()
    dirty = bool(git("status", "--porcelain", cwd=ctx.worktree)[1].strip())
    for t, r in open_marks(ctx).items():
        if r.get("_node") != node or r.get("_presented_at"):
            continue
        moved = bool(r.get("_sha")) and r["_sha"] != head
        if moved or dirty:
            out.append((mark_label(r, t), moved, dirty))
    return out


def lead_owes(ctx, node):
    """What this node owes its children, as (kind, child, task, age) rows.

    Two things, and both are one command. A child that has presented and not
    been signed off is finished work nobody has accepted. A child with a queue
    and no open task is capacity standing still with work already written for
    it. Neither is visible to the child — only the node above can act.

    Both are aged. A presentation seconds old is a lead mid-review, not a lead
    that has forgotten; a child idle for a moment is one being recycled. The
    threshold is what separates "has not got to it" from "is not going to".
    """
    owed, marks = [], open_marks(ctx)
    kids = ctx.children(node)
    for t, r in marks.items():
        if r.get("_node") in kids and r.get("_presented_at"):
            then = _epoch(r["_presented_at"])
            if then and time.time() - then > STALLED_SIGNOFF:
                owed.append(("sign off", r["_node"], mark_label(r, t),
                             time.time() - then))
    for k in kids:
        try:
            _held = json.loads(ctx.lock_path(k).read_text())
        except Exception:
            _held = None
        _dead = _held is not None and holder_alive(_held) is False
        _lw = last_write((_held or {}).get("ref")) if _dead else None
        _gone = time.time() - _lw if _lw else 0
        own = [t for t, r in marks.items()
               if r.get("_node") == k and not r.get("_presented_at")]
        if own:
            # A session that ended holding its task is not "mid-task" (obs 63,
            # 64): say so now, not when a message to it bounces.
            if _dead and _gone > 120:
                owed.append(("orphan", k, own[0], _gone))
            continue                       # mid-task, nothing owed
        # A lead whose subtree holds an open mark is waiting on it, not idle
        # (obs 19, 22, 27) -- unless the lead itself has gone.
        below = set(subtree(ctx, k))
        if any(r.get("_node") in below for r in marks.values()):
            if _dead and _gone > 120:
                owed.append(("down", k, "and its lanes still hold open work", _gone))
            continue
        q = startable(ctx, k)
        if not q:
            continue                       # nothing it can start: not this rule
        try:
            held = json.loads(ctx.lock_path(k).read_text())
        except Exception:
            held = None
        alive = holder_alive(held) if held else False
        # Standing still since its last task closed, the work was written, or
        # its session last wrote, whichever is latest.
        stamps = [_epoch(r.get("_closed_at")) for r in marks.values()
                  if r.get("_node") == k] + [_epoch(q[0].get("written_at"))]
        if held:
            stamps.append(last_write(held.get("ref")))
        last = max([x for x in stamps if x] or [0])
        if last and time.time() - last > STALLED_IDLE:
            if alive is not False:
                owed.append(("start", k, q[0]["task"], time.time() - last))
            else:
                owed.append(("down", k, f"'{q[0]['task']}' queued", time.time() - last))
    # A child carrying more context than its rank should (obs 60).
    for k in kids:
        warn = context_limits(ctx, k)[0]
        try:
            held = json.loads(ctx.lock_path(k).read_text())
        except Exception:
            continue
        if not warn or not holder_alive(held):
            continue
        size = context_size(held.get("ref"))
        if size and size > warn:
            try:
                rr = json.loads(reset_path(ctx, k).read_text())
            except Exception:
                rr = {}
            owed.append(("heavy", k, f"{ktok(size)} (warn {ktok(warn)})" + (
                f"; reset overdue: skipped {rr.get('skipped_why') or 'busy'} at "
                f"{time.strftime('%H:%M', time.localtime(rr['skipped_at']))}, retries at "
                f"its next turn end" if rr.get("skipped_at") else ""), 0))
    return owed


def subtree(ctx, node):
    """Every node below `node`."""
    out, todo = [], list(ctx.children(node))
    while todo:
        n = todo.pop()
        out.append(n)
        todo.extend(ctx.children(n))
    return out


def owed_line(kind, child, task, age):
    """One line for a lead_owes row, shared by the prompt and Stop hooks."""
    return {
        "sign off": f"{child} presented '{task}' {human_age(age)} ago, unsigned"
                    f"  — harness mark {task} --close",
        "start": f"{child} quiet {human_age(age)}, '{task}' queued"
                 f"  — message it to start (SendMessage)",
        "down": f"{child} has no running session, {task}"
                f"  — harness spawn {child}",
        "heavy": f"{child} at {task} context"
                 f"  — harness recycle {child} --at-quiet",
        "orphan": f"{child}'s session ended {human_age(age)} ago holding '{task}' open"
                  f"  — harness recycle {child} (it resumes the task)",
    }[kind]


def rank0_owes(ctx, node):
    """What rank 0 owes as the operator's proxy, as (kind, id, label, age) rows.

    Rank 0 holds more queues than anyone — pending approvals, blocks the
    operator answered that produced no task — and reads them least often,
    because it is the ONE node R13 never recycles and orientation fires on
    startup, resume and compact. A rank-0 session that began this morning and
    has not compacted has read its queue exactly once. Measured on a live tree:
    its lock had not been refreshed in 37 hours.

    That inversion is the whole reason this exists. `lead_owes` gave rank 0 a
    per-turn heartbeat for what it owes DOWNWARD and nothing for what it owes
    outward, so the queues that only it can clear were the ones with no
    heartbeat at all.
    """
    if ctx.rank(node) != 0:
        return []
    owed = []
    # Documenter batches: rank 0 reviews every one (T18; owner, 2026-10-05).
    try:
        for r in docs_pending(ctx):
            age = time.time() - (_epoch(r.get("at")) or time.time())
            if age > DOC_REVIEW_AFTER:
                owed.append(("review", r["task"], f"{r['task']}: {batch_summary(r)}", age))
    except Exception:
        pass
    bd = ctx.state / "briefs"
    for f in (sorted(bd.glob("*.json")) if bd.is_dir() else []):
        try:
            b = json.loads(f.read_text())
        except Exception:
            continue
        ap = b.get("approval") or {}
        if ap.get("state") != "pending" or b.get("superseded_at"):
            continue
        then = _epoch(ap.get("asked_at"))
        if then and time.time() - then > STALLED_APPROVAL:
            owed.append(("approve", b.get("task") or f.stem,
                         b.get("task") or f.stem, time.time() - then))
    for key, r in decided_blocks(ctx).items():
        # The last thing the operator said on it. `answered()` is what put it
        # here, so there is one by construction; the max is for a block they
        # spoke on more than once.
        cs = [c.get("at") or "" for c in (r.get("comments") or [])
              if c.get("by") == "operator"]
        then = _epoch(max(cs) if cs else (r.get("granted_at") or r.get("resolved_at")))
        if then and time.time() - then > STALLED_APPROVAL:
            owed.append(("task", key, r.get("need") or key, time.time() - then))
    # A complete unit waits on rank 0's cleanup decision.
    # One line however many: a backlog of units must not become a page of nags.
    try:
        n = len(completed_units(ctx))
        sf, sn = stale_records(ctx)
        m = len(sf) + len(sn)
        # One row per population, each naming the command that acts on it (obs 65).
        if n:
            owed.append(("sweep", "units", f"{n} complete unit(s)", 0))
        if m:
            owed.append(("sweep", "stale", f"{m} stale record(s)", 0))
        k = ended_count(ctx)
        if k >= ENDED_NAG:
            owed.append(("sweep", "sessions", f"{k} ended session(s) still listed", 0))
    except Exception:
        pass
    return owed


# ── orientation, edge-triggered ──────────────────────────────────────────────
#
# The cost of telling a session something is NOT paid once. A line printed at
# turn k of an n-turn conversation is resent on every turn after it, so it costs
# roughly (n - k) times — periodic orientation output is quadratic in session
# length. That single fact rules out "print the queue every N turns" and leaves
# only one shape that works: report a CHANGE, never a state. A session already
# told about an item does not pay for it again, so the bill is O(changes)
# instead of O(turns), and a quiet tree costs nothing at all.
#
# Which is also why this is a set of ids rather than a rendered block. What is
# compared is what the reader would have to act on, not how it was phrased.

def focus_tasks(ctx):
    """The focus as stored: a list of task names or globs, [] when unset."""
    try:
        r = json.loads((ctx.state / "focus.json").read_text())
    except Exception:
        return []
    return r.get("tasks") or ([r["task"]] if r.get("task") else [])


def focus_family(ctx):
    """The owner's focus as a set of task keys: every brief matching one of its
    names or globs, and every part split from those. None when unset (obs 5, 6,
    13, 53)."""
    pats = [re.sub(r"[^A-Za-z0-9*?\[\]]", "_", t) for t in focus_tasks(ctx)]
    if not pats:
        return None
    briefs = all_briefs(ctx)
    fam = {p for p in pats if not any(c in p for c in "*?[")}
    fam |= {k for k in briefs if any(fnmatch.fnmatchcase(k, p) for p in pats)}
    todo = list(fam)
    while todo:
        k = todo.pop()
        # A replacement (`--supersede --by`) inherits its predecessor's place (obs 56).
        nxt = tkey((briefs.get(k) or {}).get("superseded_for") or "")
        if nxt and nxt not in fam:
            fam.add(nxt); todo.append(nxt)
        for c, b in briefs.items():
            if c not in fam and tkey(b.get("from") or "") == k:
                fam.add(c); todo.append(c)
    return fam


def in_focus(fam, task):
    return fam is None or tkey(task or "") in fam


def cmd_focus(a):
    """The owner's priority. Nags outside it fold into one line; queues are never
    filtered by it, only labelled."""
    ctx = Ctx(); ctx.require_enrolled()
    f = ctx.state / "focus.json"
    if a.clear:
        f.unlink(missing_ok=True); print("focus cleared"); return
    cur = focus_tasks(ctx)
    if not (a.task or a.add or a.remove):
        if not cur:
            print("no focus set"); return
        r = json.loads(f.read_text())
        fam = focus_family(ctx) or set()
        print(f"focus: {', '.join(cur)}  ({r.get('why') or 'no reason given'}, "
              f"set {r.get('at')}; {len(fam)} task(s) in it)")
        return
    gone = {tkey(t) for t in (a.remove or [])}
    tasks = [t for t in (a.task or cur) + (a.add or []) if tkey(t) not in gone]
    tasks = list(dict.fromkeys(tasks))
    if not tasks:
        f.unlink(missing_ok=True); print("focus cleared — nothing left in it"); return
    why = a.why or (json.loads(f.read_text()).get("why") if f.exists() and not a.task else "")
    f.write_text(json.dumps({"tasks": tasks, "why": why or "",
                             "at": time.strftime("%Y-%m-%dT%H:%M:%S%z")}) + "\n")
    fam = focus_family(ctx) or set()
    print(f"focus: {', '.join(tasks)} — {len(fam)} task(s) in it; "
          f"nags outside fold into one line")
    if not fam:
        print("  nothing matches yet — check the names (`harness queue`)")
    # What it leaves out, so a gap is seen now rather than by a lane (obs 55).
    for n in sorted(ctx.tree["nodes"]):
        left = [b["task"] for b in queue(ctx, n) if not in_focus(fam, b["task"])]
        if left:
            print(f"  outside  {n:<10} {', '.join(left)}")


def queue_items(ctx, node):
    """Everything this node currently owes or holds, as {id: one-line text}.

    Ids are stable across calls so an unchanged item compares equal, and carry
    the thing they name so an item that goes away and comes back reports again
    — which is correct: it is news the second time too.
    """
    out = {}
    try:
        for kind, child, task, age in lead_owes(ctx, node):
            # heavy's text changes every turn; its id must not, or it re-reports
            key = f"heavy:{child}" if kind == "heavy" else f"{kind}:{child}:{task}"
            out[key] = owed_line(kind, child, task, age)
    except Exception:
        pass
    try:
        for kind, ident, label, age in rank0_owes(ctx, node):
            # Selected by kind, with an explicit fallback. This was an
            # if/else whose else-branch hardcoded the word "block", so the day a
            # third kind arrived it would have described itself as a block and
            # named a command that could not find it.
            _line = {
                "review": f"documenter batch {label} awaits your review ({human_age(age)})"
                          f"  — harness pairs {ident}, then apply or --decline",
                "approve": f"'{label}' waits on your approval ({human_age(age)})"
                           f"  — harness brief {label} --approve",
                "task": f"block '{label}' was answered {human_age(age)} ago and "
                        f"produced no task  — harness blocked --decided",
                "sweep": f"{label} await a cleanup decision  — harness sweep"
                         + (" --stale --dry-run" if ident == "stale" else
                            " --sessions --dry-run" if ident == "sessions" else
                            "  (then --dry-run, --why)"),
            }.get(kind)
            out[f"{kind}:{ident}"] = _line or (
                f"'{label}' ({kind}) has been waiting {human_age(age)}"
                f"  — harness status")
    except Exception:
        pass
    try:
        _w = open_waits(ctx)
        _below = set(subtree(ctx, node))
        for n, r in _w.items():
            if r.get("parent") == node:
                out[f"asked:{n}"] = (f"{n} is stopped waiting on you "
                                     f"({wait_age(r.get('since'))}): {r.get('asked')}")
            elif n in _below and time.time() - (_epoch(r.get("since")) or time.time()) > WAIT_STALL:
                # A wait the lead in between has not seen: it runs no harness
                # command while a long job runs, so it is never told (obs 68).
                up = r.get("parent")
                doing = node_activity(ctx, up, _w)
                out[f"stuck:{n}"] = (f"{n} has waited {wait_age(r.get('since'))} on {up}"
                                     + (f" — {up}: {doing}" if doing else "")
                                     + f". Message {up}, or answer {n} yourself")
    except Exception:
        pass
    try:
        # Every part settled, yet a clause of the segment has no part (obs 58).
        for x in delegated(ctx, node):
            if x.get("uncovered") and x["done"] == len(x["children"]) and not x["closed_at"]:
                out[f"uncovered:{x['key']}"] = (
                    f"{x['task']}: parts settled, clause(s) "
                    f"{','.join(map(str, x['uncovered']))} have no part"
                    f"  — brief them, or close with --force")
    except Exception:
        pass
    try:
        fam = focus_family(ctx)
    except Exception:
        fam = None
    try:
        # One line for all of them; the detail is one command away.
        un = {t: cs for t, cs in unread_brief_comments(ctx, node).items()
              if in_focus(fam, t)}
        if un:
            n = sum(len(cs) for cs in un.values())
            names = ", ".join(sorted(un)[:3]) + (", …" if len(un) > 3 else "")
            out[f"comment:{n}"] = (f"{n} unread comment(s) on {names}"
                                   f"  — harness brief <task>")
    except Exception:
        pass
    try:
        # Only a node with nothing in flight here or below is sitting on handed
        # work, and only the next brief is owed: a queue is worked in order.
        here = {node, *subtree(ctx, node)}
        busy = any(r.get("_node") in here for r in open_marks(ctx).values())
        left = [t for t in unactioned_briefs(ctx, node) if in_focus(fam, t)]
        able = {b["task"] for b in startable(ctx, node)}
        nxt = next((b["task"] for b in queue(ctx, node) if b["task"] in left and b["task"] in able),
                   None)
        if nxt and not busy:
            out[f"handed:{nxt}"] = (
                f"'{nxt}' is yours and not started or split"
                f"  — harness mark {nxt}, or brief <part> --from {nxt}")
    except Exception:
        pass
    out.update(ask_notices(ctx, node))     # T17: rulings, rejections, returns
    if ctx.rank(node) == 0:
        out.update(docs_notices(ctx))      # T18: batches applied or refused, said once
    if fam is None:
        return out
    # The item's task is the third field of a node row, else the second.
    def task_of(k):
        parts = k.split(":")
        return parts[2] if parts[0] in ("sign off", "start", "down", "orphan") else parts[1]
    kept = {k: v for k, v in out.items()
            if k.startswith(("asked:", "comment:", "handed:", "heavy:", "sweep:", "uncovered:",
                             "orphan:", "down:", "stuck:", "ruled:", "rejected:", "returned:",
                             "docs:", "review:", "done:", "imask:"))
            or in_focus(fam, task_of(k))}
    if len(kept) < len(out):
        kept[f"fold:{len(out) - len(kept)}"] = (f"+{len(out) - len(kept)} item(s) "
                                                f"outside the focus  — harness whoami")
    return kept


# A DEBT is not news. R15 said report a change and never a state, which is right
# for something that happened and wrong for something you OWE: an unsigned
# presentation does not stop being true because you have been told once. Reported
# once and suppressed forever is exactly how a lead mid-conversation with its own
# lead forgets to sign off a child -- observed, and caused by this file.
#
# So obligations re-report on a cooldown while they persist. Everything else
# still fires once. The cooldown is what keeps that from being a per-turn tax:
# a debt costs one line every DEBT_RENAG, not one line every turn.
DEBT_RENAG = 10 * 60
DEBT_KINDS = ("sign off:", "start:", "down:", "orphan:", "stuck:", "heavy:", "approve:", "task:", "asked:", "handed:",
              "sweep:")


def is_debt(item_id):
    return item_id.startswith(DEBT_KINDS)


def seen_path(ctx, sid):
    return ctx.state_file("seen", sid or "no-session", ".json")


def delta(ctx, node, sid, update=True):
    """New items since this session was last told, and only new ones.

    Keyed on the SESSION, not the node: a recycled session has been told
    nothing, which is exactly right — it starts cold by design and its
    orientation is where it learns the lot.
    """
    now = queue_items(ctx, node)
    p = seen_path(ctx, sid)
    told = {}
    try:
        raw = json.loads(p.read_text())
        # Both formats. The old one was a bare list of ids with no timestamps,
        # which is why nothing could re-nag: there was nothing to compare.
        told = raw.get("told") or {k: raw.get("at") or "" for k in (raw.get("ids") or [])}
    except Exception:
        told = {}
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    nowsec = time.time()
    new, keep = [], {}
    for k in now:
        last = told.get(k)
        if last is None:
            new.append(k); keep[k] = stamp
        elif is_debt(k) and (nowsec - (_epoch(last) or 0)) > DEBT_RENAG:
            new.append(k); keep[k] = stamp          # still owed, say so again
        else:
            keep[k] = last                          # told, and not yet due again
    if update:
        try:
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(json.dumps({"told": keep, "at": stamp}) + "\n")
        except Exception:
            pass
        # Told is the moment a rejected or returned stub has done its job. Here
        # rather than in queue_items, which status and the GUI read without telling.
        ask_consume(ctx, new)
        docs_consume(ctx, new)
    # The ids as well as the lines, so a caller can tell whether what it just
    # printed was a debt without recomputing the queue and getting a different
    # answer than the one it showed.
    return [now[k] for k in new], new


def print_delta(ctx=None, node=None, prefix="new"):
    """Silent unless something changed, and silent on every failure.

    It runs on the interactive path — after any harness command, and from the
    UserPromptSubmit hook on every turn — so it reads local JSON only. No
    roster, no git beyond what Ctx already did: a `claude agents --json` here
    would put 0.55s on every prompt in the repository.
    """
    try:
        if ctx is None:
            ctx = Ctx()
            if not (ctx.tree_path.exists() and ctx.binding_path.exists()):
                return
            ctx.require_enrolled()
        if node is None:
            node = next((n for n, s in ctx.tree["nodes"].items()
                         if s.get("branch") == ctx.branch), None)
            if node is None:
                return
        rows, ids = delta(ctx, node, os.environ.get("CLAUDE_CODE_SESSION_ID", ""))
        for r in rows:
            print(f"{prefix:<8} {r}")
        # The harness cannot hold a thought for a session; the session's own todo
        # list can, and it is the only structure that survives a long exchange
        # with somebody else. So the reminder names the tool rather than hoping.
        # It prints only when something is actually owed, so a quiet lane pays
        # nothing.
        # Gated on what was just PRINTED, not on what exists. Keyed on the
        # latter it fired on every quiet turn with nothing above it -- three
        # lines of standing advice in every transcript forever, which is the
        # per-turn tax the whole edge-triggered design exists to avoid.
        if any(is_debt(k) for k in ids):
            print("         ^ owed below you — put them on your todo list (TaskCreate)")
    except SystemExit:
        return
    except Exception:
        return


def cmd_hook_orient(a):
    """UserPromptSubmit: the per-turn orientation heartbeat.

    `Stop` cannot do this job. Checked against the reference rather than
    assumed, 2026-09-08 — and the spec asserted the opposite: exit-0 stdout
    becomes context for `UserPromptSubmit`, `UserPromptExpansion`, `SessionStart`
    and `PostModelSwitch`, and for everything else, `Stop` included, it goes to
    the debug log. So a Stop hook reaches the model only by BLOCKING, which is
    the right instrument for work that is owed and the wrong one for news.

    This is the other half: it speaks on the turn a session is about to act, it
    says only what changed, and it says nothing at all when nothing has. A quiet
    tree costs zero tokens per turn.
    """
    global QUIET
    QUIET = True
    try:
        sys.stdin.read()
    except Exception:
        pass
    print_delta()
    sys.exit(0)


def cmd_hook_stop(a):
    """Claude Code's Stop hook: the one moment a member that has finished and
    said nothing is still reachable.

    Everything else in the harness reaches a session when it runs a command, and
    the failure here is precisely that it runs none — it finishes the work and
    ends its turn. This fires there, blocks once, and names the command.

    Three things it must never do. It must never raise: a hook that errors on
    every turn is worse than no enforcement. It must never print on the allow
    path, because plain stdout on exit 0 becomes context on EVERY turn of every
    session in the repository. And it must never block twice — `stop_hook_active`
    says a block already happened this turn, and one nudge is the whole of what
    is proportionate.
    """
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except Exception:
        return
    again = bool(payload.get("stop_hook_active"))
    # Not inside a git worktree is the common case for this hook: it is
    # installed per repository, but a session can sit anywhere. Ctx() calls
    # die() there, which raises SystemExit and exits 3 — a non-blocking error
    # that still writes a notice into the transcript, on every turn, forever.
    # SystemExit is not an Exception, so the guard below would not have caught
    # it. Check first, and catch it anyway.
    if git("rev-parse", "--git-dir")[0]:
        return
    try:
        ctx = Ctx()
        if not ctx.tree_path.exists() or not ctx.binding_path.exists():
            return
        ctx.tree = json.loads(ctx.tree_path.read_text())
        node, _ = ctx.node()
        # Rank 0's quiet point is also when a documenter batch lands, or a
        # documenter run starts (T18). Detached and silent.
        try:
            docs_apply_step(ctx, node)
        except Exception:
            pass
        # The Stop right after a block carries stop_hook_active. It may launch a
        # pending reset (that is the quiet point the flush leads to) but it must
        # never block again.
        if reset_step(ctx, node, launch_only=again) or again:
            return
        # A session without a doorbell can't be woken while idle: remind it,
        # once per session, at the first turn end that finds it unarmed.
        sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
        if sid and not bell_armed(ctx, node, sid):
            mark = bell_dir(ctx, node) / "reminded"
            if (mark.read_text().strip() if mark.exists() else "") != sid:
                mark.write_text(sid)
                print(json.dumps({"hookSpecificOutput": {
                    "hookEventName": "Stop", "decision": "block", "reason":
                    "Arm your doorbell so the harness can wake you when idle: run "
                    "`harness doorbell` with run_in_background. When it finishes, run "
                    "`harness doorbell --read`, act on it, and arm it again."}}))
                return
        # Downward first: what this node owes the rank below. It applies to rank
        # 0 as much as anyone — main is dev's lead — which is why every row is
        # aged past a threshold, so a design conversation is not interrupted over
        # a child that has been idle for ninety seconds.
        fam = focus_family(ctx)
        owed = [o for o in lead_owes(ctx, node) if o[0] != "heavy"
                and (o[0] in ("orphan", "down") or in_focus(fam, o[2]))]
        if owed:
            nl = chr(10)
            lines = []
            for kind, child, task, age in owed[:4]:
                lines.append("  " + owed_line(kind, child, task, age))
            print(json.dumps({"hookSpecificOutput": {
                "hookEventName": "Stop", "decision": "block", "reason":
                f"Owed to the rank below you:{nl}"
                + nl.join(lines) + f"{nl}"
                + "Act on each, or say on the record why not."}}))
            return
        if ctx.rank(node) == 0:
            # It presents to nobody, so the upward arm below does not apply. But
            # it is the OPERATOR's proxy, and those queues had no heartbeat at
            # all: orientation fires on startup, resume and compact, and rank 0
            # is the one node R13 never recycles. Measured on a live tree — its
            # lock had gone 37 hours without a refresh, which is 37 hours of
            # approvals and answered blocks read exactly once.
            #
            # Aged on the same rule as everything above, so a conversation with
            # the operator is never interrupted over something two minutes old.
            mine = [o for o in rank0_owes(ctx, node) if o[0] != "sweep"]
            if mine:
                nl = chr(10)
                def _owed(kind, label, age):
                    if kind == "approve":
                        return (f"  '{label}' is waiting on your approval "
                                f"({human_age(age)}):{nl}    harness brief {label} "
                                f"--approve   (or --decline \"why\")")
                    if kind == "review":
                        return (f"  documenter batch {label} has waited "
                                f"{human_age(age)}:{nl}    harness pairs {label.split(':')[0]}"
                                f"   then harness pairs apply …  (or --decline \"why\")")
                    if kind == "task":
                        return (f"  block '{label}' was answered {human_age(age)} ago "
                                f"and has produced no task:{nl}    harness blocked "
                                f"--decided")
                    # Never the second branch by default. An unknown kind that
                    # described itself as a block would send the reader to a
                    # command that cannot find it.
                    return (f"  '{label}' ({kind}) has been waiting "
                            f"{human_age(age)}:{nl}    harness status")
                lines = [_owed(kind, label, age)
                         for kind, ident, label, age in mine[:4]]
                print(json.dumps({"hookSpecificOutput": {
                    "hookEventName": "Stop", "decision": "block", "reason":
                    f"You are about to stop with these still yours:{nl}{nl}"
                    + f"{nl}{nl}".join(lines) + f"{nl}{nl}"
                    + "Nobody below you may do either, and you are the node that is "
                      "never recycled — so nothing will re-orient you into noticing. "
                      "Being told is not being tasked: an answered block is finished "
                      "when it has produced a brief or an explicit `none`."}}))
            return
        rows = unreported(ctx, node)
        if not rows:
            return
        lead = ctx.tree["nodes"].get(node, {}).get("parent") or "your lead"
        task, moved, dirty = rows[0]
        why = ("the worktree has uncommitted changes" if dirty
               else "HEAD has moved since you opened the mark")
        nl = chr(10)
        step = (f"Commit it, then present it:{nl}  harness mark {task} --done"
                if dirty else f"Present it:{nl}  harness mark {task} --done")
        reason = (
            f"You are about to stop with work on '{task}' that {lead} has not "
            f"been told about: {why}, and the task record still says it was never "
            f"presented.{nl}{nl}{step}{nl}{nl}"
            f"Presenting is what ends the task and frees the node; {lead} signs it "
            f"off and starts the next one. If you cannot finish it, say so on the "
            f"record: harness blocked for something you need, or harness brief "
            f"{task} --suggest if the plan is wrong. Do not stop silently, because "
            f"nothing else in the tree can see that you are done.")
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "Stop", "decision": "block", "reason": reason}}))
    except (Exception, SystemExit):
        return


def lead_address(ctx, parent):
    """The parent's live session, as (name, session_id) -- or (None, None).

    Presenting writes a record; it does not reach anybody. The parent learns of
    it only when it next takes a turn, and the debt is created AFTER the turn it
    would have been told on. Measured on a live tree 2026-09-08: dev stopped at
    11:21:10, its children presented at 11:25:47 and 11:44:14, and so neither
    the Stop hook nor the orientation hook could fire for either one -- there
    was no turn left to fire on. Both sat unsigned until the operator prompted
    rank 0 by hand, twenty-eight minutes later. That was the third time in one
    evening, and every time it was read as a lead that forgot.

    It is not forgetting. The ageing thresholds guarantee it: a presentation is
    only owed after STALLED_SIGNOFF, by which point the lead has been standing
    still for at least that long, so the condition becomes true strictly after
    the last moment anything could have tested it.

    Nothing in a shell can wake a stopped session -- checked against the CLI on
    2026-09-08, `claude` offers attach, logs, stop, rm and respawn, and not one
    of them delivers a prompt. The only transport into a running session is a
    message from another session, which means it must be sent by somebody who is
    mid-turn. The child that has just presented IS mid-turn. That is the whole
    reason this is said here and not anywhere upward of here.
    """
    if not parent:
        return None, None
    try:
        h = json.loads(ctx.lock_path(parent).read_text())
    except Exception:
        return None, None                  # no claim: nothing is holding it
    sid, name = h.get("session_id"), h.get("name")
    if not sid:
        return None, None
    try:
        live = {r.get("sessionId"): r for r in live_rows(agents_json())}
    except Exception:
        # An unreadable roster is UNKNOWN, not empty -- the same call
        # claim_conflict makes, and for the same reason. Naming a lead that may
        # already be gone costs one wasted message; staying silent costs the
        # sign-off this exists to deliver.
        return name, sid
    row = live.get(sid)
    if not row:
        return None, None                  # claimed by a session that has exited
    return (row.get("name") or name), sid


def claim_conflict(ctx, node):
    """Is this node's claim held by a DIFFERENT live session?

    Nothing required a claim before writing to the ledger. Measured on the
    sandbox 2026-09-08: a whole lifecycle -- briefs, marks, presentation,
    review, integration, sign-off -- ran through with `harness status` reporting
    `no nodes claimed` the entire time. The lock is the only mutual-exclusion
    primitive in the design and no write path consulted it.

    The rule implemented here is deliberately narrower than "you must hold the
    claim", and the difference is where the hazard actually is. An UNCLAIMED
    node is the operator working by hand, or a scripted walkthrough, or a
    session between claims -- awkward, not dangerous, and refusing it would
    break every by-hand path including this project's own test harness. A node
    claimed by SOMEBODY ELSE WHO IS STILL RUNNING is the real thing: two
    sessions writing one node's ledger, which is I1's failure reached through
    the records instead of through the worktree.

    So: refuse a live foreign holder, warn on unclaimed, and say which it is.
    Absence of a claim is a gap in the record; presence of the wrong one is a
    collision.
    """
    lock = ctx.lock_path(node)
    if not lock.exists():
        return None, "unclaimed"
    try:
        h = json.loads(lock.read_text())
    except Exception:
        return None, "unreadable"
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    if h.get("session_id") == sid:
        return None, "mine"
    alive = holder_alive(h)
    if not h.get("pid"):
        try:
            alive = holder_alive(h, agents_json())
        except Exception:
            # Unknown, not empty: warn and let it through. `integrate`, which
            # writes into somebody else's worktree, makes the opposite call.
            return None, "roster-unknown"
    if alive:
        return h, "held"
    return None, "stale"


def cmd_mark(a):
    """Record the token position when a T1 is accepted, so the actual at T10 is a
    subtraction rather than an apportionment.

    `--close` is T10's record, and it exists because T10 had none. "Released"
    was a claim in a message rather than a fact in a store, so nothing could
    distinguish a node still working from a node finished and still standing
    there — and an idle session with a live counterparty fills the gap with
    elective correspondence. Closing is always permitted; the MEASUREMENT may
    not be, and the two are recorded separately.
    """
    ctx = Ctx(); ctx.require_enrolled()
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    if not sid:
        die(CONTRACT, "CLAUDE_CODE_SESSION_ID is unset — cannot mark (C1)")
    node, _ = ctx.node()
    f = ctx.state_file("marks", a.task, ".json")
    f.parent.mkdir(parents=True, exist_ok=True)

    if a.done:
        # The MEMBER presents, and the measurement is taken here rather than at
        # sign-off. Its own transcript is the only place the subtraction is real,
        # and the lead closing later is by definition a different session (I10).
        if not f.exists():
            die(REFUSED, f"no mark for '{a.task}' — nothing to present")
        rec = json.loads(f.read_text())
        if rec.get("_closed_at"):
            die(REFUSED, f"'{a.task}' is already closed")
        if rec.get("_node") and rec["_node"] != node:
            die(REFUSED, f"'{a.task}' belongs to '{rec['_node']}', not '{node}'")
        # "X must be an ancestor" checked here, at presenting, not at the first
        # commit: required early, it met a lead holding its tree still for a
        # check and stopped two lanes in an hour (obs 68, 70).
        _miss = [x for x in (load_brief(ctx, a.task)[1] or {}).get("requires") or []
                 if git("merge-base", "--is-ancestor", x["sha"], "HEAD", cwd=ctx.worktree)[0]]
        if _miss:
            die(REFUSED, f"'{a.task}' requires "
                         + ", ".join(f"{x['ref']} ({x['sha'][:8]})" for x in _miss)
                         + " in HEAD before presenting.\n           Catch up "
                           "(harness behind), then present again.")
        # Presenting must not be blocked by an unmeasurable cost either. A
        # member that cannot present is a member whose finished work is
        # invisible to everyone above it, which is a strictly worse outcome
        # than a null in the cost column.
        now, _nospend = read_spend_or_none(sid)
        if now is None:
            now = {k: 0 for k in TOKEN_KINDS}
            now["_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        rec["_presented_at"] = now["_at"]
        rec["_presented_by"] = f"{node} (session {sid[:8]})"
        rec["_presented_sha"] = git("rev-parse", "HEAD", cwd=ctx.worktree)[1].strip()
        nxt, coupled = next_after(ctx, node, a.task)
        if _nospend or rec.get("_unmeasured"):
            rec["_delta"] = None
            rec["_delta_unavailable"] = _nospend or rec.get("_unmeasured")
            cost = "cost not measurable"
        elif rec.get("_session") == sid:
            rec["_delta"] = {k: now[k] - rec.get(k, 0) for k in TOKEN_KINDS}
            cost = spend_line(rec["_delta"])
        else:
            rec["_delta"] = None
            rec["_delta_unavailable"] = (f"opened in session {str(rec.get('_session'))[:8]}, "
                                         f"presented in {sid[:8]} — not subtractable (I10)")
            cost = "cost not measurable across a recycle"
        if a.note:
            rec.setdefault("_comments", []).append(
                {"at": rec["_presented_at"], "by": rec["_presented_by"],
                 "text": a.note})
        f.write_text(json.dumps(rec, indent=2) + "\n")
        # Presenting IS finishing with the node. The claim is on the worktree,
        # and a presented member has nothing left to write there, so holding it
        # only stops the lead refilling the node. It was a separate command, and
        # it was the one that got skipped.
        lock = ctx.lock_path(node)
        released = False
        try:
            if lock.exists() and json.loads(lock.read_text()).get("session_id") == sid:
                lock.unlink(); released = True
        except Exception:
            pass
        parent = ctx.tree["nodes"].get(node, {}).get("parent")
        if rec.get("_model"):
            print(f"ran as {rec['_model']}, effort {rec.get('_effort')}")
        if rec.get("_band") and rec.get("_delta"):
            u, dn, _ = split(rec["_delta"])
            actual = band_of(u + dn)
            order = list(BANDS) + ["XL"]
            verdict = ("in band" if actual == rec["_band"]
                       else "OVER band" if order.index(actual) > order.index(rec["_band"])
                       else "under band")
            print(f"band: estimated {rec['_band']}, measured {actual} "
                  f"({tok(u + dn)} new) — {verdict}")
            if verdict == "OVER band":
                print(f"  Say so in your report. A band that was wrong is the only "
                      f"thing that improves\n  the next estimate, and it is your "
                      f"lead's estimate that was wrong, not your work.")
        # I5, at the one moment it decides something. A member presents; a lead
        # integrates. If nobody ran the checks, the lead is about to accept work
        # on a claim rather than on a result, which is what T4's gate exists to
        # refuse in the other direction.
        _sha = git("rev-parse", "HEAD", cwd=ctx.worktree)[1].strip()
        _rep = read_check_report(ctx, node, _sha)
        if _rep is None:
            print(f"  NOT CHECKED at {_sha[:8]} — nothing has run the check set against "
                  f"this commit.\n  Your lead will see that too:  harness check")
        elif _rep.get("baseline") and not _rep.get("new"):
            print(f"  checks at {_sha[:8]}: no new failures against baseline "
                  f"{_rep['baseline'][:8]}")
        elif _rep.get("baseline"):
            print(f"  CHECKS at {_sha[:8]}: {_rep['new']} NEW failure(s) against the "
                  f"baseline. Say so in your report.")
        elif not _rep.get("passed"):
            print(f"  CHECKS FAILED at {_sha[:8]} — {_rep.get('failed')} of "
                  f"{len(_rep.get('checks') or [])}. Presenting anyway is a choice;\n"
                  f"  say so in your report rather than leaving it to be discovered.")
        else:
            print(f"  checks passed at {_sha[:8]} "
                  f"({len(_rep.get('checks') or [])}/{len(_rep.get('checks') or [])})"
                  + ("   [worktree was dirty when they ran]" if _rep.get("dirty") else ""))
        print(f"presented {a.task}  {cost}"
              + ("   node released" if released else ""))
        print(f"  It is NOT closed. {parent or 'your lead'} signs it off: "
              f"harness mark {a.task} --close")
        print(f"  You cannot close your own work — you cannot check it either (T4).")
        # Nothing above this line reaches anybody. See lead_address: the record
        # is inert until the lead takes a turn, and the lead has no reason to
        # take one. So the last act of presenting is to say so, out loud, to a
        # session that is running right now.
        _lead, _lsid = lead_address(ctx, parent)
        if _lead:
            print(f"\n  NOT DONE YET — tell {parent}. It is running as '{_lead}'.")
            print(f"  Send this before you stop, in this turn:")
            print(f"    SendMessage(to: \"{_lead}\", message: \"{node}: '{a.task}' is "
                  f"presented at {rec['_presented_sha'][:8]} and waiting on your "
                  f"sign-off — harness mark {a.task} --close\")")
            print(f"  The record alone does not reach it. It is read when {parent} next")
            print(f"  takes a turn, and presenting gives it no reason to take one — which")
            print(f"  is exactly how finished work sits invisible for half an hour.")
        elif parent:
            print(f"\n  {parent} is not running, so there is nobody to tell. It is on the")
            print(f"  record:  harness status")
        # What happens to this session next, said here rather than left to be
        # worked out. A member that has presented and does not know whether it is
        # continuing will fill the gap, and what it fills it with is a question.
        if nxt and coupled:
            print(f"\nnext: '{nxt['task']}' is coupled to this one — you carry on in "
                  f"this session.")
            print(f"  {nxt.get('coupled_why') or ''}")
            print(f"  harness brief {nxt['task']}    then    harness mark {nxt['task']}")
        elif nxt:
            print(f"\nnext: '{nxt['task']}' is queued for you and is NOT yours to "
                  f"start.")
            print(f"  {parent or 'your lead'} recycles this node first (R13). Do not "
                  f"open it, and do not\n  ask whether to.")
        if not (nxt and coupled):
            print(f"\nYou are done. Stop here — do not wait for the sign-off, do not "
                  f"poll for it,\nand do not start anything else. "
                  f"{parent or 'Your lead'} signs off and replaces you.")
        return

    # Work that stopped and finished nothing. There were two verbs and both lie
    # about this: --done says it is finished and records a cost, --close says
    # somebody signed it off. A mark opened by a session that has since died is
    # the common shape — it survives recycles, and every fresh session's
    # orientation names it as the work in front of them. The harness could
    # already SEE it, and said so in passing: "closing work nobody said was
    # finished" is this exact condition, detected at the right moment and then
    # used for nothing.
    if a.abandon is not None:
        if not f.exists():
            die(REFUSED, f"no mark for '{a.task}' — nothing to abandon")
        if not a.abandon.strip():
            die(REFUSED, "say why it stopped. An abandoned task with no reason is "
                         "indistinguishable\n           from one nobody got to, and "
                         "the next session inherits the same silence.")
        rec = json.loads(f.read_text())
        if rec.get("_closed_at"):
            die(REFUSED, f"'{a.task}' is already closed")
        owner = rec.get("_node") or node
        if a.requeue_after and tkey(a.requeue_after) not in {
                tkey(b["task"]) for b in queue(ctx, owner)}:
            die(REFUSED, f"'{a.requeue_after}' is not queued for '{owner}' — "
                         f"name a task in `harness queue {owner}`")
        rec["_abandoned_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        rec["_abandoned_by"] = f"{node} (session {sid[:8]})" if sid else "operator"
        rec["_abandoned_why"] = a.abandon
        rec["_closed_at"] = rec["_abandoned_at"]
        rec["_closed_by"] = rec["_abandoned_by"]
        f.write_text(json.dumps(rec, indent=2) + "\n")
        print(f"abandoned {a.task} on {owner}: {a.abandon}")
        if a.requeue_after:
            requeue_after(ctx, f, owner, a.task, a.requeue_after, f"{node}", a.abandon)
            return
        print(f"  It is off the board and recorded as UNFINISHED, not signed off.")
        print(f"  It does NOT return to the queue — parking it was deliberate. The "
              f"brief is\n  untouched and still readable; if the work is still "
              f"wanted, its lead rewrites it\n  or `harness mark {a.task} --force` "
              f"opens it again from here.")
        return

    if a.close:
        _held = close_waits(ctx, load_brief(ctx, a.task)[1])
        if _held and not a.force:
            die(REFUSED, f"'{a.task}' closes only after: {'; '.join(_held)}\n"
                         f"           Set by {(load_brief(ctx, a.task)[1] or {}).get('close_after_by')}. "
                         f"--force overrides a recorded condition.")
        if _held:
            print(f"--force: closing '{a.task}' against its recorded condition: {'; '.join(_held)}")
        # A segment discharged by splitting it has no mark and never will —
        # nobody opened one, because nobody executed it. That made it
        # uncloseable, so it stayed on the board forever looking like work not
        # started. Closing it is bookkeeping on a segment whose parts are all
        # signed off, and the record is written here so there is still exactly
        # one place a finished task lives.
        if not f.exists():
            db = load_brief(ctx, a.task)[1]
            deleg = next((x for x in delegated(ctx, (db or {}).get("node") or node)
                          if tkey(x["key"]) == tkey(a.task)), None)
            if deleg is None:
                die(REFUSED, f"no mark for '{a.task}' — nothing to close")
            if not deleg["ready"] and not a.force and deleg.get("uncovered") and \
                    all(r["state"] in ("closed", "superseded") for r in deleg["children"]):
                die(REFUSED,
                    f"'{a.task}': every part is settled, but no part covers clause(s) "
                    f"{', '.join(map(str, deleg['uncovered']))} of its checks.\n"
                    f"           Brief them (--from {a.task} --covers N), or --force if "
                    f"the work is done some other way.")
            if not deleg["ready"] and not a.force:
                open_kids = [r for r in deleg["children"]
                             if r["state"] not in ("closed", "superseded")]
                die(REFUSED,
                    f"'{a.task}' was split into {len(deleg['children'])} task(s) and "
                    f"{len(open_kids)} {'is' if len(open_kids) == 1 else 'are'} not "
                    f"closed yet:\n"
                    + "".join(f"           {r['task']} ({r['node']}) — {r['state']}\n"
                              for r in open_kids)
                    + f"           A segment is finished when its parts are. Close "
                      f"those first, or --force.")
            f.parent.mkdir(parents=True, exist_ok=True)
            f.write_text(json.dumps(
                {"_node": (db or {}).get("node") or node,
                 "_task": a.task,
                 "_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                 "_delegated": [r["task"] for r in deleg["children"]],
                 "_note": (db or {}).get("task") or a.task}, indent=2) + "\n")
            # What the close ASSERTS, printed beside what discharged it. The
            # parts closing proves the parts were done; it does not prove they
            # cover the segment, and the lead chose the split — so a segment
            # broken into parts that miss a third of it closes green. Nothing
            # can check that but a person, and a person cannot check it against
            # a tick. Put the text and the parts on one screen and the gap, if
            # there is one, is visible at the moment it still costs nothing.
            print(f"'{a.task}' was delegated, not executed. You are asserting that "
                  f"these {len(deleg['children'])} part(s) cover it:\n")
            for line in (db or {}).get("text", "").strip().splitlines()[:12] or ["(no text)"]:
                print(f"      {line}")
            print()
            for r in deleg["children"]:
                mark = "✓" if r["state"] == "closed" else "—"
                note = "" if r["state"] == "closed" else f"  ({r['state']})"
                print(f"      {mark} {r['task']:<24} {r['node']}{note}")
            print()
        rec = json.loads(f.read_text())
        if rec.get("_closed_at") and not a.force:
            die(REFUSED, f"'{a.task}' was closed at {rec['_closed_at']} — "
                         f"--force to close it again")
        # Sign-off belongs to the lead, on the same rule as the brief: the node
        # above sets the task and the node above says it is finished. A member
        # closing its own is a member marking its own homework, and T4 already
        # says it cannot check its own work.
        owner = rec.get("_node") or node
        parent = ctx.tree["nodes"].get(owner, {}).get("parent")
        own_root = (owner == node and ctx.rank(node) == 0)
        # A lead may close its OWN delegated segment. "Nobody closes their own"
        # is there because you cannot check your own work — and here the lead
        # did none: it split the segment and signed off each part under T4,
        # which is the check. Requiring its own lead to close the wrapper would
        # ask a node to certify work it never saw.
        own_delegated = (owner == node and rec.get("_delegated"))
        if parent != node and not own_root and not own_delegated and not a.force:
            die(REFUSED,
                f"'{node}' does not sign off '{a.task}', which belongs to '{owner}'.\n"
                + (f"           Its lead is '{parent}'.\n" if parent else "")
                + f"           Present it instead:  harness mark {a.task} --done\n"
                  f"           Rank 0 closes its own; nobody else closes their own.")
        if not rec.get("_presented_at") and not rec.get("_delegated"):
            print(f"note: '{a.task}' was never presented — closing work nobody said "
                  f"was finished")
        rec["_closed_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        rec["_closed_by"] = f"{node} (session {sid[:8]})" if sid else f"{node} (operator)"
        rec["_closed_sha"] = git("rev-parse", "HEAD", cwd=ctx.worktree)[1].strip()
        d = rec.get("_delta")
        cost = spend_line(d) if d else "not measured at presentation"
        f.write_text(json.dumps(rec, indent=2) + "\n")
        print(f"signed off {a.task} for {owner} at {rec['_closed_at']}  {cost}")
        still = sorted(t for t, r in open_marks(ctx).items() if r.get("_node") == owner)
        if still:
            print(f"  {owner} still has {len(still)} open task(s): {', '.join(still)}")
            return
        # The boundary between two tasks is where a member is either replaced or
        # deliberately kept. Leaving that to be remembered is how a session ends
        # up doing four tasks on one accumulating context, which is the thing
        # R13 exists to prevent — so the answer is computed and printed here,
        # with the command already written out.
        # Closing a segment you SPLIT is bookkeeping, not the end of a stint of
        # work. The session that ticks it off did none of it — its children did,
        # and it signed each of them off as they came back — so there is no
        # accumulated context to be rid of. R13 replaces a session that has been
        # working; recycling a lead because it filed a wrapper would throw away
        # the view that made it a lead.
        if rec.get("_delegated"):
            still = [x for x in delegated(ctx, owner) if not x["closed_at"]]
            if still:
                print(f"  {owner} has {len(still)} more segment(s) out with its "
                      f"children — harness queue {owner}")
            return
        # What this close releases elsewhere (obs 59). Named, not acted on: that
        # node's own lead recycles it, and the idle nag catches a missed one.
        for rb in all_briefs(ctx).values():
            if (any(tkey(y) == tkey(a.task) for y in rb.get("after") or [])
                    and not waits_on(ctx, rb) and rb.get("node") != owner):
                print(f"  releases {rb['task']} ({rb.get('node')}) — "
                      f"harness recycle {rb.get('node')}")
        nxt, coupled = next_after(ctx, owner, a.task)
        if nxt and coupled:
            print(f"  '{nxt['task']}' is COUPLED to this one — the same session "
                  f"carries on:")
            print(f"    {nxt.get('coupled_why') or '(no reason recorded)'}")
            print(f"  It opens the next mark itself. Do not recycle {owner}.")
        elif nxt:
            # The cycle continues by itself. Leaving the recycle to be remembered
            # is what stranded a finished hand-off: the member had stopped, the
            # next task was queued, and the only thing between them was a command
            # nobody ran. `recycle` still applies its own guards — a dirty
            # worktree or an open unpresented mark refuses here exactly as it
            # would have on the command line.
            print(f"  next for {owner}: {nxt['task']} — recycling {owner} onto it "
                  f"(R13: a fresh\n  session costs less than the errors the old one "
                  f"accumulated)")
            if a.no_recycle:
                print(f"    --no-recycle: run it yourself when ready — "
                      f"harness recycle {owner}")
            else:
                res = subprocess.run([sys.executable, str(Path(__file__).resolve()),
                                      "recycle", owner],
                                     cwd=ctx.worktree, capture_output=True, text=True)
                for line in (res.stdout or res.stderr).splitlines():
                    print(f"    {line}")
                if res.returncode:
                    print(f"    recycle refused — {owner} keeps its session. "
                          f"Clear it and run: harness recycle {owner}")
        else:
            _w = [b for b in queue(ctx, owner) if not b.get("coupled_to") and waits_on(ctx, b)]
            if _w:
                print(f"  next for {owner}: {_w[0]['task']} waits — {waits_on(ctx, _w[0])[0]}. "
                      f"Not recycling; that close releases it.")
            else:
                print(f"  {owner} has nothing queued. Brief it again, or recycle it "
                      f"idle:  harness recycle {owner}")
        return

    # T1 is a gate, not a convention. A task opened without a brief is a task
    # whose scope will arrive in pieces, and the same information delivered
    # piecemeal costs 39% against delivering it at once — with the degradation
    # appearing at TWO pieces, so the first follow-up detail is already the
    # failure. There is no --force: the remedy is one command, and it is the
    # command that makes the work go better.
    _, b = load_brief(ctx, a.task)
    if b is None:
        parent = ctx.tree["nodes"].get(node, {}).get("parent")
        own = ctx.rank(node) == 0
        die(REFUSED,
            f"'{a.task}' has no brief, so it cannot be opened on '{node}'.\n"
            + (f"           Write it first:  harness brief {a.task} --for {node} "
               f"--write \"...\"\n" if own else
               f"           Ask '{parent}' for one:  harness brief {a.task} "
               f"--for {node} --write \"...\"\n")
            + f"           Scope, the approach already decided, the check set, the "
              f"seams, what done\n           means — all of it at once. Delivered in "
              f"pieces instead it costs 39%,\n           and the penalty lands at the "
              f"second piece.")
    if b.get("node") != node:
        die(REFUSED, f"'{a.task}' is briefed for '{b.get('node')}', not '{node}'. "
                     f"A task belongs to one node.")

    if b is not None and superseded(b) and not a.force:
        die(REFUSED,
            f"'{a.task}' was superseded at {b['superseded_at'][:19]} by "
            f"{b.get('superseded_by')}:\n           {b.get('superseded_why')}"
            + (f"\n           Replaced by: {b['superseded_for']} "
               f"({task_state(ctx, b['superseded_for'])})"
               if b.get("superseded_for") else "")
            + f"\n\n           If that is wrong, it is your lead's to reinstate, "
              f"not yours to override.")

    held = [x for x in unreported(ctx, node)
            if tkey(x[0]) != tkey(a.task)] if not a.force else []
    if held:
        t, moved, dirty = held[0]
        nl = chr(10)
        die(REFUSED,
            f"'{t}' is open on this node, has work in it, and was never presented."
            f"{nl}           Finish that first: "
            + ("commit, then " if dirty else "")
            + f"harness mark {t} --done{nl}"
              f"           Opening a second task would leave the first invisible "
              f"to everyone above you.")
    if awaiting(b):
        die(REFUSED,
            f"'{a.task}' is not approved. It was written from something noticed rather "
            f"than\n           asked for, and the operator has not said it is worth a "
            f"session yet.\n           Rank 0 approves it: harness brief {a.task} --approve. "
            f"Carry on with what is queued.")
    _after = [r for r in waits_on(ctx, b) if r.startswith("after ")]
    if _after:
        die(REFUSED, f"'{a.task}' waits: {'; '.join(_after)}.\n           Stop and say "
                     f"so; it opens when that is signed off. A lead that wants it\n"
                     f"           now re-briefs it with --after none.")
    _until = [r for r in waits_on(ctx, b) if r.startswith("until ")]
    if _until:
        die(REFUSED, f"'{a.task}' waits {_until[0]}: it may not start before then.\n"
                     f"           A lead that wants it now: harness brief {a.task} "
                     f"--not-before none")
    if ((b.get("approval") or {}).get("state")) == "declined":
        die(REFUSED, f"'{a.task}' was declined by the operator: "
                     f"{(b['approval'].get('why'))}")
    # I1, applied to the ledger rather than to the worktree.
    _holder, _cl = claim_conflict(ctx, node)
    if _cl == "held":
        die(REFUSED,
            f"'{node}' is claimed by {_holder.get('name') or '?'} "
            f"[{str(_holder.get('session_id'))[:8]}], which is still running.\n"
            f"           Two sessions writing one node's ledger is I1 reached through "
            f"the\n           records instead of the worktree, and it is the failure "
            f"that leaves no\n           artefact. Claim it, or stop the holder: "
            f"harness stop {node}")
    tot, _nospend = read_spend_or_none(sid)
    if tot is None:
        # A position with no baseline is still a position. The delta is what is
        # lost, and it is recorded as lost rather than guessed.
        tot = {"input": 0, "cache_write": 0, "cache_read": 0, "output": 0,
               "_records": 0, "_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
               "_session": sid, "_unmeasured": _nospend}
    if f.exists() and not a.force:
        die(REFUSED, f"{a.task} is already marked at {json.loads(f.read_text()).get('_at')} "
                     f"— use --force to re-mark, which discards the earlier position")
    # The estimate is the lead's and it arrives on the brief, which is where the
    # lead made it. Entering it here was the defect: it put a lead's refusal in
    # front of a member, who may not split the task and can dissolve the
    # refusal by typing a smaller letter.
    if b.get("band"):
        tot["_band"] = b["band"]
        tot["_band_source"] = "brief"
    if a.band:
        band = a.band.upper()
        if band == "XL":
            die(REFUSED,
                "XL is a refusal, not a size (I10), and it is not yours to record.\n"
                "           A task above 300k new tokens is a decomposition that has "
                "not happened\n           yet, and the split is your lead's: say so, "
                "and it rewrites the brief.")
        if band not in BANDS:
            die(REFUSED, f"band must be one of {', '.join(BANDS)} "
                         f"({', '.join(f'{k} < {tok(v[1])}' for k, v in BANDS.items())})")
        # An override, and recorded as one. A member that disagrees with its
        # lead's estimate is information — it is the earliest possible signal
        # that a brief was mis-sized — and it is worth nothing if it silently
        # replaces the estimate it disagrees with. Both numbers stay.
        if tot.get("_band") and tot["_band"] != band:
            tot["_band_brief"] = tot["_band"]
        tot["_band"] = band
        tot["_band_source"] = "member"
    # Which model actually ran this. Without it a per-node model change produces
    # two numbers nobody can attribute, and the comparison that would settle
    # whether a cheaper member causes rework cannot be made at all.
    tot["_model"], tot["_effort"] = assignment_for(ctx, node)
    tot["_task"] = a.task
    tot["_note"] = a.note or ""
    tot["_node"] = node
    tot["_branch"] = ctx.branch
    tot["_sha"] = git("rev-parse", "HEAD", cwd=ctx.worktree)[1].strip()
    f.write_text(json.dumps(tot, indent=2) + "\n")
    if _cl in ("unclaimed", "stale"):
        print(f"note     '{node}' is {_cl} — this task record has no session holding "
              f"the node.\n         Not refused: by-hand and scripted work is "
              f"legitimate. But `status` will\n         show a task with no holder, and "
              f"nothing will stop a second session\n         opening one beside it: "
              f"harness claim {node}")
    print(f"marked {a.task} on {node} at {tot['_at']}  "
          f"({tot['_records']} records, {spend_line(tot)} so far)")
    if tot.get("_unmeasured"):
        print(f"note     {tot['_unmeasured']}. The task is open and its POSITION is "
              f"recorded;\n         only the cost baseline is missing, so --done will "
              f"report a null rather\n         than a number. Opening a task is not "
              f"blocked by an unmeasurable cost.")
    if tot.get("_band"):
        lo, hi = BANDS[tot["_band"]]
        src = {"brief": " (your lead's estimate)",
               "member": " (yours, overriding the brief)"}.get(tot.get("_band_source"), "")
        print(f"  band {tot['_band']}{src}: expected under {tok(hi)} new tokens "
              f"(up + down, resent not counted)")
        if tot.get("_band_brief"):
            print(f"  the brief said {tot['_band_brief']} — both are kept, and --done "
                  f"measures against yours")
    elif not a.band:
        print(f"  no band on this brief — the estimate is your lead's to make (I10): "
              f"harness brief {a.task} --band S|M|L")
    print(f"  brief revision {b.get('revision')} by {b.get('written_by')} "
          f"— read it: harness brief {a.task}")


def load_checks(ctx):
    """The check set, with `blindSpot` enforced as the required field I5 says it is.

    Nothing read this block until now. `manifest.json` declared checks, briefs
    said "done means green", and no command ran them or recorded that anyone
    had — so a lead integrated on a member's word that they passed, which is
    the self-verification T4's gate exists to refuse, arriving through the
    other door.

    A missing `blindSpot` is refused rather than defaulted. A check that does
    not say what it cannot see gets read as proof of more than it is, and the
    whole point of carrying the field into the report is that the reader meets
    it at the moment they are deciding.
    """
    man = ctx.repo / ".harness" / "manifest.json"
    if not man.exists():
        die(NOT_ENROLLED, f"no manifest at {man}")
    try:
        checks = json.loads(man.read_text()).get("checks") or []
    except Exception as e:
        die(CONTRACT, f"manifest is unreadable ({e})")
    if not checks:
        die(REFUSED,
            "the check set is empty, and an empty suite passes for the wrong reason.\n"
            "           Declare at least one in .harness/manifest.json, with what it "
            "cannot see.")
    for i, c in enumerate(checks):
        for k in ("name", "command", "blindSpot"):
            if not str(c.get(k) or "").strip():
                die(REFUSED,
                    f"check #{i + 1} has no '{k}'. All three are required (I5).\n"
                    f"           `blindSpot` especially: a check that does not say what "
                    f"it cannot\n           see is read as proof of more than it is.")
    return checks


def check_report_path(ctx, node, sha):
    return ctx.state_file("checks", f"{node}-{sha}", ".json")


def check_running_path(ctx, node):
    """Present only while `check` runs on this node (obs 68)."""
    return ctx.state_file("checks", f"{node}.running", ".json")


def check_output_paths(ctx, node, arm):
    """Where an arm streams while it runs, overwritten each run (obs 69)."""
    return (ctx.state_file("checks", f"{node}-{arm}", ".out"),
            ctx.state_file("checks", f"{node}-{arm}", ".err"))


def clip(line, n=100):
    """A cut that says it is one (obs 69): a silent cut reads as the whole line."""
    return line if len(line) <= n else f"{line[:n]}…(+{len(line) - n} chars)"


def _tail(path, n=2000):
    try:
        with open(path, "rb") as fh:
            fh.seek(0, 2)
            fh.seek(max(0, fh.tell() - n))
            return fh.read().decode("utf-8", "replace")
    except OSError:
        return ""


def run_arm(command, cwd, limit, outf, errf, env=None):
    """One arm under `sh -c`, streamed to disk so a timeout keeps what it printed.

    `subprocess.run(timeout=)` threw the output away with the process, so an arm
    that ran twenty files and hung on the twenty-first reported nothing (obs 69).
    Its own process group, so a timeout kills the whole arm, not just `sh`.
    Returns (exit, stdout tail, stderr tail, timed_out)."""
    outf.parent.mkdir(parents=True, exist_ok=True)
    try:
        with open(outf, "wb") as o, open(errf, "wb") as e:
            pr = subprocess.Popen(["sh", "-c", command], cwd=str(cwd), stdout=o, stderr=e,
                                  stdin=subprocess.DEVNULL, start_new_session=True, env=env)
            _ARM[0] = pr.pid
            if _ARM_HOOK[0]:
                _ARM_HOOK[0](pr.pid)
            try:
                code = pr.wait(timeout=limit)
                timed_out = False
            except subprocess.TimeoutExpired:
                # The whole tree, not the group: a runner that setsid's its
                # children leaves them out of the group (obs 80).
                kill_tree(pr.pid)
                pr.wait()
                code, timed_out = 124, True
            finally:
                _ARM[0] = None
    except Exception as ex:
        return 125, "", str(ex), False
    return code, _tail(outf), _tail(errf), timed_out


_ARM = [None]          # the arm running now, for a signal handler to kill
_ARM_HOOK = [None]     # told each arm's pid as it starts (the queue records it on the job)
_CANCEL = [False]      # set by `harness test --cancel` on the running job


def proc_children():
    """{pid: [child pids]} and {pid: pgid}, read from /proc in one pass."""
    kids, pg = {}, {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            with open(f"/proc/{d}/stat") as fh:
                st = fh.read()
            f = st[st.rindex(")") + 2:].split()
            ppid, pgid = int(f[1]), int(f[2])
        except Exception:
            continue
        kids.setdefault(ppid, []).append(int(d))
        pg[int(d)] = pgid
    return kids, pg


def proc_tree(pid):
    """pid and every descendant, found by parent links while they are intact."""
    kids, _ = proc_children()
    out, todo = [], [pid]
    while todo:
        p = todo.pop()
        out.append(p)
        todo += kids.get(p, [])
    return out


def _pid_exists(pid):
    if not isinstance(pid, int) or pid <= 0:
        return False             # os.kill(0, …) is the caller's own process group
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except OSError:
        return True


def _proc_name(pid):
    try:
        with open(f"/proc/{pid}/cmdline") as fh:
            return fh.read().replace("\0", " ").strip()[:60] or str(pid)
    except OSError:
        return str(pid)


def kill_tree(pid, sig=9):
    """Kill a process and everything under it (obs 80: killing `check` left its
    arm's `sh`, killing `run.py` left the test file it had started). The tree is
    read first, then each process group and each pid is signalled, so a child
    that setsid'd out of the group dies too. Returns the pids signalled."""
    pids = proc_tree(pid)
    _, pg = proc_children()
    for g in {pg.get(p) for p in pids if pg.get(p) and pg.get(p) != os.getpgrp()}:
        try:
            os.killpg(g, sig)
        except OSError:
            pass
    for p in pids:
        try:
            os.kill(p, sig)
        except OSError:
            pass
    return pids


def read_check_report(ctx, node, sha):
    f = check_report_path(ctx, node, sha)
    if not f.exists():
        return None
    try:
        return json.loads(f.read_text())
    except Exception:
        return None


_FAILED_LINE = re.compile(r"^failed:\s*(.*)$", re.M)


def failed_files(out):
    """The files an arm says failed, from its last `failed: a.py(1) b.py(2)` line
    ('failed: none' is an empty list), or None when the arm prints no such line."""
    hits = _FAILED_LINE.findall(out or "")
    if not hits:
        return None
    toks = hits[-1].split()
    if toks in ([], ["none"]):
        return []
    return sorted({re.sub(r"\(\d+\)$", "", t) for t in toks})


def baseline_path(ctx):
    return ctx.state / "checks" / "baseline.json"


def load_baseline(ctx):
    try:
        return json.loads(baseline_path(ctx).read_text())
    except Exception:
        return None


def baseline_diff(rows, base):
    """Each arm against the baseline (obs 42): {arm: {new, gone, same, notrun}}.
    An arm without a file list compares as a whole; an arm missing from the
    baseline counts its failures as new."""
    out = {}
    for r in rows:
        b = (base.get("arms") or {}).get(r["name"]) or {"failed": False, "files": []}
        if r.get("timedOut") or r.get("exit") == 125 or r.get("held"):
            out[r["name"]] = {"new": [], "gone": [], "same": 0, "notrun": True}
            continue
        now, was = r.get("failedFiles"), b.get("files")
        failing = r.get("exit") != 0
        if now is None or was is None:
            new = ["(arm)"] if failing and not b.get("failed") else []
            gone = ["(arm)"] if b.get("failed") and not failing else []
            same = int(failing and bool(b.get("failed")))
        else:
            new, gone = sorted(set(now) - set(was)), sorted(set(was) - set(now))
            same = len(set(now) & set(was))
        out[r["name"]] = {"new": new, "gone": gone, "same": same, "notrun": False}
    return out


def baseline_line(d):
    """One line for an arm's diff, empty when there is nothing to say."""
    if d["notrun"]:
        return "vs baseline: NOT RUN"
    bits = ([f"new {', '.join(d['new'])}"] if d["new"] else []) + \
           ([f"gone {', '.join(d['gone'])}"] if d["gone"] else []) + \
           ([f"{d['same']} same"] if d["same"] else [])
    return "vs baseline: " + " · ".join(bits) if bits else ""


def baseline_summary(rep, base):
    """The verdict line for a report compared with the baseline."""
    diff = baseline_diff(rep.get("checks") or [], base)
    known = sum(d["same"] for d in diff.values())
    new = sum(len(d["new"]) + d["notrun"] for d in diff.values())
    if new:
        return f"{new} NEW failure(s) against baseline {str(base.get('sha'))[:8]}"
    return (f"no new failures against baseline {str(base.get('sha'))[:8]}"
            f" ({known} known)")


def set_baseline(ctx, node, why):
    """Record the baseline from the report already stored at HEAD."""
    if not ctx.children(node):
        die(REFUSED, "a leaf does not set the baseline — its lead or rank 0 does")
    if not (why or "").strip():
        die(REFUSED, 'say why: harness check --set-baseline --why "..."')
    sha = git("rev-parse", "HEAD", cwd=ctx.worktree)[1].strip()
    rep = read_check_report(ctx, node, sha)
    if rep is None:
        die(REFUSED, f"no check report at {sha[:8]} — run `harness check` first")
    old = load_baseline(ctx)
    base = {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "by": node, "node": node,
            "sha": sha, "why": why,
            "arms": {r["name"]: {"failed": r.get("exit") != 0,
                                 "files": r.get("failedFiles")}
                     for r in rep.get("checks") or []},
            "history": ((old or {}).pop("history", []) + [old]) if old else []}
    p = baseline_path(ctx)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(base, indent=2) + "\n")
    n = sum(len(v["files"] or []) or int(v["failed"]) for v in base["arms"].values())
    print(f"baseline set at {sha[:8]}: {n} known failure(s) across "
          f"{sum(v['failed'] for v in base['arms'].values())} arm(s)")


def run_arms(ctx, node, sha, cwd, checks, base, timeout, report, env=None, progress=None):
    """Every arm, in order, never stopping at a failure (I5). Prints as it goes;
    returns (rows, failed). `progress(i, arm)` is told before each arm."""
    holds = live_holds(ctx)
    rows, failed = [], 0
    for i, c in enumerate(checks):
        if _CANCEL[0]:
            print(f"  cancelled before {c['name']}")
            break
        limit = c.get("timeout") or timeout             # per-check ceiling (obs 24)
        outf, errf = check_output_paths(ctx, node, c["name"])
        c = dict(c, reads=check_reads(c, cwd, env))
        h = hold_catching(c, holds)
        if h:
            why = f"{h['why']} — {h['by']}" + (f", until {h['until']}" if h.get("until") else "")
            rows.append({"name": c["name"], "command": c["command"],
                         "blindSpot": c["blindSpot"], "exit": None, "held": why,
                         "seconds": 0, "timedOut": False, "failedFiles": None,
                         "stdout": "", "stderr": ""})
            print(f"  NOT RUN (held: {why})  {c['name']}")
            continue
        if progress:
            progress(i, c["name"])
        print(f"  …     {c['name']}")
        t0 = time.time()
        code, out, err, timed_out = run_arm(c["command"], cwd, limit, outf, errf, env)
        dur = time.time() - t0
        ok = code == 0
        failed += (not ok)
        last = next((x for x in reversed((out + "\n" + err).splitlines()) if x.strip()), "")
        if timed_out:
            err = (err + f"\ntimed out after {limit}s").lstrip("\n")
        rows.append({"name": c["name"], "command": c["command"],
                     "blindSpot": c["blindSpot"], "exit": code,
                     "seconds": round(dur, 2), "timedOut": timed_out,
                     "failedFiles": failed_files(out), "lastLine": last[-300:],
                     "stdout": out[-2000:], "stderr": err[-2000:]})
        verdict = "NOT RUN (timed out)" if timed_out else "PASS" if ok else "FAIL"
        print(f"  {verdict}  {c['name']:<18} {dur:5.1f}s of {limit}"
              + ("" if ok or timed_out else f"   exit {code}"))
        if timed_out and last:
            print(f"        last output: {clip(last)}")
        if not ok and not timed_out:
            lines = (err or out).strip().splitlines()
            if len(lines) > 6:
                print(f"        … {len(lines) - 6} earlier line(s) omitted")   # obs 34
            for line in lines[-6:]:
                print(f"        {clip(line)}")
        if not ok:
            ff = rows[-1]["failedFiles"]
            print(f"        report: {report}"
                  + (f"  ({len(ff)} failed file(s) listed)" if ff else "")
                  + f"\n        output: {outf}")
        if base and not ok:
            bl = baseline_line(baseline_diff(rows[-1:], base)[c["name"]])
            if bl:
                print(f"        {bl}")
        # The blind spot is printed beside the RESULT, not filed away in the
        # manifest, because the moment it matters is the moment somebody is
        # deciding what a pass means.
        print(f"        cannot see: {c['blindSpot']}")
    return rows, failed


def check_reads(c, cwd, env=None):
    """A check's `reads`, widened by its `reads_from` command when it has one
    (obs 79): the project's own list of what the arm opens, not a typed copy."""
    reads = list(c.get("reads") or [])
    cmd = c.get("reads_from")
    if cmd:
        try:
            r = subprocess.run(["sh", "-c", cmd], cwd=str(cwd), env=env, capture_output=True,
                               text=True, timeout=60)
            if r.returncode == 0:
                reads += [l.strip() for l in r.stdout.splitlines() if l.strip()]
            else:
                print(f"  reads_from failed for {c['name']} (exit {r.returncode}); "
                      f"using its typed reads")
        except Exception as e:
            print(f"  reads_from failed for {c['name']}: {e}; using its typed reads")
    return reads


def check_summary(rep, base, n):
    """The closing lines of a check, from its report."""
    nheld = rep.get("held") or 0
    out = [f"{n - (rep.get('failed') or 0) - nheld}/{n} passed"
           + (f", {nheld} held (not run — this report does not cover them)" if nheld else "")
           + f" — recorded against {rep['sha'][:8]}"]
    if base and rep.get("baseline"):
        out.append("  " + baseline_summary(rep, base))
    return out


def print_check_report(rep, base):
    """A finished report, arm by arm, as a check prints it while it runs."""
    for r in rep.get("checks") or []:
        if r.get("held"):
            print(f"  NOT RUN (held: {r['held']})  {r['name']}"); continue
        v = ("NOT RUN (timed out)" if r.get("timedOut") else
             "PASS" if r.get("exit") == 0 else "FAIL")
        print(f"  {v}  {r['name']:<18} {r.get('seconds', 0):5.1f}s"
              + ("" if r.get("exit") in (0, None) or r.get("timedOut") else f"   exit {r['exit']}"))
        if v == "FAIL":
            for line in (r.get("stderr") or r.get("stdout") or "").strip().splitlines()[-6:]:
                print(f"        {clip(line)}")
    for line in check_summary(rep, base, len(rep.get("checks") or [])):
        print(line)
    if rep.get("partial"):
        print(f"  partial: only {', '.join(rep.get('arms') or [])} ran; this is not the full set")


def make_check_report(node, sha, rows, failed, base, **extra):
    rep = dict({"node": node, "sha": sha, "dirty": False, "at": _now(),
                "passed": failed == 0 and not any(r.get("held") for r in rows),
                "failed": failed, "held": sum(1 for r in rows if r.get("held")),
                "checks": rows}, **extra)
    diff = baseline_diff(rows, base) if base else None
    if diff is not None:
        rep["baseline"] = base.get("sha")
        rep["new"] = sum(len(d["new"]) + d["notrun"] for d in diff.values())
    return rep


def check_exit(rep):
    """REFUSED on new failures against a baseline, or on any failure without one."""
    if rep.get("new") is not None:
        return REFUSED if rep["new"] else 0
    return REFUSED if rep.get("failed") else 0


def cmd_check(a):
    """I5: submit this commit's checks to the project's test queue.

    EVERY check runs, including after one fails, and the result is recorded
    against the exact commit. They run in a copy of the commit, one job at a time
    per project (obs 81): integration checks from the priority queue first, then
    lanes', each first in, first out. `--wait` blocks for the result; otherwise
    the requester's doorbell rings when it is in. The harness has no tests of its
    own: the checks are the project's commands, run as given (owner, 2026-10-06).

    NOTHING RUNS THIS IMPLICITLY. `manifest.json` is a document that travels to
    every node and `checks[].command` is executed by the queue, which the trust
    model names as one of three code-execution channels rank 0 holds over the
    tree. A job runs only when someone submits it.
    """
    ctx = Ctx(); ctx.require_enrolled()
    node, _ = ctx.node()
    if a.set_baseline:
        return set_baseline(ctx, node, a.why)
    try:
        sys.stdout.reconfigure(line_buffering=True)
    except Exception:
        pass
    if a.report:
        rc, sha, _ = git("rev-parse", a.report, cwd=ctx.worktree)
        rep = read_check_report(ctx, node, sha.strip()) or _read_json(shared_report_path(ctx, sha.strip()))
        if not rep:
            die(REFUSED, f"no check report for {a.report}")
        print_check_report(rep, load_baseline(ctx)); sys.exit(check_exit(rep))
    checks = load_checks(ctx)           # refuses an empty or malformed set now, not in the queue
    arms = None
    if a.arms:
        # The caller (its project) chooses the arms; the harness only runs them.
        arms = sorted({x.strip() for x in a.arms.split(",") if x.strip()})
        names = [c["name"] for c in checks]
        bad = [x for x in arms if x not in names]
        if bad:
            die(REFUSED, f"no arm {', '.join(bad)} in the manifest (arms: {', '.join(names)})")
    queue = ("priority" if a.priority else "normal" if a.normal else
             "priority" if role_of(ctx, node) in ("root", "lead") else "normal")
    sha = git("rev-parse", "HEAD", cwd=ctx.worktree)[1].strip()
    rc, dirt, _ = git("status", "--porcelain", "--untracked-files=no", cwd=ctx.worktree)
    if dirt.strip():
        die(REFUSED, f"{len(dirt.splitlines())} uncommitted change(s). The queue runs a copy of "
                     f"the commit, so commit first (a WIP commit is fine), then harness check.")
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    job, how = testq_submit(ctx, "check", sha, node, sid, timeout=a.timeout, arms=arms,
                            queue=queue, origin=str(ctx.worktree))
    print(f"{how} {job['id']} — {'check' if not arms else 'arms ' + ', '.join(arms)} of "
          f"{sha[:8]}, {job['queue']} queue" + testq_wait_phrase(ctx, job))
    if not a.wait:
        print("  Your doorbell rings with the result; end your turn, or carry on with "
              "something else.\n  `harness test` shows the queue; `--wait` would have blocked.")
        return
    rep = testq_wait(ctx, job["id"])
    if rep is None:
        die(REFUSED, f"{job['id']} ended without a report: harness test --log {job['id']}")
    print_check_report(rep, load_baseline(ctx))
    sys.exit(check_exit(rep))


# ── the test queue: one job at a time per project, in a copy of the commit ───
#
# Owner, 2026-10-05: "tests should be handled by a typical scheduler, not a
# session. Tests are submitted to the scheduler, so we're not trying to run
# multiple tests of the same things in different places all together. The test
# node doesn't need a session. It just takes the jobs, copies the worktree, runs
# the tests, reports and tears down, removing everything it built."
# Decisions: one run per project; lanes may still run a single test file
# directly; copies on the Linux disk; strict first in, first out.

TESTQ_IDLE = 120                # a runner with nothing queued exits after this
TESTQ_FREE_GB = 5               # the disk a job needs before it copies anything
RUNS_HOME = Path.home() / ".cache" / "harness" / "runs"


class ProjCtx:
    """Enough of Ctx for the runner, which stands in no node: the repo and its state."""

    def __init__(self, pdir, repo):
        self.state, self.repo = Path(pdir), Path(repo)
        self.slug = self.state.name
        self.worktree = self.repo

    def state_file(self, kind, name, ext):
        return self.state / kind / (re.sub(r"[^A-Za-z0-9]", "_", name) + ext)


def _read_json(f):
    try:
        return json.loads(Path(f).read_text())
    except Exception:
        return None


def shared_report_path(ctx, sha):
    return Path(ctx.state) / "checks" / f"{sha}.json"


def testq_dir(ctx):
    d = Path(ctx.state) / "testq"
    d.mkdir(parents=True, exist_ok=True)
    return d


def testq_jobs(ctx, states=None):
    """Jobs, oldest first, optionally only in `states`."""
    out = []
    for f in sorted(testq_dir(ctx).glob("*.json")):
        j = _read_json(f)
        if j and (states is None or j.get("state") in states):
            out.append(j)
    return sorted(out, key=lambda j: j.get("at") or "")


def testq_save(ctx, job):
    """Whole-file replace, keeping requesters who joined since `job` was read: a
    node joins a running job while the runner is saving its progress."""
    f = testq_dir(ctx) / f"{job['id']}.json"
    old = _read_json(f) or {}
    have = {r.get("node") for r in job.get("requested_by") or []}
    job["requested_by"] = (job.get("requested_by") or []) + [
        r for r in old.get("requested_by") or [] if r.get("node") not in have]
    if old.get("state") == "cancelled" and job.get("state") == "queued":
        job["state"] = "cancelled"
    _save(f, job)


def testq_ahead(ctx, job):
    """The jobs that run before this one, in run order (testq_order)."""
    order = testq_order(testq_jobs(ctx, ("running", "queued")))
    ids = [j["id"] for j in order]
    return order[:ids.index(job["id"])] if job["id"] in ids else order


def testq_describe(j):
    who = ", ".join(r.get("node") or "?" for r in j.get("requested_by") or [])
    what = ("check" if j.get("kind") == "check" and not j.get("arms") else
            f"arms {', '.join(j['arms'])}" if j.get("kind") == "check" else
            f"`{(j.get('command') or '')[:40]}`")
    if j.get("state") == "running":
        return (f"{who}'s {what}, running" + (f" arm {j.get('done_arms', 0) + 1}/{j.get('total')}"
                                              if j.get("total") else "")
                + f" since {(j.get('started') or '')[11:16]}")
    return f"{who}'s {what}, queued"


def testq_submit(ctx, kind, sha, node, sid, command=None, timeout=None, arms=None,
                 queue="normal", origin=None):
    """Queue a job, or join an identical one (same commit and arms) still queued
    or running: that is one run, not a guess about a result. A finished report is
    never reused; whether an old result still holds is the project's to say (obs
    83: its tests read data git doesn't hold). Returns (job, "queued" | "joined")."""
    req = {"node": node, "session": sid, "at": _now()}
    if kind == "check":
        for j in testq_jobs(ctx, ("queued", "running")):
            if j.get("kind") == "check" and j.get("sha") == sha and j.get("arms") == arms:
                if not any(r.get("node") == node for r in j["requested_by"]):
                    j["requested_by"].append(req)
                if queue == "priority" and j.get("queue") != "priority" and j["state"] == "queued":
                    j["queue"] = "priority"            # a lead's integration check joins it
                testq_save(ctx, j)
                return j, "joined"
    # Unique even for two submits in one second from one process (a collision
    # overwrote a queued job, 2026-10-06).
    job = {"id": f"{time.strftime('%Y%m%d-%H%M%S')}-{sha[:8]}-{os.urandom(3).hex()}",
           "kind": kind, "sha": sha, "command": command, "requested_by": [req],
           "state": "queued", "at": _now(), "timeout": timeout, "arms": arms,
           "queue": queue, "origin": origin}
    testq_save(ctx, job)
    testq_ensure_runner(ctx)
    return job, "queued"


def testq_order(jobs):
    """Run order: the running job, then priority (integration) jobs, then normal
    ones, each first in, first out (owner, 2026-10-06; obs 82)."""
    run = [j for j in jobs if j.get("state") == "running"]
    q = sorted((j for j in jobs if j.get("state") == "queued"),
               key=lambda j: (j.get("queue") != "priority", j.get("at") or ""))
    return run + q


def testq_duration(ctx, kind, arms):
    """The median seconds of the last five finished jobs like this one (same kind
    and arms, else same kind), or None."""
    done = [j for j in testq_jobs(ctx, ("done",)) if j.get("kind") == kind
            and _epoch(j.get("started")) and _epoch(j.get("finished"))]
    same = [j for j in done if j.get("arms") == arms] or done
    ds = sorted(_epoch(j["finished"]) - _epoch(j["started"])
                for j in sorted(same, key=lambda j: j["finished"])[-5:])
    return ds[len(ds) // 2] if ds else None


def testq_wait_estimate(ctx, job):
    """Seconds until this job finishes, from what runs and waits before it, or
    None when no job like one of them has finished yet."""
    total = 0
    for j in testq_ahead(ctx, job) + [job]:
        d = testq_duration(ctx, j.get("kind"), j.get("arms"))
        if d is None:
            return None
        if j.get("state") == "running":
            d = max(0, d - (time.time() - (_epoch(j.get("started")) or time.time())))
        total += d
    return total


def _wait_words(sec):
    return "under a minute" if sec < 60 else f"about {human_age(sec)}"


def testq_wait_phrase(ctx, job):
    ahead = testq_ahead(ctx, job)
    est = testq_wait_estimate(ctx, job)
    return ((f", {len(ahead)} ahead" if ahead else ", next to run")
            + (f" ({testq_describe(ahead[0])})" if ahead else "")
            + (f"; done in {_wait_words(est)}" if est is not None else
               "; no finished job to estimate from yet"))


def testq_ensure_runner(ctx):
    """Start the project's runner, detached, if none holds its lock."""
    if testq_runner_alive(ctx):
        return
    log = testq_dir(ctx) / "runner.log"
    env = {k: v for k, v in os.environ.items() if k not in ("CLAUDE_CODE_SESSION_ID",)}
    with open(log, "a") as fh:
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "testd",
                          project_arg(ctx.state)], cwd=str(ctx.repo), env=env, stdout=fh,
                         stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                         start_new_session=True)


def _flock(path, block):
    import fcntl
    fh = open(path, "a+")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | (0 if block else fcntl.LOCK_NB))
    except OSError:
        fh.close()
        return None
    return fh


def testq_runner_alive(ctx):
    fh = _flock(testq_dir(ctx) / "runner.lock", block=False)
    if fh is None:
        return True
    fh.close()
    return False


def testq_wait(ctx, job_id):
    """Block until a job ends; its shared report, or None."""
    while True:
        j = _read_json(testq_dir(ctx) / f"{job_id}.json") or {}
        if j.get("state") in ("done", "failed", "cancelled"):
            return _read_json(j.get("report") or "") if j.get("report") else None
        time.sleep(5)


def testd(pdir, repo):
    """The project's runner: one at a time, oldest first, until the queue is
    empty for TESTQ_IDLE. Exits at once if another runner holds the lock."""
    ctx = ProjCtx(pdir, repo)
    lock = _flock(testq_dir(ctx) / "runner.lock", block=False)
    if lock is None:
        print("another runner holds the lock"); return
    try:
        _testd_loop(ctx)
    finally:
        lock.close()


def _testd_loop(ctx):
    testq_recover(ctx)
    state = {"job": None}

    def on_term(signum, frame):
        if _ARM[0]:
            kill_tree(_ARM[0])
        j = state["job"]
        if j:
            j.update(state="cancelled", finished=_now(), why="the runner was stopped")
            testq_save(ctx, j)
            testq_teardown(ctx, j)
        sys.exit(1)
    def on_cancel(signum, frame):
        # Cancel this job only: kill its arm, and run_arms runs no more arms.
        _CANCEL[0] = True
        if _ARM[0]:
            kill_tree(_ARM[0])
    import signal
    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGUSR1, on_cancel)
    idle_since = time.time()
    while True:
        q = testq_order(testq_jobs(ctx, ("queued",)))
        if not q:
            if time.time() - idle_since > TESTQ_IDLE:
                print(f"{_now()} queue empty; runner exits"); return
            time.sleep(3); continue
        job = _read_json(testq_dir(ctx) / f"{q[0]['id']}.json") or q[0]
        if job.get("state") != "queued":
            continue
        state["job"] = job
        testq_run(ctx, job)
        state["job"] = None
        idle_since = time.time()


def testq_recover(ctx):
    """A job left `running` by a runner that died: failed, and its copy removed."""
    for j in testq_jobs(ctx, ("running",)):
        if not runner_alive(j.get("pid")):
            if _pid_exists(j.get("arm_pid")):
                kill_tree(j["arm_pid"])
            j.update(state="failed", finished=_now(), why="the runner died mid-job")
            testq_save(ctx, j)
            testq_teardown(ctx, j)


def testq_teardown(ctx, job):
    """Remove everything a job built: the worktree, then its whole run folder."""
    d = job.get("dir")
    if not d:
        return
    wt = Path(d) / job.get("wt_name", "")
    if job.get("wt_name"):
        git("worktree", "remove", "--force", str(wt), cwd=ctx.repo)
    git("worktree", "prune", cwd=ctx.repo)
    shutil.rmtree(d, ignore_errors=True)


def testq_run(ctx, job):
    """One job, start to finish: copy the commit, set up, run, report, ring, tear down."""
    node = (job["requested_by"][0].get("node") or "operator")
    run = RUNS_HOME / ctx.slug / job["id"]
    wt_name = f"{Path(ctx.repo).name}-{node}-{job['sha'][:8]}"
    log = testq_dir(ctx) / f"{job['id']}.log"
    job.update(state="running", started=_now(), pid=os.getpid(), dir=str(run), wt_name=wt_name,
               log=str(log))
    testq_save(ctx, job)
    out = open(log, "a", buffering=1)
    old = sys.stdout
    sys.stdout = out
    rep, code = None, None
    _CANCEL[0] = False
    def arm_started(pid):
        job["arm_pid"] = pid
        testq_save(ctx, job)
    _ARM_HOOK[0] = arm_started
    slot = _flock(testq_dir(ctx) / "slot.lock", block=False)
    if slot is None:
        print("waiting for the test slot (harness slot holds it)")
        slot = _flock(testq_dir(ctx) / "slot.lock", block=True)
    try:
        free = shutil.disk_usage(Path.home()).free / 2**30
        if free < TESTQ_FREE_GB:
            raise RuntimeError(f"only {free:.1f} GB free on the Linux disk; a job needs "
                               f"{TESTQ_FREE_GB} GB (copies of the test databases land in it)")
        (run / "tmp").mkdir(parents=True, exist_ok=True)
        rc, o, e = git("worktree", "add", "--detach", str(run / wt_name), job["sha"], cwd=ctx.repo)
        if rc:
            raise RuntimeError(f"git worktree add failed: {(e or o).strip()[:300]}")
        wt = run / wt_name
        # What the project needs to know about where it runs. The copy is not
        # where the worktree was (obs 84), and only what is under the run folder
        # is torn down (obs 86); setup is the project's own (obs 85).
        (run / "scratch").mkdir(exist_ok=True)
        env = {k: v for k, v in os.environ.items() if k != "CLAUDE_CODE_SESSION_ID"}
        env.update(TMPDIR=str(run / "tmp"), HARNESS_TEST_JOB=job["id"],
                   HARNESS_TEST_SHA=job["sha"], HARNESS_TEST_ORIGIN=job.get("origin") or "",
                   HARNESS_TEST_SCRATCH=str(run / "scratch"))
        if job["kind"] == "check":
            rep = testq_check(ctx, job, wt, env)
        else:
            print(f"$ {job['command']}")
            code, o, e, to = run_arm(job["command"], wt, None, run / "cmd.out",
                                     run / "cmd.err", env)
            keep = testq_dir(ctx) / f"{job['id']}.out"
            keep.write_text(_tail(run / "cmd.out", 200_000) + "\n--- stderr ---\n" +
                            _tail(run / "cmd.err", 50_000))
            print(f"exit {code}; output kept in {keep}")
        if _CANCEL[0]:
            job.update(state="cancelled", finished=_now(), why="cancelled with harness test --cancel")
        else:
            job.update(state="done", finished=_now())
    except Exception as ex:
        print(f"job failed: {ex}")
        job.update(state="failed", finished=_now(), why=str(ex)[:300])
    finally:
        _ARM_HOOK[0] = None
        slot.close()
        sys.stdout = old
        out.close()
        testq_save(ctx, job)
        testq_teardown(ctx, job)
    testq_ring(ctx, job, rep, code)


def testq_check(ctx, job, wt, env):
    """A check job's arms, run in the copy; the report goes to the commit and to
    every node that asked for it."""
    checks = load_checks(ctx)
    if job.get("arms"):
        checks = [c for c in checks if c["name"] in job["arms"]]
    base = load_baseline(ctx)
    sha = job["sha"]
    shared = shared_report_path(ctx, sha)
    job["total"] = len(checks)

    def progress(i, arm):
        job.update(done_arms=i, arm=arm, arm_started=_now())
        testq_save(ctx, job)
    node = job["requested_by"][0].get("node") or "operator"
    print(f"{len(checks)} check(s) at {sha[:8]} in {wt}")
    rows, failed = run_arms(ctx, node, sha, wt, checks, base, job.get("timeout") or 900,
                            shared, env, progress)
    if _CANCEL[0]:
        print("cancelled: no report is written, so nothing reuses a partial run")
        return None
    rep = make_check_report(node, sha, rows, failed, base,
                            job=job["id"], requested_by=[r.get("node") for r in job["requested_by"]],
                            arms=job.get("arms"), partial=bool(job.get("arms")))
    shared.parent.mkdir(parents=True, exist_ok=True)
    shared.write_text(json.dumps(rep, indent=2) + "\n")
    # Requesters who joined while it ran are read fresh from the job file.
    latest = _read_json(testq_dir(ctx) / f"{job['id']}.json") or job
    job["requested_by"] = latest.get("requested_by") or job["requested_by"]
    for r in job["requested_by"]:
        n = r.get("node") or "operator"
        f = check_report_path(ctx, n, sha)
        f.write_text(json.dumps(dict(rep, node=n), indent=2) + "\n")
    job["report"] = str(shared)
    for line in check_summary(rep, base, len(checks)):
        print(line)
    return rep


def testq_ring(ctx, job, rep, code):
    """Tell each requester the result, through its doorbell."""
    if job.get("state") != "done":
        text = f"test job {job['id']} {job.get('state')}: {job.get('why') or ''} — harness test --log {job['id']}"
    elif rep is not None:
        n = len(rep.get("checks") or [])
        text = (f"check of {job['sha'][:8]}: {n - rep['failed'] - rep['held']}/{n} passed"
                + (f", {rep['new']} new failure(s) against the baseline" if rep.get("new") else "")
                + f" — harness check --report {job['sha'][:8]}")
    else:
        text = (f"test job {job['id']} (`{(job.get('command') or '')[:60]}`) exited {code} — "
                f"output: {testq_dir(ctx) / (job['id'] + '.out')}")
    for r in job.get("requested_by") or []:
        n = r.get("node")
        if n and n not in ("operator", "owner"):
            ring_inbox(ctx.state, n, "test queue", text)


def testq_cancel(ctx, job):
    """Cancel a queued job, or kill a running one's arm; the runner tears it down."""
    if job.get("state") == "queued":
        job.update(state="cancelled", finished=_now())
        testq_save(ctx, job)
        return "cancelled (it had not started)"
    if job.get("state") == "running":
        pid = job.get("pid")
        if runner_alive(pid):
            os.kill(pid, 10)        # SIGUSR1: the runner kills the arm's tree, ends the job,
            return "stopped; its copy is being removed"     # tears it down, and goes on
        if _pid_exists(job.get("arm_pid")):
            kill_tree(job["arm_pid"])
        job.update(state="failed", finished=_now(), why="runner already gone")
        testq_save(ctx, job)
        testq_teardown(ctx, job)
        return "its runner was gone; marked failed and removed"
    return f"already {job.get('state')}"


def cmd_test(a):
    """`harness test -- <command>` queues a command (a sweep, a probe) to run in a
    copy of this commit; `harness test` lists the queue."""
    ctx = Ctx(); ctx.require_enrolled()
    cmd = [x for x in (a.command or []) if x != "--"]
    if a.cancel:
        jobs = testq_jobs(ctx, ("queued", "running"))
        hit = jobs if a.cancel == "all" else [j for j in jobs if j["id"].startswith(a.cancel)]
        if not hit:
            die(REFUSED, f"no queued or running job '{a.cancel}'. harness test")
        for j in hit:
            print(f"{j['id']}: {testq_cancel(ctx, j)}")
        return
    if a.log:
        hit = [j for j in testq_jobs(ctx) if j["id"].startswith(a.log)]
        if not hit:
            die(REFUSED, f"no job '{a.log}'")
        f = testq_dir(ctx) / f"{hit[-1]['id']}.log"
        print(f.read_text() if f.exists() else "no log yet"); return
    if cmd:
        node, _ = ctx.node()
        sha = git("rev-parse", "HEAD", cwd=ctx.worktree)[1].strip()
        rc, dirt, _ = git("status", "--porcelain", "--untracked-files=no", cwd=ctx.worktree)
        if dirt.strip():
            die(REFUSED, "uncommitted changes: the queue runs a copy of the commit; commit first")
        job, _ = testq_submit(ctx, "cmd", sha, node, os.environ.get("CLAUDE_CODE_SESSION_ID", ""),
                              command=shlex.join(cmd) if len(cmd) > 1 else cmd[0],
                              origin=str(ctx.worktree))
        print(f"queued {job['id']} (normal queue)" + testq_wait_phrase(ctx, job)
              + ". Your doorbell rings when it ends; its output is kept.")
        return
    jobs = testq_order(testq_jobs(ctx, ("running", "queued")))
    if not jobs:
        print("the test queue is empty" + ("" if testq_runner_alive(ctx) else "; no runner up"))
    for k, j in enumerate(jobs):
        est = testq_wait_estimate(ctx, j)
        print(f"{'▶' if j['state'] == 'running' else k}  {j['id']}  {j.get('queue', 'normal'):<8} "
              f"{testq_describe(j)}  (asked {(j.get('at') or '')[11:16]}"
              + (f"; done in {_wait_words(est)}" if est is not None else "") + ")")
    done = [j for j in testq_jobs(ctx, ("done", "failed", "cancelled"))][-5:]
    if done:
        print("recent:")
        for j in done:
            print(f"   {j['id']}  {j['state']}  {(j.get('finished') or '')[11:16]}"
                  + (f"  {j.get('why')}" if j.get("why") else ""))


def cmd_testd(a):
    pdir, repo = intermediary_project(a.project)
    testd(pdir, repo)


def cmd_slot(a):
    """`harness slot -- <command>`: run a command holding the project's test slot,
    so a project's own runner never runs beside the queue (obs 81)."""
    ctx = Ctx(); ctx.require_enrolled()
    cmd = [x for x in (a.command or []) if x != "--"]
    if not cmd:
        die(REFUSED, "harness slot -- <command>")
    f = testq_dir(ctx) / "slot.lock"
    fh = _flock(f, block=False)
    if fh is None:
        run = testq_jobs(ctx, ("running",))
        print("waiting for the test slot" + (f": {testq_describe(run[0])}" if run else ""))
        fh = _flock(f, block=True)
    try:
        sys.exit(subprocess.call(cmd if len(cmd) > 1 else ["sh", "-c", cmd[0]]))
    finally:
        fh.close()


def cmd_spend(a):
    """The delta since the mark, in components. Never one number."""
    ctx = Ctx(); ctx.require_enrolled()
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    if not sid:
        die(CONTRACT, "CLAUDE_CODE_SESSION_ID is unset — cannot measure (C1)")
    now = read_spend(sid)
    base = None
    if a.task:
        f = ctx.state_file("marks", a.task, ".json")
        if not f.exists():
            die(REFUSED, f"no mark for '{a.task}'. Nothing recorded where it began, so "
                         f"its share cannot be measured — report the session total and "
                         f"say so, rather than apportioning (I10)")
        base = json.loads(f.read_text())
        if base.get("_session") != sid:
            # REFUSED, not CONTRACT: the platform is fine. Exit 2 means Claude's
            # internals changed and you must not work around it; this is the
            # harness declining to subtract two incomparable numbers, which is
            # the mechanism working. Reporting it as platform drift would send
            # the reader hunting a fault that is not there.
            die(REFUSED,
                f"'{a.task}' was marked in session {str(base.get('_session'))[:8]}, this is "
                f"{sid[:8]}.\n           A recycled session (R13) starts a new transcript, so "
                f"the difference is not a measurement of anything. Report both totals "
                f"separately.")
    label = f"since mark '{a.task}'" if base else "whole session"
    if base and base.get("_model"):
        label += f"   {base['_model']}/{base.get('_effort')}"
    print(f"{label}   session {sid[:8]}   {now['_records']} usage records")
    d = {k: now[k] - (base[k] if base else 0) for k in TOKEN_KINDS}
    up, down, resent = split(d)
    print(f"{'':14}{'tokens':>14}")
    print(f"  {'input':<12}{d['input']:>14,}")
    print(f"  {'cache write':<12}{d['cache_write']:>14,}")
    print(f"  {'up':<12}{up:>14,}   sent, new")
    print(f"  {'output':<12}{d['output']:>14,}")
    print(f"  {'down':<12}{down:>14,}   generated")
    print(f"  {'':<12}{'':>14}")
    print(f"  {'NEW':<12}{up + down:>14,}   up + down — this is what a band means")
    print(f"  {'resent':<12}{resent:>14,}   cache reads: the conversation handed "
          f"back each turn")
    print()
    print("  Units: BILLED tokens, summed across turns. NOT context occupancy —")
    print("  what a window holds at one moment and what a session was billed across")
    print("  all of them are different quantities and must never share a column.")
    print()
    print("  Resent is reported and never added in. Every turn hands the whole")
    print("  conversation back, so it grows with the square of the turns and swamps")
    print("  the work: a task inside a 40k band measured 261.7M once counted that")
    print("  way. A total that includes it measures the shape of the conversation,")
    print("  not the size of the job.")
    if base:
        actual = band_of(up + down)
        est = base.get("_band")
        line = f"\n  band: {actual}"
        if est:
            line += f", estimated {est}"
            order = list(BANDS) + ["XL"]
            if order.index(actual) > order.index(est):
                line += "  — OVER"
            elif order.index(actual) < order.index(est):
                line += "  — under"
        print(line)
    else:
        print("\n  No mark: this is the whole session, not a task's share (I10).")


def write_review(ctx, node, branch, sha, by_node, carried_from=None):
    """The record `_guard --gate` reads before it will let a fast-forward land.

    `reviewed_by_node` is the field that makes it a record of an ORACLE rather
    than of a file. It is derived from git in the recording session (R1), like
    every other position in this design, so it cannot be claimed — only stood
    in. `reviewed_by` and `session` were always written and never read, which is
    how the gate went on certifying a reader it had never identified.
    """
    f = ctx.state_file("reviews", f"{node}-{sha}", ".json")
    f.parent.mkdir(parents=True, exist_ok=True)
    me = ""
    try:
        row = self_row(live_rows(agents_json())) or {}
        me = row.get("name") or ""
    except Exception:
        pass
    rec = {"node": node, "branch": branch, "sha": sha,
           "reviewed_by_node": by_node,
           "reviewed_by": me,
           "session": os.environ.get("CLAUDE_CODE_SESSION_ID", ""),
           "at": time.strftime("%Y-%m-%dT%H:%M:%S%z")}
    if carried_from:
        rec["carried_from"] = carried_from
    f.write_text(json.dumps(rec, indent=2) + "\n")
    return f


def read_review(ctx, node, sha):
    f = ctx.state_file("reviews", f"{node}-{sha}", ".json")
    if not f.exists():
        return None
    try:
        return json.loads(f.read_text())
    except Exception:
        return None


def cmd_review(a):
    """T4-review: the diff a lead reads before integrating, built from local git.

    This is the review a pull request would give, minus the platform. It exists
    because nothing else in the tree reads a member's diff — `T4` integrates by
    fast-forward, which is mechanical; `T11` reviewed the approach, not the code;
    the checks test behaviour, not quality. That was the one unreviewed seam.

    It reports one thing no PR can: which files a sibling also touched. Seams
    between children belong to the lead ([[#I9]]), so an overlap is the lead's
    business by definition and nobody else is positioned to see it.
    """
    ctx = Ctx(); ctx.require_enrolled()
    idx = load_index(ctx, refresh=True)
    here = idx["byBranch"].get(ctx.branch)
    if a.children:
        if here is None:
            die(NOT_ENROLLED, "not standing in a node, so --children has no meaning")
        targets = idx["nodes"][here]["children"]
        if not targets:
            print(f"'{here}' has no children"); return
    else:
        targets = a.node or ([here] if here else [])
    if not targets:
        die(REFUSED, "name a node, or pass --children")

    guard = ctx.repo / ".harness/hooks/_guard"

    def classify(branch, paths):
        """Ask the guard. Never reimplement its matcher — that drift is what made
        doctor's code-path arm select a document and pass for the wrong reason.

        Returns (kinds, problem). A missing or broken guard yields a PROBLEM, not
        an empty dict: 'I could not check' must never render as 'nothing wrong'.
        """
        if not paths:
            return {}, None
        if not guard.exists():
            return {}, f"no guard at {guard.relative_to(ctx.repo)} on this branch — not checked"
        r = subprocess.run([str(guard), "--classify"], input="\n".join(paths) + "\n",
                           capture_output=True, text=True,
                           env=dict(os.environ, HARNESS_BRANCH=branch), cwd=str(ctx.repo))
        if r.returncode != 0:
            return {}, f"guard --classify exited {r.returncode} — not checked"
        out = {}
        for line in r.stdout.splitlines():
            kind, _, path = line.partition(" ")
            if path:
                out[path] = kind
        if not out:
            return {}, "guard --classify returned nothing — is it older than --classify?"
        return out, None

    for n in targets:
        sp = idx["nodes"].get(n)
        if sp is None:
            print(f"skip {n}: not a node"); continue
        parent = sp["parent"]
        if not parent:
            print(f"skip {n}: rank 0 has nothing to present"); continue
        pb, cb = idx["nodes"][parent]["branch"], sp["branch"]

        rc, ahead, _ = git("rev-list", "--count", f"{pb}..{cb}", cwd=ctx.repo)
        rc2, behind, _ = git("rev-list", "--count", f"{cb}..{pb}", cwd=ctx.repo)
        ahead, behind = ahead.strip() or "0", behind.strip() or "0"

        # The option to read must always be there. A fast-forward integration
        # leaves NO merge commit — parent and child end up on the same sha — so
        # once work lands, `pb..cb` is empty and the diff a lead chose not to
        # read becomes unreachable. Reading is not required here, but it must
        # never be unavailable, so an integrated child falls back to a window of
        # its own recent history.
        rc, total, _ = git("rev-list", "--count", cb, cwd=ctx.repo)
        total = int(total.strip() or 0)
        if a.since:
            base, mode = a.since, f"since {a.since}"
        elif ahead != "0":
            base, mode = pb, "pending integration"
        else:
            back = min(a.last, max(total - 1, 0))
            # `~N` is N FIRST-PARENT steps, and the resulting range holds every
            # commit merged in along the way — routinely more than N. The label
            # says steps, and the count printed below says commits, because a
            # header claiming "last 4 commits" above a list of 13 is the kind of
            # number that gets quoted.
            base, mode = (f"{cb}~{back}" if back else None), \
                         f"already integrated — window of the last {back} first-parent step(s)"

        print(f"\n── {n}  ({cb} → {parent}/{pb})  {sp['model']}/{sp['effort']}")
        if base is None:
            print("   no history to show"); continue
        if ahead == "0" and not a.since:
            print(f"   {mode}")
            print(f"   ⚠ a fast-forward leaves no boundary — this is a window of "
                  f"history, not the exact set that was integrated")

        # T2: a lead's merge is only a fast-forward if the child caught up.
        # Meaningless once the branches are identical — say nothing there.
        if ahead == "0" and not a.since:
            pass
        elif behind != "0":
            print(f"   ⚠ {behind} commit(s) behind {parent} — T4 will refuse this "
                  f"until it catches up (T2)")
        else:
            print(f"   caught up — `git merge --ff-only {cb}` will fast-forward")

        rc, shown, _ = git("rev-list", "--count", f"{base}..{cb}", cwd=ctx.repo)
        shown = shown.strip() or "0"
        print(f"   {shown} commit(s) in this range:")
        rc, log, _ = git("log", "--reverse",
                         "--format=%h %s%x09%(trailers:key=Task,valueonly,separator=;)",
                         f"{base}..{cb}", cwd=ctx.repo)
        untrailered = 0
        for line in log.splitlines():
            body, _, tr = line.partition("\t")
            tr = tr.strip()
            if not tr and "Merge branch" not in body:
                untrailered += 1
                print(f"     {body}   ← no Task: trailer")
            else:
                print(f"     {body}" + (f"   [{tr}]" if tr else ""))
        if untrailered:
            print(f"   ⚠ {untrailered} commit(s) carry no Task: trailer — an ancestor "
                  f"holding a conflicted hunk would have names and no route to a ledger")

        # THREE dots. `git diff A..B` is `git diff A B` — symmetric, and it reads
        # as directional, which is the trap this repository documents and warns
        # humans away from. This command then committed it, under a name that
        # implies the directional question has been answered.
        #
        # What it produced: a child six commits behind its lead, holding one
        # commit of its own that touched two files, reported as 9 files and 612
        # deletions — every deletion being the LEAD's own work the child has not
        # merged yet. Worse for the seam check below, which then names a sibling
        # whose work is already integrated in the parent and is therefore behind
        # the reviewer rather than beside it.
        #
        # `A...B` is `git diff $(git merge-base A B) B`: what THIS node did since
        # it diverged, which is the only question a lead is asking. It is also
        # correct in the other two modes — `--since REF` reads as work since the
        # divergence from REF, and the integrated-child fallback bases on an
        # ancestor of cb, where the merge base IS the base.
        rc, names, _ = git("diff", "--name-only", f"{base}...{cb}", cwd=ctx.repo)
        files = [f for f in names.splitlines() if f]
        rc, stat, _ = git("diff", "--shortstat", f"{base}...{cb}", cwd=ctx.repo)
        print(f"   {stat.strip() or 'no file changes'}")

        # A code node touching a document is the guard's business, and the lead's.
        kinds, problem = classify(cb, files)
        if problem:
            print(f"   ⚠ document check UNAVAILABLE: {problem}")
        docs = [f for f in files if kinds.get(f) == "doc"]
        if docs and sp.get("kind") == "code":
            print(f"   ⚠ touches {len(docs)} document(s) from a code node — "
                  f"documents are requested upward (T5), not committed:")
            for d in docs[:5]:
                print(f"       {d}")

        # I9: the seams are the lead's, so an overlap with a sibling is the point.
        overlaps = {}
        for sib in sp["siblings"]:
            sb = idx["nodes"][sib]["branch"]
            rc, sa, _ = git("rev-list", "--count", f"{pb}..{sb}", cwd=ctx.repo)
            if sa.strip() != "0":
                sbase = pb                       # sibling still pending
            else:
                rc, st, _ = git("rev-list", "--count", sb, cwd=ctx.repo)
                sback = min(a.last, max(int(st.strip() or 0) - 1, 0))
                if not sback:
                    continue
                sbase = f"{sb}~{sback}"          # same-size window as ours
            # Same three dots, and this is where it hurt most: a sibling's
            # already-integrated work showed as a live seam, so the tool named a
            # conflict with a node that is behind the reviewer rather than
            # beside it.
            rc, sn, _ = git("diff", "--name-only", f"{sbase}...{sb}", cwd=ctx.repo)
            shared = sorted(set(files) & {f for f in sn.splitlines() if f})
            if shared:
                overlaps[sib] = shared
        if overlaps:
            for sib, shared in overlaps.items():
                print(f"   ⚠ SEAM with {sib} — {len(shared)} file(s) both changed:")
                for f in shared[:5]:
                    print(f"       {f}")
            print("   Seams are yours (I9). Neither child can judge this; you can.")
        else:
            print("   no files shared with a sibling")

        if a.diff:
            rc, d, _ = git("diff", f"{base}...{cb}", cwd=ctx.repo)
            print("\n" + d)

        # What the checks said, at the commit you are about to take. This is the
        # thing a lead had no way to see: `review` showed the diff, `T11`
        # reviewed the approach, and whether the suite ever ran was a claim in a
        # message. An absent report renders as ABSENT, never as clean — the same
        # rule the document check follows two lines up, and the fault that made
        # the first draft of this command read an empty result as "no
        # violations".
        _crep = read_check_report(ctx, n, git("rev-parse", cb, cwd=ctx.repo)[1].strip())
        if _crep is None:
            print("   checks       NOT RUN at this commit — nothing recorded")
        elif _crep.get("passed"):
            print(f"   checks       passed ({len(_crep.get('checks') or [])}/"
                  f"{len(_crep.get('checks') or [])}) at {_when(_crep.get('at'))}"
                  + ("   [dirty worktree]" if _crep.get("dirty") else ""))
        else:
            _base = load_baseline(ctx) if _crep.get("baseline") else None
            _diff = baseline_diff(_crep.get("checks") or [], _base) if _base else {}
            print(f"   checks       " + (baseline_summary(_crep, _base) if _base else
                  f"FAILED {_crep.get('failed')} of {len(_crep.get('checks') or [])}:"))
            for c in _crep.get("checks") or []:
                if c.get("held"):
                    print(f"                  {c['name']}  NOT RUN (held: {c['held']})")
                if c.get("exit"):
                    print(f"                  {c['name']}  exit {c['exit']}"
                          + (f"  {baseline_line(_diff[c['name']])}" if c["name"] in _diff else ""))
        for c in (_crep or {}).get("checks") or []:
            print(f"                  {c['name']} cannot see: {c['blindSpot'][:70]}")

        if a.record:
            # Reading is for anyone; RECORDING is the lead's, and it took the
            # guard reading the record to notice the difference. This command
            # defaults its target to the node you are standing in and asked
            # nobody's rank, so a member running bare `harness review --record`
            # wrote the file that unblocked its own integration — and the gate,
            # whose entire justification is that a member cannot check its own
            # work, was satisfied by that member. The record has carried who
            # wrote it since the beginning; nothing read the field.
            #
            # Refused here AND in the guard, deliberately. This one gives the
            # honest error at the moment of the mistake; the guard's is the one
            # that holds, because a check in this CLI is bypassed by writing the
            # file.
            if here is None:
                die(REFUSED,
                    f"not standing in a node, so there is nobody here whose read\n"
                    f"           would count. Record it from {parent}'s worktree.")
            if n == here:
                die(REFUSED,
                    f"recording your own review is marking your own homework.\n"
                    f"           A member cannot check its own work — that is the whole "
                    f"reason T4\n           gates on this record. Read it as often as you "
                    f"like; '{parent}' records it.")
            if parent != here:
                die(REFUSED,
                    f"'{n}' is {parent}'s child and you are standing in '{here}'.\n"
                    f"           The read that unblocks an integration is recorded by the "
                    f"node being\n           integrated INTO, because that is the party the "
                    f"gate is about.\n           Read it freely — harness review {n} — but "
                    f"the record is {parent}'s.")
            rc, tip, _ = git("rev-parse", cb, cwd=ctx.repo)
            tip = tip.strip()
            write_review(ctx, n, cb, tip, here)
            print(f"   recorded review of {n} at {tip[:8]} — integration unblocked")
            print(f"   any new commit on {cb} invalidates this, by design")
    print()


def cmd_integrate(a):
    """T4: catch a presented child up, then fast-forward it into this node.

    THE RULE THIS EXISTS TO CLOSE. T2 says a member catches up twice and only
    twice, the second time immediately before presenting. T4 is `--ff-only`,
    which succeeds only while the child is an ancestor of the parent. Integrate
    the first child and the parent MOVES: every sibling that caught up before
    presenting — exactly as instructed — is now behind, unmergeable, and needs a
    third catch-up that T2 forbids. With k children at most one per round can
    satisfy both rules, and the other k-1 land in a state the tree has no verb
    for. It was found three times in one night and worked around in `recycle` by
    letting the stranded child go, which cleared the node and left the work
    exactly where it was.

    The way out is not a new rule, it is reading the old one for what it
    protects. T2 forbids the NODE from merging into a worktree because merging
    into a worktree that is IN USE aborts on dirty files and lands silently
    otherwise. A member that has presented and released is not in use, and the
    roster says so. So: the member catches up twice; a third catch-up into an
    unoccupied worktree is the lead's, and is part of T4 rather than an
    exception to T2.

    Serialisation lives here rather than in a lead's head, which is the other
    half of why the state was reachable at all — T4 was hand-typed git with
    nothing to order it.

    WHAT IT WILL NOT DO. It does not resolve a conflict. A catch-up that
    conflicts is T7 or T8: it needs the two intents, and the party holding them
    is not this command. It aborts the merge, leaves the child exactly as it
    was, and says which one applies.

    It does not run the child's checks either. Nothing in this CLI executes a
    manifest command, and the one place the design has a lead run a member's
    checks is T7, where a conflict has already made it necessary.
    """
    ctx = Ctx(); ctx.require_enrolled()
    idx = load_index(ctx, refresh=True)
    here = idx["byBranch"].get(ctx.branch)
    if here is None:
        die(NOT_ENROLLED, f"branch '{ctx.branch}' is not a node — nothing to integrate into")
    if a.children:
        targets = idx["nodes"][here]["children"]
        if not targets:
            print(f"'{here}' has no children"); return
    else:
        targets = a.node
    if not targets:
        die(REFUSED, "name a child, or pass --children")

    try:
        rows = live_rows(agents_json(read_roster(a.roster)))
    except SystemExit:
        raise
    except Exception as e:
        # The same rule the viewer and `trim` follow: a roster that could not be
        # read is UNKNOWN, never empty. Every other reader can shrug and carry
        # on with a worse answer; this one would merge into a worktree somebody
        # is standing in, which is the one failure the claim lock exists to
        # prevent and the one that leaves no artefact behind.
        die(CONTRACT, f"cannot read the session roster ({e}) — refusing.\n"
                      f"           An unreadable roster is not an empty one, and this "
                      f"command writes\n           into another node's worktree.")

    marks = open_marks(ctx)
    pw = ctx.worktree
    done, failed = 0, 0
    for n in targets:
        sp = idx["nodes"].get(n)
        if sp is None:
            print(f"skip {n:<12} not a node"); failed += 1; continue
        if sp["parent"] != here:
            print(f"skip {n:<12} is {sp['parent'] or 'rank 0'}'s child, not {here}'s — "
                  f"integration is the parent's"); failed += 1; continue
        cb, cw = sp["branch"], sp["worktree"]
        if not cw:
            print(f"skip {n:<12} has no worktree on this machine"); failed += 1; continue

        rc, ahead, _ = git("rev-list", "--count", f"{ctx.branch}..{cb}", cwd=ctx.repo)
        if (ahead.strip() or "0") == "0":
            print(f"     {n:<12} nothing to integrate — already in {here}"); continue

        holders = [r for r in rows if r.get("cwd") == cw]
        if holders:
            who = ", ".join(r.get("name") or r.get("sessionId", "?")[:8] for r in holders)
            print(f"skip {n:<12} OCCUPIED by {who} — catching it up would write into a "
                  f"live worktree.\n     {'':<12} That is what T2 forbids, and the reason "
                  f"it forbids it. Let it present\n     {'':<12} and release, or stop it "
                  f"first: harness stop {n}")
            failed += 1; continue

        rc, dirt, _ = git("status", "--porcelain", cwd=cw)
        if dirt.strip():
            print(f"skip {n:<12} worktree is dirty ({len(dirt.splitlines())} path(s)) — "
                  f"refusing.\n     {'':<12} Nobody is standing there, so this is "
                  f"uncommitted work with no author\n     {'':<12} left to explain it. "
                  f"Look before you merge over it: {cw}")
            failed += 1; continue

        stem = next((k for k, r in marks.items()
                     if r.get("_node") == n and r.get("_presented_at")), None)
        if stem is None:
            print(f"skip {n:<12} has commits ahead but no PRESENTED task record.\n"
                  f"     {'':<12} Work that was never offered upward is not work you were "
                  f"asked to take.\n     {'':<12} It presents with: harness mark <task> --done")
            failed += 1; continue
        mrec = marks[stem]

        rc, tip, _ = git("rev-parse", cb, cwd=ctx.repo)
        tip = tip.strip()
        if mrec.get("_presented_sha") and mrec["_presented_sha"] != tip:
            print(f"skip {n:<12} has committed since it presented "
                  f"({mrec['_presented_sha'][:8]} → {tip[:8]}).\n"
                  f"     {'':<12} Anything committed after presenting was never offered "
                  f"upward. It\n     {'':<12} presents again, or you are integrating "
                  f"something nobody showed you.")
            failed += 1; continue

        rc, behind, _ = git("rev-list", "--count", f"{cb}..{ctx.branch}", cwd=ctx.repo)
        behind = behind.strip() or "0"
        if a.dry_run:
            print(f"     {n:<12} would {'catch up (' + behind + ' behind) then ' if behind != '0' else ''}"
                  f"fast-forward {here} to {tip[:8]}")
            continue

        carried = None
        if behind != "0":
            rc, out, err = git("merge", "--no-edit", ctx.branch, cwd=cw)
            if rc:
                git("merge", "--abort", cwd=cw)
                # Whose collision it is turns on authorship, not on position:
                # T7 if this node issued both tasks, T8 if the work was authored
                # ranks below. The trailers answer it and nobody has to guess.
                print(f"skip {n:<12} CONFLICTS with {here} — not resolved here.\n"
                      f"     {'':<12} The merge is aborted and {n} is untouched. A "
                      f"conflict needs the two\n     {'':<12} intents behind it, and this "
                      f"command holds neither.\n"
                      f"     {'':<12}   T7 if you issued both tasks; T8 if they were "
                      f"authored below you.\n"
                      f"     {'':<12}   git -C {cw} log --merge --format='%(trailers:key="
                      f"Task,valueonly)'")
                failed += 1; continue
            prev, tip = tip, git("rev-parse", cb, cwd=ctx.repo)[1].strip()
            print(f"     {n:<12} caught up ({behind} behind) — {prev[:8]} → {tip[:8]}")
            # A CLEAN catch-up carries the review. The child's side was read;
            # the parent's side is this node's own integrated history, which it
            # does not need to review to itself; and git wrote the merge
            # mechanically, so there is no third party's decision in it. A
            # CONFLICTED one does not reach here at all, which is the case where
            # somebody chose something and it has to be read.
            old = read_review(ctx, n, prev)
            if old and old.get("reviewed_by_node") == here:
                write_review(ctx, n, cb, tip, here, carried_from=prev)
                carried = prev
            # The presentation followed the work across the merge, so every
            # other reader — `recycle`, `status`, the viewer — still sees a node
            # whose presented sha is its tip. Leaving that stale is how a store
            # starts describing a node that no longer exists in that state.
            mrec["_presented_sha"] = tip
            mrec["_caught_up_by"] = here
            mrec["_caught_up_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
            (ctx.state / "marks" / (stem + ".json")).write_text(
                json.dumps(mrec, indent=2) + "\n")

        rev = read_review(ctx, n, tip)
        if rev is None or rev.get("reviewed_by_node") != here:
            why = ("no review is recorded at this commit" if rev is None else
                   f"the record was written by '{rev.get('reviewed_by_node')}', not by {here}")
            print(f"skip {n:<12} {why}.\n"
                  f"     {'':<12} A member cannot check its own work, so the lead reads "
                  f"it (T4):\n     {'':<12}   harness review {n} --record\n"
                  f"     {'':<12} The gate would refuse this a moment later, with your "
                  f"working tree\n     {'':<12} already updated. This refuses first.")
            failed += 1; continue

        rc, out, err = git("merge", "--ff-only", cb, cwd=pw)
        if rc:
            # The whole message, not its first line. git puts the HEADER first
            # and the actionable part -- which files -- underneath, so
            # `splitlines()[0]` printed "the following untracked working tree
            # files would be overwritten by merge:" and swallowed the list.
            # A refusal you cannot act on.
            print(f"skip {n:<12} fast-forward refused:")
            for line in (err or out).strip().splitlines()[:12]:
                print(f"     {'':<12} {clip(line)}")
            failed += 1; continue
        done += 1
        print(f"  ✓  {n:<12} {here} → {tip[:8]}"
              + (f"  (review carried from {carried[:8]})" if carried else ""))
        task = mrec.get("_task") or stem
        print(f"     {'':<12} sign it off, which also starts its next task: "
              f"harness mark {task} --close")

    if not a.dry_run:
        print(f"\nintegrated {done}" + (f", refused {failed}" if failed else ""))
    if failed:
        sys.exit(REFUSED)


STOP_SETTLE = 6.0     # seconds to wait for a stopped session to leave the roster
STOP_POLL = 0.5


def stop_took(a, sid):
    """Did the session actually go? A zero from `claude stop` does not say so.

    Exit 0 is a claim that it ASKED. Whether the process died is a separate
    fact, and the roster is the one that reports it — so verify the outcome
    rather than the call. The gap is not theoretical for a spawn path: a
    session that ignores the signal, shuts down slowly, or outlives the request
    leaves the caller free to start a second one beside it, with a clean exit
    code certifying the result.

    `live_rows`, so a row that lingers with a null pid counts as gone: the
    roster naming no process is the roster saying nothing runs under it.

    Raised by biblion2-main 2026-09-07 while reading the fix for the previous
    version of this bug. Its supporting history is about `claude stop`'s exit
    code being misread through a pipe (`${PIPESTATUS[0]}`, three recurrences)
    — which is NOT this call's problem, since `subprocess.run` reads the real
    code. The argument survives its own citation being inapplicable, and that
    is why it is implemented: the fault here is trusting a request as a result.
    """
    waited = 0.0
    while True:
        rows = live_rows(agents_json(read_roster(a.__dict__.get("roster"))))
        if not any(r.get("sessionId") == sid for r in rows):
            return True
        if waited >= STOP_SETTLE:
            return False
        time.sleep(STOP_POLL)
        waited += STOP_POLL


def cmd_recycle(a):
    """R13: end a member's session and start a fresh one on the same node.

    A member is stateless by design — position comes from git, orientation from
    the SessionStart hook, scope from the task record. So there is nothing in its
    context worth carrying past the commit that ends its task, and plenty worth
    dropping. This is a full teardown and relaunch, not `/clear`: a background
    session cannot clear itself, and a session that stopped itself could not
    start its own replacement.

    It stops, it does not `claude rm`: the stopped session's job folder may
    hold files a record will cite, and `rm` deletes it. `harness sweep` takes
    ended sessions off the list once that is decided. (`rm` never deletes a
    worktree made with `git worktree add`; measured 2026-10-05.)
    """
    ctx = Ctx(); ctx.require_enrolled()
    if a.at_quiet or a.cancel_reset:
        return request_reset(ctx, a.node, a.by, a.within, a.dry_run, a.cancel_reset)
    idx = load_index(ctx, refresh=True)
    if a.when_idle:
        wait_until_idle(idx, a.node)
    rows = live_rows(agents_json(read_roster(a.__dict__.get("roster"))))
    by_wt = idx["byWorktree"]
    mine = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    here = idx["byBranch"].get(ctx.branch)
    if a.children or a.idle or a.cold:
        if here is None:
            die(NOT_ENROLLED, "not standing in a node, so --children has no meaning")
        targets = idx["nodes"][here]["children"]
        if a.cold:
            # Narrower than --idle, and for a different reason. --idle removes
            # capacity with nothing to do; --cold replaces a session whose
            # context has fallen out of the prompt cache, where resuming costs a
            # full re-read of everything it carries and starting fresh costs one
            # orientation.
            warm = []
            for n in targets:
                wt = idx["nodes"].get(n, {}).get("worktree")
                ages = [last_turn(r.get("sessionId") or "")[0] for r in rows
                        if r.get("cwd") == wt]
                ages = [x for x in ages if x is not None]
                if not ages or max(ages) <= CACHE_TTL:
                    warm.append(n)
            for n in warm:
                print(f"  keep {n:<12} still inside the {CACHE_TTL // 60}m cache "
                      f"lifetime")
            targets = [n for n in targets if n not in warm]
        if a.idle or a.cold:
            # A node with no OPEN task record is unassigned, and an unassigned
            # session with a live counterparty is what funds correspondence no
            # transaction ends. It decides nothing; it removes the capacity.
            #
            # It applies to LEADS as much as to members, and that is a change of
            # scope rather than of mechanism. A lead used to be worth keeping
            # because it held what nobody else did: which briefs it had written,
            # which blocks were answered, what its children were carrying. All of
            # that is a record now — briefs, the queue, marks with derived state,
            # findings, facts, block consequences — so a fresh lead reads it back
            # instead of remembering it, and the only thing lost by replacing one
            # is context it should never have been the sole holder of.
            # Presented work does not hold a node. The member has finished and
            # measured it; the record stays open only because its LEAD has not
            # signed off yet, and waiting for that would idle a session that has
            # nothing left to do.
            busy = {r.get("_node") for r in open_marks(ctx).values()
                    if not r.get("_presented_at")}
            for n in [x for x in targets if x in busy]:
                print(f"  keep {n:<12} has an open task record")
            targets = [n for n in targets if n not in busy]
        if not targets:
            print("nothing to recycle" if (a.idle or a.cold)
                  else f"'{here}' has no children"); return
    else:
        targets = a.node
    if not targets:
        die(REFUSED, "name at least one node, or pass --children / --idle / --cold")

    occ = {}
    for r in rows:
        n = by_wt.get(r.get("cwd", ""))
        if n:
            occ.setdefault(n, []).append(r)

    done = 0
    for n in targets:
        sp = idx["nodes"].get(n)
        if sp is None:
            print(f"  skip {n:<12} not a node"); continue
        if sp["rank"] == 0:
            print(f"  skip {n:<12} rank 0 is never recycled — it is the only "
                  f"session holding a\n       {'':<12} conversation with the "
                  f"operator, and no record reconstructs that"); continue
        if not sp["worktree"]:
            print(f"  skip {n:<12} no worktree"); continue

        # Uncommitted work would be stranded in a context nobody can read again.
        rc, out, _ = git("status", "--porcelain", cwd=sp["worktree"])
        if rc == 0 and out.strip() and not a.force:
            print(f"  skip {n:<12} worktree is dirty — commit or stash first"); continue

        # "At the end of commits" means the commits have LANDED. Work sitting
        # unintegrated is work whose author is about to be replaced.
        #
        # Except across an edge that never integrates. Code does not land on the
        # document branch — the guard refuses it there, and this file already
        # says so where the doctor draws its samples ("the document node may
        # track no code at all"). So for the top of the code subtree, `pb..cb`
        # is not a backlog waiting to be integrated; it is the project, and it
        # only grows. Counted as unintegrated work it made the arm permanently
        # unsatisfiable: `recycle dev` refused for the life of the repository,
        # `recycle --idle` recycled zero every time, and orientation went on
        # recommending both. A refusal nobody can ever clear is worse than no
        # check, because it reads as a fact about tonight's tree.
        #
        # Derived, not declared. `kind` is already on the node and already in
        # the index, so nothing needs to be marked by hand and no existing tree
        # needs migrating. A doc child of a doc parent still integrates.
        parent = sp["parent"]
        integrates = not (parent
                          and idx["nodes"].get(parent, {}).get("kind") == "doc"
                          and sp.get("kind") != "doc")
        if parent and not a.force:
            pb = idx["nodes"][parent]["branch"]
            rc, ahead, _ = git("rev-list", "--count", f"{pb}..{sp['branch']}", cwd=ctx.repo)
            n_ahead = int(ahead.strip()) if rc == 0 and ahead.strip().isdigit() else 0
            # Said out loud, and only where it changes the answer. Silently
            # passing an arm that would otherwise have refused leaves a reader
            # to guess which rule applied — and the count is large and rising,
            # so anyone who checks by hand will find it and conclude the tool
            # missed it.
            if n_ahead and not integrates:
                print(f"       {n:<12} {n_ahead} commit(s) ahead of {parent}, and "
                      f"that edge never integrates:\n"
                      f"       {'':<12} {parent} is the document node and receives no "
                      f"code. Nothing to\n"
                      f"       {'':<12} prove and nothing to strand — that count is "
                      f"the project, not a backlog.")
            elif n_ahead:
                # "Not yet in the parent" conflated two cases, and the second
                # one deadlocked. A child that never presented would really be
                # stranded — refuse that. A child that PRESENTED and was then
                # left behind because its lead integrated a sibling and moved
                # the target underneath it has nothing to strand: the work is
                # committed, on a ref, and its lead has been told.
                #
                # Jointly unsatisfiable otherwise. `merge --ff-only` refuses
                # because the child is BEHIND; recycle refused because it is
                # AHEAD; and the only party who could run the catch-up is the
                # child, which has presented and released — which is exactly
                # what T10 tells it to do. Messages to it arrive at a session
                # that correctly finished. Measured three times in one night.
                #
                # `harness integrate` is the way OUT of that state and this is
                # the way THROUGH it. They are different jobs and both are
                # needed: integrate catches the released worktree up and
                # fast-forwards it, which is the lead's act; this one lets the
                # child's own node be refilled while that is still outstanding,
                # because the child has genuinely finished. Deleting this arm
                # once integrate existed would put the deadlock back for any
                # lead that has not got to it yet.
                #
                # The tip must equal what was presented. Anything committed
                # after presenting was never offered upward and is the first
                # case again.
                tip = git("rev-parse", sp["branch"], cwd=ctx.repo)[1].strip()
                pres = next((r for r in open_marks(ctx).values()
                             if r.get("_node") == n and r.get("_presented_at")
                             and r.get("_presented_sha") == tip), None)
                if pres is None:
                    print(f"  skip {n:<12} {ahead.strip()} commit(s) not yet in "
                          f"{parent} — present them first"); continue
                print(f"       {n:<12} {ahead.strip()} commit(s) ahead of {parent}, "
                      f"and all of them presented\n"
                      f"       {'':<12} at {_when(pres.get('_presented_at'))}. "
                      f"Nothing to strand: the work is\n"
                      f"       {'':<12} committed and on a ref, and {parent} has been "
                      f"told. It is behind\n"
                      f"       {'':<12} because {parent} moved, which is {parent}'s to "
                      f"resolve, not this\n"
                      f"       {'':<12} node's — and this node has already released.\n"
                      f"       {'':<12} {parent} clears it with: harness integrate {n}")

        # `continue` here continues the HOLDER loop, not the node — so every
        # refusal below used to be printed and then contradicted, two lines
        # later, by the same command. Measured: with a busy holder and no
        # --force it printed `skip dev  busy`, then `recycled dev`, then
        # `recycled 1`, and started a session beside the one it had just
        # declined to stop. Same shape when `claude stop` returned non-zero.
        # Two sessions in one worktree is the exact state the claim lock exists
        # to prevent, reached by the command that is supposed to maintain it.
        holders, unstopped = [], []
        for r in occ.get(n, []):
            label = f"{r.get('name') or '?'} [{r['sessionId'][:8]}]"
            if r["sessionId"] == mine:
                # Skipping the stop was right; carrying on to the spawn was not.
                # A session cannot stop itself, so this arm ended with the
                # caller still in the worktree and a second session started
                # beside it — and `--force` made no difference, because the
                # thing being forced was never the obstacle. `spawn` has always
                # refused its own worktree; this is the same refusal.
                print(f"  skip {n:<12} that is this session — it cannot stop itself, "
                      f"and a second\n       {'':<12} session in this worktree is "
                      f"what the claim lock exists to forbid.\n"
                      f"       {'':<12} Recycling is the parent's, from the parent's "
                      f"worktree.")
                unstopped.append(label); continue
            if is_stopped(r) and not a.force:
                # Recycling is the WRONG remedy here and it looks like the right
                # one, because a stopped session reports `status: idle` and
                # every other idle session is exactly what recycle is for. A
                # replacement starts cold, walks the same path, and stops at the
                # same prompt — so the sweep costs a session and changes
                # nothing, and whatever the halted one was about to be told is
                # gone. Only a human at the keyboard clears this.
                print(f"  skip {n:<12} STOPPED AT A PROMPT — it reads as idle and it "
                      f"is not.\n       {'':<12} Recycling is not the remedy: a "
                      f"replacement starts cold and, if it\n       {'':<12} was a "
                      f"permission prompt, meets the same one. Send it a prompt, or\n"
                      f"       {'':<12}   claude attach {r['sessionId'][:8]}\n"
                      f"       {'':<12} --force recycles anyway, discarding whatever it "
                      f"was waiting to be told.")
                unstopped.append(label); continue
            if r.get("status") == "busy" and not a.force:
                print(f"  skip {n:<12} {label} is busy — it may be mid-task or "
                      f"awaiting a reply")
                unstopped.append(label); continue
            holders.append(label)
            if not a.dry_run:
                res = subprocess.run(["claude", "stop", r["sessionId"][:8]],
                                     capture_output=True, text=True)
                if res.returncode:
                    print(f"  FAILED {n:<12} {label}: {res.stderr.strip()[:80]}")
                    unstopped.append(label); continue
                if not stop_took(a, r["sessionId"]):
                    print(f"  FAILED {n:<12} {label}: `claude stop` exited 0, but it "
                          f"is still\n       {'':<12} running {STOP_SETTLE:g}s later. "
                          f"Zero says it asked, not that it died.")
                    unstopped.append(label); continue
        if unstopped:
            # Starting one anyway is not a partial success, it is the worse
            # outcome: the old session keeps the node and the new one cannot
            # claim it.
            print(f"  skip {n:<12} not recycled — still in this worktree: "
                  f"{', '.join(unstopped)}")
            if a.when_idle and not a.dry_run:
                reset_outcome(ctx, n, "busy")
            continue

        # Resolved BEFORE the dry-run branch: a dry run that cannot show the
        # effort it would use cannot check the flag you ran it to check.
        model, effort = assignment_for(ctx, n)
        model, effort = a.model or model, a.effort or effort
        if a.escalate:
            was = effort
            effort = escalate(effort)
            if effort == was:
                print(f"  note {n:<12} already at '{was}' — a retry here buys nothing; "
                      f"read the failure instead")
            else:
                print(f"  escalating {n:<12} {was} -> {effort}")

        # What the fresh session will open, decided BEFORE the dry-run branch so
        # the dry run and the real command cannot disagree (obs 64). The node's
        # own open mark comes first: a session that died mid-task left work to
        # RESUME, which is not "nothing to do" and not "waiting".
        start = next_start(ctx, n)
        if start["skip"] and not a.force:
            print(f"  skip {n:<12} {start['skip']}  (--force starts it anyway)")
            continue
        line = start["line"] if not start["skip"] else \
            f"{start['skip']} — started anyway (--force)"
        if a.dry_run:
            who = ", ".join(holders) if holders else "nobody there — would just start one"
            print(f"  would recycle {n:<12} {model}/{effort:<7} {who}; {line}")
            done += 1
            continue
        print(f"       {n:<12} {line}")
        name = f"{idx['project']}-{n}"
        gr = grants_for(ctx, n)
        cmd = launch_cmd(ctx, n, name, gr, model, effort, a.prompt)
        subprocess.Popen(cmd, cwd=sp["worktree"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f"  recycled {n:<12} {model}/{effort:<7} fresh context"
              + (f"  +{len(gr)} grant(s)" if gr else ""))
        reset_outcome(ctx, n)
        done += 1

    verb = "would recycle" if a.dry_run else "recycled"
    print(f"{verb} {done}")


def _close_lock(ctx, path, why):
    """I6: a claim record is closed, never destroyed.

    `status` globs `locks/*.lock` at the top level, so a record moved into a
    subdirectory stops being reported without ceasing to exist.
    """
    try:
        rec = json.loads(path.read_text())
    except Exception:
        rec = {"node": path.stem, "unreadable": True}
    rec["closed_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    rec["closed_because"] = why
    dest_dir = ctx.state / "locks" / "_closed"
    dest_dir.mkdir(parents=True, exist_ok=True)
    dest = dest_dir / f"{path.stem}-{time.strftime('%Y%m%dT%H%M%S')}.lock"
    dest.write_text(json.dumps(rec, indent=2))
    path.unlink()
    return dest


def _reconcile(ctx, dry_run=False):
    """Make the two derived stores agree with the tree, and name every
    disagreement that is not this command's to fix.

    The tree is the truth. `index.json` is rebuilt from it outright; a claim
    naming a node the tree no longer has is closed. Worktrees and branches are
    only reported, because deleting one that nobody declared is a guess.
    """
    # The index is derived, not state: it is a pure function of the tree and git,
    # so rebuilding it under a dry run changes no answer. Every other store here
    # is real, and a dry run must leave all of them alone.
    idx = build_index(ctx)
    print(f"  index      {len(idx['nodes'])} node(s) -> {ctx.state / 'index.json'}"
          + ("   (derived, so rebuilt either way)" if dry_run else ""))
    d = ctx.state / "locks"
    closed = 0
    for p in (sorted(d.glob("*.lock")) if d.is_dir() else []):
        try:
            node = json.loads(p.read_text()).get("node") or p.stem
        except Exception:
            node = p.stem
        if node in ctx.tree["nodes"]:
            continue
        closed += 1
        if dry_run:
            print(f"  would close lock for '{node}' — not in the tree")
        else:
            _close_lock(ctx, p, "node is not in the tree")
            print(f"  closed     claim on '{node}' — not in the tree")
    if not closed:
        print("  locks      every claim names a node that exists")

    stale_m, unattr_m = orphan_marks(ctx)
    for task, rec in sorted(stale_m.items()):
        f = ctx.state_file("marks", task, ".json")
        if dry_run:
            print(f"  would close mark '{task}' — names '{rec.get('_node')}', not in the tree")
            continue
        rec["_closed_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        rec["_closed_because"] = f"node '{rec.get('_node')}' is not in the tree"
        rec["_delta"] = None
        f.write_text(json.dumps(rec, indent=2) + "\n")
        print(f"  closed     mark '{task}' — named '{rec.get('_node')}', not in the tree")
    if not stale_m:
        print("  marks      every open task record names a node that exists")
    if unattr_m:
        # Reported, never guessed. Which node a pre-`_node` mark belonged to is
        # not recoverable, and inventing one would put a wrong number in a ledger
        # that exists to be trusted.
        print(f"  note       {len(unattr_m)} open task record(s) name no node "
              f"(they predate the field): {', '.join(sorted(unattr_m))}")
        print(f"  {'':<10} close with: harness mark <task> --close --force")
    rc, porc, _ = git("worktree", "list", "--porcelain", cwd=ctx.repo)
    cur, stray = None, []
    for line in porc.splitlines():
        if line.startswith("worktree "):
            cur = line.split(" ", 1)[1]
        elif line.startswith("branch ") and cur:
            br = line.split(" ", 1)[1].replace("refs/heads/", "")
            if br not in idx["byBranch"]:
                stray.append((br, cur))
    for br, wt in stray:
        print(f"  note       worktree {wt} is on '{br}', which is not a node")
    orphan_br = []
    rc, brs, _ = git("for-each-ref", "--format=%(refname:short)", "refs/heads", cwd=ctx.repo)
    if rc == 0:
        known = set(idx["byBranch"])
        orphan_br = [b for b in brs.split() if b not in known]
    if orphan_br:
        print(f"  note       branch(es) that are not nodes: {', '.join(sorted(orphan_br))}")
    empty = sorted(n for n, s in idx["nodes"].items() if not s["worktree"])
    if empty:
        print(f"  note       node(s) with no worktree: {', '.join(empty)}")
    return idx


def cmd_trim(a):
    """Remove nodes from the tree, and make every store that records them agree.

    Node state lives in THREE places and nothing tells you the second and third
    exist: `.harness/tree.json` in the repo, which is the definition and travels
    with it; `~/.claude/harness/<slug>/index.json`, a derived cache; and
    `.../locks/*.lock`, the claims. A session asked to remove six nodes proved
    containment by hand, removed six worktrees and six branches, hand-edited the
    tree, rebuilt the index on a guess, and then found `status` still naming all
    six from the third store. This command is that sequence, in order, with the
    containment proof first and every refusal raised before anything is deleted.

    Called with no nodes it only reconciles, which is the repair path for a tree
    that was already trimmed by hand.

    The tree is a document, so only rank 0 may shrink it — the same rule the
    pre-commit guard would enforce a moment later, applied before the damage.
    """
    ctx = Ctx(); ctx.require_enrolled()
    idx = load_index(ctx, refresh=True)
    here = idx["byBranch"].get(ctx.branch)
    targets = list(dict.fromkeys(a.node))

    if not targets:
        print(f"reconciling {ctx.tree.get('project', ctx.repo.name)} "
              f"({len(ctx.tree['nodes'])} node(s) in the tree)")
        _reconcile(ctx, dry_run=a.dry_run)
        return

    if here is None:
        die(NOT_ENROLLED, f"branch '{ctx.branch}' is not a node, so there is no rank to check")
    if idx["nodes"][here]["rank"] != 0:
        die(REFUSED,
            f"'{here}' is rank {idx['nodes'][here]['rank']}. The tree is a document and\n"
            f"           {ctx.tree_path} lives in rank 0's worktree — editing it from here\n"
            f"           writes into another node's checkout, and the guard would refuse the\n"
            f"           commit anyway. Trim from rank 0.")

    # Fail closed. Every other reader of the roster can shrug and carry on with a
    # worse answer; this one would delete a worktree somebody is standing in.
    try:
        rows = live_rows(agents_json())
    except Exception as e:
        die(REFUSED, f"cannot read the session roster ({e}).\n"
                     f"           Occupancy is unknown, and a trim that guesses wrong "
                     f"deletes an occupied worktree.")
    occ = {}
    for r in rows:
        n = idx["byWorktree"].get(r.get("cwd", ""))
        if n:
            occ.setdefault(n, []).append(r)

    # Every refusal is collected before anything is deleted. A trim that removes
    # three of six nodes and then stops leaves the tree in a state no store
    # describes, which is the failure this command exists to end.
    refusals, plan = [], []
    for n in sorted(targets, key=lambda x: -idx["nodes"].get(x, {}).get("rank", 0)):
        sp = idx["nodes"].get(n)
        if sp is None:
            refusals.append(f"{n}: not a node in {ctx.tree_path}"); continue
        if sp["rank"] == 0:
            refusals.append(f"{n}: rank 0 — the root is not removable"); continue
        orphans = [c for c in sp["children"] if c not in targets]
        if orphans:
            refusals.append(f"{n}: would orphan {', '.join(orphans)} — name them too")
            continue
        if n in occ:
            who = ", ".join((r.get("name") or "?") for r in occ[n])
            refusals.append(f"{n}: occupied by {who} — `harness stop {n}` first"); continue

        wt, br = sp["worktree"], sp["branch"]
        if wt:
            rc, out, _ = git("status", "--porcelain", cwd=wt)
            if rc == 0 and out.strip() and not a.force:
                refusals.append(f"{n}: worktree is dirty ({len(out.splitlines())} path(s)) — "
                                f"commit, stash, or --force"); continue

        # The proof. Every commit on this branch must already be reachable from
        # the parent, or removing the branch destroys the only reference to it.
        held = None
        pb = idx["nodes"][sp["parent"]]["branch"] if sp["parent"] else None
        if br and pb and git("rev-parse", "--verify", "--quiet", br, cwd=ctx.repo)[0] == 0:
            rc, ahead, _ = git("rev-list", "--count", f"{pb}..{br}", cwd=ctx.repo)
            if rc != 0 or not ahead.strip().isdigit():
                # Not proven contained is not the same as proven empty, and the
                # difference is somebody's work.
                if not a.force:
                    refusals.append(f"{n}: cannot count commits against {sp['parent']} — "
                                    f"containment is unproven, not proven empty"); continue
                held = "CONTAINMENT UNPROVEN"
            else:
                lost = int(ahead.strip())
                if lost and not a.force:
                    rc, log, _ = git("log", "--oneline", "-5", f"{pb}..{br}", cwd=ctx.repo)
                    detail = "; ".join(log.splitlines()[:5]) if rc == 0 else "unreadable"
                    refusals.append(f"{n}: {lost} commit(s) not in {sp['parent']} — {detail}")
                    continue
                held = f"held by {sp['parent']}" if not lost else f"LOSES {lost} commit(s)"
        elif br:
            held = "branch does not exist"
        plan.append((n, wt, br, held))

    if refusals:
        print(f"refusing — nothing removed ({len(refusals)} of {len(targets)}):")
        for r in refusals:
            print(f"  {r}")
        sys.exit(REFUSED)

    print(f"trim {len(plan)} node(s) from {ctx.tree.get('project', ctx.repo.name)}:")
    for n, wt, br, held in plan:
        print(f"  {n:<12} branch {br or '—':<14} {held or ''}")
        print(f"  {'':<12} worktree {wt or '— none registered'}")
    if a.dry_run:
        print("dry run — no worktree, branch, tree entry or claim was touched. "
              "The reconcile pass would then:")
        _reconcile(ctx, dry_run=True)
        return

    # A git operation can still fail here — a worktree on a mount that went away,
    # a ref another process is holding. The loop stops at the first one, but the
    # tree is written for what DID go, so no store is left describing a node that
    # no longer exists. Partial is acceptable; partial and unrecorded is not.
    done, stopped = [], None
    for n, wt, br, held in plan:
        if wt:
            cmd = ["worktree", "remove"] + (["--force"] if a.force else []) + [wt]
            rc, _, err = git(*cmd, cwd=ctx.repo)
            print(f"  {'removed' if rc == 0 else 'FAILED '}    worktree {wt}"
                  + ("" if rc == 0 else f"  {err.strip()[:120]}"))
            if rc:
                stopped = n; break
        if br:
            vrc, sha, _ = git("rev-parse", "--short", "--verify", "--quiet", br, cwd=ctx.repo)
            if vrc == 0:
                rc, _, err = git("branch", "-D", br, cwd=ctx.repo)
                # The sha is the only handle left once the ref is gone. Under
                # --force it is also the only route back to work the parent
                # never took.
                print(f"  {'deleted' if rc == 0 else 'FAILED '}    branch {br} "
                      f"(was {sha.strip()})" + ("" if rc == 0 else f"  {err.strip()[:120]}"))
                if rc:
                    stopped = n; break
        ctx.tree["nodes"].pop(n, None)
        done.append(n)
    git("worktree", "prune", cwd=ctx.repo)

    ctx.tree_path.write_text(json.dumps(ctx.tree, indent=2) + "\n")
    print(f"  wrote      {ctx.tree_path}  ({len(ctx.tree['nodes'])} node(s) remain)")
    rel = str(ctx.tree_path.relative_to(ctx.repo))
    git("add", "--", rel, cwd=ctx.repo)
    _reconcile(ctx)
    if done:
        print(f"one step remains — the tree is a tracked document and this edit is staged, "
              f"not committed:\n  git -C '{ctx.repo}' commit -m "
              f"'Trim {', '.join(done)} from the tree'")
    if stopped:
        die(REFUSED, f"stopped at '{stopped}' — git refused above. "
                     f"{len(done)} node(s) removed and recorded; nothing after it was touched.")


# ── I11: reach beyond the worktree is granted at enrolment, never in the tree ─

def load_grants(ctx):
    p = ctx.state / "grants.json"
    if not p.exists():
        return {"nodes": {}}
    try:
        return json.loads(p.read_text())
    except json.JSONDecodeError:
        die(REFUSED, f"{p} is not valid JSON — refusing to guess at a permission set")


def grants_for(ctx, node):
    """What this machine's owner declared this node may reach outside its worktree.

    Machine-local by decision. A grant in the repository would be a document, and
    rank 0 edits documents, so the tree could widen its own permissions — and the
    grant would travel to machines whose owner never agreed to it. Enrolment is
    where a machine consents to participate, so it is where its owner says how
    far. Same key, same scope, and it cannot arrive by merge.
    """
    return [r for r in load_grants(ctx).get("nodes", {}).get(node, [])
            if not r.get("revoked_at")]


def launch_cmd(ctx, node, name, grants, model, effort, prompt):
    """The `claude --bg` line for a node, with its rank's auto-compaction
    threshold (obs 60) so a lead compacts at a size the tree chose."""
    cmd = ["claude", "--bg", "-n", name] + grant_flags(grants, model, effort)
    if model:
        cmd += ["--model", model]
    if effort:
        cmd += ["--effort", effort]
    ac = context_limits(ctx, node)[1]
    if ac:
        cmd += ["--autocompact", str(ac)]
    return cmd + [prompt]


def grant_flags(rows, model, effort):
    """Grants -> `claude` flags, using documented additive flags only.

    `--settings` takes a JSON string and is documented as ADDITIONAL settings, so
    it widens without replacing what the machine already allows. `--add-dir` is
    variadic, which means a bare list before a positional argument can swallow
    the prompt; it is therefore emitted only when a `--model`/`--effort` flag is
    guaranteed to follow it and stop the greed. No invented settings schema:
    `permissions.allow` is the same key `install.sh` merges into.
    """
    dirs, rules = [], []
    for r in rows:
        if r.get("rule"):
            rules.append(r["rule"]); continue
        p = "//" + r["path"].lstrip("/")
        rules += [f"Read({p})", f"Write({p})"]
        d = str(Path(r["path"]).parent)
        if d not in dirs:
            dirs.append(d)
    out = []
    if rules:
        out += ["--settings", json.dumps({"permissions": {"allow": rules}})]
    if dirs and (model or effort):
        for d in dirs:
            out += ["--add-dir", d]
    elif dirs:
        print("  WARNING: grants need --add-dir but this node sets neither model nor "
              "effort, so nothing would stop the flag consuming the prompt. Reach not "
              "applied; the permission rules were.", file=sys.stderr)
    return out


def append_inbox(rec):
    p = HOME_STATE / "inbox.jsonl"
    p.parent.mkdir(parents=True, exist_ok=True)
    with p.open("a") as fh:
        fh.write(json.dumps(rec) + "\n")


def _epoch(ts):
    """Seconds since the epoch, for either timestamp shape the harness handles.

    Records this CLI writes carry a local offset (`+1000`); timestamps lifted
    from a transcript are UTC with a `Z`. Parsing the second as though it were
    the first put every derived age out by the local offset — ten hours here —
    so a task presented a minute ago read as presented overnight. The offset was
    being truncated away, which is worse than failing: it produced a plausible
    number rather than an error.
    """
    t = (ts or "").strip().replace("Z", "+0000")
    if not t:
        return None
    for fmt in ("%Y-%m-%dT%H:%M:%S%z", "%Y-%m-%dT%H:%M:%S.%f%z"):
        try:
            return datetime.datetime.strptime(t, fmt).timestamp()
        except ValueError:
            pass
    try:                       # no offset at all: assume local, as before
        return time.mktime(time.strptime(t[:19], "%Y-%m-%dT%H:%M:%S"))
    except Exception:
        return None


def _when(ts):
    """A stored instant, rendered in the reader's own clock, with its offset.

    The companion to `_epoch`, and it exists for the same reason one turn later.
    `_epoch` fixed derived AGES across the two timestamp shapes; nothing fixed
    absolute DISPLAY, so `str(ts)[:19]` kept being written — which truncates the
    `Z` off a UTC instant and prints it bare in a tree where every other
    timestamp a reader meets carries `+10:00`.

    That is not decoration when the timestamp is the evidence for a claim in the
    same sentence. `recycle` prints "all of them presented at T. Nothing to
    strand." A reader checking whether the work really was offered upward
    compares T against a commit time git gives them in local, finds a ten-hour
    gap that does not exist, and stops — so the more careful the reader, the
    more likely the message is to fail. It did exactly that.
    """
    e = _epoch(ts)
    if e is None:
        return str(ts or "?")
    return time.strftime("%Y-%m-%d %H:%M:%S %z", time.localtime(e))


def _ago(ts):
    then = _epoch(ts)
    if then is None:
        return "?"
    d = max(0, int(time.time() - then))
    if d < 90:
        return f"{d}s ago"
    if d < 5400:
        return f"{d // 60}m ago"
    if d < 172800:
        return f"{d // 3600}h ago"
    return f"{d // 86400}d ago"


def load_charter(ctx):
    """What the project is, and which features are in scope. One object, held
    beside the briefs because it is the same kind of thing: a working document
    the operator owns, not a record that must survive audit.

    It exists because a tree with no statement of purpose divides the only thing
    it can see. Rank 0 reading a repository finds failing checks, stale
    docstrings and disagreements between artefacts, and if nothing says what the
    project is FOR, that list becomes the plan. It is a maintenance backlog
    wearing a plan's clothes: it cannot be prioritised, because nothing in it
    says what matters, and it cannot say what is OUT of scope, because it was
    derived from what happens to be broken.

    The charter is prose, deliberately. Written to be understood rather than
    implemented from — because the reader who has to check it is a person, and a
    technical specification is the format a person will not read closely enough
    to notice that it describes the wrong project.
    """
    f = ctx.state / "charter.json"
    if not f.exists():
        return f, {"features": {}}
    try:
        c = json.loads(f.read_text())
    except json.JSONDecodeError:
        die(REFUSED, f"{f} is not valid JSON — refusing to overwrite a charter "
                     f"it cannot read")
    c.setdefault("features", {})
    return f, c


def charter_features(c, include_retired=False):
    """Every feature, in the order the operator put them.

    `include_retired` is accepted and ignored. Retiring is gone: a feature that
    left scope is deleted outright now, so there is no second class of feature
    to filter for, and callers that passed the flag were asking a question that
    no longer has two answers.
    """
    return {k: v for k, v, _ in charter_order(c)}


def charter_normalise(c):
    """Give every feature a position, and keep the nesting exactly two deep.

    `seq` and `parent` did not exist in the first charters and a dict has no
    order of its own, so the panel drew them alphabetically — an order nobody
    chose and one that moved a feature whenever it was renamed. Missing
    positions are backfilled from that alphabetical order, once, so the first
    read after this change looks exactly like the last read before it.
    """
    feats = c.get("features") or {}
    changed = False
    nxt = max([v["seq"] for v in feats.values()
               if isinstance(v.get("seq"), int)] or [-1]) + 1
    for k in sorted(feats):
        if not isinstance(feats[k].get("seq"), int):
            feats[k]["seq"] = nxt; nxt += 1; changed = True
    for v in feats.values():
        p = v.get("parent")
        # A parent that was deleted, or one that is itself nested. Either way
        # this is a top-level feature now, rather than an orphan nothing draws.
        if p is not None and (p not in feats or feats[p].get("parent")):
            v["parent"] = None; changed = True
    return changed


def charter_order(c):
    """[(key, feature, depth)] — parents first, each followed by its own."""
    feats = c.get("features") or {}
    kids, tops = {}, []
    for k, v in feats.items():
        p = v.get("parent")
        kids.setdefault(p, []).append(k) if p else tops.append(k)
    rank = lambda k: (feats[k].get("seq", 0), k)
    out = []
    for k in sorted(tops, key=rank):
        out.append((k, feats[k], 0))
        for ck in sorted(kids.get(k, []), key=rank):
            out.append((ck, feats[ck], 1))
    return out


def charter_reseq(c, parent):
    """Renumber one sibling group 0..n and return it in order.

    Every move writes a position that is deliberately out of line — 0.5 to land
    between two others, or a big number to land last — and then calls this. The
    alternative is arithmetic that keeps working until two features end up with
    the same seq and the order starts depending on the key.
    """
    feats = c.get("features") or {}
    sibs = sorted([k for k, v in feats.items() if (v.get("parent") or None) == parent],
                  key=lambda k: (feats[k].get("seq", 0), k))
    for n, k in enumerate(sibs):
        feats[k]["seq"] = n
    return sibs


def cmd_charter(a):
    """Read it from anywhere; write it from rank 0 or from a shell.

    Every node can read it and none is required to. That asymmetry is the point:
    a member does not need the project's purpose to execute a complete brief, and
    making it read one would be handing it context its task was scoped to
    exclude. But a member that wants to ask WHY has somewhere to look, and until
    now the only answer to that question was its lead's availability.

    Writing is rank 0's, or the operator's directly. A lead cannot amend the
    scope it was handed — that is the same act as a node setting its own task,
    one level up and harder to see.
    """
    ctx = Ctx(); ctx.require_enrolled()
    node, _ = ctx.node()
    f, c = load_charter(ctx)
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    who = f"{node} (session {sid[:8]})" if sid else "operator"
    now = time.strftime("%Y-%m-%dT%H:%M:%S%z")

    writing = (a.write is not None or a.delete or a.move
               or a.promote or a.demote)
    if writing and sid and ctx.rank(node) != 0:
        die(REFUSED,
            f"'{node}' is rank {ctx.rank(node)}. The charter is rank 0's, or the "
            f"operator's directly.\n           A lead amending the scope it was "
            f"handed is a node setting its own task,\n           one rank up and "
            f"harder to see. If it is wrong, say so to your lead.")

    if a.json:
        print(json.dumps(c, indent=2)); return

    # ── shaping the charter ────────────────────────────────────────────────
    # The charter is an outline now, not a flat list: features have an order the
    # operator set and may sit under one another. Two levels, deliberately — a
    # charter that can nest four deep stops being prose you read top to bottom
    # and becomes a document with a table of contents, which is the thing this
    # was written not to be.
    if a.delete or a.move or a.promote or a.demote:
        if not a.feature:
            die(REFUSED, "which one? --feature <name>")
        k = tkey(a.feature)
        feats = c.get("features") or {}
        if k not in feats:
            near = ", ".join(v.get("name", x) for x, v in feats.items()) or "none"
            die(REFUSED, f"no feature '{a.feature}' in the charter. In scope: {near}")
        charter_normalise(c)
        me = feats[k]
        parent = me.get("parent") or None
        name = me.get("name", k)

        if a.delete:
            # Absolute, and it says so. This is the one place the harness
            # removes something without leaving a row behind, because the
            # operator asked for a list they own rather than a ledger: a charter
            # that remembers everything ever proposed is one nobody rereads.
            kids = [x for x, v in feats.items() if v.get("parent") == k]
            for x in [k] + kids:
                feats.pop(x, None)
            charter_reseq(c, parent)
            f.parent.mkdir(parents=True, exist_ok=True)
            f.write_text(json.dumps(c, indent=2) + "\n")
            print(f"deleted '{name}'"
                  + (f" and {len(kids)} sub-feature(s) under it" if kids else ""))
            print("  Nothing was kept. If it left scope for a reason worth having,")
            print("  that reason belongs in the description, written by you.")
            return

        if a.move:
            sibs = charter_reseq(c, parent)
            i = sibs.index(k)
            j = i - 1 if a.move == "up" else i + 1
            if j < 0 or j >= len(sibs):
                where = "first" if a.move == "up" else "last"
                die(REFUSED, f"'{name}' is already {where} "
                             + ("in the charter" if parent is None
                                else f"under '{feats[parent].get('name', parent)}'"))
            o = sibs[j]
            feats[k]["seq"], feats[o]["seq"] = feats[o]["seq"], feats[k]["seq"]

        elif a.promote:
            if parent is None:
                die(REFUSED, f"'{name}' is already a feature in its own right")
            # Lands immediately after what it used to sit under, which is where
            # a reader was already looking for it.
            me["parent"] = None
            me["seq"] = feats[parent].get("seq", 0) + 0.5
            charter_reseq(c, None)
            charter_reseq(c, parent)

        elif a.demote:
            if parent is not None:
                die(REFUSED, f"'{name}' is already a sub-feature, and the charter "
                             f"nests two deep.\n           Two levels is enough to "
                             f"group with and few enough to still read as prose.")
            tops = charter_reseq(c, None)
            i = tops.index(k)
            if i == 0:
                die(REFUSED, f"'{name}' is the first feature — there is nothing "
                             f"above it to sit under")
            tgt = tops[i - 1]
            kids = [x for x, v in feats.items() if v.get("parent") == k]
            end = max([v.get("seq", 0) for x, v in feats.items()
                       if v.get("parent") == tgt] or [-1]) + 1
            me["parent"] = tgt
            me["seq"] = end
            # Its own follow it rather than going down with it. A feature that
            # swallowed its sub-features on the way down would take them out of
            # the charter with no way to see that it had.
            for n, x in enumerate(sorted(kids, key=lambda x: feats[x].get("seq", 0))):
                feats[x]["parent"] = tgt
                feats[x]["seq"] = end + 1 + n
            charter_reseq(c, tgt)
            charter_reseq(c, None)

        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(json.dumps(c, indent=2) + "\n")
        act = ("moved " + a.move) if a.move else ("promoted" if a.promote else "demoted")
        par = feats[k].get("parent")
        print(f"{act}: '{name}'"
              + (f" — now under '{feats[par].get('name', par)}'" if par
                 else " — now a feature in its own right" if a.promote else ""))
        return

    if a.write is not None:
        if not a.write.strip():
            die(REFUSED, "an empty charter is worse than none — it reads as though "
                         "the question\n           was answered.")
        if a.feature:
            charter_normalise(c)
            k = tkey(a.feature)
            prev = (c["features"].get(k) or {})
            # A new one goes last rather than wherever its name sorts to. Where
            # it belongs is the operator's call, and --move is how they make it.
            seq = prev.get("seq")
            if not isinstance(seq, int):
                seq = max([v.get("seq", 0) for v in c["features"].values()]
                          or [-1]) + 1
            c["features"][k] = dict(prev, name=a.feature, text=a.write,
                                    revision=prev.get("revision", 0) + 1,
                                    written_by=who, written_at=now,
                                    seq=seq, parent=prev.get("parent") or None)
            rev = c["features"][k]["revision"]
        else:
            prev = c.get("description") or {}
            c["description"] = {"text": a.write, "revision": prev.get("revision", 0) + 1,
                                "written_by": who, "written_at": now}
            rev = c["description"]["revision"]
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(json.dumps(c, indent=2) + "\n")
        what = f"feature '{a.feature}'" if a.feature else "the project description"
        print(f"charter: {what} written  (revision {rev}, by {who})")
        if rev > 1:
            print("  the previous text is gone — the charter is what the project is "
                  "NOW, not how it got here")
        print("  Every node can read it: harness charter")
        return

    if a.feature:
        k = tkey(a.feature)
        ft = (c.get("features") or {}).get(k)
        if not ft:
            near = ", ".join(v.get("name", k) for k, v
                             in charter_features(c).items()) or "none"
            die(REFUSED, f"no feature '{a.feature}' in the charter. In scope: {near}")
        par = ft.get("parent")
        print(f"{ft.get('name', k)}   revision {ft.get('revision')}"
              + (f"   under {(c['features'][par]).get('name', par)}"
                 if par and par in c.get("features", {}) else ""))
        print(f"  by {ft.get('written_by')} at {str(ft.get('written_at'))[:19]}\n")
        for line in (ft.get("text") or "").splitlines() or [""]:
            print(f"  {line}")
        return

    d = c.get("description") or {}
    if not d.get("text"):
        print("no charter for this project — nothing states what it is for.")
        if ctx.rank(node) == 0 or not sid:
            print("  Without one the only work visible from here is whatever "
                  "happens to be broken,\n  and a backlog is not a plan. Write it, "
                  "or edit it in `harness gui`:")
            print('    harness charter --write "..."')
            print('    harness charter --feature "<name>" --write "..."')
        return
    print(f"{ctx.repo.name}   charter revision {d.get('revision')}")
    print(f"  by {d.get('written_by')} at {str(d.get('written_at'))[:19]}\n")
    for line in (d.get("text") or "").splitlines():
        print(f"  {line}")
    # Indented, in the operator's order. The outline IS information — which
    # features are facets of one thing, and which stand on their own — and a
    # flat alphabetical list threw all of it away every time it printed.
    live = charter_order(c)
    if live:
        print(f"\n  {len(live)} feature(s) in scope:")
        for k, ft, depth in live:
            pad = "    " + "  " * depth
            first = (ft.get("text") or "").strip().splitlines()
            print(f"{pad}{ft.get('name', k)}")
            if not a.full and first:
                print(f"{pad}  {first[0][:96]}")
            for line in (ft.get("text") or "").splitlines() if a.full else []:
                print(f"{pad}  {line}")
    if not a.full and live:
        print(f"\n  harness charter --full        every feature in full")
        print(f"  harness charter --feature <name>")


def load_fact(ctx, name):
    f = ctx.state_file("facts", name, ".json")
    if not f.exists():
        # Folded by `sweep --stale`: still readable; a new observation revives it.
        return f, archived_knowledge(ctx, "facts", name)
    try:
        return f, json.loads(f.read_text())
    except json.JSONDecodeError:
        die(REFUSED, f"{f} is not valid JSON — refusing to overwrite a fact it "
                     f"cannot read")


def all_facts(ctx):
    d = ctx.state / "facts"
    out = {}
    for p in (sorted(d.glob("*.json")) if d.is_dir() else []):
        try:
            r = json.loads(p.read_text())
        except Exception:
            continue
        r.setdefault("name", p.stem)
        out[p.stem] = r
    return out


def latest(fact):
    obs = fact.get("observations") or []
    return obs[-1] if obs else None


def fact_state(ctx, o):
    """Whether an observation still describes the tree the reader is standing in.

    Two separate things can have moved, and conflating them is how a stale
    figure passes for a current one. The COMMIT may have moved, which makes the
    figure old. The WORKTREE may be a different one, which makes it a different
    measurement — two lanes ran the same check honestly and got 1 and 9, because
    npm ci leaves node_modules/ and surface/build/ behind and both are invisible
    to git status. A worktree that has ever run an install is not the tree the
    next reader holds.

    Stale means the MEASURING worktree has moved past the sha, not that the
    reader stands somewhere else (obs 54). Returns (fresh, same_wt, head, rel):
    fresh is None when the measuring worktree is gone; rel is how the reader's
    HEAD relates to the measured sha when they are in another worktree.
    """
    head = git("rev-parse", "HEAD", cwd=ctx.worktree)[1].strip()
    sha = o.get("sha") or ""
    same_wt = str(o.get("worktree") or "") == str(ctx.worktree)
    if same_wt:
        return bool(sha) and sha == head, True, head, None
    wt = Path(str(o.get("worktree") or ""))
    rc, wt_head, _ = git("rev-parse", "HEAD", cwd=wt) if wt.is_dir() else (1, "", "")
    fresh = (bool(sha) and sha == wt_head.strip()) if rc == 0 else None
    return fresh, False, head, sha_relation(ctx, sha, head)


def sha_relation(ctx, sha, head):
    """How `head` relates to a measured `sha`, in words."""
    if not sha:
        return "unknown"
    if sha == head:
        return "is the measured commit"
    anc = lambda a, b: git("merge-base", "--is-ancestor", a, b, cwd=ctx.worktree)[0] == 0
    if anc(sha, head):
        return "contains the measured commit"
    if anc(head, sha):
        return "is behind the measured commit"
    return "has diverged from the measured commit"


def run_recorded(cmd, cwd, timeout):
    """Run the command a previous session recorded. This is the whole point of
    recording it — but it is also arbitrary code from another session's
    transcript, so it is never automatic and never implied. Nothing in the
    harness re-runs one of these except `--recheck`, typed deliberately."""
    try:
        r = subprocess.run(cmd, shell=True, cwd=cwd, capture_output=True,
                           text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return None, f"timed out after {timeout}s", 124
    out = (r.stdout or "").strip()
    return out, (r.stderr or "").strip(), r.returncode


def cmd_fact(a):
    """A measured value, and the command that produced it.

    Written because sessions kept re-deriving figures that another session had
    already measured — and, worse, kept re-deriving *how* to measure them, which
    is the expensive half. A number in prose ages silently and carries no way to
    check it, so the honest thing to write beside one is a date and an
    instruction to re-derive, and that is exactly what a lead ended up doing by
    hand: "RECORDED 2026-08-30 and deliberately not re-measured since. Re-derive
    before acting."

    So the command is not optional. A value with no way to reproduce it is a
    rumour with a number attached, and the next session either believes it or
    pays the full cost of the original derivation. Record the command and it
    pays for one `--recheck`.

    Facts are OBSERVATIONS, appended, never edited ([[I6]]). What a figure was
    last week and what it is now is usually the interesting part; a store that
    overwrote would delete the finding.

    Any node may write one. This is not authority — a measurement is not an
    instruction and does not tell anyone what to do. The member running the
    command is the one who has the number, and routing it through a lead to be
    retyped is how a digit changes.
    """
    ctx = Ctx(); ctx.require_enrolled()
    node, _ = ctx.node()
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    who = f"{node} (session {sid[:8]})" if sid else "operator"

    if a.list or not a.name:
        rows = all_facts(ctx)
        if not rows:
            print("no facts recorded — nothing measured here has been written down "
                  "with\nthe command that measured it.  harness fact <name> --is "
                  "\"...\" --from \"...\"")
            return
        for k, r in sorted(rows.items()):
            o = latest(r)
            if not o:
                continue
            fresh, same_wt, _, _ = fact_state(ctx, o)
            flag = ("tree moved since" if fresh is False
                    else "current" if same_wt
                    else "OTHER WORKTREE")
            print(f"  {r.get('name', k):<24} {str(o.get('value'))[:34]:<36} {flag}")
            print(f"  {'':<24} {_ago(o.get('at'))} by {o.get('by')}"
                  + (f"   ({len(r['observations'])} observations)"
                     if len(r.get("observations") or []) > 1 else ""))
        print(f"\n{len(rows)} fact(s). Each carries the command that produced it: "
              f"harness fact <name>")
        return

    f, r = load_fact(ctx, a.name)

    if a.is_ is not None or a.from_ is not None:
        if a.is_ is None or not str(a.is_).strip():
            die(REFUSED, "--is needs the value. Record it in the command's OWN words, "
                         "not yours —\n           a value you paraphrased is one "
                         "`--recheck` can never compare against.")
        if a.from_ is None or not a.from_.strip():
            die(REFUSED,
                "--from is required: the command that produced this value.\n"
                "           A number with no way to reproduce it is a rumour with a "
                "figure attached,\n           and the next session either believes it "
                "or pays the whole derivation\n           again. That cost is the "
                "reason this command exists.")
        head = git("rev-parse", "HEAD", cwd=ctx.worktree)[1].strip()
        r = r or {"name": a.name, "observations": []}
        if a.what:
            r["what"] = a.what
        r.setdefault("observations", []).append(
            {"value": a.is_, "command": a.from_, "node": node,
             "worktree": str(ctx.worktree), "sha": head, "by": who,
             "at": time.strftime("%Y-%m-%dT%H:%M:%S%z")})
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(json.dumps(r, indent=2) + "\n")
        n = len(r["observations"])
        print(f"fact '{a.name}' = {a.is_}   (observation {n}, by {who})")
        print(f"  from: {a.from_}")
        print(f"  at {head[:8]} in {ctx.worktree}")
        if n > 1:
            prev = r["observations"][-2]
            if str(prev.get("value")) != str(a.is_):
                print(f"  CHANGED from {prev.get('value')} "
                      f"({_ago(prev.get('at'))}, {str(prev.get('sha'))[:8]})")
        print(f"  Cite it rather than pasting the number: harness fact {a.name}")
        return

    if r is None:
        die(REFUSED, f"no fact '{a.name}'. Whoever measured it records it with the "
                     f"command:\n           harness fact {a.name} --is \"...\" "
                     f"--from \"...\"")
    o = latest(r)
    if o is None:
        die(REFUSED, f"'{a.name}' has no observations")

    if a.recheck:
        cwd = ctx.worktree
        _, same_wt, head, _ = fact_state(ctx, o)
        print(f"re-running: {o['command']}")
        if not same_wt:
            print(f"  NOTE it was measured in {o.get('worktree')} and you are in "
                  f"{cwd}.")
            print(f"       A different worktree is a different measurement, not a "
                  f"disagreement —\n       an install directory that git cannot see "
                  f"changes what a check counts.")
        out, err, rc = run_recorded(o["command"], cwd, a.timeout)
        if out is None:
            die(CONTRACT, f"recheck failed: {err}")
        print(f"  exit {rc}")
        for line in (out or "(no output)").splitlines()[:20]:
            print(f"  | {line}")
        if err:
            for line in err.splitlines()[:5]:
                print(f"  ! {line}")
        r["observations"].append(
            {"value": out, "command": o["command"], "node": node,
             "worktree": str(cwd), "sha": head, "by": who, "exit": rc,
             "rechecked": True, "at": time.strftime("%Y-%m-%dT%H:%M:%S%z")})
        f.write_text(json.dumps(r, indent=2) + "\n")
        if out.strip() == str(o.get("value")).strip():
            print(f"\n  UNCHANGED — same as the recorded value, {_ago(o.get('at'))}")
        else:
            print(f"\n  recorded value was: {o.get('value')}")
            print(f"  the two are not textually equal. Compare them yourself: this "
                  f"does not\n  claim a verdict, because a value someone phrased in "
                  f"their own words differs\n  from its own command's output without "
                  f"anything having changed.")
        return

    if not f.exists():
        print("[archived] folded by `harness sweep --stale`; a new observation brings it back")
    for x in (r.get("observations") or [])[-3:]:
        for g in gone_job_files(x):
            print(f"  GONE     --from reads {g} — it no longer exists; this observation "
                  f"can't be re-checked")
    fresh, same_wt, head, rel = fact_state(ctx, o)
    print(f"{r.get('name')} = {o.get('value')}")
    if r.get("what"):
        print(f"  {r['what']}")
    print(f"  from     {o.get('command')}")
    print(f"  measured {_ago(o.get('at'))} by {o.get('by')}  at {str(o.get('sha'))[:8]}")
    if not same_wt:
        print(f"  WORKTREE {o.get('worktree')}")
        print(f"           not the one you are standing in — a check can count "
              f"differently in a\n           tree that has run an install, and git "
              f"cannot see the difference.")
    if same_wt:
        print(f"  STALE    this tree has moved since ({head[:8]} now). Re-run it:"
              if not fresh else
              f"  current  measured at the commit you are standing on. Re-run it:")
        print(f"           harness fact {r.get('name')} --recheck")
    else:
        print(f"  yours    your HEAD ({head[:8]}) {rel}")
        if fresh is False:
            print(f"  STALE    that worktree has moved since; recheck it there")
        elif fresh is None:
            print(f"  gone     that worktree no longer exists")
    obs = r.get("observations") or []
    if len(obs) > 1:
        print(f"\n  {len(obs)} observations:")
        for x in obs[-6:]:
            print(f"    {str(x.get('at'))[:16]}  {str(x.get('value'))[:40]:<42} "
                  f"{str(x.get('sha'))[:8]}  {x.get('node')}")


def all_findings(ctx):
    d = ctx.state / "findings"
    out = {}
    for p in (sorted(d.glob("*.json")) if d.is_dir() else []):
        try:
            r = json.loads(p.read_text())
        except Exception:
            continue
        r.setdefault("name", p.stem)
        out[p.stem] = r
    return out


def finding_route(ctx, node, who, a, r, f):
    """`--to <child>` hands a finding down; `--ruled <ref>` closes it as
    answered by a document change (obs 57). Only its addressee may do either."""
    if r is None:
        die(REFUSED, f"no finding '{a.name}'")
    if r.get("to") != node:
        die(REFUSED, f"'{a.name}' is addressed to '{r.get('to')}', not '{node}'")
    closed = r.get("became") or r.get("dropped_at") or r.get("ruled_at")
    if closed:
        die(REFUSED, f"'{a.name}' is already closed"
                     + (f" — it became '{r['became']}'" if r.get("became") else ""))
    now = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    if a.ruled is not None:
        if not a.ruled.strip():
            die(REFUSED, 'name what answered it: --ruled "<commit or document ref>"')
        r.update(ruled_at=now, ruled_by=who, ruled_ref=a.ruled)
        f.write_text(json.dumps(r, indent=2) + "\n")
        print(f"ruled '{a.name}' — answered in {a.ruled}; closed, not declined")
        return
    if a.to not in ctx.children(node):
        die(REFUSED, f"'{a.to}' is not your child. A finding moves one rank at a time.")
    r.setdefault("handed", []).append({"from": node, "by": who, "at": now})
    r["to"] = a.to
    if ctx.rank(node) == 0:
        r["approved_by"] = node            # rank 0 decided it is worth a session
    f.write_text(json.dumps(r, indent=2) + "\n")
    print(f"handed '{a.name}' to {a.to} — it may brief from it: "
          f"harness brief <task> --for <child> --from-finding {a.name} --write -"
          + ("\n  approved by rank 0 on the way down: the brief will not be gated" if r.get("approved_by") else ""))


def open_findings(ctx, lead=None):
    """Findings nobody has turned into a task or declined.

    Addressed to the LEAD of the node that made the claim, because the claim is
    about work the claimant was not given and must not take. A member that acts
    on what it noticed is choosing its own task; a member that says nothing has
    thrown away the most expensive thing the session produced.
    """
    out = {}
    for k, r in all_findings(ctx).items():
        if r.get("became") or r.get("dropped_at") or r.get("ruled_at"):
            continue
        if lead is not None and r.get("to") != lead:
            continue
        out[k] = r
    return out


def cmd_finding(a):
    """Potential work, noticed while doing something else, handed one rank up.

    This is the channel that was missing, and its absence had a shape: a lane
    would learn something real — that a pixel size is not a size on screen
    because the offset is added before the perspective divide, so nothing at two
    depths is painted alike — and there was nowhere for it to go. Not a block: it
    asks the operator for nothing. Not a suggestion: it is not about this task's
    brief. Not a fact: there is no command that produces it. So it went in a
    report, and a report is read once by one session and then ends.

    It goes to the lead, not to the operator and not sideways, because the lead
    is the only party that may turn it into a task. And it carries HOW it was
    found on the same rule as [[I13]]: 'found by looking at a screenshot after
    the arm went green' is the difference between a claim a lead can weigh and
    one it can only believe.
    """
    ctx = Ctx(); ctx.require_enrolled()
    node, _ = ctx.node()
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    who = f"{node} (session {sid[:8]})" if sid else "operator"
    f = ctx.state_file("findings", a.name or "_", ".json")

    if a.list or not a.name:
        rows = open_findings(ctx, None if a.all else node)
        if not rows:
            print("no open findings" + ("" if a.all else " addressed to you"))
            return
        for k, r in sorted(rows.items()):
            print(f"  {r.get('name', k)}   from {r.get('from')} → {r.get('to')}   "
                  f"{_ago(r.get('at'))}")
            for line in (r.get("what") or "").splitlines():
                print(f"      {line}")
            if r.get("how"):
                print(f"    found by: {r['how']}")
            if r.get("fact"):
                print(f"    fact: {r['fact']}  — harness fact {r['fact']}")
        print(f"\n{len(rows)} open. Each is potential work nobody has scoped. Turn one "
              f"into a task:")
        print(f"  harness brief <task> --for <node> --from-finding <name> --write \"...\"")
        print(f"or decline it, on the record:  harness finding <name> --drop \"why\"")
        return

    _, r = (f, json.loads(f.read_text())) if f.exists() else (f, None)
    if r is None and not (a.to or a.ruled is not None or a.drop is not None or a.what):
        r = archived_knowledge(ctx, "findings", a.name)
        if r is not None:
            print("[archived] folded by `harness sweep --stale`")

    if a.to or a.ruled is not None:
        return finding_route(ctx, node, who, a, r, f)
    if a.drop is not None:
        if r is None:
            die(REFUSED, f"no finding '{a.name}'")
        if not a.drop.strip():
            die(REFUSED, "say why. A finding that disappears without a reason is "
                         "indistinguishable\n           from one nobody read, and the "
                         "next lane will find it again.")
        if r.get("to") != node:
            die(REFUSED, f"'{a.name}' was handed to '{r.get('to')}', not '{node}'. "
                         f"Only the lead it was\n           addressed to decides what "
                         f"becomes of it.")
        r["dropped_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        r["dropped_by"] = who
        r["dropped_why"] = a.drop
        f.write_text(json.dumps(r, indent=2) + "\n")
        print(f"declined '{a.name}' — it stays on the record with your reason")
        print(f"  {a.drop}")
        return

    if a.what is None:
        if r is None:
            die(REFUSED, f"no finding '{a.name}'. Record one:\n"
                         f"           harness finding {a.name} --what \"...\" "
                         f"--how \"how you found it\"")
        print(f"{r.get('name')}   from {r.get('from')} → {r.get('to')}   "
              f"{_ago(r.get('at'))}   at {str(r.get('sha'))[:8]}")
        print()
        for line in (r.get("what") or "").splitlines():
            print(f"  {line}")
        if r.get("how"):
            print(f"\n  found by: {r['how']}")
        if r.get("fact"):
            print(f"  fact:     {r['fact']}")
        if r.get("became"):
            print(f"\n  became the task '{r['became']}'")
        if r.get("ruled_at"):
            print(f"\n  ruled {str(r['ruled_at'])[:19]} by {r.get('ruled_by')}: "
                  f"answered in {r.get('ruled_ref')}")
        for h in r.get("handed") or []:
            print(f"  handed down by {h.get('from')} {str(h.get('at'))[:16]}")
        if r.get("dropped_at"):
            print(f"\n  declined {str(r['dropped_at'])[:19]} by {r.get('dropped_by')}: "
                  f"{r.get('dropped_why')}")
        return

    if not a.what.strip():
        die(REFUSED, "an empty finding says nothing")
    if not (a.how or "").strip():
        die(REFUSED,
            "--how is required: how you came to this.\n"
            "           'found by looking at a screenshot after the arm went green' is "
            "the\n           difference between a claim your lead can weigh and one it "
            "can only\n           believe. A claim with no derivation is the thing this "
            "harness spent\n           four sessions learning not to act on.")
    if a.fact and load_fact(ctx, a.fact)[1] is None:
        die(REFUSED, f"no fact '{a.fact}' to cite. Record the measurement first: "
                     f"harness fact {a.fact} --is \"...\" --from \"...\"")
    lead = ctx.tree["nodes"].get(node, {}).get("parent")
    if not lead:
        die(REFUSED, f"'{node}' is rank 0 and has no lead to hand this to. What you "
                     f"noticed is\n           yours to brief or to drop; the finding "
                     f"channel exists to cross a rank.")
    rec = {"name": a.name, "what": a.what, "how": a.how, "fact": a.fact or "",
           "from": node, "to": lead, "by": who,
           "sha": git("rev-parse", "HEAD", cwd=ctx.worktree)[1].strip(),
           "at": time.strftime("%Y-%m-%dT%H:%M:%S%z")}
    f.parent.mkdir(parents=True, exist_ok=True)
    f.write_text(json.dumps(rec, indent=2) + "\n")
    print(f"finding '{a.name}' handed to {lead}")
    print(f"  It sees it at its next harness command. Nothing else happens: this is")
    print(f"  potential work, and it is not yours to start — carry on with your brief.")
    return


def load_brief(ctx, task):
    f = ctx.state_file("briefs", task, ".json")
    if not f.exists():
        return f, None
    try:
        return f, json.loads(f.read_text())
    except json.JSONDecodeError:
        die(REFUSED, f"{f} is not valid JSON — refusing to overwrite a brief it cannot read")


def brief_node(ctx, task, explicit=None):
    """Which node a brief is for: what was said, then what was stored, then the
    mark. Never inferred from who is asking."""
    if explicit:
        return explicit
    _, b = load_brief(ctx, task)
    if b and b.get("node"):
        return b["node"]
    mf = ctx.state_file("marks", task, ".json")
    if mf.exists():
        try:
            return json.loads(mf.read_text()).get("_node")
        except Exception:
            pass
    return None


def tkey(name):
    """The filename a task id becomes. Two ids that differ only in punctuation
    are the same brief, so lineage has to be compared on this, not on what was
    typed — otherwise `--from corpus-ingest` never matches the brief stored as
    corpus_ingest and the split silently fails to count."""
    return re.sub(r"[^A-Za-z0-9]", "_", name or "")


def all_briefs(ctx):
    """Every brief, keyed by its file stem, each carrying the task id its writer
    typed. Callers print the id and match on the stem."""
    d = ctx.state / "briefs"
    out = {}
    for p in (sorted(d.glob("*.json")) if d.is_dir() else []):
        try:
            b = json.loads(p.read_text())
        except Exception:
            continue
        b.setdefault("task", p.stem)
        out[p.stem] = b
    return out


def unactioned_briefs(ctx, node):
    """Briefs handed to this node that it has neither started nor passed on.

    A brief is how work travels exactly one rank. For a member that is the end
    of the line, so opening a mark is the only thing that discharges it. For a
    lead it is not: a lead's brief is a segment it is expected to break up, and
    the break-up IS the cascade. Without this, a brief written for a lead sits
    in a directory nobody is asked to look in, and the rank below never learns
    the work exists.

    A brief is discharged by a mark (this node is doing it) or by a brief
    derived from it (this node has split it). Both are real answers; neither is
    guessed. Cleared by doing the right thing, not by dismissing a warning.
    """
    briefs = all_briefs(ctx)
    derived = {tkey(b.get("from")) for b in briefs.values() if b.get("from")}
    return sorted(b["task"] for k, b in briefs.items()
                  if b.get("node") == node
                  and k not in derived
                  and not superseded(b) and not refused(b)
                  and not ctx.state_file("marks", k, ".json").exists())


def inherited_marks(ctx, live_ids):
    """Open marks whose opening session is gone.

    A mark outlives the session that opened it and looks identical to a live
    one. It survives recycles, so every fresh session's orientation names it as
    the work in front of them — and the dead session may have produced nothing
    at all, which is a stale POSITION rather than partial work. No surface told
    those apart, and the difference decides whether to resume or to abandon.

    It also quietly corrupts the ledger. R13 means the band was measured against
    a transcript that no longer exists, so the spend delta records a cost for
    work this session did not do. `--band XL` is refused to keep that honest; an
    inherited mark is a quieter way to put a fiction in the same column.
    """
    out = []
    for t, r in open_marks(ctx).items():
        s = r.get("_session") or r.get("session") or ""
        if s and s not in live_ids:
            out.append({"task": t, "node": r.get("_node"), "session": s[:8],
                        "at": r.get("_at") or "",
                        "presented": bool(r.get("_presented_at"))})
    return sorted(out, key=lambda x: x["at"])


def stopped_without_asking(ctx, node, live, has_session):
    """A node that is up, holds nothing it opened, and has nothing queued.

    `harness waiting` covers the node that knows it is stuck, and opt-in is
    right there: a node that asked and stopped can say so. This is the other
    one, and no discipline reaches it — the node does not think it is stuck, it
    thinks it is finished. Nobody reports it because nobody believes there is
    anything to report.

    It is computable, which is the point: a live session, no open mark, and an
    empty queue is a session that will sit there indefinitely. It is its LEAD's
    to fix, by briefing or recycling, so that is who is told.
    """
    if not has_session:
        return False
    if ctx.rank(node) == 0:
        return False          # rank 0 marks against nobody; permanently "no task"
    marks = open_marks(ctx).values()
    if any(r.get("_node") == node for r in marks):
        return False
    # A LEAD whose children hold open marks is between integrations, which is
    # the resting state of the rank rather than a stall — receiving those IS its
    # next task. Without this the rule fires hardest on the healthiest shape a
    # tree can be in, which is the wrong thing to train anyone to ignore.
    kids = set(ctx.children(node))
    if kids and any(r.get("_node") in kids for r in marks):
        return False
    return not queue(ctx, node)


_CLAUSE_PARA = re.compile(r"^\s*(CHECKS|DONE)\b[.:]?(.*?)(?=^\s*[A-Z][A-Z ]{2,}[.:]|\Z)",
                          re.M | re.S)


_CLAUSE_HEAD = re.compile(r"^(#{1,6})\s+(.*\b(?:checks?|done)\b.*)$", re.M | re.I)
_CLAUSE_MARK = re.compile(r"\((\d{1,2})\)|^\s*(\d{1,2})[.)]\s", re.M)
CLAUSE_FORMS = ("`(n)`, `n.` or `n)` markers, in a paragraph starting CHECKS. or "
                "DONE., or under a heading naming checks or done")


def brief_clauses(text):
    """The numbered clauses a segment must deliver (obs 58): `(n)`, `n.` or `n)`
    markers in its CHECKS./DONE. paragraphs or under a markdown heading naming
    checks or done, as rank 0's `## Done means` does (obs 71). Empty when the
    brief numbers none."""
    text = text or ""
    bodies = [b for _, b in _CLAUSE_PARA.findall(text)]
    for m in _CLAUSE_HEAD.finditer(text):
        lvl = len(m.group(1))
        nxt = re.compile(r"^#{1,%d}\s" % lvl, re.M).search(text, m.end())
        bodies.append(text[m.end():nxt.start() if nxt else len(text)])
    return {int(a or b) for body in bodies for a, b in _CLAUSE_MARK.findall(body)}


def brief_headings(text):
    return [h.strip() for h in re.findall(r"^#{1,6}\s+(.+)$", text or "", re.M)]


def segment_coverage(ctx, seg, kids=None):
    """(clauses, uncovered, declared): uncovered is None when no part declares
    --covers, so segments written before this keep their old behaviour."""
    _, pb = load_brief(ctx, seg)
    clauses = brief_clauses((pb or {}).get("text"))
    if kids is None:
        kids = [b for b in all_briefs(ctx).values() if tkey(b.get("from") or "") == tkey(seg)]
    live = [b for b in kids if not superseded(b)]
    declared = any(b.get("covers") for b in live)
    if not clauses or not declared:
        return clauses, None, declared
    covered = set().union(*(set(b.get("covers") or []) for b in live))
    return clauses, sorted(clauses - covered), declared


def delegated(ctx, node):
    """A brief this node discharged by splitting it, and what became of the parts.

    Splitting IS the discharge — see `unactioned_briefs`, and it is the right
    rule: a lead's segment is something it breaks up, not something it executes.
    What the rule did not come with was anywhere to SEE the result. A split
    brief leaves the queue, never opens a mark, never gets presented and never
    closes, so it sits on the board indistinguishable from work nobody has
    started. Thirteen briefs on one lead, six of them phantom, is what that
    looks like after a fortnight.

    `ready` is the honest completion test: every child closed. That is the only
    moment the segment is actually finished, and it is a fact about the
    children, so nobody has to remember to record it.
    """
    briefs = all_briefs(ctx)
    out = []
    for k, b in sorted(briefs.items()):
        if b.get("node") != node:
            continue
        kids = sorted((c for c in briefs.values()
                       if tkey(c.get("from") or "") == k),
                      key=lambda c: c.get("task") or "")
        if not kids:
            continue
        rows = [{"task": c.get("task"), "node": c.get("node"),
                 "state": task_state(ctx, c.get("task"))} for c in kids]
        mf = ctx.state_file("marks", k, ".json")
        closed_at = ""
        if mf.exists():
            try:
                closed_at = json.loads(mf.read_text()).get("_closed_at") or ""
            except Exception:
                pass
        # A superseded part is TERMINAL. It will never be worked and was never
        # signed off, so it satisfies neither "closed" nor "outstanding" — and
        # counting it as outstanding left the segment above it permanently
        # unclosable, reading on the lead's card as work being ignored, which is
        # the exact failure this section exists to prevent. Worse, it fires for
        # anyone who supersedes a lane's only queued task, which is now the
        # recommended move: the fix for one invisible state manufactured another
        # one rank up. `--force` is not an answer, because the honest cleanup
        # and a lead bulldozing a genuinely unfinished part are then the same
        # command, and a reviewer reading the log cannot tell them apart.
        settled = [r for r in rows if r["state"] in ("closed", "superseded")]
        unc = segment_coverage(ctx, k, kids)[1]
        held = close_waits(ctx, b)
        out.append({"task": b.get("task") or k, "key": k, "children": rows,
                    "done": len(settled),
                    "gone": sum(1 for r in rows if r["state"] == "superseded"),
                    "uncovered": unc or [], "held": held,
                    "ready": len(settled) == len(rows) and not unc and not held,
                    "closed_at": closed_at})
    return out


def briefed_unstarted(ctx, node):
    """Briefs written for a node that no mark has opened yet: work handed down
    and not picked up. This is what a session STARTS on, so a node with none of
    it is a session about to ask what it should be doing."""
    d = ctx.state / "briefs"
    out = []
    for p in (sorted(d.glob("*.json")) if d.is_dir() else []):
        try:
            b = json.loads(p.read_text())
        except Exception:
            continue
        if b.get("node") != node:
            continue
        if ctx.state_file("marks", p.stem, ".json").exists():
            continue
        out.append(p.stem)
    return out


def awaiting(b):
    """A brief written, visible, and not staffable until the operator says so.

    A superseded brief is not awaiting anything. Fixing that in the definition
    rather than at each call site is deliberate: the alternative was five
    callers each remembering to write `and not superseded(x)`, and the one that
    forgot would put a withdrawn task back in front of the operator. A brief
    gated before --supersede existed still carries `pending` in its record, and
    nothing rewrites it — a reader that repairs records is how two writers
    appear where the design says there is one.
    """
    return ((b.get("approval") or {}).get("state") == "pending"
            and not b.get("superseded_at"))


def refused(b):
    """Declined by the operator. The brief stays — what was decided against is
    part of what the project is, and the next lead to notice the same thing
    deserves the answer rather than the silence. It is simply never offered."""
    return (b.get("approval") or {}).get("state") == "declined"


def superseded(b):
    """Withdrawn by the lead that wrote it, structurally rather than in prose.

    A brief that has been overtaken used to be marked by writing DO NOT START at
    the top of its own text, and nothing that CHOOSES what to run can read that.
    `spawn --dry-run` said 'dev_2 starts on layout_truncation' about a brief
    whose first line is 'SUPERSEDED. DO NOT START THIS.' — the warning is
    addressed to a reader, and spawn is not a reader. One eye on a queue was the
    only thing between a fresh session and a night of withdrawn work.

    Refusing is the same shape as `refused`: the brief stays, because what was
    started and abandoned is part of what the project is, and it is never
    offered again.
    """
    return bool(b.get("superseded_at"))


def pending_approvals(ctx):
    return {k: b for k, b in all_briefs(ctx).items() if awaiting(b)}


def queue(ctx, node):
    """The briefs waiting for this node, in the order its lead put them.

    A node holding three briefs and no order does not have a backlog, it has an
    ambiguity — and an ambiguity at the top of a session is answered by asking.
    Ordering is the lead's, on the same authority as the briefs themselves: a
    member choosing which of its tasks to do first is choosing its own work, one
    notch smaller than choosing its own task.

    Order is `seq` where the lead has set one, and the order the briefs were
    written where it has not, which is almost always the order intended.
    """
    briefs = all_briefs(ctx)
    derived = {tkey(b.get("from")) for b in briefs.values() if b.get("from")}
    rows = [b for k, b in briefs.items()
            if b.get("node") == node and k not in derived
            and not awaiting(b) and not refused(b) and not superseded(b)
            and not ctx.state_file("marks", k, ".json").exists()]
    rows.sort(key=lambda b: (b.get("seq") if b.get("seq") is not None else 10**6,
                             b.get("written_at") or ""))
    return rows


def reparent_check(ctx, task, b, from_task, move):
    """Re-parenting changes what BOTH segments read as settled (obs 45), so it
    is refused without --move, and printed with it."""
    old = (b or {}).get("from")
    if not (old and from_task and tkey(from_task) != tkey(old)):
        return
    if not move:
        die(REFUSED, f"'{task}' is already a part of '{old}'. Moving it to "
                     f"'{from_task}'\n           changes what both segments count as "
                     f"settled. Add --move if that is meant.")
    mine = task_state(ctx, task) in ("closed", "superseded")
    for seg, delta in ((old, -1), (from_task, +1)):
        d, t = segment_count(ctx, seg)
        print(f"  {seg}: {d}/{t} settled → {d + delta * mine}/{t + delta}")


def requeue_after(ctx, mark_file, owner, task, after, me, why):
    """Park an abandoned mark and put its brief back in the queue after
    `after` (obs 52). The record is kept under marks/parked/, which nothing
    that reads open marks looks in."""
    parked = mark_file.parent / "parked"
    parked.mkdir(parents=True, exist_ok=True)
    mark_file.rename(parked / f"{mark_file.stem}-{time.strftime('%Y%m%dT%H%M%S')}.json")
    order = [b for b in queue(ctx, owner) if not b.get("coupled_to")]
    mine = next(b for b in order if tkey(b["task"]) == tkey(task))
    order.remove(mine)
    at = next(i for i, b in enumerate(order) if tkey(b["task"]) == tkey(after)) + 1
    order.insert(at, mine)
    stamp = {"ordered_by": me, "ordered_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
             "ordered_why": f"requeued after {after}: {why}"}
    for i, b in enumerate(order):
        b.update(stamp, seq=i)
        ctx.state_file("briefs", b["task"], ".json").write_text(json.dumps(b, indent=2) + "\n")
    print(f"  requeued: {' → '.join(b['task'] for b in order)}")


def segment_count(ctx, seg):
    """(settled, total) parts of a split segment, per `delegated`."""
    _, sb = load_brief(ctx, seg)
    x = next((x for x in delegated(ctx, (sb or {}).get("node"))
              if tkey(x["key"]) == tkey(seg)), None)
    return (x["done"], len(x["children"])) if x else (0, 0)


def next_start(ctx, node):
    """What a fresh session on `node` would open: {"line", "skip"}. Its own
    open, unpresented mark first (resume); then the first startable brief;
    a queue that only waits is a skip; an empty one is a note."""
    own = [t for t, r in open_marks(ctx).items()
           if r.get("_node") == node and not r.get("_presented_at")]
    if own:
        return {"line": f"resumes {own[0]} — its open task", "skip": None}
    nq = startable(ctx, node)
    if nq:
        return {"line": f"starts on {nq[0]['task']}"
                        + (f", then {len(nq) - 1} more" if len(nq) > 1 else ""), "skip": None}
    waiting = [b for b in queue(ctx, node) if not b.get("coupled_to") and waits_on(ctx, b)]
    if waiting:
        return {"line": "", "skip": "every queued task waits: " + "; ".join(
            f"{b['task']} {waits_on(ctx, b)[0]}" for b in waiting[:2])}
    return {"line": "nothing queued — the fresh session will have no task to open",
            "skip": None}


def next_seq(ctx, node):
    """A new brief joins the BACK of an ordered queue (obs 14). Unordered, it
    keeps write order."""
    seqs = [b["seq"] for b in queue(ctx, node) if b.get("seq") is not None]
    return {"seq": max(seqs) + 1} if seqs else {}


def brief_preview(b, siblings):
    """The brief's first line that no sibling shares, so briefs opening with a
    common preamble do not all preview alike (obs 14)."""
    lines = [l.strip() for l in (b.get("text") or "").splitlines() if l.strip()]
    shared = {l.strip() for o in siblings if o is not b
              for l in (o.get("text") or "").splitlines()}
    return next((l for l in lines if l not in shared), lines[0] if lines else "")


def couple_chain(ctx, task):
    """Every task coupled to this one, forward, in order. A chain runs in ONE
    session; the whole point is that the boundary between them is not a
    teardown."""
    briefs = all_briefs(ctx)
    out, cur = [], tkey(task)
    seen = {cur}
    while True:
        nxt = next((b for k, b in briefs.items()
                    if tkey(b.get("coupled_to")) == cur and k not in seen), None)
        if not nxt:
            return out
        cur = tkey(nxt["task"]); seen.add(cur)
        out.append(nxt)


def launch_wake(ctx, task, at):
    """A time gate's alarm (obs 70): a detached `harness wake` that sleeps until
    the gate and then starts the task's node if nothing else will. Detached and
    without a session id, like a reset's launch, so it outlives the turn and acts
    as the operator would from the repository root. Nothing wakes an idle session
    otherwise: a lead went idle "until the reset" and rank 0 had to set a cron
    in its own session to message it."""
    log = ctx.state_file("wakes", tkey(task), ".log")
    log.parent.mkdir(parents=True, exist_ok=True)
    env = {k: v for k, v in os.environ.items() if k != "CLAUDE_CODE_SESSION_ID"}
    with open(log, "a") as fh:
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "wake", task,
                          "--at", str(at)], cwd=str(ctx.repo), env=env, stdout=fh,
                         stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                         start_new_session=True)


def wake_plan(ctx, task, at, rows):
    """What the alarm does once its time has come: (action, why). Action is
    "start" (recycle the node into its queue) or None. It never recycles a live
    lead, a busy session or one mid-task: those reach the task at their next
    close, which already reads the clock."""
    b = load_brief(ctx, task)[1]
    if not b or superseded(b):
        return None, "no live brief"
    if b.get("not_before") != at:
        return None, "the gate was moved or cleared; its own alarm handles it"
    st = task_state(ctx, task)
    if st != "briefed":
        return None, f"it is {st}"
    still = waits_on(ctx, b)
    if still:
        return None, "still waits: " + "; ".join(still)
    node = b.get("node")
    if node not in ctx.tree["nodes"]:
        return None, f"'{node}' is not a node"
    wt = (load_index(ctx)["nodes"].get(node) or {}).get("worktree")
    here = [r for r in rows if r.get("cwd") == wt]
    if not here:
        return "start", f"{node} has no session"
    if role_of(ctx, node) != "member":
        return None, f"{node} is a live lead; it starts {task} at its next close"
    if any(r.get("status") == "busy" for r in here):
        return None, f"{node} is busy; it reaches {task} at its next close"
    if any(r.get("_node") == node and not r.get("_presented_at")
           for r in open_marks(ctx).values()):
        return None, f"{node} has an open task; {task} follows it"
    return "start", f"{node} is idle with nothing open"


def cmd_wake(a):
    """The alarm behind `brief --not-before` (obs 70). Internal: launched by it."""
    ctx = Ctx(); ctx.require_enrolled()
    at = float(a.at)
    while time.time() < at:
        time.sleep(min(60, max(1, at - time.time())))
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    try:
        rows = live_rows(agents_json())
    except Exception as e:
        print(f"{stamp} {a.task}: roster unreadable ({e}); not started"); return
    act, why = wake_plan(ctx, a.task, at, rows)
    print(f"{stamp} {a.task}: {why}" + ("; starting it" if act else ""))
    if act:
        node = load_brief(ctx, a.task)[1]["node"]
        subprocess.run([sys.executable, str(Path(__file__).resolve()), "recycle", node,
                        "--when-idle"], cwd=str(ctx.repo))
        append_inbox({"event": "woken", "task": a.task, "node": node,
                      "repo": str(ctx.repo), "at": stamp})


def task_node(ctx, task):
    """Which node a task belongs to, from its mark or its brief."""
    mf = ctx.state_file("marks", task, ".json")
    try:
        return json.loads(mf.read_text()).get("_node")
    except Exception:
        return (load_brief(ctx, task)[1] or {}).get("node")


def parse_utc(v, now=None):
    """'00:05Z' (the next one) or a full ISO time → epoch seconds, UTC (obs 70)."""
    v = str(v or "").strip()
    now = time.time() if now is None else now
    m = re.fullmatch(r"(\d{1,2}):(\d{2})Z?", v)
    if m:
        d = datetime.datetime.fromtimestamp(now, datetime.timezone.utc).replace(
            hour=int(m.group(1)), minute=int(m.group(2)), second=0, microsecond=0)
        if d.timestamp() <= now:
            d += datetime.timedelta(days=1)
        return d.timestamp()
    try:
        d = datetime.datetime.fromisoformat(v.replace("Z", "+00:00"))
    except ValueError:
        die(REFUSED, f"--not-before {v}: give a UTC time, 00:05Z or 2026-10-05T00:05Z")
    if d.tzinfo is None:
        d = d.replace(tzinfo=datetime.timezone.utc)
    return d.timestamp()


def utc_label(t):
    return datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime("%Y-%m-%d %H:%MZ")


def waits_on(ctx, b):
    """Why a brief cannot start yet, as reasons; [] when it can (obs 15, 59).
    One rule for every path that picks or opens a task."""
    out = []
    for y in b.get("after") or []:
        seen = set()
        while tkey(y) not in seen:
            seen.add(tkey(y))
            st = task_state(ctx, y)
            nxt = (load_brief(ctx, y)[1] or {}).get("superseded_for") if st == "superseded" else None
            if not nxt:
                break
            y = nxt
        if st not in ("closed", "superseded"):
            out.append(f"after {y} ({st} on {task_node(ctx, y) or '?'})")
    # A clock, not only a task (obs 70): the gate every start path already reads.
    nb = b.get("not_before")
    if nb and time.time() < nb:
        out.append(f"until {utc_label(nb)} (in {human_age(nb - time.time())})")
    return out


def close_waits(ctx, b):
    """Why a segment may not close yet (obs 67): the tasks its close was set to
    wait on, read like `--after`. A condition in a note lost to "all parts settled"."""
    return waits_on(ctx, {"after": (b or {}).get("close_after") or []})


def startable(ctx, node):
    """The queue a session can actually open, in order: no coupled tasks, nothing
    that waits on another task."""
    return [b for b in queue(ctx, node) if not b.get("coupled_to") and not waits_on(ctx, b)]


def after_cycle(ctx, task, afters):
    """True when `task --after afters` would make a task wait on itself."""
    todo, seen = list(afters), set()
    while todo:
        y = tkey(todo.pop())
        if y == tkey(task):
            return True
        if y in seen:
            continue
        seen.add(y)
        todo.extend((load_brief(ctx, y)[1] or {}).get("after") or [])
    return False


def next_after(ctx, node, task):
    """What happens when `task` closes: (next_brief, coupled).

    Coupled means the same session carries on, because the context it already
    holds is the reason the two were put together. Uncoupled means the session
    ends: a fresh one is cheaper than the accumulated errors of the old one, and
    that is R13 rather than tidiness."""
    chain = couple_chain(ctx, task)
    if chain:
        return chain[0], True
    # A coupled task is reached through its predecessor, never picked up cold,
    # and a task that waits is not picked up at all (obs 59).
    q = [b for b in startable(ctx, node) if tkey(b["task"]) != tkey(task)]
    return (q[0] if q else None), False


def cmd_queue(a):
    """What each node has waiting, and in what order.

    Read by anyone. Ordered by the lead, because a member picking its own next
    task is picking its own work.
    """
    ctx = Ctx(); ctx.require_enrolled()
    me, _ = ctx.node()

    if a.order:
        target = a.node or me
        parent = ctx.tree["nodes"].get(target, {}).get("parent")
        own = parent == me or (target == me and ctx.rank(me) == 0)
        # Ordering is not authorship, and that is the whole reason this can be
        # granted where writing a grandchild's brief cannot. A brief written past
        # a lead skips the translation that rank exists to perform, and rebuilds
        # the drip feed one rank down. Reordering changes no brief's text: it
        # says which of them matters first, and what matters is rank 0's — it
        # holds the charter and it is the one talking to the operator.
        if not own and ctx.rank(me) != 0:
            die(REFUSED, f"'{me}' does not order '{target}'s queue. A lead orders "
                         f"its CHILDREN's;\n           rank 0 orders anywhere in "
                         f"the tree.")
        # Every reorder says why (obs 21). Once a task opens it leaves the queue
        # and its order record becomes unwritable, so an optional reason is one
        # nobody can add later.
        if not (a.why or "").strip():
            die(REFUSED, f"say why: harness queue {target} --order ... --why \"...\"")
        # Symmetric, and it is what keeps the permission from being hollow. A
        # lead orders its own children freely — until a higher rank has ordered
        # them, at which point undoing that silently is the same act as reaching
        # past a rank, performed downward. It is not refused: the lead may know a
        # dependency rank 0 does not. It is recorded, and rank 0 reads the queue.
        prior = sorted(
            {b["ordered_by"] for b in queue(ctx, target) if b.get("ordered_by")}
            - {me},
            key=lambda n: ctx.rank(n) if n in ctx.tree["nodes"] else 99)
        above = [n for n in prior if n in ctx.tree["nodes"]
                 and ctx.rank(n) < ctx.rank(me)]
        want = [t.strip() for t in a.order.split(",") if t.strip()]
        # Only the head of each coupled chain is orderable. A coupled task is
        # reached through its predecessor by construction, so giving it a
        # position of its own would state an order that can never happen.
        all_q = {tkey(b["task"]): b for b in queue(ctx, target)}
        have = {k: b for k, b in all_q.items() if not b.get("coupled_to")}
        chained = [t for t in want if tkey(t) in all_q and tkey(t) not in have]
        if chained:
            die(REFUSED,
                f"{', '.join(chained)} runs inside another task's session and has no "
                f"place\n           of its own in the queue. Order the task it is "
                f"coupled to.")
        missing = [t for t in want if tkey(t) not in have]
        if missing:
            die(REFUSED, f"not queued for '{target}': {', '.join(missing)}\n"
                         f"           queued: "
                         f"{', '.join(b['task'] for b in have.values())}")
        # The stamp always names who ordered it LAST. Leaving a superseded one in
        # place would have the queue claiming an authority that no longer holds.
        stamp = {"ordered_by": me,
                 "ordered_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                 "ordered_why": a.why}
        for i, t in enumerate(want):
            b = have[tkey(t)]
            b.update(stamp)
            b["seq"] = i
            ctx.state_file("briefs", b["task"], ".json").write_text(
                json.dumps(b, indent=2) + "\n")
        # Anything unnamed keeps its place behind what was named, rather than
        # being silently promoted by a partial reorder.
        for j, b in enumerate((x for x in have.values() if tkey(x["task"]) not in
                               {tkey(t) for t in want}), start=len(want)):
            b.update(stamp)
            b["seq"] = j
            ctx.state_file("briefs", b["task"], ".json").write_text(
                json.dumps(b, indent=2) + "\n")
        print(f"{target}: " + " → ".join(b["task"] for b in queue(ctx, target)
                                         if not b.get("coupled_to")))
        if own and above:
            print(f"  overrides {above[0]}'s ordering: {a.why}")
            print(f"  '{above[0]}' reads this queue and will see it.")
        elif not own:
            print(f"  ordered by {me}, past {parent}: {a.why}")
            print(f"  '{parent}' sees it at its next `harness queue`. It changes no "
                  f"brief's text —\n  if the work itself should change, that is "
                  f"{parent}'s rewrite, not this.")
        return

    # Who is actually standing in each node, and for how long. A lead reading
    # its children's queues is the moment it should also see that one of them
    # has nobody in it, or somebody who stopped an hour ago — the two states
    # that make a queue stop moving without anything in the queue changing.
    occ = {}
    try:
        idx = load_index(ctx)
        rows = live_rows(agents_json(read_roster(a.__dict__.get("roster"))))
        for n, sp in (idx.get("nodes") or {}).items():
            for r in rows:
                if r.get("cwd") == sp.get("worktree"):
                    age, _ = last_turn(r.get("sessionId") or "")
                    occ[n] = (r.get("status"), age)
    except Exception:
        occ = None

    nodes = [a.node] if a.node else sorted(ctx.tree["nodes"])
    shown = False
    for n in nodes:
        if n not in ctx.tree["nodes"]:
            die(REFUSED, f"'{n}' is not a node in {ctx.tree_path}")
        q = queue(ctx, n)
        openm = sorted(t for t, r in open_marks(ctx).items() if r.get("_node") == n)
        gated = [x for x in all_briefs(ctx).values()
                 if x.get("node") == n and awaiting(x)]
        # Segments this node broke up. They leave the queue the moment they are
        # split, which is right — nobody is going to work on them — but until
        # now they left every OTHER surface with it, so a lead had no way to see
        # what it had handed on, or that the last part had come back.
        deleg = [x for x in delegated(ctx, n) if not x["closed_at"]]
        # Shown, never offered. A withdrawn brief that vanished entirely would
        # have the next lead re-propose the same thing and get no answer; the
        # point of keeping it is that somebody already decided.
        gone = [x for x in all_briefs(ctx).values()
                if x.get("node") == n and superseded(x)
                and not ctx.state_file("marks", tkey(x["task"]), ".json").exists()]
        if not q and not openm and not gated and not deleg and not gone:
            continue
        shown = True
        if occ is None:
            who = "   occupancy unknown"
        elif n not in occ:
            who = "   no session"
        elif occ[n][0] == "busy":
            who = "   busy"
        else:
            who = f"   idle {human_age(occ[n][1])}" if occ[n][1] else "   idle"
        act = node_activity(ctx, n)
        if act and occ is not None and n in occ:
            who = f"   {act}"
        print(f"{n}{who}")
        for t in openm:
            r = open_marks(ctx)[t]
            state = "presented, waiting on sign-off" if r.get("_presented_at") else "OPEN"
            print(f"    ▸ {mark_label(r, t):<24} {state}")
        for gb in gated:
            print(f"    gate {gb['task']:<24} waiting on approval "
                  f"({_ago((gb.get('approval') or {}).get('asked_at'))})")
        head = [b for b in q if not b.get("coupled_to")]
        # One stamp for the whole queue is the usual case — say it once. Repeating
        # the same sentence against every row is how a useful line becomes
        # wallpaper.
        stamps = {(b.get("ordered_by"), b.get("ordered_why"))
                  for b in head if b.get("ordered_by")}
        stamps.discard((None, None))
        if len(stamps) == 1:
            who_o, why_o = stamps.pop()
            print(f"    ordered by {who_o}: {why_o}")
            stamps = set()
        first = next((b for b in head if not waits_on(ctx, b)), None)
        for i, b in enumerate(head):
            mark = "next" if b is first and not openm else f"  {i + 1}."
            print(f"    {mark:<4} {b['task']:<24} {brief_preview(b, head)[:44]}")
            for w in waits_on(ctx, b):
                print(f"    {'':<4} {'':<24} waits: {w}")

            if b.get("ordered_by") and stamps:
                print(f"    {'':<4} {'':<24} ordered by {b['ordered_by']}: "
                      f"{(b.get('ordered_why') or '')[:40]}")
            for c in couple_chain(ctx, b["task"]):
                why = (c.get("coupled_why") or "").strip().replace("\n", " ")
                print(f"         ↳ {c['task']:<22} same session: "
                      f"{why[:40]}{'…' if len(why) > 40 else ''}")
        for x in deleg:
            done = (f"{x['done']}/{len(x['children'])} parts settled"
                    + (f" ({x['gone']} superseded)" if x.get("gone") else "")
                    + (f"; closes {', '.join(x['held'])}" if x.get("held") else "")
                    + (f"; no part covers {','.join(map(str, x['uncovered']))}"
                       if x.get("uncovered") else ""))
            print(f"    split {x['task']:<24} "
                  + (f"ALL PARTS SETTLED — harness mark {x['task']} --close"
                     if x["ready"] else done))
            if x["ready"]:
                continue
            for r in x["children"]:
                print(f"         ↳ {r['task']:<22} {r['node']:<6} {r['state']}")
        for x in gone:
            print(f"    gone  {x['task']:<24} superseded — "
                  f"{(x.get('superseded_why') or '')[:44]}")
            if x.get("superseded_for"):
                print(f"         ↳ replaced by {x['superseded_for']}")
    if not shown:
        print("nothing queued or open anywhere in this tree")


def unread_brief_comments(ctx, who):
    """Comments on any brief for this node that this node has not read yet.

    Keyed by READER, so a lead reading a child's brief does not mark it read for
    the child. Nothing can push to a running session ([[R4]] — no daemon), so
    this is surfaced by the next harness command the session happens to run. A
    comment therefore reaches a lane at its next harness call or its next
    recycle, not the instant it is written, and a session deep in an edit-test
    loop will not see it for a while. That limit is real and is not worked
    around by inventing a poller.
    """
    d = ctx.state / "briefs"
    out = {}
    for p in (sorted(d.glob("*.json")) if d.is_dir() else []):
        try:
            b = json.loads(p.read_text())
        except Exception:
            continue
        # The LEAD that writes this brief, not the lane it is for. A comment is
        # context and only the brief instructs, so the party who is prompted to
        # act on it must be the one who can fold it in. The lane still sees
        # comments when it reads its brief; it is simply not asked to act.
        owner = b.get("node")
        lead = ctx.tree["nodes"].get(owner, {}).get("parent")
        if (lead or owner) != who:
            continue
        seen = (b.get("read") or {}).get(who, "")
        mine = {who, f"session {os.environ.get('CLAUDE_CODE_SESSION_ID', '')[:8]}"}
        new = [c for c in (b.get("comments") or [])
               if (c.get("at") or "") > seen and c.get("by") not in mine]  # obs 17
        if new:
            out[p.stem] = new
    return out


def brief_carry(rec, b):
    """What a rewrite keeps that the writer did not write: the owner's rulings
    (T17), and who has read it, which the ruling notices are timed against."""
    for k in ("rulings", "read", "close_after", "close_after_by", "not_before",
              "requires"):
        if k not in rec and (b or {}).get(k):
            rec[k] = b[k]
    for k in ("not_before", "requires"):
        if k in rec and rec[k] is None:
            del rec[k]                  # an explicit 'none' this rewrite
    return rec


def cmd_brief(a):
    """The task description: written by the lead, for its children.

    A brief is a PLAN, not a record. It is rewritten in place as understanding
    changes, and no earlier version is kept, because pretending a working
    document is provenance makes people afraid to correct it. Comments
    (`harness note`) are the append-only half; this is the mutable half, and
    keeping them in separate files is what lets both be honest.

    Authority follows the tree, which is the whole point. A lead writes the
    briefs of its children. Rank 0 writes its own, because there is nobody above
    it. A node cannot write its own brief anywhere else: a node that sets its own
    task is the failure the tree exists to prevent, and it is also [[T1]] —
    everything the lead knows goes down at once, from the lead.

    The assignee is not silent. It reads the brief, and `--suggest` appends a
    proposed change for the lead to fold in or decline. A suggestion is not an
    edit, and the difference is deliberate.
    """
    ctx = Ctx(); ctx.require_enrolled()
    me, _ = ctx.node()
    f, b = load_brief(ctx, a.task)
    target = brief_node(ctx, a.task, a.for_node)
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    who = f"{me} ({'session ' + sid[:8] if sid else 'operator'})"
    # The band is written with the brief because it is an estimate OF the brief,
    # and re-estimating without rewriting is a change to the plan that leaves no
    # revision behind. Said rather than ignored: `--band` on its own would
    # otherwise print the brief and exit 0, which reads as having worked.
    if a.band and not a.write:
        die(REFUSED,
            "--band goes in with --write. It is an estimate of the plan, so it moves "
            "when\n           the plan does and the revision counter has to see it. "
            f"Rewrite it:\n           harness brief {a.task} --write - --band {a.band.upper()}")

    if a.write is None and (a.with_task or a.why):
        die(REFUSED, "--with and --why describe a brief being written. Add --write "
                     "\"...\" —\n           coupling two tasks does not write the "
                     "second one for you.")
    if a.write is not None:
        if target is None:
            die(REFUSED, f"no brief for '{a.task}' yet and no node named — "
                         f"say who it is for: harness brief {a.task} --for <node> --write ...")
        if target not in ctx.tree["nodes"]:
            die(REFUSED, f"'{target}' is not a node in {ctx.tree_path}")
        parent = ctx.tree["nodes"][target].get("parent")
        own_root = (target == me and ctx.rank(me) == 0)
        if parent != me and not own_root:
            die(REFUSED,
                f"'{me}' does not write the brief for '{target}'.\n"
                f"           A lead writes the briefs of its CHILDREN; "
                + (f"'{target}' answers to '{parent}'.\n" if parent
                   else f"'{target}' has no parent.\n") +
                f"           Rank 0 writes its own, and nobody writes their own anywhere "
                f"else — a node\n           that sets its own task is what the tree exists "
                f"to prevent. Suggest instead:\n"
                f"           harness brief {a.task} --suggest \"...\"")
        if not a.write.strip():
            die(REFUSED, "an empty brief is not a brief. If there is nothing to say "
                         "about scope,\n           approach, checks, seams and what done "
                         "means, the task is not ready to issue.")
        # A brief cannot split itself. This is free to refuse and it is the
        # cheapest of the four things that had to line up to destroy one: a
        # lead named its child `properties_hide_empty` after the parent
        # `properties-hide-empty`, tkey resolves both to one record, and
        # `--from properties-hide-empty` was in the same command line naming the
        # record it was about to overwrite. Incoherent, and nothing objected.
        if a.from_task and tkey(a.from_task) == tkey(a.task):
            die(REFUSED,
                f"'{a.task}' cannot be split from itself.\n"
                f"           --from names the brief you were HANDED; this writes the "
                f"brief you are\n           handing DOWN. They resolved to one record "
                f"— hyphens and underscores are\n           the same character here, "
                f"so '{a.from_task}' and '{a.task}' are one name.\n"
                f"           Give the child a name of its own.")

        # Replacing an existing brief is legitimate and expected — a lead
        # rewrites a brief when the work should change. What is NOT expected is
        # moving it to a different node: that is the shape of a create that
        # collided with an existing name, and it reassigns work somebody may
        # already be doing. It was indistinguishable from a fresh write.
        if b is not None and b.get("node") and b.get("node") != target and not a.force:
            die(REFUSED,
                f"'{a.task}' already exists, written for '{b.get('node')}', and this "
                f"would move it\n           to '{target}' and replace its text.\n\n"
                f"           If you meant to create a NEW brief, the name collided: "
                f"hyphens and\n           underscores are the same character here, so "
                f"'{a.task}' is the record that\n           already exists. Give the "
                f"new one a different name.\n\n"
                f"           If you really did mean to reassign this one, --force.")

        parent_task = a.from_task or (b or {}).get("from")
        reparent_check(ctx, a.task, b, a.from_task, a.move)
        if parent_task:
            # Splitting is passing your OWN brief down one rank, so the parent
            # brief must be one written for you. Anything else is a lead
            # inventing lineage for work it was never handed, and a provenance
            # chain that can be invented is not one worth reading.
            _, pb = load_brief(ctx, parent_task)
            if pb is None:
                die(REFUSED, f"no brief '{parent_task}' to split. "
                             f"--from names the brief you were handed.")
            if pb.get("node") != me:
                die(REFUSED,
                    f"'{parent_task}' was written for '{pb.get('node')}', not '{me}'.\n"
                    f"           --from splits a brief handed to YOU into work for your\n"
                    f"           children. You cannot split a brief you were not given.")
        if a.with_task:
            # Coupling is the EXCEPTION and has to read as one. A fresh session
            # per task is the default because a persistent worker's own errors
            # compound in its own context and clearing history is what fixes it;
            # coupling deliberately keeps that context, so it is justified in
            # writing or not at all.
            _, wb = load_brief(ctx, a.with_task)
            if wb is None:
                die(REFUSED, f"no brief '{a.with_task}' to couple to")
            if wb.get("node") != target:
                die(REFUSED,
                    f"'{a.with_task}' is for '{wb.get('node')}' and this is for "
                    f"'{target}'.\n           Coupling means one session does both, "
                    f"so they must be the same node.")
            if tkey(a.with_task) == tkey(a.task):
                die(REFUSED, "a task cannot be coupled to itself")
            if not (a.why or "").strip():
                die(REFUSED,
                    "--with needs --why. Coupling keeps a session alive across a task "
                    "boundary,\n           and a worker carrying its own history "
                    "compounds its own errors — so the\n           context being "
                    "reused has to be worth more than the reset it costs. Say what "
                    "it is.")
        # I10: the estimate is the LEAD's, and until now the only place to enter
        # it was `mark`, which the member runs. So a lead that estimated XL had
        # its refusal delivered to the member's keyboard — the one party that
        # may not split the task (T15) and can make the refusal go away by
        # typing a smaller letter. The number now goes in beside the plan that
        # produced it, where T1 always said it was: "a task record carries an
        # estimated cost band" at issue, not at open.
        band = (a.band or "").upper() or (b or {}).get("band")
        if a.band:
            if band == "XL":
                die(REFUSED,
                    "XL is a refusal, not a size (I10). A task estimated above 300k new "
                    "tokens is\n           a decomposition that has not happened yet — and "
                    "it is yours to make.\n           Split this brief into ones you can "
                    "band at L or under, or escalate it.")
            if band not in BANDS:
                die(REFUSED, f"band must be one of {', '.join(BANDS)} "
                             f"({', '.join(f'{k} < {tok(v[1])}' for k, v in BANDS.items())})")
        coupled = a.with_task or (b or {}).get("coupled_to")
        rev = (b or {}).get("revision", 0) + 1
        rec = {"task": a.task, "node": target, "text": a.write, "revision": rev,
               "written_by": who, "written_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
               "suggestions": (b or {}).get("suggestions", []),
               # Carried, because the whole point of a comment on a brief is
               # that it outlives the plan. A rewrite that dropped them would
               # make the append-only channel append-until-the-next-rewrite,
               # which is the property it exists to have.
               "comments": (b or {}).get("comments", [])}
        # One brief was destroyed by a write onto a colliding name and there was
        # nothing to recover from: `revision` counts, it does not chain, and no
        # store here kept a prior copy. It was recovered only because a session
        # that had read it minutes earlier was still alive to retype it, from
        # rendered output, so possibly not byte-identical. The next reader will
        # have been recycled. Keeping the last few costs a few kilobytes against
        # a loss that nothing else in this design can undo.
        if b is not None:
            hist = list(b.get("history") or [])
            hist.append({k: b.get(k) for k in
                         ("revision", "node", "text", "written_by", "written_at")})
            rec["history"] = hist[-5:]
        elif b is None:
            rec["history"] = []
        if parent_task:
            rec["from"] = parent_task
        fnd = None
        if a.from_finding:
            _, fnd = (ctx.state_file("findings", a.from_finding, ".json"),
                      None)
            ff = ctx.state_file("findings", a.from_finding, ".json")
            if not ff.exists():
                die(REFUSED, f"no finding '{a.from_finding}'. "
                             f"harness finding --list shows the open ones.")
            fnd = json.loads(ff.read_text())
            if fnd.get("to") != me:
                die(REFUSED,
                    f"'{a.from_finding}' was handed to '{fnd.get('to')}', not '{me}'.\n"
                    f"           A finding crosses exactly one rank. If it belongs "
                    f"further up, hand\n           your own on rather than reaching "
                    f"past the lead it was addressed to.")
        cited = a.fact or (b or {}).get("facts") or []
        for nm in cited:
            if load_fact(ctx, nm)[1] is None:
                die(REFUSED,
                    f"no fact '{nm}' to cite. Whoever measured it records it first, "
                    f"with the\n           command that produced it:  harness fact "
                    f"{nm} --is \"...\" --from \"...\"")
        if cited:
            rec["facts"] = list(dict.fromkeys(cited))
        # Work nobody asked for does not get staffed on a lead's say-so. A
        # finding is potential work by definition — the claimant noticed it while
        # doing something else and nobody has decided it is worth a session. So
        # the brief is written in full, sits where everyone can read it, and is
        # not staffable until the operator says so.
        _fa = None
        if a.from_finding:
            try:
                _fa = json.loads(ctx.state_file("findings", a.from_finding, ".json")
                                 .read_text()).get("approved_by")
            except Exception:
                _fa = None
        if a.from_finding and _fa and not a.needs_approval:
            # Handed down by rank 0, which already decided it is worth a session.
            rec["approval"] = {"state": "approved", "decided_by": _fa,
                               "decided_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                               "why": "handed down with the finding",
                               "from_finding": a.from_finding}
        elif a.from_finding or a.needs_approval:
            prev_ap = (b or {}).get("approval") or {}
            if prev_ap.get("state") != "approved":
                rec["approval"] = {"state": "pending",
                                   "asked_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                                   "asked_by": who,
                                   "from_finding": a.from_finding or ""}
            else:
                rec["approval"] = prev_ap
        elif (b or {}).get("approval"):
            rec["approval"] = b["approval"]
        if a.from_finding:
            rec["from_finding"] = a.from_finding
        if coupled:
            rec["coupled_to"] = coupled
            rec["coupled_why"] = a.why or (b or {}).get("coupled_why") or ""
        if band:
            rec["band"] = band
        if (b or {}).get("seq") is not None:
            rec["seq"] = b["seq"]
        elif b is None:
            rec.update(next_seq(ctx, target))
        if a.covers:
            want = sorted({int(n) for c in a.covers for n in re.findall(r"\d+", c)})
            if not parent_task:
                die(REFUSED, "--covers names the parent's clauses a part delivers; it "
                             "needs --from <segment>")
            ptext = (load_brief(ctx, parent_task)[1] or {}).get("text")
            have = brief_clauses(ptext)
            bad = [n for n in want if n not in have]
            if bad:
                hs = brief_headings(ptext)
                die(REFUSED, f"'{parent_task}' has no clause {', '.join(map(str, bad))}"
                             + (f" (it numbers {', '.join(map(str, sorted(have)))})" if have
                                else f" — it numbers none. Looked for {CLAUSE_FORMS}"
                                     + (f"; its headings: {', '.join(hs)}" if hs else "")))
            rec["covers"] = want
        elif (b or {}).get("covers"):
            rec["covers"] = b["covers"]
        if a.after:
            afters = [] if [x.lower() for x in a.after] == ["none"] else list(a.after)
            for y in afters:
                if load_brief(ctx, y)[1] is None and \
                        not ctx.state_file("marks", y, ".json").exists():
                    die(REFUSED, f"--after {y}: no brief or task by that name")
            if after_cycle(ctx, a.task, afters):
                die(REFUSED, f"--after {', '.join(afters)} would make '{a.task}' wait on itself")
            if afters:
                rec["after"] = afters
        elif (b or {}).get("after"):
            rec["after"] = b["after"]
        if a.not_before:
            rec["not_before"] = (None if a.not_before.lower() == "none"
                                 else parse_utc(a.not_before))
        if a.requires and [x.lower() for x in a.requires] == ["none"]:
            rec["requires"] = None
        elif a.requires:
            rec["requires"] = []
            for r in a.requires:
                rc, sha, _ = git("rev-parse", "--verify", f"{r}^{{commit}}", cwd=ctx.repo)
                if rc:
                    die(REFUSED, f"--requires {r}: no such commit here")
                rec["requires"].append({"ref": r, "sha": sha.strip()})
        blk = a.from_block or (b or {}).get("from_block")
        if blk:
            rec["from_block"] = blk
        brief_carry(rec, b)
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(json.dumps(rec, indent=2) + "\n")
        if a.not_before and (rec.get("not_before") or 0) > time.time():
            launch_wake(ctx, a.task, rec["not_before"])
        # Create and replace said the same words, so the line that means "I
        # destroyed one" was indistinguishable from the line that means "I made
        # you one" — and the one warning that did print, "the previous text is
        # gone", had been correct twice that evening on writes where replacing
        # WAS the intent. A correct neighbour suppresses the re-read; that is
        # not carelessness, and telling people to look harder does not fix it.
        # So the two say different things, and the replace quotes what it took.
        if b is None:
            print(f"WROTE a new brief for '{target}' / {a.task}  (by {who})")
        else:
            was = (b.get("text") or "").strip().splitlines()
            print(f"REPLACED the brief '{a.task}' for '{target}'  "
                  f"(revision {b.get('revision', 0)} → {rev}, by {who})")
            print(f"  what it said before: {was[0][:66] if was else '(empty)'}"
                  + ("…" if was and len(was[0]) > 66 else ""))
            print(f"  kept, and readable:  harness brief {a.task} --history")
        if a.from_task:
            print(f"  splits '{parent_task}', the brief '{me}' was handed")
            _cl, _unc, _decl = segment_coverage(ctx, parent_task)
            if _cl:
                print(f"  covers {','.join(map(str, rec.get('covers') or [])) or 'nothing declared'}"
                      f" of {parent_task}'s {len(_cl)} clauses"
                      + (f"; no part covers {','.join(map(str, _unc))}" if _unc else
                         "; every clause has a part" if _unc == [] else
                         " — give each part --covers so an unissued clause shows"))
        if a.from_finding:
            fnd["became"] = a.task
            fnd["became_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
            ctx.state_file("findings", a.from_finding, ".json").write_text(
                json.dumps(fnd, indent=2) + "\n")
            print(f"  from {fnd.get('from')}'s finding '{a.from_finding}' — it stops "
                  f"asking you for a decision")
        if (rec.get("approval") or {}).get("state") == "pending":
            print(f"  NOT STAFFABLE until it is approved. It is queued nowhere and\n"
                  f"  `harness mark {a.task}` is refused until then.")
            print(f"  Rank 0 approves it: harness brief {a.task} --approve")
        if a.with_task:
            print(f"  runs in the SAME session as '{a.with_task}', which is why it "
                  f"is not queued separately")
            print(f"  because: {a.why}")
        if a.from_block:
            hit = stamp_consequence(ctx, blk, a.task, target)
            if hit:
                print(f"  records this as what the block '{blk}' produced "
                      f"— it stops asking rank 0 for a task")
            else:
                print(f"  no block named '{blk}' — nothing stamped. "
                      f"`harness blocked --decided` lists them.")
        if rev > 1:
            print("  the previous text is gone — a brief is a plan, not a record")
        open_s = [i for i, s in enumerate((b or {}).get("suggestions", []), 1)
                  if not s.get("resolved_at")]
        if open_s:
            print(f"  {len(open_s)} suggestion(s) still open: "
                  f"{', '.join('#' + str(i) for i in open_s)}  (--resolve N)")
        return

    if a.suggest is not None:
        if b is None:
            die(REFUSED, f"no brief for '{a.task}' to suggest against. "
                         f"Its lead writes one first.")
        if me != b.get("node"):
            die(REFUSED, f"'{a.task}' is briefed for '{b.get('node')}', not '{me}'. "
                         f"Suggestions come from the node doing the work.")
        b.setdefault("suggestions", []).append(
            {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "by": who,
             "text": a.suggest, "against_revision": b.get("revision")})
        f.write_text(json.dumps(b, indent=2) + "\n")
        print(f"suggested against revision {b.get('revision')} of {a.task} "
              f"({len(b['suggestions'])} total)")
        print("  Your lead decides. Carry on with the brief as it stands meanwhile.")
        return

    if a.comment is not None:
        # Anyone may comment; only the lead may WRITE. A comment is context, not
        # an instruction — if it changes what the work should be, the lead folds
        # it into the brief and the revision advances. Two channels of
        # instruction would rebuild the drip-feed this design exists to close,
        # one piece at a time.
        if b is None:
            die(REFUSED, f"no brief for '{a.task}' to comment on. Its lead writes one "
                         f"first:\n           harness brief {a.task} --for <node> "
                         f"--write \"...\"")
        if not a.comment.strip():
            die(REFUSED, "an empty comment says nothing")
        b.setdefault("comments", []).append(
            {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "by": who, "text": a.comment})
        f.write_text(json.dumps(b, indent=2) + "\n")
        lead = ctx.tree["nodes"].get(b.get("node"), {}).get("parent") or "rank 0"
        print(f"commented on {a.task} ({len(b['comments'])} total)")
        print(f"  '{b.get('node')}' and its lead '{lead}' see it at their next "
              f"harness command.")
        print(f"  It does not change the brief. If it should, {lead} rewrites it:")
        print(f"    harness brief {a.task} --write \"...\"")
        return

    # Withdrawing a brief you wrote, structurally. The prose form of this —
    # SUPERSEDED. DO NOT START THIS. at the top of the text — is addressed to a
    # reader, and the things that choose what to run are not readers: `spawn`
    # offered one, and the recycle after a close offered another, both in the
    # same evening and neither with any signal that anything was wrong.
    # History you cannot read is not history. The point of keeping revisions is
    # that somebody can get one back at the moment they discover it is gone.
    if a.history:
        if b is None:
            die(REFUSED, f"no brief for '{a.task}'")
        hist = list(b.get("history") or [])
        if not hist:
            print(f"'{a.task}' is at revision {b.get('revision')} and has replaced "
                  f"nothing.")
            if (b.get("revision") or 0) > 1:
                print(f"  It was rewritten before revisions were kept — those are "
                      f"gone, and nothing\n  here can get them back.")
            return
        # The count and the policy, said separately. "The last N are kept" with
        # N computed from what happens to be stored is the exact grammatical
        # shape of a policy statement — it is how you would write the policy —
        # so a reader holding one revision read "The last 1 are kept" and
        # concluded, carefully and wrongly, that a second rewrite loses the
        # first. True, and unreadable in the specific way that produces a
        # confident wrong belief.
        print(f"'{a.task}' — {len(hist)} earlier revision(s), newest first. "
              f"Up to 5 are kept.")
        for h in reversed(hist):
            print(f"\n  revision {h.get('revision')}  for '{h.get('node')}'  "
                  f"by {h.get('written_by')} at {str(h.get('written_at'))[:19]}")
            for line in (h.get("text") or "").splitlines():
                print(f"      {line}")
        return

    if a.write is None and (a.not_before or a.requires):
        if b is None:
            die(REFUSED, f"no brief for '{a.task}'")
        target = b.get("node")
        parent = ctx.tree["nodes"].get(target, {}).get("parent")
        if sid and parent != me and ctx.rank(me) != 0:
            die(REFUSED, f"'{a.task}' is {target}'s; its gates are set by '{parent}' or rank 0")
        if a.not_before:
            if a.not_before.lower() == "none":
                b.pop("not_before", None)
                print(f"'{a.task}' has no time gate")
            else:
                b["not_before"] = parse_utc(a.not_before)
                print(f"'{a.task}' starts no earlier than {utc_label(b['not_before'])}: "
                      f"`mark`, `recycle` and a close-into-next all skip it until then")
        if a.requires:
            if [x.lower() for x in a.requires] == ["none"]:
                b.pop("requires", None)
                print(f"'{a.task}' requires nothing at presenting")
            else:
                reqs = []
                for r in a.requires:
                    rc, sha, _ = git("rev-parse", "--verify", f"{r}^{{commit}}", cwd=ctx.repo)
                    if rc:
                        die(REFUSED, f"--requires {r}: no such commit here")
                    reqs.append({"ref": r, "sha": sha.strip()})
                b["requires"] = reqs
                print(f"'{a.task}' presents only once its HEAD contains "
                      + ", ".join(f"{x['ref']} ({x['sha'][:8]})" for x in reqs)
                      + ". Commit freely before then.")
        f.write_text(json.dumps(b, indent=2) + "\n")
        if a.not_before and (b.get("not_before") or 0) > time.time():
            launch_wake(ctx, a.task, b["not_before"])
            print(f"  At that time {b.get('node')} is started into it if it is free; "
                  f"busy or mid-task, it takes it at its next close.")
        return

    if a.close_after:
        if b is None:
            die(REFUSED, f"no brief for '{a.task}'")
        target = b.get("node")
        parent = ctx.tree["nodes"].get(target, {}).get("parent")
        if sid and parent != me and ctx.rank(me) != 0:
            die(REFUSED, f"'{a.task}' is {target}'s; its close is set by '{parent}' or rank 0")
        tasks = [] if [x.lower() for x in a.close_after] == ["none"] else list(a.close_after)
        for y in tasks:
            if tkey(y) == tkey(a.task):
                die(REFUSED, f"'{a.task}' cannot close after itself")
            if load_brief(ctx, y)[1] is None and not ctx.state_file("marks", y, ".json").exists():
                die(REFUSED, f"--close-after {y}: no brief or task by that name")
        if tasks:
            b["close_after"], b["close_after_by"] = tasks, who
        else:
            b.pop("close_after", None); b.pop("close_after_by", None)
        f.write_text(json.dumps(b, indent=2) + "\n")
        print(f"'{a.task}' closes only after {', '.join(tasks)} — `mark --close` refuses "
              f"until then" if tasks else f"'{a.task}' has no close condition")
        return

    if a.supersede is not None:
        if b is None:
            die(REFUSED, f"no brief for '{a.task}'")
        if not a.supersede.strip():
            die(REFUSED, "say what overtook it. A brief that vanishes without a "
                         "reason is\n           indistinguishable from one nobody "
                         "got to, and the next lead to\n           notice the same "
                         "thing deserves the answer.")
        target = b.get("node")
        parent = ctx.tree["nodes"].get(target, {}).get("parent")
        # The same authority as writing it. Withdrawing work is setting scope,
        # and a node that could withdraw its own brief could choose its own
        # task by declining everything it was given.
        if sid and parent != me and not (target == me and ctx.rank(me) == 0):
            die(REFUSED,
                f"'{me}' did not write '{a.task}' — it is {target}'s, and "
                + (f"'{target}' answers to '{parent}'.\n" if parent
                   else f"'{target}' has no parent.\n")
                + f"           Withdrawing work is setting scope. Say it to "
                  f"{parent or 'your lead'} instead.")
        if superseded(b):
            die(REFUSED, f"'{a.task}' was already superseded at "
                         f"{b['superseded_at'][:19]}: {b.get('superseded_why')}")
        if a.superseded_for and load_brief(ctx, a.superseded_for)[1] is None:
            die(REFUSED, f"no brief '{a.superseded_for}' to replace it with. Write "
                         f"the replacement first — a\n           pointer at nothing "
                         f"is worse than no pointer.")
        mf = ctx.state_file("marks", a.task, ".json")
        if mf.exists() and not json.loads(mf.read_text()).get("_closed_at"):
            die(REFUSED,
                f"'{a.task}' has an open mark — somebody is on it. Superseding a "
                f"brief\n           does not stop a session, and a task withdrawn "
                f"under a working node is\n           work thrown away without "
                f"telling it. Say so to {target} first.")
        # Read before the flag is set: awaiting() is false once a brief is
        # superseded, which is the point of it, and asking afterwards would
        # always say there was nothing to withdraw.
        voided = awaiting(b)
        b["superseded_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        b["superseded_by"] = f"{me} (session {sid[:8]})" if sid else "operator"
        b["superseded_why"] = a.supersede
        b["superseded_for"] = a.superseded_for or None
        # A withdrawn brief cannot need approval. Leaving the request standing
        # wakes the operator to a decision about work nothing can start, and
        # approving it would release something already stopped. This is not
        # approving or declining — those are the operator's and stay theirs. It
        # is the node that ASKED withdrawing its own question, which is the same
        # act as withdrawing the brief the question was about.
        if voided:
            b["approval"]["state"] = "withdrawn"
            b["approval"]["decided_at"] = b["superseded_at"]
            b["approval"]["decided_by"] = b["superseded_by"]
            b["approval"]["why"] = f"the brief was superseded: {a.supersede}"
        f.write_text(json.dumps(b, indent=2) + "\n")
        print(f"superseded {a.task}: {a.supersede}")
        if voided:
            print(f"  Its pending approval is withdrawn — the operator is no longer "
                  f"being asked to\n  decide about work that nothing can start.")
        if a.superseded_for:
            print(f"  replaced by {a.superseded_for} ({task_state(ctx, a.superseded_for)})")
        print(f"  The brief stays and is still readable. Nothing offers it again: "
              f"not the\n  queue, not a recycle, not spawn, and mark refuses it.")
        return

    if a.approve or a.decline is not None:
        if b is None:
            die(REFUSED, f"no brief for '{a.task}'")
        if not awaiting(b):
            st = (b.get("approval") or {}).get("state") or "not gated"
            die(REFUSED, f"'{a.task}' is not waiting on approval ({st})")
        # Rank 0 decides on the operator's behalf; ranks below it still may not.
        #
        # It used to refuse EVERY session, rank 0 included, and the reasoning is
        # kept rather than deleted because the risk it named did not go away:
        # approval is a DECISION, not a capability, and a lead approving the
        # work it just briefed is the gate approving itself. The CLI cannot
        # authenticate an operator and does not pretend to, so it refused the
        # one case it could identify. Changed on the operator's instruction
        # 2026-09-07, after that refusal left rank 0 unable to act on the
        # approvals waiting for it.
        #
        # The refusal below rank 0 is untouched, and it is the arm that was
        # always load-bearing: a lead approving its own child's brief staffs
        # work that nobody outside the pair ever saw. Rank 0 at least holds the
        # charter and is the node talking to the operator.
        if sid and ctx.rank(me) != 0:
            die(REFUSED,
                f"'{me}' is rank {ctx.rank(me)}. Approving work is the operator's, or "
                f"rank 0's on their\n           behalf: a lead approving the brief it "
                f"wrote is the gate approving itself.\n           Raise it upward: "
                f"rank 0 approves it with harness brief {a.task} --approve")
        ap = b["approval"]
        ap["state"] = "approved" if a.approve else "declined"
        ap["decided_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        # Say who, rather than assert "operator". The field was write-only
        # provenance and nothing read it, which is exactly why it could go on
        # claiming a human had decided after that stopped being true. Provenance
        # that is wrong is worse than provenance that is absent.
        ap["decided_by"] = who
        if a.decline is not None:
            if not a.decline.strip():
                die(REFUSED, "say why it is declined — the brief stays on the record "
                             "and the next\n           lead to notice the same thing "
                             "deserves the answer.")
            ap["why"] = a.decline
        # The exact case the old refusal existed for, now reachable. It is NOT
        # refused — carving it out would be the old gate back under a narrower
        # name, and the operator asked for rank 0 to be able to decide — but it
        # is never silent. A gate that approved its own request is the first
        # thing a later reader needs to be able to find, and the record is the
        # only place that can still say so once the session is gone.
        selfsame = sid and (ap.get("asked_by") or "").startswith(f"{me} (")
        if selfsame:
            ap["self_approved"] = True
        f.write_text(json.dumps(b, indent=2) + "\n")
        if selfsame:
            print(f"  NOTE: {me} asked for this and {me} decided it. Recorded as "
                  f"self_approved —\n        nothing outside this node has seen the "
                  f"question.")
        if a.approve:
            print(f"approved {a.task} — it is now at the back of {b.get('node')}'s "
                  f"queue.")
            print(f"  Nothing starts by itself: its lead recycles or spawns "
                  f"{b.get('node')} when ready.")
        else:
            print(f"declined {a.task}: {a.decline}")
            print(f"  The brief stays. It is not queued and cannot be marked.")
        return

    if a.resolve:
        if b is None:
            die(REFUSED, f"no brief for '{a.task}'")
        if ctx.tree["nodes"].get(b.get("node"), {}).get("parent") != me and \
           not (b.get("node") == me and ctx.rank(me) == 0):
            die(REFUSED, f"only '{b.get('node')}'s lead resolves its suggestions")
        ss = b.get("suggestions", [])
        if not 1 <= a.resolve <= len(ss):
            die(REFUSED, f"no suggestion #{a.resolve} (there are {len(ss)})")
        ss[a.resolve - 1]["resolved_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        ss[a.resolve - 1]["resolved_by"] = who
        f.write_text(json.dumps(b, indent=2) + "\n")
        print(f"resolved suggestion #{a.resolve} on {a.task}")
        return

    if b is None:
        mf = ctx.state_file("marks", a.task, ".json")
        extra = ""
        if mf.exists():
            try:
                n = json.loads(mf.read_text()).get("_note")
                if n:
                    extra = f"\n  the mark carries a note, which is not a brief: {n}"
            except Exception:
                pass
        print(f"no brief for '{a.task}'"
              + (f" — its lead writes one:\n  harness brief {a.task} --for {target} "
                 f"--write \"...\"" if target else "") + extra)
        return
    # Reading marks it read for THIS reader only.
    seen_before = (b.get("read") or {}).get(me, "")
    b.setdefault("read", {})[me] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    try:
        f.write_text(json.dumps(b, indent=2) + "\n")
    except Exception:
        pass
    print(f"{a.task}   for {b.get('node')}   revision {b.get('revision')}")
    print(f"  by {b.get('written_by')} at {str(b.get('written_at'))[:19]}")
    if b.get("from"):
        print(f"  splits   {b['from']}")
    ap = b.get("approval") or {}
    if ap.get("state") == "pending":
        print(f"  GATED    not staffable — waiting on approval since "
              f"{_ago(ap.get('asked_at'))}")
    elif ap.get("state") == "declined":
        print(f"  DECLINED by the operator: {ap.get('why')}")
    elif ap.get("state") == "approved":
        print(f"  approved by the operator {_ago(ap.get('decided_at'))}")
    if b.get("from_finding"):
        print(f"  from     {b['from_finding']}, a finding — harness finding "
              f"{b['from_finding']}")
    for nm in (b.get("facts") or []):
        # Resolved at READ time, never pasted at write time. A figure typed into
        # prose is a figure that ages silently, and the honest thing to write
        # beside one is the date it was taken and an instruction to re-derive —
        # which is the whole cost this avoids.
        _, fr = load_fact(ctx, nm)
        o = latest(fr) if fr else None
        if not o:
            print(f"  fact      {nm} — recorded, then removed")
            continue
        fresh, same_wt, _, _ = fact_state(ctx, o)
        tag = ("  [the tree has moved since]" if fresh is False
               else "" if same_wt
               else "  [MEASURED IN ANOTHER WORKTREE]")
        print(f"  fact      {nm} = {o.get('value')}{tag}")
        print(f"            {_ago(o.get('at'))} · {o.get('command')}")
    if b.get("ordered_by"):
        print(f"  placed    where it is by {b['ordered_by']}: {b.get('ordered_why')}")
    if b.get("coupled_to"):
        print(f"  follows   {b['coupled_to']} in the same session: "
              f"{b.get('coupled_why') or ''}")
    if b.get("from_block"):
        # A pointer, not a copy. The operator's actual words stay one hop away
        # in the block record; what is above is the lead's rewriting of them,
        # and that rewriting is the instruction.
        print(f"  answers  the block '{b['from_block']}'  "
              f"— reasoning behind it: harness blocked --list")
    print()
    for line in (b.get("text") or "").splitlines() or [""]:
        print(f"  {line}")
    rs = b.get("rulings") or []
    if rs:
        print(f"\n  {len(rs)} ruling(s) by the owner — they bind this task:")
        for r in rs:
            print(f"  ruled {str(r.get('ruled_at'))[:10]}  {r.get('question')}")
            print(f"           → {r.get('answer')}")
    kids = ctx.children(b.get("node") or "")
    derived = sorted(o["task"] for o in all_briefs(ctx).values()
                     if tkey(o.get("from")) == tkey(a.task))
    if derived:
        print(f"\n  split into {', '.join(derived)}")
    elif kids and b.get("node") == me:
        print(f"\n  Not split yet. This is a segment of work for {', '.join(kids)}, "
              f"not for you to\n  do: break it up and hand each piece down, whole, "
              f"in one brief each.")
        print(f"    harness brief <sub-task> --for {kids[0]} --from {b.get('task')} "
              f"--write \"...\"")
    cs = b.get("comments") or []
    if cs:
        print(f"\n  {len(cs)} comment(s) — context, not instruction. Only the brief "
              f"above tells you what to do.")
        for c in cs:
            flag = "NEW  " if (c.get("at") or "") > seen_before else ""
            print(f"    [{flag}{str(c.get('at'))[:16]}  {c.get('by')}]")
            for line in (c.get("text") or "").splitlines():
                print(f"        {line}")
    ss = b.get("suggestions") or []
    if ss:
        print(f"\n  {len(ss)} suggestion(s):")
        for i, sg in enumerate(ss, 1):
            state = "resolved" if sg.get("resolved_at") else "OPEN"
            print(f"    #{i} [{state}] {sg.get('by')} against rev "
                  f"{sg.get('against_revision')}")
            for line in (sg.get("text") or "").splitlines():
                print(f"        {line}")


def cmd_note(a):
    """Read a task's brief and its comments, or append one.

    A comment is the only thing written to a mark after it opens, and it is
    APPENDED, never edited ([[I6]]). It exists because a reply to a running task
    had nowhere to live that the task's own session could read: a message dies
    with the session that received it, and the next occupant of that node starts
    with none of it. The mark outlives a recycle, so the reply belongs there.

    Reading is free. Writing takes `--add`, and records who wrote it — a session
    id, or `operator` when there is no session, which is the same distinction
    `harness grant` records and for the same reason.
    """
    ctx = Ctx(); ctx.require_enrolled()
    f = ctx.state_file("marks", a.task, ".json")
    bf, b = load_brief(ctx, a.task)
    # A task that is briefed and not yet marked used to have no durable channel
    # at all, and THE WINDOW THAT EXCLUDED IS THE WINDOW THAT MATTERS: between
    # brief and mark is exactly when a fresh session claims a node, orients, and
    # meets whatever it is going to meet. That is how tonight's scaffold
    # incident happened. The only thing reaching a lane before it marks was the
    # brief, and a brief is a plan that gets rewritten — saying one sentence
    # meant folding it into the plan and then checking the load-bearing strings
    # survived the rewrite.
    #
    # The brief already carries `comments`; the viewer has been reading them all
    # along. Nothing needed inventing, only writing to.
    if not f.exists() and b is None:
        die(REFUSED, f"no task '{a.task}' — neither a brief nor a task record.\n"
                     f"           `harness status` lists the open ones, `harness "
                     f"queue` what is briefed.")
    rec = json.loads(f.read_text()) if f.exists() else None

    if a.add:
        sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
        entry = {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                 "by": (f"session {sid[:8]}" if sid else "operator"),
                 "text": a.add}
        if rec is not None:
            rec.setdefault("_comments", []).append(entry)
            f.write_text(json.dumps(rec, indent=2) + "\n")
            print(f"added a comment to {a.task}  ({len(rec['_comments'])} total)")
        else:
            b.setdefault("comments", []).append(entry)
            bf.write_text(json.dumps(b, indent=2) + "\n")
            print(f"added a comment to the BRIEF for {a.task}  "
                  f"({len(b['comments'])} total)")
            print(f"  '{a.task}' is briefed for {b.get('node')} and not yet marked, "
                  f"so it goes on the\n  brief. It is append-only and survives a "
                  f"rewrite of the brief's text — whoever\n  opens the task reads it "
                  f"at `harness brief {a.task}`, and it does not instruct:\n"
                  f"  the brief is the instruction.")
        return

    if rec is None:
        # Briefed and not started. There is no mark to describe, so describe
        # what there is; the read path used to assume the write path's subject.
        print(f"{a.task}")
        print(f"  node     {b.get('node')}")
        print(f"  state    briefed, not yet marked — nobody has opened it")
    else:
        node = rec.get("_node") or "— names no node (it predates the field)"
        print(f"{a.task}")
        print(f"  node     {node}")
        # Both in the reader's clock. These were adjacent lines in two
        # different zones — `_at` comes from a transcript in UTC, `_closed_at`
        # from this CLI in local — each truncated so neither said which.
        print(f"  opened   {_when(rec.get('_at'))}   "
              f"session {str(rec.get('_session'))[:8]}")
        if rec.get("_closed_at"):
            print(f"  closed   {_when(rec['_closed_at'])}")
    if b:
        print(f"  brief    revision {b.get('revision')} by {b.get('written_by')} "
              f"— harness brief {a.task}")
        for line in (b.get("text") or "").splitlines():
            print(f"           {line}")
        openn = [i for i, x in enumerate(b.get("suggestions") or [], 1)
                 if not x.get("resolved_at")]
        if openn:
            print(f"           {len(openn)} open suggestion(s)")
    else:
        print(f"  brief    — none written. Its lead writes one: harness brief {a.task}")
    if rec is not None and rec.get("_note"):
        print(f"  mark note {rec['_note']}")
    # Both stores, because which one a comment landed in is an accident of WHEN
    # it was written, not of what it says. A reader wants the thread.
    cs = ((b or {}).get("comments") or []) + ((rec or {}).get("_comments") or [])
    cs.sort(key=lambda c: c.get("at") or "")
    if not cs:
        print("  no comments")
        return
    print(f"  {len(cs)} comment(s):")
    for c in cs:
        print(f"    [{str(c.get('at'))[:16]}  {c.get('by')}]")
        for line in (c.get("text") or "").splitlines() or [""]:
            print(f"      {line}")


def cmd_grant(a):
    """Record what a node may reach outside its worktree. Append-only.

    The CLI cannot authenticate an operator, so it does not pretend to. What it
    can do is refuse the one case that is laundering rather than administration —
    a session widening its own or a sibling's permissions — and record who made
    every grant so a self-grant is discoverable afterwards. Rank 0 already holds
    arbitrary code execution on every node (I4), so a grant it makes gives it
    nothing it did not have; a member granting itself is a different act.
    """
    ctx = Ctx(); ctx.require_enrolled()
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    p = ctx.state / "grants.json"
    g = load_grants(ctx)

    if a.list or not a.node:
        rows = [(n, r) for n, rs in sorted(g.get("nodes", {}).items()) for r in rs]
        if not rows:
            print("no grants — every node is confined to its worktree"); return
        for n, r in rows:
            state = f"revoked {r['revoked_at'][:10]}" if r.get("revoked_at") else "live"
            by = r.get("granted_by") or "?"
            print(f"  {n:<12} {state:<18} {r.get('rule') or r.get('path')}")
            print(f"  {'':<12} by {by}   {r.get('reason') or '(no reason recorded)'}")
        return

    if a.node not in ctx.tree["nodes"]:
        die(REFUSED, f"'{a.node}' is not a node in {ctx.tree_path}")
    if not a.what:
        die(REFUSED, "name a path or a permission rule to grant")

    if sid:
        node, _ = ctx.node()
        if ctx.rank(node) != 0:
            die(REFUSED,
                f"'{node}' is rank {ctx.rank(node)}. A session cannot widen its own or a\n"
                f"           sibling's permissions — that is the operator's decision being\n"
                f"           routed around, not implemented. Ask for it with "
                f"`harness blocked`, or\n           have the operator run this from a shell.")

    rec = {"granted_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
           "granted_by": (f"session {sid[:8]}" if sid else "shell"),
           "reason": a.reason or "", "for": a.__dict__.get("for_block") or ""}
    if "(" in a.what:
        rec["rule"] = a.what
    else:
        rec["path"] = str(Path(a.what).expanduser().resolve())
    rows = g.setdefault("nodes", {}).setdefault(a.node, [])

    key = rec.get("rule") or rec.get("path")
    if a.revoke:
        hit = [r for r in rows if (r.get("rule") or r.get("path")) == key
               and not r.get("revoked_at")]
        if not hit:
            die(REFUSED, f"no live grant on '{a.node}' for {key}")
        for r in hit:
            r["revoked_at"] = rec["granted_at"]
            r["revoked_by"] = rec["granted_by"]
        p.write_text(json.dumps(g, indent=2) + "\n")
        print(f"revoked {key} on {a.node} — it applies at the next spawn or recycle, "
              f"not to a session already running")
        return

    if any((r.get("rule") or r.get("path")) == key and not r.get("revoked_at") for r in rows):
        print(f"already granted: {key} on {a.node}"); return
    rows.append(rec)
    p.write_text(json.dumps(g, indent=2) + "\n")
    # Close the block this answers. Left open, `blocked --list` keeps naming
    # something already dealt with, and a list that lies is one nobody reads.
    closed = 0
    bd = ctx.state / "blocks"
    for bf in (sorted(bd.glob("*.json")) if bd.is_dir() else []):
        try:
            br = json.loads(bf.read_text())
        except Exception:
            continue
        if br.get("resolved_at") or br.get("node") != a.node:
            continue
        same = (br.get("need") == a.what
                or (rec.get("path") and
                    str(Path(br.get("need", "")).expanduser().resolve()) == rec["path"]))
        if not same:
            continue
        br["resolved_at"] = rec["granted_at"]
        br["resolved_by"] = "grant"
        bf.write_text(json.dumps(br, indent=2) + "\n")
        append_inbox(dict(br, event="resolved"))
        closed += 1
    print(f"granted {key}\n  to {a.node}, by {rec['granted_by']}"
          + (f"\n  reason: {rec['reason']}" if rec["reason"] else ""))
    print("  applies at the next spawn or recycle; a running session keeps what it had")
    if closed:
        print(f"  closed {closed} block(s) this answers")


def open_blocks(ctx):
    d = ctx.state / "blocks"
    out = {}
    for f in (sorted(d.glob("*.json")) if d.is_dir() else []):
        try:
            r = json.loads(f.read_text())
        except Exception:
            continue
        if not r.get("resolved_at"):
            out[f.stem] = r
    return out


def decided_blocks(ctx):
    """Blocks that closed with a decision in them and no task written yet.

    This is the seam the harness was missing. A block leaves the tree, the
    operator answers it, the answer closes the block, and there it stopped: the
    lane was unblocked but never re-instructed. The decision then lived in a
    block record nobody downstream reads and in a rank 0 transcript that ends at
    the next recycle. Being told is not the same as being tasked, and only a
    task moves.

    So a block that closed with the operator's fingerprints on it — answered in
    comments, or closed by a grant — is not finished until rank 0 says what work
    it produced. That answer is a brief, or an explicit `none`, and both are
    recorded on the block.

    A block the raiser closed by itself with no operator comment is not listed.
    It found another way, there is nothing to hand down, and a queue that names
    work which does not exist is a queue that stops being read.
    """
    out = {}
    d = ctx.state / "blocks"
    for f in (sorted(d.glob("*.json")) if d.is_dir() else []):
        try:
            r = json.loads(f.read_text())
        except Exception:
            continue
        # Answered is the test, not closed. A block the operator replied to and
        # nobody closed is the commonest shape of this: the decision has been
        # made, the lane is still working to the old brief, and it appeared in
        # nobody's queue — not the operator's as a decision (they made it) and
        # not rank 0's as work (it was not resolved).
        if r.get("consequence"):
            continue
        if answered(r):
            out[f.stem] = r
    return out


def task_state(ctx, task):
    """Where a task has got to, in one word, derived rather than tracked.

    A respawn arrives knowing nothing. What it must not do is re-decide work
    already in flight, and the only thing that stops it is being able to see, per
    task, whether anyone has started or finished it. Every state here is read
    off records that already exist — no second store to fall out of step.
    """
    mf = ctx.state_file("marks", task, ".json")
    if mf.exists():
        try:
            r = json.loads(mf.read_text())
        except Exception:
            return "unreadable"
        if r.get("_abandoned_at"):
            return "abandoned"            # not settled: the work is undone (obs 39)
        if r.get("_closed_at"):
            return "closed"
        return "presented" if r.get("_presented_at") else "open"
    _, b = load_brief(ctx, task)
    if b is None:
        return "closed" if archived_unit(ctx, task) else "no brief"
    if superseded(b):
        return "superseded"
    ap = (b.get("approval") or {}).get("state")
    return "gated" if ap == "pending" else "declined" if ap == "declined" else "briefed"


def in_flight(ctx):
    """Answered blocks that DID produce a task, where the task is not finished.

    Blocks whose tasks have all closed are finished business and are not printed:
    a queue that keeps naming completed work is one that stops being read, which
    is the same rule that keeps a self-closed block out of `--decided`.
    """
    out = {}
    d = ctx.state / "blocks"
    for f in (sorted(d.glob("*.json")) if d.is_dir() else []):
        try:
            r = json.loads(f.read_text())
        except Exception:
            continue
        tasks = ((r.get("consequence") or {}).get("tasks")) or []
        if not tasks:
            continue
        states = {t: task_state(ctx, t) for t in tasks}
        if all(v == "closed" for v in states.values()):
            continue
        out[f.stem] = (r, states)
    return out


def answered(r):
    return (r.get("resolved_by") == "grant"
            or any(c.get("by") == "operator" for c in (r.get("comments") or [])))


def settle(ctx, need, node):
    """Find the block a consequence is being recorded against, and close it if it
    is still open.

    Recording what an answer produced IS the second half of closing it ([[T13]]),
    so doing the second half finishes the first. A block the operator answered
    and nobody closed sat in their queue forever while the work it caused was
    already briefed — the queue naming something dealt with, which is how a queue
    stops being read.
    """
    key = re.sub(r"[^A-Za-z0-9]", "_", need or "")
    d = ctx.state / "blocks"
    for f in (sorted(d.glob("*.json")) if d.is_dir() else []):
        try:
            r = json.loads(f.read_text())
        except Exception:
            continue
        if r.get("need") != need and not f.stem.endswith(key):
            continue
        if not r.get("resolved_at") and not answered(r):
            die(REFUSED, f"'{need}' has not been answered by the operator. Recording "
                         f"what it\n           produced would close a block still "
                         f"waiting on them.")
        closed = False
        if not r.get("resolved_at"):
            r["resolved_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
            r["resolved_by"] = node
            closed = True
        return f, r, closed
    die(REFUSED, f"no block for '{need}'")


def stamp_consequence(ctx, need, task, node):
    """Record on the block that this brief is what it produced. Returns the keys
    stamped, so a wrong --from-block is visible rather than silent."""
    hit = []
    d = ctx.state / "blocks"
    for f in (sorted(d.glob("*.json")) if d.is_dir() else []):
        try:
            r = json.loads(f.read_text())
        except Exception:
            continue
        if r.get("need") != need and not f.stem.endswith(
                re.sub(r"[^A-Za-z0-9]", "_", need or "")):
            continue
        c = r.setdefault("consequence", {"tasks": []})
        if isinstance(c, dict):
            c.setdefault("tasks", [])
            if task not in c["tasks"]:
                c["tasks"].append(task)
            c["for"] = node
            c["at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        f.write_text(json.dumps(r, indent=2) + "\n")
        hit.append(f.stem)
    return hit


def unread_block_comments(ctx, who):
    """Comments on ANY open block in this tree, for rank 0 only.

    Not for the node that raised it. A block leaves the tree — it is addressed
    to the operator — and what comes back is usually reasoning rather than an
    instruction: whether a class of document is eligible, whether to re-embed,
    what a column is for. Routed straight to the lane, that reasoning arrives as
    exactly the contextual noise a scoped task is supposed to be free of.

    So the conversation happens between the operator and rank 0, and its OUTCOME
    reaches the lane rewritten: as a grant, as a ruling ([[T9]]), or as a brief
    revision. Each level rewrites rather than forwards, and this is that rule
    applied to the one channel that starts outside the tree.
    """
    if ctx.rank(who) != 0:
        return {}
    out = {}
    for k, r in open_blocks(ctx).items():
        seen = (r.get("read") or {}).get(who, "")
        new = [c for c in (r.get("comments") or []) if (c.get("at") or "") > seen]
        if new:
            out[f"{r.get('node')}: {r.get('need') or k}"] = new
    return out


# ── waiting on a lead (T12, T7) ────────────────────────────────────────────
# A block says a lane needs the OPERATOR. This says it needs its LEAD, which is
# the other half of the same problem and had no record at all: R-table put
# "mid-task" and "awaiting a reply to T12" behind the same `busy` session, so a
# node that asked a question and stopped looked exactly like a node that was
# working. The operator saw a busy tree; the lead saw nothing at all until it
# happened to orient.
def waiting_path(ctx, node):
    return ctx.state_file("waiting", node, ".json")


def open_waits(ctx):
    """Every node in this tree that has asked upward and stopped.

    Its own record, not a field on the claim: a claim says who is here, this
    says what they are doing, and the two have different lifetimes — a wait
    outlives a compact and ends with the answer, not with the session.
    """
    d = ctx.state / "waiting"
    out = {}
    for f in (sorted(d.glob("*.json")) if d.is_dir() else []):
        try:
            r = json.loads(f.read_text())
        except Exception:
            continue
        if r.get("node") in ctx.tree["nodes"]:
            out[r["node"]] = r
    return out


def check_activity(ctx, node):
    """This node's place in the test queue, as a phrase, or None (obs 68, 81)."""
    try:
        jobs = testq_jobs(ctx, ("running", "queued"))
    except Exception:
        return None
    for k, j in enumerate(jobs):
        if not any(r.get("node") == node for r in j.get("requested_by") or []):
            continue
        what = "check" if j.get("kind") == "check" else "test job"
        if j["state"] == "running":
            if not runner_alive(j.get("pid")):
                return f"{what} runner died — harness test --log {j['id']}"
            return (f"{what} running" + (f" arm {j.get('done_arms', 0) + 1}/{j['total']}"
                                         if j.get("total") else "")
                    + f", {wait_age(j.get('started'))}")
        return f"{what} queued, {k} ahead"
    return None


def check_pid_alive(pid):
    """The `check` process itself, not a Claude session: `pid_alive` asks for
    "claude" in the command line, which a check passes only by its install path."""
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except OSError:
        pass
    try:
        cmd = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return True
    return pid == os.getpid() or b"check" in cmd       # a reused pid is not


def runner_alive(pid):
    """A test-queue runner (`harness testd`), not a reused pid."""
    if not isinstance(pid, int) or pid <= 0 or not _pid_exists(pid):
        return False
    try:
        return pid == os.getpid() or b"testd" in Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return True


def node_activity(ctx, node, waits=None):
    """What a node is doing that the runtime's busy/idle cannot say: waiting on
    its lead, or running a check. One reading, used by every surface (obs 68)."""
    w = (open_waits(ctx) if waits is None else waits).get(node)
    if w:
        return f"waiting on {w.get('parent') or 'its lead'} {wait_age(w.get('since'))}: {w.get('asked')}"
    return check_activity(ctx, node)


def clear_wait(ctx, node):
    """Silently does nothing when nothing is waiting.

    Every caller is a moment where the node has plainly stopped waiting —
    released, or marked onto other work — and none of them should have to check
    first. The record is removed rather than tombstoned; what happened is in
    the inbox, where the rest of the history already lives, and a directory of
    cleared waits nobody reads is a directory that hides the live ones.
    """
    f = waiting_path(ctx, node)
    if not f.exists():
        return False
    f.unlink()
    append_inbox({"event": "wait-cleared", "node": node, "repo": str(ctx.repo),
                  "at": time.strftime("%Y-%m-%dT%H:%M:%S%z")})
    return True


def wait_age(since):
    """How long it has been stopped, in the units a person answers in."""
    try:
        t = time.mktime(time.strptime((since or "")[:19], "%Y-%m-%dT%H:%M:%S"))
    except Exception:
        return ""
    m = int(max(0, time.time() - t) // 60)
    return f"{m}m" if m < 60 else f"{m // 60}h{m % 60:02d}"


def cmd_waiting(a):
    """A member says, on the record, that it asked and stopped.

    The point is not the flag. It is that `--still-moving` is asked for at the
    same moment: a lane that is waiting on one answer and working on four other
    things is not the same event as a lane that has halted, and a lead reading
    a list of stopped children needs to know which it is before it decides what
    to answer first.

    It does not notify. A lead reads it when it orients, exactly like every
    other thing that climbs — anything that interrupts a lead mid-task is a
    message, and messages arrive out of order and are read once.
    """
    ctx = Ctx(); ctx.require_enrolled()
    node, spec = ctx.node()
    parent = spec.get("parent")

    if a.list:
        rows = open_waits(ctx)
        if not rows:
            print("nobody in this tree is waiting on an answer")
            return
        for n in sorted(rows):
            r = rows[n]
            print(f"{n:<12} → {(r.get('parent') or 'rank 0'):<12} "
                  f"{wait_age(r.get('since')):>6}  {r.get('asked') or '—'}")
            if r.get("still_moving"):
                print(f"{'':<12}   still moving: {r['still_moving']}")
        return

    if a.clear:
        if clear_wait(ctx, node):
            print(f"{node} is no longer marked as waiting")
        else:
            print(f"{node} was not marked as waiting")
        return

    if not a.asked:
        # Reading the state is the commonest use, so it is what the bare verb
        # does. Both directions, because a lead wants the other one.
        waits = open_waits(ctx)
        mine = waits.get(node)
        if mine:
            print(f"waiting  on {mine.get('parent') or 'your lead'} for "
                  f"{wait_age(mine.get('since'))} — {mine.get('asked')}")
            if mine.get("still_moving"):
                print(f"         still moving: {mine['still_moving']}")
            print(f"         harness waiting --clear, the moment you have the answer")
        else:
            print(f"{node} is not waiting on anything")
        for r in sorted((r for r in waits.values() if r.get("parent") == node),
                        key=lambda r: r.get("since") or ""):
            print(f"asked    {r['node']} has been stopped on you for "
                  f"{wait_age(r.get('since'))} — {r.get('asked')}")
        return

    if parent is None:
        die(REFUSED,
            "rank 0 has no lead to wait on. What rank 0 waits for is the "
            "operator,\n           and that is a block:\n\n"
            "           harness blocked <need> --why \"...\" --still-moving \"...\"")
    rec = {"node": node, "parent": parent, "asked": a.asked,
           "still_moving": a.still_moving or "",
           "repo": str(ctx.repo),
           "since": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
           "session": os.environ.get("CLAUDE_CODE_SESSION_ID", "")}
    f = waiting_path(ctx, node)
    f.parent.mkdir(parents=True, exist_ok=True)
    f.write_text(json.dumps(rec, indent=2) + "\n")
    append_inbox(dict(rec, event="waiting"))
    print(f"{node} is marked as waiting on {parent}")
    # The record is read at the lead's next harness command, and a lead parked on
    # a long job runs none, so the wait sat unseen behind a 29-minute check (obs 68).
    # Same remedy as presenting: say it, now, to the running session.
    _lead, _ = lead_address(ctx, parent)
    _doing = check_activity(ctx, parent)
    if _doing:
        print(f"  {parent} is running {_doing} and runs no harness command until it ends.")
    if _lead:
        print(f"  The record does not reach it. Send this before you stop, in this turn:")
        print(f"    SendMessage(to: \"{_lead}\", message: \"{node} is waiting on you: "
              f"{a.asked}\")")
    else:
        print(f"  {parent} is not running, so nobody is told; its parent sees the wait "
              f"after {WAIT_STALL // 60}m.")
    if not a.still_moving:
        print(f"  Nothing was recorded as still moving, so this reads as a full stop.")
        print(f"  If it is not one, say so: harness waiting {shlex.quote(a.asked)} "
              f"--still-moving \"...\"")
    print(f"  Clear it yourself when the answer lands: harness waiting --clear")


def cmd_blocked(a):
    """A member raises a block as a RECORD, not a message.

    A message carrying a blocked lane arrives in a transcript, out of order,
    behind whatever else is in it, and terminates on nothing. A record sits in
    one place, survives the recycle that ends the session which raised it, and
    `status` prints every one of them together. It grants nothing: raising a
    block and being unblocked are deliberately different acts, performed by
    different parties.
    """
    ctx = Ctx(); ctx.require_enrolled()
    node, _ = ctx.node()

    if a.decided:
        rows = decided_blocks(ctx)
        flight = in_flight(ctx)
        if flight:
            print("answered, in hand:")
            for k, (r, st) in sorted(flight.items()):
                print(f"  {r.get('node', '?'):<12} {str(r.get('need'))[:34]:<36} "
                      + ", ".join(f"{t} {v}" for t, v in st.items()))
            print()
        if not rows:
            print("nothing answered is waiting on a task"); return
        print(f"{len(rows)} block(s) answered and not yet turned into work.\n")
        for k, r in sorted(rows.items()):
            print(f"  {r.get('node', '?'):<12} {r.get('need', k)}")
            print(f"  {'':<12} raised for: {r.get('why') or '—'}")
            for c in (r.get("comments") or []):
                print(f"  {'':<12} [{str(c.get('at'))[:16]}  {c.get('by')}]")
                for line in (c.get("text") or "").splitlines():
                    print(f"  {'':<14}  {line}")
            kid = ctx.tree["nodes"].get(r.get("node"), {}).get("parent")
            hand = r.get("node") if kid == node else (kid or r.get("node"))
            print(f"  {'':<12} write the task it produced, for the rank below you:")
            print(f"  {'':<14}  harness brief <task> --for {hand} "
                  f"--from-block {shlex.quote(r.get('need') or k)} --write \"...\"")
            print(f"  {'':<12} or, if the task already exists, link it:")
            print(f"  {'':<14}  harness blocked {shlex.quote(r.get('need') or k)} "
                  f"--task <task>")
            print(f"  {'':<12} or record that it produced none:")
            print(f"  {'':<14}  harness blocked {shlex.quote(r.get('need') or k)} "
                  f"--no-task \"why not\"\n")
        print("Being told is not being tasked. Until one of these is written, the")
        print("lane that raised the block is unblocked and still working to the old")
        print("brief — the decision reached you and stopped.")
        return

    if a.task and not a.resolve:
        # The link was made at the moment a brief was written with --from-block,
        # and only then. Work briefed before anyone thought to connect it left
        # the block asking for a task that already existed, and every respawn
        # asked again.
        f, r, closed = settle(ctx, a.need, node)
        for t in a.task:
            if load_brief(ctx, t)[1] is None:
                die(REFUSED, f"no brief '{t}'")
        c = r.setdefault("consequence", {"tasks": []})
        c.setdefault("tasks", [])
        for t in a.task:
            if t not in c["tasks"]:
                c["tasks"].append(t)
        c["by"], c["at"] = node, time.strftime("%Y-%m-%dT%H:%M:%S%z")
        f.write_text(json.dumps(r, indent=2) + "\n")
        print(f"{r.get('need')} → " + ", ".join(
            f"{t} ({task_state(ctx, t)})" for t in c["tasks"])
            + ("   (block closed)" if closed else ""))
        return

    if a.no_task is not None:
        if ctx.rank(node) != 0:
            die(REFUSED, f"'{node}' is rank {ctx.rank(node)}. Whether an answer produces "
                         f"work is\n           rank 0's call — it is the only party in the "
                         f"conversation the answer came from.")
        if not (a.no_task or "").strip():
            die(REFUSED, "say why it produces no work. An unexplained 'none' is "
                         "indistinguishable\n           from forgetting.")
        f, r, closed = settle(ctx, a.need, node)
        r["consequence"] = {"tasks": [], "none": a.no_task,
                            "by": node, "at": time.strftime("%Y-%m-%dT%H:%M:%S%z")}
        f.write_text(json.dumps(r, indent=2) + "\n")
        print(f"{r.get('need')} → no task: {a.no_task}"
              + ("   (block closed)" if closed else ""))
        print(f"  '{r.get('node')}' is not told — if it should be, that is a brief "
              f"revision.")
        return

    if a.list or not a.need:
        rows = open_blocks(ctx)
        pend = decided_blocks(ctx) if ctx.rank(node) == 0 else {}
        if not rows and not pend:
            print("nothing blocked"); return
        if not rows:
            print("nothing blocked")
        for k, r in sorted(rows.items()):
            print(f"  {r.get('node', '?'):<12} {r.get('need', k)}")
            print(f"  {'':<12} {r.get('why') or '(no reason recorded)'}   "
                  f"raised {str(r.get('raised_at'))[:19]}")
            cs = r.get("comments") or []
            for c in cs:
                print(f"  {'':<12} [{str(c.get('at'))[:16]}  {c.get('by')}]")
                for line in (c.get("text") or "").splitlines():
                    print(f"  {'':<14}  {line}")
            if cs and ctx.rank(node) == 0:
                r.setdefault("read", {})[node] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
                try:
                    (ctx.state / "blocks" / (k + ".json")).write_text(
                        json.dumps(r, indent=2) + "\n")
                except Exception:
                    pass
        if pend:
            print(f"\n{len(pend)} answered and not yet turned into work — "
                  f"harness blocked --decided")
            for k, r in sorted(pend.items()):
                print(f"  {r.get('node', '?'):<12} {r.get('need', k)}")
        return
    if a.comment is not None:
        # The operator answering a block is the thing the lane is waiting on, so
        # it goes on the record rather than into a message: the record outlives
        # the session that raised it, and the next occupant of that node inherits
        # the answer along with the question.
        hits = [(k, r) for k, r in open_blocks(ctx).items()
                if r.get("need") == a.need or k.endswith(re.sub(r"[^A-Za-z0-9]", "_",
                                                                a.need or ""))]
        if not hits:
            die(REFUSED, f"no open block for '{a.need}'. `harness blocked --list` lists them.")
        k, r = hits[0]
        bf = ctx.state / "blocks" / (k + ".json")
        r.setdefault("comments", []).append(
            {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
             "by": (f"{node} (session {os.environ['CLAUDE_CODE_SESSION_ID'][:8]})"
                    if os.environ.get("CLAUDE_CODE_SESSION_ID") else "operator"),
             "text": a.comment})
        bf.write_text(json.dumps(r, indent=2) + "\n")
        root = next((n for n in ctx.tree["nodes"] if ctx.rank(n) == 0), "rank 0")
        print(f"commented on the block '{r.get('need')}' ({len(r['comments'])} total)")
        print(f"  '{root}' sees it at its next harness command — NOT '{r.get('node')}'.")
        print(f"  Reasoning about a block is discussed at rank 0 and reaches the lane")
        print(f"  rewritten: as a grant, a ruling, or a brief revision.")
        return

    f = ctx.state_file("blocks", f"{node}-{a.need}", ".json")
    f.parent.mkdir(parents=True, exist_ok=True)
    if a.resolve:
        # You close your own. Rank 0 closes anyone's, because rank 0 is the party
        # that holds the conversation the answer comes from — leaving the close
        # to the raiser means the node that was never in that conversation
        # decides when it is over.
        if not f.exists() and ctx.rank(node) == 0:
            hits = [(k, r) for k, r in open_blocks(ctx).items()
                    if r.get("need") == a.need or k.endswith(
                        re.sub(r"[^A-Za-z0-9]", "_", a.need or ""))]
            if hits:
                f = ctx.state / "blocks" / (hits[0][0] + ".json")
        if not f.exists():
            die(REFUSED, f"no block recorded for '{a.need}' on {node}")
        r = json.loads(f.read_text())
        answered = any(c.get("by") == "operator" for c in (r.get("comments") or []))
        if answered and not (a.task or a.no_task is not None):
            die(REFUSED,
                f"'{a.need}' was answered by the operator. Closing it is half the "
                f"act; the\n           other half is saying what work the answer "
                f"produced, because a decision\n           nobody is tasked with is a "
                f"decision that does not move.\n\n"
                f"           harness blocked {shlex.quote(a.need)} --resolve "
                f"--task <task>      (a brief you wrote)\n"
                f"           harness blocked {shlex.quote(a.need)} --resolve "
                f"--no-task \"why\"   (it produced none)")
        if a.task:
            for t in a.task:
                if load_brief(ctx, t)[1] is None:
                    die(REFUSED, f"no brief '{t}'. Write the task before you close the "
                                 f"block:\n           harness brief {t} --for <node> "
                                 f"--from-block {shlex.quote(a.need)} --write \"...\"")
            r["consequence"] = {"tasks": list(a.task), "by": node,
                                "at": time.strftime("%Y-%m-%dT%H:%M:%S%z")}
        elif a.no_task is not None:
            r["consequence"] = {"tasks": [], "none": a.no_task, "by": node,
                                "at": time.strftime("%Y-%m-%dT%H:%M:%S%z")}
        r["resolved_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        r["resolved_by"] = node
        f.write_text(json.dumps(r, indent=2) + "\n")
        append_inbox(dict(r, event="resolved"))
        print(f"resolved: {a.need}")
        if a.task:
            print("  → " + ", ".join(f"{t} ({task_state(ctx, t)})" for t in a.task))
        return
    if f.exists() and not json.loads(f.read_text()).get("resolved_at"):
        print(f"already raised: {a.need} on {node}"); return
    rec = {"node": node, "need": a.need, "why": a.why or "",
           "still_moving": a.still_moving or "",
           "repo": str(ctx.repo),
           "raised_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
           "session": os.environ.get("CLAUDE_CODE_SESSION_ID", "")}
    f.write_text(json.dumps(rec, indent=2) + "\n")
    append_inbox(dict(rec, event="raised"))
    print(f"raised on {node}: {a.need}")
    print(f"  rank 0 sees it in `harness blocked --list`")
    print("  Do not route around it, do not ask a session with looser settings to do")
    print("  it for you, and do not stop: carry on with everything this does not")
    print("  block, and say in your report what it does.")


def cmd_scaffold(a):
    # The most tree-wide act in this CLI, and until now it was reachable — and
    # recommended in writing — from the most junior session in the tree.
    # core.hooksPath is absolute into the document node's checkout, so a
    # scaffold run from ANY worktree rewrites the hooks every node executes, at
    # once, the moment the files land: no commit, no review, and sessions
    # mid-task never learn it happened.
    #
    # A leaf met doctor's drift FAIL on claim, did exactly what the line told
    # it, and rewrote the whole tree's guards before it had done any work. An
    # earlier session on the same node hit the same FAIL and correctly refused
    # — and that refusal died with it, because it lived in a message rather
    # than in anything the next session could read. Two sessions, same node,
    # same input, opposite acts. That is a missing rule, not a lapse of
    # judgement, and `grant` and `trim` already refuse by rank for it.
    # Probed without dying, because scaffolding is also how a repo that is NOT
    # enrolled gets its first tree. The refusal is raised OUTSIDE the probe: the
    # first version put die() inside a bare except and the gate silently never
    # fired, which is the same fault it was written to prevent.
    standing = None
    try:
        ctx = Ctx()
        if ctx.binding_path.exists() and os.environ.get("CLAUDE_CODE_SESSION_ID"):
            ctx.require_enrolled()
            node, _ = ctx.node()
            standing = (node, ctx.rank(node))
    except SystemExit:
        standing = None
    except Exception:
        standing = None
    if standing and standing[1] != 0:
        node, rank = standing
        die(REFUSED,
                    f"'{node}' is rank {rank}. Scaffolding is rank 0's, or "
                    f"the operator's directly.\n\n"
                    f"           core.hooksPath is absolute into the document node's "
                    f"checkout, so this\n           would rewrite the hooks EVERY node "
                    f"in the tree runs — including the ones\n           mid-task, which "
                    f"would never learn it happened. There is no commit and no\n"
                    f"           review between the copy and the effect.\n\n"
                    f"           Report it upward instead. Say which arm of `harness "
                    f"doctor` failed and\n           what the diff showed; the decision "
                    f"and the timing are rank 0's.")
    repo = Path(a.repo).resolve()
    rc, common, _ = git("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=repo)
    if rc:
        die(NOT_ENROLLED, f"{repo} is not a git repository")
    repo = Path(common).parent
    dst = repo / ".harness"
    if dst.exists() and not a.force:
        die(REFUSED, f"{dst} already exists (use --force to overwrite hooks only)")
    rc, prior, _ = git("config", "--get", "core.hooksPath", cwd=repo)
    target = str(dst / "hooks")
    if rc == 0 and prior and prior != target and not a.force:
        die(REFUSED,
            f"core.hooksPath is already set to '{prior}'.\n"
            f"           Scaffolding would replace it, disabling whatever guards it "
            f"points at.\n           Re-run with --force to replace it deliberately.")
    (dst / "hooks").mkdir(parents=True, exist_ok=True)
    for h in (TEMPLATES / "hooks").iterdir():
        shutil.copy2(h, dst / "hooks" / h.name)
        os.chmod(dst / "hooks" / h.name, 0o755)
    for f in ("tree.json", "manifest.json"):
        if not (dst / f).exists():
            shutil.copy2(TEMPLATES / f, dst / f)
    # Absolute, never relative: a relative hooksPath missing on a branch runs no
    # hook and exits 0 silently. Absolute also makes every worktree resolve to
    # the same guards, so no branch is ever naked.
    # The chmod above touches the filesystem; git records the mode from its
    # index. Where core.fileMode is false — any Windows-backed mount — the two
    # disagree, and hooks committed at 100644 are inert in every fresh clone and
    # after every `git reset --hard`. Set the mode git will actually store.
    hook_files = [str((dst / "hooks" / h.name).relative_to(repo)) for h in (TEMPLATES / "hooks").iterdir()]
    git("add", "--", *hook_files, cwd=repo)
    rc, _, err = git("update-index", "--chmod=+x", "--", *hook_files, cwd=repo)
    if rc:
        print(f"WARNING: could not set the executable bit in git's index: {err}", file=sys.stderr)
        print("         Commit these and the hooks will be inert in fresh clones.", file=sys.stderr)
    else:
        modes = git("ls-files", "-s", "--", *hook_files, cwd=repo)[1].splitlines()
        bad = [m for m in modes if not m.startswith("100755")]
        print("hooks staged 100755 in the index" if not bad
              else f"WARNING: {len(bad)} hook(s) still not executable in the index")
    git("config", "core.hooksPath", str(dst / "hooks"), cwd=repo)
    # Orientation hook, scoped to THIS repo. Anthropic documents three scopes:
    # ~/.claude/settings.json is every project; .claude/settings.json is this one
    # and is committable. A harness hook has no business existing outside an
    # enrolled repo, so it goes here and travels with the tree.
    cs = repo / ".claude" / "settings.json"
    cs.parent.mkdir(parents=True, exist_ok=True)
    conf = {}
    if cs.exists():
        try:
            conf = json.loads(cs.read_text())
        except json.JSONDecodeError:
            die(REFUSED, f"{cs} exists but is not valid JSON — refusing to overwrite it")
    hooks = conf.setdefault("hooks", {})
    ss = hooks.setdefault("SessionStart", [])
    for e in ss:
        e["hooks"] = [h for h in e.get("hooks", []) if "harness" not in h.get("command", "")]
    ss[:] = [e for e in ss if e["hooks"]]
    ss.append({"matcher": "startup|resume|compact",
               "hooks": [{"type": "command", "timeout": 10,
                          "command": "~/.claude/harness/bin/harness whoami --quiet --no-check",
                          "statusMessage": "Resolving harness position..."}]})
    # The one moment a member that has finished and said nothing is still
    # reachable. Everything else here reaches a session when it runs a command,
    # and the failure this catches is that it runs none: it finishes the work and
    # ends its turn. Blocks once, names the command, then lets the stop proceed.
    st = hooks.setdefault("Stop", [])
    for e in st:
        e["hooks"] = [h for h in e.get("hooks", []) if "harness" not in h.get("command", "")]
    st[:] = [e for e in st if e["hooks"]]
    st.append({"hooks": [{"type": "command", "timeout": 10,
                          "command": "~/.claude/harness/bin/harness hook-stop"}]})
    # The per-turn orientation heartbeat, and the reason it is THIS event.
    # Checked against the reference 2026-09-08 rather than assumed: exit-0
    # stdout becomes context for UserPromptSubmit, UserPromptExpansion,
    # SessionStart and PostModelSwitch, and for everything else — Stop included
    # — it goes to the debug log. So `Stop` can only reach a session by BLOCKING
    # it, which is right for work that is owed and wrong for news; this is the
    # channel that can simply say something.
    #
    # It costs nothing when nothing has changed, because it prints nothing. A
    # line printed at turn k of an n-turn session is resent on every turn after
    # it, so a per-turn report of STATE would be quadratic; a report of CHANGE
    # is paid once per change and never again. Timeout is short because this is
    # on the interactive path and it reads local JSON only.
    up = hooks.setdefault("UserPromptSubmit", [])
    for e in up:
        e["hooks"] = [h for h in e.get("hooks", []) if "harness" not in h.get("command", "")]
    up[:] = [e for e in up if e["hooks"]]
    up.append({"hooks": [{"type": "command", "timeout": 5,
                          "command": "~/.claude/harness/bin/harness hook-orient"}]})
    cs.write_text(json.dumps(conf, indent=2) + "\n")
    print(f"scaffolded {dst}")
    # It was sold as "make the hooks match" and also rewrote how every session
    # in the project terminates, unstaged and unmentioned. A command that
    # changes two things has to name both, especially when the second is not
    # the one anybody ran it for.
    print(f"  hooks       {dst / 'hooks'}  — live IMMEDIATELY for every node in "
          f"this tree,\n              because core.hooksPath is absolute. No commit "
          f"stands between the\n              copy and the effect; sessions mid-task "
          f"will not learn of it.")
    print(f"  settings    {cs}  — a Stop hook was added or refreshed here. That "
          f"changes how\n              every session in this project ends, which is "
          f"not what you ran this for.")
    print(f"  Both are left for you to review and commit. Uncommitted hooks in a "
          f"single-checkout\n  worktree are the worse resting state: every node runs "
          f"what HEAD does not contain,\n  and one `git reset` anywhere disarms the "
          f"tree silently.")
    print(f"orientation hook → {cs}  (this repo only; commit it)")
    if rc == 0 and prior and prior != target:
        print(f"core.hooksPath REPLACED: {prior}  ->  {target}")
        print(f"  whatever guards '{prior}' provided are no longer running.")
    else:
        print(f"core.hooksPath = {target}  (absolute, shared by every worktree)")
    print("next: edit .harness/tree.json, commit it, then: harness enrol " + str(repo))


def cmd_unenrol(a):
    ctx = Ctx()
    if ctx.binding_path.exists():
        ctx.binding_path.unlink()
        print(f"unenrolled {ctx.repo.name} on this machine (repo untouched)")
    else:
        print("this machine was not enrolled")


# ── T5 document pairs, as data (obs 25, 47) ─────────────────────────────────

PAIR_OPS = {"replace": ("file", "old", "new"), "create": ("file", "new"),
            "move": ("file", "old", "to", "pointer"), "delete": ("file",)}


def parse_pairs(src):
    """A JSON list of pairs, from a path or the JSON itself. Each is
    {file, old, new, why} (a replace), or carries `op`: create {file, new},
    move {file, old, to, pointer} (old leaves file for the end of `to`, pointer
    takes its place), delete {file}."""
    try:
        text = (sys.stdin.read() if src == "-" else
                Path(src).read_text() if Path(src).is_file() else src)
        pairs = json.loads(text)
    except Exception as e:
        die(REFUSED, f"pairs are a JSON list of {{file, old, new, why}}: {e}")
    if not isinstance(pairs, list) or not pairs:
        die(REFUSED, "pairs are a non-empty JSON list of {file, old, new, why}")
    for i, x in enumerate(pairs, 1):
        op = x.get("op", "replace") if isinstance(x, dict) else None
        need = PAIR_OPS.get(op)
        if not need:
            die(REFUSED, f"pair {i}: op is one of {', '.join(PAIR_OPS)}")
        if not all(isinstance(x.get(k), str) for k in need) or ("old" in need and not x["old"]):
            die(REFUSED, f"pair {i} ({op}) needs string {', '.join(repr(k) for k in need)}"
                         + (" (old non-empty)" if "old" in need else ""))
    return pairs


def pair_report(pairs, read, check=None):
    """Each pair judged in order, applying earlier pairs first so a batch that
    edits one file twice is judged as it will be applied. Returns (rows, texts):
    rows are (i, pair, count, nearest, note), ok when count is 1; texts the
    results, None for a file the batch deletes. `check(pair)` may refuse a pair
    with a reason (a cited path)."""
    texts, rows = {}, []
    def get(f):
        if f not in texts:
            texts[f] = read(f)
        return texts[f]
    for i, x in enumerate(pairs, 1):
        op, f = x.get("op", "replace"), x["file"]
        t, n, near, note = get(f), 0, None, None
        if op == "create":
            n, note = (1, None) if t is None else (0, "the file already exists")
            if n:
                texts[f] = x["new"]
        elif op == "delete":
            n, note = (1, None) if t is not None else (0, "no such file")
            if n:
                texts[f] = None
        else:
            n = t.count(x["old"]) if t is not None else 0
            if n == 0 and t is not None:
                first = next((l for l in x["old"].splitlines() if l.strip()), "")
                near = (difflib.get_close_matches(first, t.splitlines(), n=1, cutoff=0.5)
                        or [None])[0]
            if n == 1 and op == "move":
                texts[f] = t.replace(x["old"], x["pointer"], 1)
                dest = get(x["to"]) or ""
                texts[x["to"]] = dest + ("\n" if dest and not dest.endswith("\n") else "") \
                    + x["old"] + ("" if x["old"].endswith("\n") else "\n")
            elif n == 1:
                texts[f] = t.replace(x["old"], x["new"], 1)
        if n == 1 and check:
            note = check(x)
            if note:
                n = 0
        rows.append((i, x, n, near, note))
    return rows, texts


def print_pair_report(rows):
    for i, x, n, near, note in rows:
        op = x.get("op", "replace")
        print(f"  {'ok ' if n == 1 else 'BAD'} {i:>2}  {x['file']}"
              + (f" → {x['to']}" if op == "move" else "")
              + (f"  {op}" if op != "replace" else f"  count {n}")
              + (f"  — {note}" if note else f"  — {x['why']}" if x.get("why") else ""))
        if n == 0 and near is not None:
            first = next((l for l in x["old"].splitlines() if l.strip()), "")
            print(f"         old:     {first[:100]}\n         nearest: {near[:100]}")
    return all(n == 1 for _, _, n, _, _ in rows)


def words(t):
    return len((t or "").split())


def claude_md_budget(ctx):
    """The manifest's word budget for CLAUDE.md, or None."""
    try:
        v = json.loads((ctx.repo / ".harness" / "manifest.json").read_text()).get("claude_md_words")
        return int(v) if v else None
    except Exception:
        return None


def budget_verdict(ctx, read, texts):
    """A refusal when the batch leaves CLAUDE.md over budget AND larger than it
    was. A batch that shrinks it always passes, so an over-budget file can still
    be cut down. Whoever sent it: the budget is the harness's."""
    cap = claude_md_budget(ctx)
    if not cap or "CLAUDE.md" not in texts:
        return None
    before, after = words(read("CLAUDE.md")), words(texts["CLAUDE.md"])
    if after > cap and after > before:
        return (f"CLAUDE.md would be {after:,} words, over its budget of {cap:,} "
                f"(it is {before:,}). Move the detail to the doc that owns it and point there.")
    return None


def pair_guard(ctx):
    """A delete may not take away a path an open record names (obs 74). A move
    keeps its file, so it strands nothing. A file a batch creates, or a move's
    destination, must be one the manifest classes as a document (obs 76: the
    documenter's provenance/ files were code until rank 0 added a glob)."""
    def check(x):
        new = x["file"] if x.get("op") == "create" else x.get("to") if x.get("op") == "move" else None
        if new and guard_classify(ctx, [new]).get(new) == "code":
            top = new.split("/")[0]
            return (f"the manifest classes {new} as code; add a docs glob that covers it "
                    f"(e.g. {top}/**/*.md) or pick a document path")
        if x.get("op") != "delete":
            return None
        hits = [w for ws in cited(ctx, [str(ctx.repo / x["file"])]).values() for w, _ in ws]
        return f"an open record names it: {', '.join(hits[:3])}" if hits else None
    return check


def doc_node(ctx):
    return next(((n, v) for n, v in ctx.tree["nodes"].items() if v.get("kind") == "doc"),
                (None, {}))


def pairs_path(ctx, task):
    return ctx.state_file("pairs", task, ".json")


def cmd_pairs(a):
    """`pairs submit <json> --task T`, `pairs <T>`, `pairs apply <T>`."""
    ctx = Ctx(); ctx.require_enrolled()
    node, spec = ctx.node()
    dn, ds = doc_node(ctx)
    branch = ds.get("branch")

    def on_branch(path):
        rc, out, _ = git("show", f"{branch}:{path}", cwd=ctx.repo)
        return out + "\n" if rc == 0 else None   # git() strips; the file ends in one

    if a.verb == "submit":
        documenter = os.environ.get("HARNESS_DOCUMENTER") == "1"
        task = a.task or (f"docs-{time.strftime('%Y%m%d-%H%M%S')}" if documenter else None)
        if not task:
            die(REFUSED, "which task do these pairs serve? --task <task>")
        pairs = parse_pairs(a.target or "")
        rows, texts = pair_report(pairs, on_branch, pair_guard(ctx))
        ok = print_pair_report(rows)
        if not ok:
            die(REFUSED, f"every old must occur exactly once in {branch}'s copy. Fix the "
                         f"BAD pair(s) and submit again — send whole paragraphs, byte-exact.")
        over = budget_verdict(ctx, on_branch, texts)
        if over:
            die(REFUSED, over)
        rec = {"task": task, "by": "documenter" if documenter else node,
               "at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
               "base": git("rev-parse", branch, cwd=ctx.repo)[1].strip(),
               "pairs": pairs, "applied": None}
        if documenter:
            rec.update(auto=True, job=os.environ.get("HARNESS_DOCUMENTER_JOB") or "auto",
                       model=os.environ.get("HARNESS_DOCUMENTER_MODEL") or None,
                       session=os.environ.get("CLAUDE_CODE_SESSION_ID") or None)
        a.task = task
        f = pairs_path(ctx, a.task)
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(json.dumps(rec, indent=2) + "\n")
        print(f"submitted {len(pairs)} pair(s) for {a.task} — "
              + (f"{dn} reviews it before it applies (harness pairs {a.task})"
                 if rec.get("auto") else f"{dn} applies them: harness pairs apply {a.task}"))
        if rec.get("auto"):
            # An idle rank 0 hears nothing until its next turn ends, and a chain
            # waits on its decision: the documenter tells it now.
            print(f"  tell it: SendMessage to '{root_session_name(ctx, dn)}' — \"documenter "
                  f"batch {a.task} awaits your review: {batch_summary(rec)}. "
                  f"harness pairs {a.task}, then harness pairs apply {a.task} or "
                  f"--decline 'why'.\"")
        return
    task = a.target if a.verb == "apply" else a.verb
    f = pairs_path(ctx, task or "")
    if not task or not f.exists():
        die(REFUSED, f"no pairs submitted for '{task}'")
    rec = json.loads(f.read_text())
    if a.verb != "apply":
        sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
        reviewer = (node if sid and spec.get("kind") == "doc" else
                    "operator" if not sid and os.environ.get("HARNESS_DOCUMENTER") != "1" else None)
        if a.__dict__.get("decline") is not None:
            if not reviewer:
                die(REFUSED, "declining a batch is rank 0's, or the operator's from a shell")
            if not a.decline.strip():
                die(REFUSED, 'say why: harness pairs <task> --decline "..."')
            if rec.get("applied"):
                die(REFUSED, f"already applied in {rec['applied'][:8]}; revert it instead")
            rec.update(refused=f"declined by {reviewer}: {a.decline.strip()}",
                       refused_at=time.strftime("%Y-%m-%dT%H:%M:%S%z"), declined_by=reviewer)
            f.write_text(json.dumps(rec, indent=2) + "\n")
            print(f"declined {task}; the documenter run that sent it is told why")
            if rec.get("auto"):
                docs_decided(ctx, rec)
            return
        print(f"{task}: {len(rec['pairs'])} pair(s) from {rec['by']} at {rec['at']}"
              + (f", applied in {rec['applied'][:8]}" if rec.get("applied") else "")
              + (f", refused: {rec['refused']}" if rec.get("refused") else ""))
        if rec.get("auto"):
            print(f"  {batch_summary(rec)}")
        rows = pairs_review(ctx, rec, on_branch, full=a.__dict__.get("full"))
        print()
        print_pair_report(rows)
        if rec.get("auto") and reviewer and not rec.get("applied") and not rec.get("refused"):
            rec.update(reviewed_by=reviewer, reviewed_at=time.strftime("%Y-%m-%dT%H:%M:%S%z"))
            f.write_text(json.dumps(rec, indent=2) + "\n")
            print(f"\nreviewed. Apply it: harness pairs apply {task}   "
                  f"or decline: harness pairs {task} --decline \"why\"")
        return
    pairs_apply(ctx, node, spec, task, rec, f, auto=a.__dict__.get("auto"))


def root_session_name(ctx, dn):
    """The document node's session name: the live one in its worktree, else the
    name spawn gives it (<project>-<node>)."""
    try:
        wt = (load_index(ctx)["nodes"].get(dn) or {}).get("worktree")
        hit = next((r.get("name") for r in live_rows(agents_json()) if r.get("cwd") == wt), None)
        if hit:
            return hit
    except Exception:
        pass
    return f"{ctx.tree.get('project', ctx.repo.name)}-{dn}"


def batch_summary(rec):
    """One line saying what a batch does: `move "History" CLAUDE.md → x.md (+2 more)`."""
    out = []
    for x in rec.get("pairs") or []:
        op = x.get("op", "replace")
        if op == "move":
            head = next((l.lstrip("#").strip() for l in (x.get("old") or "").splitlines()
                         if l.startswith("#")), None)
            out.append(f"move {('“' + head[:40] + '” ') if head else ''}"
                       f"{x['file']} → {x['to']} ({words(x.get('old')):,} words)")
        elif op == "delete":
            out.append(f"delete {x['file']}")
        elif op == "create":
            out.append(f"create {x['file']}")
        else:
            out.append(f"rewrite {x['file']}")
    return (out[0] + (f" (+{len(out) - 1} more)" if len(out) > 1 else "")) if out else "empty"


def pairs_apply(ctx, node, spec, task, rec, f, auto=False):
    """Rank 0 applies a stored batch: all pairs or none, one commit. A documenter
    batch (`auto` on the record) is applied only after rank 0 has reviewed it
    (owner, 2026-10-05: rank 0 reads every one); its outcome is written to the
    record either way, for the next documenter run to read."""
    if os.environ.get("HARNESS_DOCUMENTER") == "1":
        die(REFUSED, "the documenter submits; rank 0 reviews and applies its batches")
    doc = bool(rec.get("auto"))
    def refuse(why):
        if doc and spec.get("kind") == "doc":
            rec.update(refused=why, refused_at=time.strftime("%Y-%m-%dT%H:%M:%S%z"))
            f.write_text(json.dumps(rec, indent=2) + "\n")
            docs_decided(ctx, rec)
        die(REFUSED, why)
    if spec.get("kind") != "doc":
        die(REFUSED, "only the document node applies pairs (T5)")
    if rec.get("applied"):
        die(REFUSED, f"already applied in {rec['applied'][:8]}")
    if doc and not rec.get("reviewed_at"):
        die(REFUSED, f"read it first: harness pairs {task} (rank 0 reviews every "
                     f"documenter batch)")
    def read(path):
        p = ctx.worktree / path
        return p.read_text() if p.is_file() else None
    rows, texts = pair_report(rec["pairs"], read, pair_guard(ctx))
    files = sorted(texts)
    rc, dirt, _ = git("status", "--porcelain", "--", *files, cwd=ctx.worktree)
    if dirt.strip():
        die(REFUSED, f"uncommitted changes in {', '.join(files)} — commit or stash first")
    if not print_pair_report(rows):
        refuse(f"not applied: a pair no longer matches exactly once. Return the "
               f"batch to {rec['by']} — harness note {task} --add \"...\"")
    over = budget_verdict(ctx, read, texts)
    if over:
        refuse(over)
    was = {p: read(p) for p in files}
    def restore():
        git("reset", "-q", "--", *files, cwd=ctx.worktree)
        for path, t in was.items():
            if t is None:
                (ctx.worktree / path).unlink(missing_ok=True)
            else:
                git("checkout", "HEAD", "--", path, cwd=ctx.worktree)
    for path, t in texts.items():
        p = ctx.worktree / path
        if t is None:
            git("rm", "-q", "--", path, cwd=ctx.worktree)
        else:
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(t)
    # A move is safe because it is verbatim; check it on disk, not by construction
    # (obs 77: rank 0 verified line identity by hand on every batch).
    for _, x, _, _, _ in rows:
        if x.get("op") == "move":
            dest, src = read(x["to"]) or "", read(x["file"]) or ""
            if x["old"] not in dest or x["pointer"] not in src:
                restore()
                refuse(f"the move to {x['to']} did not land verbatim; files restored, "
                       f"nothing applied")
    for _, x, _, _, _ in rows:       # context around each change (obs 47)
        new = x.get("pointer") if x.get("op") == "move" else x.get("new")
        t = texts.get(x["file"])
        at = t.find(new) if (t and new) else -1
        if at >= 0:
            before = t[:at].splitlines()[-2:]
            after = t[at + len(new):].splitlines()[1:3]
            print(f"  ── {x['file']}")
            for l in before + ["» " + l for l in new.splitlines()] + after:
                print(f"     {l[:110]}")
    kept = [p for p, t in texts.items() if t is not None]   # deletions are staged by git rm
    if kept:
        git("add", "--", *kept, cwd=ctx.worktree)
    cm = "CLAUDE.md"
    words_line = (f"CLAUDE.md {words(was[cm]):,} → {words(texts[cm]):,}" if cm in texts else "")
    # The subject says what moved (obs 77): `git log --oneline` read as noise.
    subject = (f"Documenter ({rec.get('job') or 'auto'}): {batch_summary(rec)}"
               + (f"; {words_line}" if words_line else "")) if doc else \
              f"Apply {len(rows)} document pair(s) from {task} ({rec['by']})"
    msg = (subject[:200] + "\n\n"
           + "".join(f"- {x['file']} {x.get('op', 'replace')}: "
                     f"{x.get('why') or '(no reason given)'}\n" for _, x, _, _, _ in rows)
           + (f"\nCLAUDE.md: {words(was[cm]):,} -> {words(texts[cm]):,} words\n"
              if cm in texts else "")
           + f"\nTask: {task}\n"
           + (f"Documenter: {rec.get('job') or 'auto'}\n"
              f"Reviewed-by: {rec.get('reviewed_by') or 'rank 0'}\n"
              f"Co-Authored-By: Claude (harness documenter"
              + (f", {rec['model']}" if rec.get("model") else "")
              + ") <noreply@anthropic.com>\n" if doc else ""))
    rc, out, err = git("commit", "-q", "-m", msg, cwd=ctx.worktree)
    if rc:
        restore()
        refuse(f"the commit was refused and the files restored; nothing applied:\n"
               f"{err or out}")
    sha = git("rev-parse", "HEAD", cwd=ctx.worktree)[1].strip()
    rec.update(applied=sha, applied_at=time.strftime("%Y-%m-%dT%H:%M:%S%z"))
    if cm in texts:
        rec["claude_md"] = [words(was[cm]), words(texts[cm])]
    f.write_text(json.dumps(rec, indent=2) + "\n")
    print(f"applied {len(rows)} pair(s) from {task} in {sha[:8]}")
    if doc:
        docs_decided(ctx, rec)


def pairs_review(ctx, rec, read, full=False):
    """What a batch would do, for the reviewer: a diff per changed file, capped
    unless --full, and CLAUDE.md's words before and after."""
    rows, texts = pair_report(rec["pairs"], read)
    cap = None if full else 200
    for path in sorted(texts):
        old, new = read(path) or "", texts[path] or ""
        d = list(difflib.unified_diff(old.splitlines(), new.splitlines(),
                                      f"a/{path}", f"b/{path}" if texts[path] is not None
                                      else "/dev/null", lineterm="", n=2))
        print(f"\n── {path}" + ("  (deleted)" if texts[path] is None else
                                  "  (new)" if read(path) is None else ""))
        for l in (d if cap is None else d[:cap]):
            print(l[:200])
        if cap is not None and len(d) > cap:
            print(f"   … {len(d) - cap} more diff lines — harness pairs {rec['task']} --full")
    if "CLAUDE.md" in texts:
        print(f"\nCLAUDE.md {words(read('CLAUDE.md')):,} → {words(texts['CLAUDE.md']):,} words")
    return rows


# ── cleanup: sweep a completed unit, on rank 0's recorded decision ───────────
#
# Nothing a session leaves behind was ever removed: transcripts, job tmp/ dirs
# holding scratch databases, and the harness's own per-task files. Deleting on
# "session closed" would destroy evidence mid-flight, so a sweep happens only
# when a UNIT is complete (a closed split segment, or the owner's focus with
# every task done), only for lane sessions whose every mark is in that unit, and
# only when rank 0 says so, in a ledger. Anything a remaining record cites stays.

def archive_dir(ctx):
    return ctx.state / "archive"


def archive_index(ctx):
    try:
        return json.loads((archive_dir(ctx) / "index.json").read_text())
    except Exception:
        return {}


def archived_unit(ctx, task):
    return archive_index(ctx).get(tkey(task or ""))


def ledger(ctx):
    out = []
    try:
        for line in (archive_dir(ctx) / "ledger.jsonl").read_text().splitlines():
            out.append(json.loads(line))
    except Exception:
        pass
    return out


def segment_tasks(ctx, task):
    """A segment and every part split from it, at any depth."""
    briefs = all_briefs(ctx)
    out, todo = {tkey(task)}, [tkey(task)]
    while todo:
        k = todo.pop()
        for c, b in briefs.items():
            if c not in out and tkey(b.get("from") or "") == k:
                out.add(c); todo.append(c)
    return out


def completed_units(ctx):
    """Complete, unswept units: [{name, kind, tasks}], outermost only."""
    done = {r.get("unit") for r in ledger(ctx)}
    units = []
    for n in ctx.tree["nodes"]:
        for x in delegated(ctx, n):
            if x["ready"] and x["closed_at"]:
                units.append({"name": x["task"], "kind": "segment",
                              "tasks": segment_tasks(ctx, x["task"])})
    fam = focus_family(ctx)
    if fam:
        states = [task_state(ctx, t) for t in fam]
        live = [s for s in states if s not in ("closed", "superseded", "no brief")]
        if states and not live:
            units.append({"name": "focus " + ",".join(focus_tasks(ctx)), "kind": "focus",
                          "tasks": set(fam)})
    idx = archive_index(ctx)
    units = [u for u in units if u["name"] not in done
             and not all(t in idx for t in u["tasks"])]
    # Nested segments are swept with their outermost unit.
    return [u for u in units
            if not any(u is not v and u["tasks"] < v["tasks"] for v in units)]


def _size(path):
    p = Path(path)
    if p.is_file():
        return p.stat().st_size
    return sum(f.stat().st_size for f in p.rglob("*") if f.is_file()) if p.is_dir() else 0


def _live_sids():
    return {d.get("sessionId") for d in live_sessions()}


_SID8 = re.compile(r"session ([0-9a-f]{8})")
_FULLSID = re.compile(r'"_session": "([0-9a-f]{8})[0-9a-f-]{28}"')
_PATHCH = r"[^\s\"'\\;|&)<>`,]"
_LITJOB = re.compile(r"\.claude/jobs/([0-9a-f]{8})(/tmp(?:/" + _PATHCH + r"*)?)?")
_ENVJOB = re.compile(r"\$\{?CLAUDE_JOB_DIR\}?(/tmp(?:/" + _PATHCH + r"*)?)?")


def job_dirs():
    """Session id, and its 8-char prefix, to its background job's folder."""
    out = {}
    for st in (JOBS.glob("*/state.json") if JOBS.is_dir() else []):
        try:
            d = json.loads(st.read_text())
        except Exception:
            continue
        for sid in {d.get("sessionId"), d.get("resumeSessionId")} - {None, ""}:
            out[sid] = out[sid[:8]] = st.parent
    return out


def record_texts(ctx):
    """Every record that can cite a file, as (who, text, author sessions). Fact
    observations are separate, because each has its own author."""
    out = []
    def add(who, obj):
        t = obj if isinstance(obj, str) else json.dumps(obj)
        out.append((who, t, set(_SID8.findall(t)) | set(_FULLSID.findall(t))))
    for kind in ("findings", "briefs", "marks", "pairs"):
        d = ctx.state / kind
        for f in (d.glob("*.json") if d.is_dir() else []):
            add(f"{kind}/{f.stem}", f.read_text(errors="replace"))
    d = ctx.state / "facts"
    for f in (d.glob("*.json") if d.is_dir() else []):
        try:
            r = json.loads(f.read_text())
        except Exception:
            continue
        for o in r.get("observations") or []:
            add(f"facts/{f.stem}", o)
    if baseline_path(ctx).exists():
        add("checks/baseline", baseline_path(ctx).read_text())
    ad = archive_dir(ctx)
    for rf in (ad.glob("*/records.json") if ad.is_dir() else []):
        try:
            for t, v in json.loads(rf.read_text()).get("tasks", {}).items():
                add(f"archive/{rf.parent.name}/{t}", v)
        except Exception:
            pass
    kf = ad / "knowledge.json"
    if kf.exists():
        try:
            k = json.loads(kf.read_text())
            for n, r in (k.get("facts") or {}).items():
                for o in r.get("observations") or []:
                    add(f"archive/facts/{n}", o)
            for n, r in (k.get("findings") or {}).items():
                add(f"archive/findings/{n}", r)
        except Exception:
            pass
    return out


def _tmp_files(jd, cache={}):
    if jd not in cache:
        t = Path(jd) / "tmp"
        cache[jd] = ([str(f.relative_to(t)) for f in t.rglob("*") if f.is_file()]
                     if t.is_dir() else [])
    return cache[jd]


def job_refs(ctx, texts=None, jobs=None):
    """What records cite inside job tmp/ folders: {job dir: {"all": who|None,
    "files": {rel: who}}}. Only PATHS protect: a literal jobs path, a
    $CLAUDE_JOB_DIR path resolved through the record's author session, or a
    file in the author's own tmp/ named in the record. A bare session id is
    authorship, not a citation, and keeps nothing."""
    jobs = job_dirs() if jobs is None else jobs
    refs = {}
    def cite(jd, rel, who):
        r = refs.setdefault(Path(jd), {"all": None, "files": {}})
        rel = (rel or "").removeprefix("/tmp").strip("/")
        if not rel:
            r["all"] = r["all"] or who
        else:
            r["files"].setdefault(rel, who)
    for who, text, authors in (record_texts(ctx) if texts is None else texts):
        for m in _LITJOB.finditer(text):
            jd = jobs.get(m.group(1)) or (JOBS / m.group(1))
            cite(jd, m.group(2), who)
        own = [jobs[a] for a in authors if a in jobs]
        for m in _ENVJOB.finditer(text):
            for jd in own:
                cite(jd, m.group(1), who)
        for jd in own:
            for rel in _tmp_files(jd):
                base = rel.rsplit("/", 1)[-1]
                if len(base) >= 5 and base in text:
                    cite(jd, rel, who)
    return refs


def _kept(rel, keep):
    return any(rel == k or rel.startswith(k + "/") for k in keep)


def sweep_plan(ctx, unit):
    """Everything a sweep of `unit` would touch, and what it keeps and why."""
    tasks = {tkey(t) for t in unit["tasks"]}
    marks = {}
    md = ctx.state / "marks"
    for f in (md.glob("*.json") if md.is_dir() else []):
        try:
            marks[f.stem] = json.loads(f.read_text())
        except Exception:
            pass
    live = _live_sids()
    sids = {}
    for k, r in marks.items():
        sid = r.get("_session")
        if sid:
            sids.setdefault(sid, []).append((k, r.get("_node")))
    plan = {"unit": unit["name"], "transcripts": [], "tmp": [], "tmp_keep": {},
            "records": [], "blocks": [], "caches": [], "kept": [], "skipped": [],
            "sessions": []}
    jobs = job_dirs()
    refs = job_refs(ctx, jobs=jobs)
    for sid, owned in sorted(sids.items()):
        if not any(k in tasks for k, _ in owned):
            continue
        why = ("live" if sid in live else
               "also worked outside the unit" if any(k not in tasks for k, _ in owned) else
               "a lead or rank 0" if any(n and role_of(ctx, n) != "member"
                                         for _, n in owned if n in ctx.tree["nodes"]) else None)
        if why:
            plan["skipped"].append((sid[:8], why)); continue
        t = transcript_for(sid)
        if t:
            plan["transcripts"].append((str(t), _size(t)))
        jd = jobs.get(sid)
        r = refs.get(jd) or {"all": None, "files": {}}
        # Off Claude Code's session list too, unless its job folder holds a
        # cited file: `claude rm` deletes the folder (the transcript stays).
        if jd and not (r["all"] or r["files"]):
            plan["sessions"].append(sid)
        tmp = jd / "tmp" if jd else None
        if not (tmp and tmp.is_dir()) or str(tmp) in plan["tmp_keep"]:
            continue
        if r["all"]:
            plan["kept"].append((str(tmp), f"cited by {r['all']}")); continue
        keep = sorted(r["files"])
        gone = sum((tmp / rel).stat().st_size for rel in _tmp_files(jd)
                   if not _kept(rel, keep))
        plan["tmp"].append((str(tmp), gone))
        plan["tmp_keep"][str(tmp)] = keep
        for rel in keep:
            plan["kept"].append((str(tmp / rel), f"cited by {r['files'][rel]}"))
    for kind in ("briefs", "marks", "pairs"):
        for t in sorted(tasks):
            f = ctx.state_file(kind, t, ".json")
            if f.exists():
                plan["records"].append((str(f), f.stat().st_size))
    bd = ctx.state / "blocks"
    for f in (bd.glob("*.json") if bd.is_dir() else []):
        try:
            ts = (json.loads(f.read_text()).get("consequence") or {}).get("tasks") or []
        except Exception:
            continue
        if ts and all(tkey(x) in tasks for x in ts):
            plan["blocks"].append((str(f), f.stat().st_size))
    plan["caches"] = stale_caches(ctx, live)
    return plan


def stale_caches(ctx, live):
    """Pure caches nobody will read again: seen files of dead sessions, and
    check reports and reviews at shas that matter to nothing still open."""
    out = []
    sd = ctx.state / "seen"
    for f in (sd.glob("*") if sd.is_dir() else []):
        if f.stem not in live:
            out.append((str(f), f.stat().st_size))
    keep = set()
    b = load_baseline(ctx)
    if b and b.get("sha"):
        keep.add(b["sha"])
    for r in open_marks(ctx).values():
        if r.get("_presented_sha"):
            keep.add(r["_presented_sha"])
    for kind in ("checks", "reviews"):
        d = ctx.state / kind
        files = [f for f in (d.glob("*.json") if d.is_dir() else []) if f.name != "baseline.json"]
        latest = {}
        for f in files:
            node = f.stem.rsplit("_", 1)[0] if "_" in f.stem else f.stem
            if node not in latest or f.stat().st_mtime > latest[node].stat().st_mtime:
                latest[node] = f
        for f in files:
            if f in latest.values() or any(k and k in f.stem for k in keep):
                continue
            out.append((str(f), f.stat().st_size))
    return out


def stale_records(ctx, days=14):
    """Facts and findings nobody needs on the board (no open record cites them),
    as ({fact: reason}, {finding: reason}). Open findings are never stale."""
    declined = {n for e in ledger(ctx) if e.get("kept") and e.get("kind") == "stale"
                for n in e.get("names") or []}
    open_briefs = [b for b in all_briefs(ctx).values()
                   if task_state(ctx, b.get("task")) not in ("closed", "superseded")]
    open_f = open_findings(ctx)
    open_marks_ = list(open_marks(ctx).values())
    text = json.dumps(open_briefs) + json.dumps(list(open_f.values())) + json.dumps(open_marks_)
    cited = {tkey(n) for b in open_briefs for n in (b.get("facts") or [])} | \
            {tkey(r["fact"]) for r in open_f.values() if r.get("fact")}
    facts, finds = {}, {}
    now = time.time()
    for k, r in all_facts(ctx).items():
        name = r.get("name") or k
        last = _epoch(((r.get("observations") or [{}])[-1]).get("at"))
        if k in declined or tkey(name) in cited or name in text:
            continue
        if last and now - last > days * 86400:
            facts[k] = f"uncited, last observed {human_age(now - last)} ago"
    for k, r in all_findings(ctx).items():
        if k in declined or k in open_f:
            continue
        why = ("dropped" if r.get("dropped_at") else "ruled" if r.get("ruled_at") else
               f"became {r['became']}, closed" if r.get("became") and
               task_state(ctx, r["became"]) == "closed" else None)
        if why:
            finds[k] = why
    return facts, finds


def fold_stale(ctx, facts, finds, why, by):
    """Fold stale facts and findings into archive/knowledge.json; one ledger line."""
    ad = archive_dir(ctx)
    ad.mkdir(parents=True, exist_ok=True)
    kf = ad / "knowledge.json"
    k = json.loads(kf.read_text()) if kf.exists() else {"facts": {}, "findings": {}}
    for kind, names in (("facts", facts), ("findings", finds)):
        for n in names:
            f = ctx.state_file(kind, n, ".json")
            try:
                k[kind][n] = json.loads(f.read_text())
            except Exception:
                continue
    kf.write_text(json.dumps(k, indent=1) + "\n")
    for kind, names in (("facts", facts), ("findings", finds)):
        for n in names:
            if n in k[kind]:
                ctx.state_file(kind, n, ".json").unlink(missing_ok=True)
    with open(ad / "ledger.jsonl", "a") as fh:
        fh.write(json.dumps({"unit": f"stale {time.strftime('%Y-%m-%dT%H:%M')}", "kind": "stale",
                             "at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "by": by, "why": why,
                             "freed": 0, "counts": {"facts": len(facts), "findings": len(finds)}})
                 + "\n")


def archived_knowledge(ctx, kind, name):
    try:
        k = json.loads((archive_dir(ctx) / "knowledge.json").read_text())
    except Exception:
        return None
    return (k.get(kind) or {}).get(tkey(name)) or (k.get(kind) or {}).get(name)


def gone_job_files(o, jobs=None):
    """Job files an observation's command reads that no longer exist."""
    jobs = job_dirs() if jobs is None else jobs
    t = json.dumps(o)
    out = []
    for m in _LITJOB.finditer(t):
        p = (jobs.get(m.group(1)) or JOBS / m.group(1))
        p = p / (m.group(2) or "").lstrip("/") if m.group(2) else p
        if not Path(p).exists():
            out.append(m.group(0))
    for a in set(_SID8.findall(t)):
        jd = jobs.get(a)
        for m in _ENVJOB.finditer(t):
            if not (jd and (jd / (m.group(1) or "/tmp").lstrip("/")).exists()):
                out.append(f"{m.group(0)} (session {a})")
    return out


def print_sweep_plan(plan):
    mb = lambda rows: sum(r[1] for r in rows if isinstance(r[1], int)) / 1e6
    print(f"sweep {plan['unit']}")
    print(f"  transcripts  {len(plan['transcripts']):>4}  {mb(plan['transcripts']):8.1f} MB  → gzip into the archive")
    print(f"  job tmp/     {len(plan['tmp']):>4}  {mb(plan['tmp']):8.1f} MB  → delete")
    print(f"  records      {len(plan['records']) + len(plan['blocks']):>4}  "
          f"{mb(plan['records'] + plan['blocks']):8.1f} MB  → fold into archive records.json")
    print(f"  caches       {len(plan['caches']):>4}  {mb(plan['caches']):8.1f} MB  → delete")
    print(f"  sessions     {len(plan.get('sessions', [])):>4}               → claude rm "
          f"(off the session list)")
    for path, why in plan["kept"]:
        print(f"  keep   {path}  — {why}")
    for sid, why in plan["skipped"]:
        print(f"  skip   session {sid}  — {why}")
    return mb(plan["transcripts"]) + mb(plan["tmp"]) + mb(plan["records"]) + mb(plan["caches"])


def run_sweep(ctx, unit, plan, why, by):
    """Carry out a plan: archive, delete, fold, and write the ledger line."""
    ud = archive_dir(ctx) / tkey(unit["name"])
    (ud / "transcripts").mkdir(parents=True, exist_ok=True)
    freed = 0
    for path, size in plan["transcripts"]:
        src = Path(path)
        dst = ud / "transcripts" / (src.name + ".gz")
        data = src.read_bytes()
        with gzip.open(dst, "wb") as fh:
            fh.write(data)
        if gzip.decompress(dst.read_bytes()) == data:
            src.unlink(); freed += size - dst.stat().st_size
    for path, size in plan["tmp"]:
        keep = plan.get("tmp_keep", {}).get(path) or []
        if not keep:
            shutil.rmtree(path, ignore_errors=True)
        else:
            t = Path(path)
            for f in sorted(t.rglob("*"), key=lambda x: -len(x.parts)):
                rel = str(f.relative_to(t))
                if f.is_file() and not _kept(rel, keep):
                    f.unlink()
                elif f.is_dir() and not any(f.iterdir()):
                    f.rmdir()
        freed += size
    rf = ud / "records.json"
    recs = json.loads(rf.read_text()) if rf.exists() else {"tasks": {}, "blocks": {}}
    for path, size in plan["records"]:
        f = Path(path)
        kind = f.parent.name
        try:
            body = json.loads(f.read_text())
        except Exception:
            continue
        if kind == "briefs":
            body.pop("history", None)
        recs["tasks"].setdefault(f.stem, {})[kind[:-1]] = body
    for path, size in plan["blocks"]:
        f = Path(path)
        recs["blocks"][f.stem] = json.loads(f.read_text())
    rf.write_text(json.dumps(recs, indent=1) + "\n")
    idx = archive_index(ctx)
    for t in unit["tasks"]:
        idx[tkey(t)] = unit["name"]
    (archive_dir(ctx) / "index.json").write_text(json.dumps(idx, indent=1) + "\n")
    for path, size in plan["records"] + plan["blocks"] + plan["caches"]:
        Path(path).unlink(missing_ok=True); freed += size
    gone = [sid[:8] for sid in plan.get("sessions", []) if claude_rm(sid)[0]]
    entry = {"sessions_removed": gone, "unit": unit["name"], "kind": unit["kind"], "at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
             "by": by, "why": why, "freed": freed,
             "counts": {k: len(plan[k]) for k in ("transcripts", "tmp", "records", "blocks", "caches", "kept")}}
    with open(archive_dir(ctx) / "ledger.jsonl", "a") as fh:
        fh.write(json.dumps(entry) + "\n")
    return entry


def _expand(path):
    return os.path.normpath(os.path.expandvars(os.path.expanduser(str(path))))


def live_holds(ctx):
    """Holds on shared resources still in force (obs 66). One with --until lifts
    itself when that task is signed off, read here, so nothing has to clean up."""
    d = ctx.state / "holds"
    out = []
    for f in (sorted(d.glob("*.json")) if d.is_dir() else []):
        try:
            h = json.loads(f.read_text())
        except Exception:
            continue
        if h.get("until") and task_state(ctx, h["until"]) in ("closed", "superseded"):
            continue
        out.append(h)
    return out


def hold_catching(check, holds):
    """The hold that stops this check, or None. A check that declares `reads` is
    matched on those paths; one that does not, on its command text."""
    reads = [_expand(r) for r in check.get("reads") or []]
    cmd = os.path.expandvars(os.path.expanduser(check.get("command") or ""))
    cmd = cmd.replace("$HOME", os.path.expanduser("~")).replace("${HOME}", os.path.expanduser("~"))
    for h in holds:
        p = _expand(h.get("path"))
        if reads:
            if any(r.startswith(p) or p.startswith(r) for r in reads):
                return h
        elif p in cmd:
            return h
    return None


def cmd_hold(a):
    """`hold <path> --why`: no check reads this while a shared job holds it (obs 66).

    The rule was prose in one lane's briefs, and the habit — `harness check`
    before presenting — is in the skill, so the habit won and a full sweep ran
    against a database a live job was writing. `check` reads holds, so the rule
    reaches every lane without anyone having to tell it."""
    ctx = Ctx(); ctx.require_enrolled()
    if a.list or not a.path:
        hs = live_holds(ctx)
        if not hs:
            print("no holds")
        for h in hs:
            print(f"  {h['path']}  — {h['why']}  (by {h['by']}"
                  + (f", until {h['until']}" if h.get("until") else "") + ")")
        return
    me, _ = ctx.node()
    if os.environ.get("CLAUDE_CODE_SESSION_ID") and ctx.rank(me) != 0 and not ctx.children(me):
        die(REFUSED, "a hold is a lead's or rank 0's: it stops checks across the tree")
    f = ctx.state_file("holds", slug(_expand(a.path)), ".json")
    if a.release:
        if not f.exists():
            die(REFUSED, f"no hold on {a.path}")
        f.unlink()
        print(f"released {a.path}")
        return
    if not (a.why or "").strip():
        die(REFUSED, 'say why: harness hold <path> --why "..."')
    if a.until and load_brief(ctx, a.until)[1] is None and \
            not ctx.state_file("marks", a.until, ".json").exists():
        die(REFUSED, f"--until {a.until}: no brief or task by that name")
    f.parent.mkdir(parents=True, exist_ok=True)
    f.write_text(json.dumps({"path": a.path, "why": a.why, "by": me, "until": a.until or "",
                             "at": time.strftime("%Y-%m-%dT%H:%M:%S%z")}, indent=2) + "\n")
    caught = [c["name"] for c in (json.loads((ctx.repo / ".harness" / "manifest.json")
                                             .read_text()).get("checks") or [])
              if hold_catching(c, [{"path": a.path}])] \
        if (ctx.repo / ".harness" / "manifest.json").exists() else []
    print(f"held {a.path}" + (f" until {a.until} closes" if a.until else "")
          + f". `check` skips {len(caught)} arm(s)"
          + (f": {', '.join(caught)}" if caught else
             " — none names it; declare \"reads\" in the manifest"))


def claude_rm(sid):
    """Take an ended session off Claude Code's list: `claude rm`. It deletes the
    job folder (and its tmp/) and keeps the transcript, so `claude --resume`
    still opens it. A worktree made with `git worktree add` (every node's) is
    never its to delete. Measured 2026-10-05 on a locked node worktree: list
    entry and job folder gone; worktree, HEAD and status untouched."""
    r = subprocess.run(["claude", "rm", sid[:8]], capture_output=True, text=True)
    return r.returncode == 0, (r.stderr or r.stdout).strip()[:120]


def all_sessions():
    """`claude agents --json --all`: ended sessions too, which plain --json drops."""
    r = subprocess.run(["claude", "agents", "--json", "--all"], capture_output=True,
                       text=True, timeout=20)
    if r.returncode:
        die(REFUSED, f"`claude agents --json --all` failed: {r.stderr.strip()[:120]}")
    return json.loads(r.stdout)


def ended_sessions(ctx, rows):
    """This project's ended sessions still on Claude Code's list, as (row, why
    kept or None). Every recycle and stop leaves one. Ours: named for the
    project, as `spawn` names them, and started in a node's worktree or in one
    that is gone (a trimmed node); anything else is the owner's. Kept: a record
    cites a file in its job folder."""
    live = {r.get("sessionId") for r in live_rows(rows)}
    wts = set(load_index(ctx).get("byWorktree") or {}) | {str(ctx.repo)}
    prefix = ctx.repo.name + "-"
    me = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    jobs = job_dirs()
    refs = job_refs(ctx, jobs=jobs)
    out = []
    for r in rows:
        sid, cwd = r.get("sessionId") or "", r.get("cwd") or ""
        if not sid or sid in live or sid == me:
            continue
        if not ((r.get("name") or "").startswith(prefix)
                and (cwd in wts or not Path(cwd).exists())):
            continue
        ref = refs.get(jobs.get(sid)) if jobs.get(sid) else None
        out.append((r, (ref["all"] or next(iter(ref["files"].values()), None))
                       if ref else None))
    return out


def ended_count(ctx):
    """What `sweep --sessions` would remove, counted off the job folders for
    orientation: no subprocess, same rules, so the nag clears when it is run.
    Whether a record cites a job folder costs a scan of every tmp/ file (0.7s
    on a live tree), so that part is cached until a job folder or record changes."""
    wts = set(load_index(ctx).get("byWorktree") or {}) | {str(ctx.repo)}
    prefix = ctx.repo.name + "-"
    cands = []
    for st in (JOBS.glob("*/state.json") if JOBS.is_dir() else []):
        try:
            d = json.loads(st.read_text())
        except Exception:
            continue
        cwd = d.get("cwd") or ""
        if (d.get("state") in ("done", "stopped", "failed")
                and (d.get("name") or "").startswith(prefix)
                and (cwd in wts or not Path(cwd).exists())):
            cands.append(st.parent)
    if len(cands) < ENDED_NAG:
        return len(cands)
    newest = max((f.stat().st_mtime for k in ("findings", "briefs", "marks", "pairs", "facts")
                  for f in (ctx.state / k).glob("*.json")), default=0)
    for f in (archive_dir(ctx).glob("**/*.json") if archive_dir(ctx).is_dir() else []):
        newest = max(newest, f.stat().st_mtime)
    key = f"{sorted(c.name for c in cands)}|{newest}"
    cf = ctx.state / "ended_count.json"
    try:
        c = json.loads(cf.read_text())
        if c.get("key") == key:
            return c["n"]
    except Exception:
        pass
    refs = job_refs(ctx)
    n = sum(1 for c in cands if c not in refs)
    try:
        cf.write_text(json.dumps({"key": key, "n": n}))
    except OSError:
        pass
    return n


def sweep_sessions(ctx, a):
    """`sweep --sessions`: this project's ended sessions off Claude Code's list."""
    found = ended_sessions(ctx, all_sessions())
    go = [r for r, why in found if not why]
    kept = [(r, why) for r, why in found if why]
    for r, why in (kept if a.dry_run else []):
        print(f"  keep   {r.get('name') or '?'} [{r['sessionId'][:8]}]  — its job "
              f"folder is cited by {why}")
    if kept and not a.dry_run:
        print(f"  keep   {len(kept)}: a record cites a file in their job folder "
              f"(--dry-run names them)")
    names = {}
    for r in go:
        names[r.get("name") or "?"] = names.get(r.get("name") or "?", 0) + 1
    for n, c in sorted(names.items(), key=lambda x: -x[1]):
        print(f"  {c:>4}  {n}")
    print(f"  {len(go)} ended session(s) → claude rm. Their transcripts stay; "
          f"`claude --resume` still opens one.")
    if a.dry_run or not (a.why or "").strip():
        if not a.dry_run and go:
            print('\n  Nothing done. Decide: harness sweep --sessions --why "..."')
        return
    by = sweep_decider(ctx)
    gone, failed = [], []
    for r in go:
        ok, msg = claude_rm(r["sessionId"])
        (gone if ok else failed).append(r["sessionId"][:8])
        if not ok:
            print(f"  FAILED {r.get('name') or '?'} [{r['sessionId'][:8]}]: {msg}")
    archive_dir(ctx).mkdir(parents=True, exist_ok=True)
    with open(archive_dir(ctx) / "ledger.jsonl", "a") as fh:
        fh.write(json.dumps({"unit": "sessions", "kind": "sessions", "removed": gone,
                             "failed": failed, "by": by, "why": a.why,
                             "at": time.strftime("%Y-%m-%dT%H:%M:%S%z")}) + "\n")
    print(f"removed {len(gone)} session(s)" + (f", {len(failed)} failed" if failed else ""))


def open_record_texts(ctx):
    """(who, text) for every record that still needs what it names: open briefs
    and marks, open findings, facts, and holds. Closed and archived work doesn't."""
    out = []
    for k, b in all_briefs(ctx).items():
        if not superseded(b) and task_state(ctx, b.get("task") or k) not in ("closed", "superseded"):
            out.append((f"brief {b.get('task') or k}", json.dumps(b)))
    for k, r in open_marks(ctx).items():
        out.append((f"mark {k}", json.dumps(r)))
    for k, r in open_findings(ctx).items():
        out.append((f"finding {k}", json.dumps(r)))
    for k, r in all_facts(ctx).items():
        out.append((f"fact {k}", json.dumps(r)))
    for h in live_holds(ctx):
        out.append((f"hold by {h.get('by')}", json.dumps(h)))
    return out


def path_forms(ctx, path):
    """The ways a record might write one path: absolute, ~/, $HOME/, and relative
    to the repository or any node's worktree. JSON escapes nothing in these."""
    ab = _expand(path)
    home = str(Path.home())
    forms = {ab}
    if ab.startswith(home + "/"):
        forms |= {"~" + ab[len(home):], "$HOME" + ab[len(home):]}
    roots = {str(ctx.repo)} | set((load_index(ctx).get("byWorktree") or {}))
    for r in roots:
        if ab.startswith(r.rstrip("/") + "/"):
            forms.add(ab[len(r.rstrip("/")) + 1:])
    return ab, forms


def cited(ctx, paths):
    """{path: [(who, how)]}: the open records that name each path (obs 74)."""
    texts = open_record_texts(ctx)
    out = {}
    for p in paths:
        ab, forms = path_forms(ctx, p)
        base = Path(ab).name
        hits = []
        for who, t in texts:
            if any(f in t for f in forms):
                hits.append((who, "names it"))
            elif len(base) >= 8 and base in t:
                hits.append((who, f"names {base}"))
        out[p] = hits
    return out


def cmd_cited(a):
    """`harness cited <path>...`: does an open record still need this? Run it on
    a deletion list before it goes to the owner (obs 74); `sweep` protects what
    records name only when the harness does the deleting."""
    ctx = Ctx(); ctx.require_enrolled()
    res = cited(ctx, a.paths)
    if a.deletable:
        for p, hits in res.items():
            if not hits:
                print(p)
        return
    for p, hits in res.items():
        if not hits:
            print(f"free    {p}")
            continue
        print(f"NEEDED  {p}")
        for who, how in hits:
            print(f"        {who} {how}")
    if any(res.values()):
        sys.exit(REFUSED)


def cmd_sweep(a):
    """`sweep` lists complete units; `sweep <unit> --dry-run` shows one; with
    `--why` rank 0 runs it, or `--keep --why` declines it. Both are ledgered."""
    ctx = Ctx(); ctx.require_enrolled()
    if a.stale:
        return sweep_stale(ctx, a)
    if a.sessions:
        return sweep_sessions(ctx, a)
    units = completed_units(ctx)
    if not units and (a.all or not a.unit):
        sf, sn = stale_records(ctx)
        print("nothing complete to sweep" + (
            f"; {len(sf) + len(sn)} stale record(s) — harness sweep --stale --dry-run"
            if sf or sn else ""))
        return
    if not a.unit and not a.all:
        for u in units:
            print(f"  {u['kind']:<8} {u['name']:<32} {len(u['tasks'])} task(s)"
                  f"  — harness sweep '{u['name']}' --dry-run")
        return
    if a.unit == "--all" or a.all:
        chosen = units
    else:
        chosen = [x for x in units if x["name"] == a.unit or tkey(x["name"]) == tkey(a.unit)]
    if not chosen:
        die(REFUSED, f"'{a.unit}' is not a complete, unswept unit — `harness sweep` lists them")
    if len(chosen) > 1:
        return sweep_many(ctx, chosen, a)
    u = chosen[0]
    plan = sweep_plan(ctx, u)
    if a.dry_run or not (a.why or a.keep):
        print_sweep_plan(plan)
        if not a.dry_run:
            print(f"\n  Nothing done. Decide: harness sweep '{u['name']}' --why \"...\"  "
                  f"or  --keep --why \"...\"")
        return
    by = sweep_decider(ctx)
    if not (a.why or "").strip():
        die(REFUSED, 'say why: harness sweep <unit> --why "..."')
    if a.keep:
        archive_dir(ctx).mkdir(parents=True, exist_ok=True)
        with open(archive_dir(ctx) / "ledger.jsonl", "a") as fh:
            fh.write(json.dumps({"unit": u["name"], "kind": u["kind"], "kept": True,
                                 "at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                                 "by": by, "why": a.why}) + "\n")
        print(f"kept {u['name']} — recorded; it will not be offered again"); return
    print_sweep_plan(plan)
    e = run_sweep(ctx, u, plan, a.why, by)
    print(f"swept {u['name']}: freed {e['freed'] / 1e6:.1f} MB — recorded in "
          f"{archive_dir(ctx) / 'ledger.jsonl'}")


def sweep_decider(ctx):
    """rank 0's node name, 'operator' from a shell, or a refusal."""
    node = next((n for n, sp in ctx.tree["nodes"].items() if sp.get("branch") == ctx.branch), None)
    if os.environ.get("CLAUDE_CODE_SESSION_ID", ""):
        if node is None or ctx.rank(node) != 0:
            die(REFUSED, "sweeping is rank 0's decision, or the operator's from a shell")
        return node
    return "operator"


def sweep_stale(ctx, a):
    """`sweep --stale`: facts and findings no open record needs, folded on a decision."""
    days = int(re.sub(r"\D", "", a.older_than or "14") or 14)
    facts, finds = stale_records(ctx, days)
    for kind, rows in (("fact", facts), ("finding", finds)):
        for n, why in sorted(rows.items()):
            print(f"  {kind:<8} {n:<48} {why}")
    print(f"  {len(facts)} fact(s), {len(finds)} finding(s) — folded into "
          f"archive/knowledge.json, still readable by name")
    if a.dry_run or not (a.why or "").strip():
        if not a.dry_run:
            print('\n  Nothing done. Decide: harness sweep --stale --why "..."  or  --keep --why')
        return
    by = sweep_decider(ctx)
    if a.keep:
        archive_dir(ctx).mkdir(parents=True, exist_ok=True)
        with open(archive_dir(ctx) / "ledger.jsonl", "a") as fh:
            fh.write(json.dumps({"unit": "stale", "kind": "stale", "kept": True,
                                 "names": sorted(facts) + sorted(finds), "by": by, "why": a.why,
                                 "at": time.strftime("%Y-%m-%dT%H:%M:%S%z")}) + "\n")
        print("kept — recorded; these will not be offered again"); return
    fold_stale(ctx, facts, finds, a.why, by)
    print(f"folded {len(facts)} fact(s) and {len(finds)} finding(s) into the archive")


def sweep_many(ctx, units, a):
    """`sweep --all`: one decision for a backlog, one ledger line per unit."""
    plans = [(u, sweep_plan(ctx, u)) for u in units]
    total = 0.0
    for u, p in plans:
        n = sum(len(p[k]) for k in ("transcripts", "tmp", "records", "blocks"))
        mb = sum(s for k in ("transcripts", "tmp", "records") for _, s in p[k]) / 1e6
        total += mb
        print(f"  {u['name']:<40} {n:>4} item(s) {mb:9.1f} MB  {len(p['kept'])} kept")
    print(f"  {len(plans)} unit(s), about {total:.0f} MB")
    if a.dry_run or not a.why:
        if not a.dry_run:
            print('\n  Nothing done. Decide: harness sweep --all --why "..."')
        return
    by = sweep_decider(ctx)
    for u, p in plans:
        run_sweep(ctx, u, p, a.why, by)
    print(f"swept {len(plans)} unit(s) — recorded in {archive_dir(ctx) / 'ledger.jsonl'}")


def cmd_archive(a):
    """Read what a sweep folded away."""
    ctx = Ctx(); ctx.require_enrolled()
    if not a.unit:
        for e in ledger(ctx):
            print(f"  {e['at'][:16]}  {e['unit']:<32} "
                  + ("KEPT" if e.get("kept") else f"freed {e.get('freed', 0) / 1e6:.0f} MB")
                  + f"  by {e['by']}: {e['why']}")
        return
    rf = archive_dir(ctx) / tkey(a.unit) / "records.json"
    if not rf.exists():
        u = archived_unit(ctx, a.unit)
        rf = archive_dir(ctx) / tkey(u or "") / "records.json"
        a.task, a.unit = a.unit, u
    if not rf.exists():
        die(REFUSED, f"nothing archived as '{a.unit}'")
    recs = json.loads(rf.read_text())
    if a.task:
        print(json.dumps(recs["tasks"].get(tkey(a.task)), indent=1)); return
    for k, v in sorted(recs["tasks"].items()):
        m = v.get("mark") or {}
        print(f"  {k:<32} {('closed ' + m['_closed_at'][:10]) if m.get('_closed_at') else ''}"
              f"  {((v.get('brief') or {}).get('text') or '').strip().splitlines()[0][:60] if (v.get('brief') or {}).get('text') else ''}")


# ── T17: the owner channel ───────────────────────────────────────────────────
#
# A question only the owner can answer goes through its project's intermediary,
# a live session outside the tree that briefs it in a fixed form. One per
# project, never one per machine: it reads that project only. The owner signs
# the ruling; it lands on the task's brief. Design: harness/design/owner-channel.md.

ASK_KINDS = ("intent", "judgement", "action", "risk", "note")   # note: the owner's own
ASK_OPEN = ("asked", "ready", "drafted")
INTERMEDIARY = "harness-intermediary"          # its skill; a session's name adds the project
# The seven sections, in order: heading, key, cap. A cap is chars unless noted.
# Raised 2026-10-05 after the first real briefing: at 120 chars an option was a
# label, and with no background the owner could not tell what it was about.
ASK_SECTIONS = (("question", "question", 300), ("background", "background", 2000),
                ("why yours", "why", 400), ("checked", "checked", 12),
                ("options", "options", 500), ("recommendation", "recommendation", 500),
                ("waiting", "waiting", 300))
ASK_ID_RE = re.compile(r"^[A-Za-z0-9_]+-\d+$")
# Commands rank 0 hands the owner to run: an `action` ask carrying them, on the
# standing task `owner` (no brief) or any task. The owner clicks Done, or asks.
OWNER_TASK = "owner"
ASK_RUNS_MAX, ASK_RUN_CAP = 10, 500
# Evidence the intermediary attaches for the owner to look at: a screenshot, a
# diff. Copied in, so the owner sees what was briefed even if the source moves.
EVIDENCE_IMAGE = (".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg")
EVIDENCE_TEXT = (".txt", ".diff", ".patch", ".log", ".md", ".json", ".csv")
EVIDENCE_CAP = {"image": 15 * 2**20, "text": 300 * 2**10}
EVIDENCE_MAX, EVIDENCE_CAPTION = 12, 300


def _now():
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def _save(path, rec):
    """Whole-file replace: the GUI polls these and must never read half of one."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(rec, indent=2) + "\n")
    os.replace(tmp, path)


def ask_projects():
    """Every enrolled project on this machine: [(state dir, repo path)]."""
    out = []
    for pdir in sorted(p for p in HOME_STATE.glob("*")
                       if p.is_dir() and (p / "binding.json").exists()):
        try:
            repo = json.loads((pdir / "binding.json").read_text()).get("repo", "")
        except Exception:
            continue
        out.append((pdir, repo))
    return out


def intermediary_name(repo):
    """The roster name of a project's intermediary: one per project."""
    return f"{INTERMEDIARY}-{Path(repo).name}"


def ask_bound():
    """The project an intermediary is bound to — HARNESS_PROJECT, a state slug —
    as (state dir, repo); None when unset. Set but naming nothing refuses: an
    intermediary that silently widened to the whole machine is the bug this stops."""
    s = os.environ.get("HARNESS_PROJECT")
    if not s:
        return None
    for pdir, repo in ask_projects():
        if pdir.name == s:
            return pdir, repo
    die(REFUSED, f"HARNESS_PROJECT={s} names no enrolled project on this machine")


def ask_next_id(state, task):
    k = tkey(task)
    # An accepted ask is deleted, so its ruling on the brief holds the id too.
    ids = [p.stem for p in (Path(state) / "asks").glob(f"{k}-*.json")]
    try:
        b = json.loads((Path(state) / "briefs" / f"{k}.json").read_text())
        ids += [str(r.get("id") or "") for r in b.get("rulings") or []]
    except Exception:
        pass
    ids += [d.get("id") or "" for d in owner_done(state)]
    ns = [int(i.rsplit("-", 1)[1]) for i in ids
          if "-" in i and i.rsplit("-", 1)[0] == k and i.rsplit("-", 1)[1].isdigit()]
    return f"{k}-{max(ns, default=0) + 1}"


def ask_open(ctx, task, kind, question, me, sid, runs=None):
    """`ask <task>`: rank 0 or a lead opens one; a lane goes through its lead.
    `runs`: commands for the owner to run (an `action` ask)."""
    documenter = me == "documenter"
    owner = tkey(task) == OWNER_TASK
    if owner and sid and (documenter or role_of(ctx, me) != "root"):
        die(REFUSED, f"'{OWNER_TASK}' is rank 0's standing task for commands the owner runs. "
                     f"Ask on your own task,\n           or tell rank 0 what the owner must do.")
    if documenter and tkey(task) != "docs":
        die(REFUSED, "the documenter asks on its standing task: harness ask docs --kind ... "
                     "--question \"...\"")
    if sid and not documenter and role_of(ctx, me) == "member":
        lead = ctx.tree["nodes"][me].get("parent")
        die(REFUSED, f"'{me}' is a lane. A lane asks its lead, and the lead decides "
                     f"whether it is the\n           owner's: harness waiting \"...\" "
                     f"--still-moving \"...\", then tell {lead}")
    if kind not in ASK_KINDS:
        die(REFUSED, f"--kind must be one of {', '.join(ASK_KINDS)}")
    q = (question or "").strip()
    if not q:
        die(REFUSED, "--question is required: one sentence the owner can answer")
    if len(q) > 200:
        die(REFUSED, f"the question is {len(q)} chars; the cap is 200. One sentence the "
                     f"owner can answer —\n           the intermediary gathers the rest.")
    runs = [r.strip() for r in runs or [] if r.strip()]
    if runs and kind != "action":
        die(REFUSED, "--run is for --kind action: commands the owner runs")
    if kind == "note" and (sid or not owner):
        die(REFUSED, f"a note is the owner's conversation, on '{OWNER_TASK}': harness ask "
                     f"{OWNER_TASK} --kind note --question \"...\" from a shell or the GUI")
    if owner and not runs and kind != "note":
        die(REFUSED, f"'{OWNER_TASK}' carries commands: --kind action --run \"cmd\" "
                     f"(repeat --run for each)")
    if len(runs) > ASK_RUNS_MAX:
        die(REFUSED, f"{len(runs)} commands; the cap is {ASK_RUNS_MAX}. Split them, or "
                     f"put them in a script the owner runs once.")
    for i, r in enumerate(runs, 1):
        if len(r) > ASK_RUN_CAP:
            die(REFUSED, f"command {i} is {len(r)} chars; the cap is {ASK_RUN_CAP}. "
                         f"Put it in a script and hand the owner that.")
    _, b = (None, None) if owner else load_brief(ctx, task)
    if b is None and documenter:
        b = {"task": "docs", "node": None}     # no brief: rulings go to docs/rulings.json
    if owner:
        b = {"task": OWNER_TASK, "node": None}  # no brief: Done rings the asker
    if b is None:
        die(REFUSED, f"no brief for '{task}'. An ask is attached to a task, so the ruling "
                     f"lands where a\n           lead reads it. Write the brief first: "
                     f"harness brief {task} --for <node> --write -")
    who = f"{me} ({'session ' + sid[:8] if sid else 'operator'})"
    rec = {"id": ask_next_id(ctx.state, task), "task": b.get("task") or task,
           "node": b.get("node"), "kind": kind, "question": q, "asked_by": who,
           "asker_node": me, "asked_at": _now(), "state": "asked", "brief": None,
           "draft": None, "returned_why": None, "merged_into": None,
           "history": [{"at": _now(), "by": who, "what": "asked"}]}
    if runs:
        rec["runs"], rec["thread"] = runs, []
    _save(Path(ctx.state) / "asks" / f"{rec['id']}.json", rec)
    return rec


def ask_find(ident, project=None):
    """An ask anywhere on the machine -> (state dir, repo, path, record). An
    intermediary (HARNESS_PROJECT set) finds only its own project's."""
    if not ASK_ID_RE.match(ident or ""):
        die(REFUSED, f"'{ident}' is not an ask id (<task>-<n>). harness ask --list")
    bound = ask_bound()
    hits = []
    for pdir, repo in ask_projects():
        if bound and pdir != bound[0]:
            continue
        if project and project not in (Path(repo).name, pdir.name):
            continue
        f = pdir / "asks" / f"{ident}.json"
        if f.exists():
            try:
                hits.append((pdir, repo, f, json.loads(f.read_text())))
            except json.JSONDecodeError:
                die(REFUSED, f"{f} is not valid JSON — refusing to touch it")
    if not hits and bound:
        die(REFUSED, f"'{ident}' is not in {Path(bound[1]).name}; this intermediary acts "
                     f"on {Path(bound[1]).name}'s asks only. harness ask --list")
    if not hits:
        die(REFUSED, f"no ask '{ident}'" + (f" in {project}" if project else
                     " in any enrolled project") + ". harness ask --list")
    if len(hits) > 1:
        die(REFUSED, f"'{ident}' is in {len(hits)} projects: "
                     f"{', '.join(Path(h[1]).name for h in hits)}.\n"
                     f"           Say which: harness ask {ident} --project <name> ...")
    return hits[0]


def parse_ask_brief(text):
    """The `## ` sections, each under its cap -> (brief, []), or (None, every fault).
    Prose keeps its paragraphs: lines join with a space, blank lines stay."""
    names = {h: k for h, k, _ in ASK_SECTIONS}
    secs, cur, errs = {}, None, []
    for line in (text or "").splitlines():
        m = re.match(r"^##\s+(.+?)\s*$", line)
        if m:
            h = m.group(1).strip().lower()
            if h not in names:
                errs.append(f"'{m.group(1).strip()}': not a section "
                            f"(they are {', '.join(h for h, _, _ in ASK_SECTIONS)})")
                cur = None
            elif names[h] in secs:
                errs.append(f"{h}: given twice"); cur = None
            else:
                cur = names[h]; secs[cur] = []
        elif cur:
            secs[cur].append(line)
    out = {}
    for h, k, cap in ASK_SECTIONS:
        if k not in secs:
            errs.append(f"{h}: missing"); continue
        lines = [l.strip() for l in secs[k] if l.strip()]
        if not lines:
            errs.append(f"{h}: empty"); continue
        paras = [" ".join(x.split()) for x in "\n".join(l.strip() for l in secs[k]).strip().split("\n\n")]
        if k == "checked":
            if len(lines) > cap:
                errs.append(f"{h}: {len(lines)} lines, cap {cap}")
            out[k] = "\n".join(lines)
        elif k == "options":
            items = []
            for l in lines:
                m = re.match(r"^(?:-|\d+\.)\s+(.*)$", l)
                if m:
                    items.append(m.group(1).strip())
                elif items:
                    items[-1] += " " + l           # a wrapped item
                else:
                    errs.append(f"{h}: '{l[:40]}' is not a list item (- or 1.)")
            if not 2 <= len(items) <= 5:
                errs.append(f"{h}: {len(items)} item(s), need 2–5")
            for i, it in enumerate(items, 1):
                if len(it) > cap:
                    errs.append(f"{h} #{i}: {len(it)} chars, cap {cap}")
            out[k] = items
        else:
            v = "\n\n".join(x for x in paras if x)
            if len(v) > cap:
                errs.append(f"{h}: {len(v)} chars, cap {cap}")
            out[k] = v
    return (None, errs) if errs else (out, [])


def _ask_log(rec, by, what):
    rec.setdefault("history", []).append({"at": _now(), "by": by, "what": what})


def ask_set_brief(path, rec, text, by="intermediary"):
    if rec.get("state") not in ASK_OPEN:
        die(REFUSED, f"{rec['id']} is {rec.get('state')}; it takes no brief")
    brief, errs = parse_ask_brief(text)
    if errs:
        die(REFUSED, f"brief refused — {len(errs)} fault(s):\n"
                     + "\n".join(f"             {e}" for e in errs)
                     + "\n           Sections, in order: "
                     + ", ".join("## " + h.capitalize() for h, _, _ in ASK_SECTIONS))
    rec["brief"], rec["state"] = brief, "ready"
    _ask_log(rec, by, "briefed")
    _save(path, rec)
    return rec


def ask_amend(path, rec, text, by="intermediary"):
    t = (text or "").strip()
    if rec.get("state") not in ASK_OPEN:
        die(REFUSED, f"{rec['id']} is {rec.get('state')}; nothing to amend")
    if not t or len(t) > 200:
        die(REFUSED, f"the amended question is {len(t)} chars; it must be 1–200")
    rec["question"] = t
    if rec.get("brief"):
        rec["brief"]["question"] = t
    _ask_log(rec, by, "amended the question")
    _save(path, rec)
    return rec


def ask_draft(path, rec, text, by="intermediary"):
    if rec.get("state") not in ("ready", "drafted"):
        die(REFUSED, f"{rec['id']} is {rec.get('state')}. Brief it first, so the owner "
                     f"has the sections\n           to rule against: harness ask "
                     f"{rec['id']} --brief FILE")
    if not (text or "").strip():
        die(REFUSED, "an empty draft rules nothing")
    rec["draft"], rec["state"] = text.strip(), "drafted"
    _ask_log(rec, by, "drafted a ruling")
    _save(path, rec)
    return rec


def evidence_dir(path, ident):
    """<state>/asks/evidence/<id>/ — beside the record, never inside a repo."""
    return path.parent / "evidence" / ident


def _evidence_name(n, name):
    stem, ext = os.path.splitext(name)
    stem = re.sub(r"[^A-Za-z0-9._-]+", "_", stem).strip("._")[:60] or "file"
    return f"{n}-{stem}{ext.lower()}"


def _bytes(b):
    return f"{b} B" if b < 1024 else f"{b / 1024:.0f} KB" if b < 2**20 else f"{b / 2**20:.1f} MB"


def ask_attach(path, rec, src, caption=None, by="intermediary"):
    if rec.get("state") not in ASK_OPEN:
        die(REFUSED, f"{rec['id']} is {rec.get('state')}; it takes no evidence")
    ev = rec.setdefault("evidence", [])
    if len(ev) >= EVIDENCE_MAX:
        die(REFUSED, f"{rec['id']} already has {len(ev)} pieces of evidence, the cap. "
                     f"Drop one first:\n           harness ask {rec['id']} --drop-evidence N")
    cap = (caption or "").strip() or None
    if cap and len(cap) > EVIDENCE_CAPTION:
        die(REFUSED, f"the caption is {len(cap)} chars; the cap is {EVIDENCE_CAPTION}")
    f = Path(src).expanduser()
    if f.is_dir():
        die(REFUSED, f"'{src}' is a directory. Attach one file at a time.")
    if not f.is_file():
        die(REFUSED, f"no file '{src}'")
    ext = f.suffix.lower()
    kind = "image" if ext in EVIDENCE_IMAGE else "text" if ext in EVIDENCE_TEXT else None
    if kind is None:
        die(REFUSED, f"'{f.name}': {ext or 'no extension'} is not evidence the owner's page "
                     f"can show.\n           Images: {' '.join(EVIDENCE_IMAGE)}; "
                     f"text: {' '.join(EVIDENCE_TEXT)}")
    size = f.stat().st_size
    if size > EVIDENCE_CAP[kind]:
        die(REFUSED, f"'{f.name}' is {_bytes(size)}; a {kind} is capped at "
                     f"{_bytes(EVIDENCE_CAP[kind])}.\n           Crop it, or attach the part "
                     f"that answers the question.")
    # A counter, not len+1: a dropped file's name is never reused, so a URL the
    # owner's page cached for it never shows the wrong thing.
    n = int(rec.get("evidence_seq") or 0) + 1
    name = _evidence_name(n, f.name)
    d = evidence_dir(path, rec["id"])
    d.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(f, d / name)
    ev.append({"file": name, "name": f.name, "caption": cap, "from": str(f.resolve()),
               "kind": kind, "bytes": size, "at": _now()})
    rec["evidence_seq"] = n
    _ask_log(rec, by, f"attached {f.name}")
    _save(path, rec)
    return ev[-1]


def ask_drop_evidence(path, rec, n, by="intermediary"):
    if rec.get("state") not in ASK_OPEN:
        die(REFUSED, f"{rec['id']} is {rec.get('state')}; nothing to drop")
    ev = rec.get("evidence") or []
    if not 1 <= n <= len(ev):
        die(REFUSED, f"{rec['id']} has {len(ev)} piece(s) of evidence; there is no {n}. "
                     f"harness ask {rec['id']} --show")
    e = ev.pop(n - 1)
    (evidence_dir(path, rec["id"]) / e["file"]).unlink(missing_ok=True)
    _ask_log(rec, by, f"dropped evidence {e.get('name')}")
    _save(path, rec)
    return e


def evidence_clear(path, ident):
    shutil.rmtree(evidence_dir(path, ident), ignore_errors=True)


def ask_return(path, rec, why, by="intermediary"):
    """Back to the asker. The stub carries no question, so it cannot be ruled on."""
    if rec.get("state") not in ASK_OPEN:
        die(REFUSED, f"{rec['id']} is {rec.get('state')}; nothing to return")
    if not (why or "").strip():
        die(REFUSED, "say why it is not the owner's — the asker reads it and acts on it")
    stub = {"id": rec["id"], "task": rec.get("task"), "asker_node": rec.get("asker_node"),
            "returned_why": why.strip(), "state": "returned", "at": _now()}
    _save(path, stub)
    evidence_clear(path, rec["id"])
    return stub


def ask_merge(path, rec, other, by="intermediary"):
    if other == rec["id"]:
        die(REFUSED, "an ask cannot be merged into itself")
    of = path.parent / f"{other}.json"
    if not of.exists():
        die(REFUSED, f"no ask '{other}' in the same project. Merging crosses no projects.")
    o = json.loads(of.read_text())
    if o.get("state") not in ASK_OPEN or rec.get("state") not in ASK_OPEN:
        die(REFUSED, "both asks must be open to merge")
    _ask_log(o, by, f"merged {rec['id']} ({rec.get('asked_by')}): {rec.get('question')}")
    # Its evidence goes with it, numbered on from the target's own.
    src, dst = evidence_dir(path, rec["id"]), evidence_dir(path, other)
    for e in rec.get("evidence") or []:
        f = src / e["file"]
        if not f.is_file():
            continue
        n = int(o.get("evidence_seq") or 0) + 1
        name = _evidence_name(n, e.get("name") or e["file"])
        dst.mkdir(parents=True, exist_ok=True)
        shutil.move(str(f), str(dst / name))
        o.setdefault("evidence", []).append(dict(e, file=name))
        o["evidence_seq"] = n
    _save(of, o)
    path.unlink()
    evidence_clear(path, rec["id"])
    return o


def ask_accept(pdir, path, rec, text=None, by="operator"):
    """Sign it: the ruling goes onto the task's brief and the ask is gone."""
    st = rec.get("state")
    if not (st == "drafted" or (st == "ready" and (text or "").strip())):
        die(REFUSED, f"{rec['id']} is {st}. Accept signs a draft ruling — the "
                     f"intermediary writes one\n           first, or give your own: "
                     f"harness ask {rec['id']} --accept --text \"...\"")
    answer = ((text or "").strip() or rec.get("draft") or "").strip()
    if rec.get("asker_node") == "documenter":
        # The documenter's standing task has no brief; its next run reads these.
        rf = Path(pdir) / "docs" / "rulings.json"
        rs = json.loads(rf.read_text()) if rf.exists() else []
        r = {"id": rec["id"], "question": (rec.get("brief") or {}).get("question")
             or rec.get("question"), "answer": answer, "kind": rec.get("kind"),
             "ruled_at": _now()}
        rf.parent.mkdir(parents=True, exist_ok=True)
        _save(rf, rs + [r])
        path.unlink()
        evidence_clear(path, rec["id"])
        return r
    bf = Path(pdir) / "briefs" / f"{tkey(rec.get('task'))}.json"
    if not bf.exists():
        die(REFUSED, f"the brief '{rec.get('task')}' is gone, so the ruling has nowhere "
                     f"to land.\n           Reject this one, and ask again on a live task.")
    b = json.loads(bf.read_text())
    # The briefed question is the one the owner ruled on; --amend keeps both in step.
    r = {"id": rec["id"], "question": (rec.get("brief") or {}).get("question") or rec.get("question"),
         "answer": answer,
         "kind": rec.get("kind"), "asked_by": rec.get("asked_by"),
         "asker_node": rec.get("asker_node"), "ruled_at": _now()}
    b.setdefault("rulings", []).append(r)
    _save(bf, b)
    path.unlink()
    evidence_clear(path, rec["id"])
    return r


def ask_reject(path, rec):
    stub = {"id": rec["id"], "task": rec.get("task"), "asker_node": rec.get("asker_node"),
            "state": "rejected", "at": _now()}
    _save(path, stub)
    evidence_clear(path, rec["id"])
    return stub


def owner_done(pdir):
    """The log of actions the owner has marked done, oldest first."""
    f = Path(pdir) / "owner" / "done.jsonl"
    out = []
    try:
        for line in f.read_text().splitlines():
            try:
                out.append(json.loads(line))
            except ValueError:
                pass
    except OSError:
        pass
    return out


def ask_done(pdir, path, rec, note=None):
    """The owner ran an action ask's commands. Logged, left as a stub the asker
    is told of once, and rung through the asker's doorbell now."""
    if rec.get("kind") not in ("action", "note") or rec.get("state") not in ASK_OPEN:
        die(REFUSED, f"{rec['id']} is a {rec.get('kind')} ask, {rec.get('state')}. Done is for "
                     f"an open action ask;\n           a question is answered with --accept.")
    note = (note or "").strip()
    d = {"id": rec["id"], "task": rec.get("task"), "question": rec.get("question"),
         "runs": rec.get("runs") or [], "note": note, "asker_node": rec.get("asker_node"),
         "asked_by": rec.get("asked_by"), "done_at": _now()}
    f = Path(pdir) / "owner" / "done.jsonl"
    f.parent.mkdir(parents=True, exist_ok=True)
    with open(f, "a") as fh:
        fh.write(json.dumps(d) + "\n")
    _save(path, {"id": rec["id"], "task": rec.get("task"), "asker_node": rec.get("asker_node"),
                 "state": "done", "at": _now(), "runs": d["runs"], "note": note})
    evidence_clear(path, rec["id"])
    node = rec.get("asker_node")
    if node and node not in ("documenter", "operator", "owner"):
        cmds = "; ".join(d["runs"])
        ring_inbox(pdir, node, "owner",
                   f"the owner ran {rec['id']} ({rec.get('question')})"
                   + (f": {cmds[:300]}" if cmds else "") + (f". Note: {note}" if note else "")
                   + ". Carry on with what waited on it.")
    return d


def ask_msg(path, rec, by, text):
    """A message into an ask's thread, from the owner or a node; the item's
    intermediary is woken for it. The owner's leaves a question open."""
    text = (text or "").strip()
    if not text:
        die(REFUSED, 'the message is empty: --msg "..."')
    if len(text) > CHAT_CAP:
        die(REFUSED, f"the message is {len(text)} chars; the cap is {CHAT_CAP}")
    if rec.get("state") not in ASK_OPEN:
        die(REFUSED, f"{rec['id']} is {rec.get('state')}; it is closed")
    rec.setdefault("thread", []).append({"by": by, "at": _now(), "text": text})
    if by == "owner":
        rec["query_open"] = True
    if rec.get("waiting_on") == by:
        rec["waiting_on"] = None
    _ask_log(rec, by, "messaged")
    _save(path, rec)


def ask_to(pdir, repo, path, rec, node, text):
    """The intermediary asks a node about its item: logged in the thread, and
    the node's doorbell rings. Its `--msg` back wakes the item's session."""
    text = (text or "").strip()
    if not text:
        die(REFUSED, 'say what you need: --to <node> --text "..."')
    if len(text) > CHAT_CAP:
        die(REFUSED, f"{len(text)} chars; the cap is {CHAT_CAP}")
    try:
        nodes = json.loads((Path(repo) / ".harness" / "tree.json").read_text()).get("nodes", {})
    except Exception:
        nodes = {}
    if node not in nodes:
        die(REFUSED, f"'{node}' is not a node of {Path(repo).name} "
                     f"({', '.join(sorted(nodes)) or 'tree unreadable'})")
    rec.setdefault("thread", []).append({"by": "intermediary", "to": node, "at": _now(),
                                         "text": text})
    rec["waiting_on"] = node
    _ask_log(rec, "intermediary", f"asked {node}")
    _save(path, rec)
    ring_inbox(pdir, node, f"intermediary ({rec['id']})",
               f"The intermediary on ask {rec['id']} ({rec.get('question')}) asks you: {text}\n"
               f"Answer: harness ask {rec['id']} --msg \"...\"")


def ask_reply(path, rec, text, by="intermediary"):
    """The intermediary answers the owner under the ask, or (on an action ask
    not yet looked at) says what its commands do."""
    text = (text or "").strip()
    if not text:
        die(REFUSED, 'the reply is empty: --reply "..."')
    if len(text) > 2000:
        die(REFUSED, f"the reply is {len(text)} chars; the cap is 2000")
    rec.setdefault("thread", []).append({"by": by, "at": _now(), "text": text})
    rec["query_open"] = False
    if rec.get("runs") and rec.get("state") == "asked":
        rec["state"] = "ready"
    _ask_log(rec, by, "replied")
    _save(path, rec)


def ask_list(every=False):
    """Open asks, oldest first, each with project and slug: across every project,
    or only the bound one when HARNESS_PROJECT is set and `every` is not."""
    bound = None if every else ask_bound()
    out = []
    for pdir, repo in ask_projects():
        if bound and pdir != bound[0]:
            continue
        for f in sorted((pdir / "asks").glob("*.json")):
            try:
                r = json.loads(f.read_text())
            except Exception:
                continue
            if r.get("state") in ASK_OPEN:
                out.append(dict(r, project=Path(repo).name, slug=pdir.name))
    return sorted(out, key=lambda r: _epoch(r.get("asked_at")) or 0)


def ask_notices(ctx, node):
    """Orientation lines: rulings this node has not read, and its returned or
    rejected asks. {id: line}."""
    out = {}
    try:
        for stem, b in all_briefs(ctx).items():
            lead = ctx.tree["nodes"].get(b.get("node"), {}).get("parent") or b.get("node")
            seen = _epoch((b.get("read") or {}).get(node)) or 0
            for r in b.get("rulings") or []:
                if node not in (r.get("asker_node"), lead) or seen >= (_epoch(r.get("ruled_at")) or 0):
                    continue
                ans = r.get("answer") or ""
                out[f"ruled:{stem}:{r.get('id')}"] = (
                    f"the owner ruled on {b['task']}: {ans[:70]}{'…' if len(ans) > 70 else ''}"
                    f"  — harness brief {b['task']}")
    except Exception:
        pass
    try:
        for f in sorted((Path(ctx.state) / "asks").glob("*.json")):
            r = json.loads(f.read_text())
            if r.get("asker_node") != node and r.get("waiting_on") != node:
                continue
            if r.get("state") == "rejected":
                out[f"rejected:{r['id']}"] = (f"the owner rejected your question on "
                                              f"{r.get('task')}; don't ask it again")
            elif r.get("state") in ASK_OPEN and r.get("waiting_on") == node:
                q = next((t for t in reversed(r.get("thread") or []) if t.get("to") == node), {})
                out[f"imask:{r['id']}:{len(r.get('thread') or [])}"] = (
                    f"the intermediary on {r['id']} asks you: {(q.get('text') or '')[:90]}"
                    f"  — harness ask {r['id']} --msg \"...\"")
            elif r.get("state") == "done":
                note = r.get("note") or ""
                out[f"done:{r['id']}"] = (f"the owner ran {r['id']}"
                                          + (f": {note[:80]}" if note else ""))
            elif r.get("state") == "returned":
                why = r.get("returned_why") or ""
                out[f"returned:{r['id']}"] = (f"the intermediary returned your ask on "
                                              f"{r.get('task')}: {why[:80]}"
                                              + ("…" if len(why) > 80 else ""))
    except Exception:
        pass
    return out


def ask_consume(ctx, ids):
    """A rejected or returned stub is said once: gone once it has been told."""
    for k in ids:
        if k.startswith(("rejected:", "returned:", "done:")):
            try:
                f = Path(ctx.state) / "asks" / f"{k.split(':', 1)[1]}.json"
                if json.loads(f.read_text()).get("state") in ("rejected", "returned", "done"):
                    f.unlink()
            except Exception:
                pass


def ask_show(pdir, repo, rec):
    """The ask, then everything the intermediary needs from the task it sits on.
    It runs outside every repo, so `harness brief` cannot resolve from there."""
    print(f"{rec['id']}  {Path(repo).name}  {rec.get('kind')}  {rec.get('state')}")
    print(f"  asked by {rec.get('asked_by')} on {rec.get('task')} "
          f"({rec.get('node')}'s brief), {_ago(rec.get('asked_at'))}")
    print(f"  question  {rec.get('question')}")
    br = rec.get("brief") or {}
    for h, k, _ in ASK_SECTIONS:
        if k in br and k != "question":
            v = br[k]
            v = "\n".join(f"- {o}" for o in v) if isinstance(v, list) else v
            print(f"  {h}:")
            for line in str(v).splitlines():
                print(f"      {line}")
    if rec.get("draft"):
        print(f"  draft     {rec['draft']}")
    for i, c in enumerate(rec.get("runs") or [], 1):
        print(f"  run {i}     {c}")
    for t in rec.get("thread") or []:
        print(f"  {t.get('by'):<12}{str(t.get('at'))[:16]}  {t.get('text')}")
    if rec.get("query_open"):
        print("  (the owner's question above waits for your --reply)")
    ed = evidence_dir(Path(pdir) / "asks" / f"{rec['id']}.json", rec["id"])
    for i, e in enumerate(rec.get("evidence") or [], 1):
        print(f"  evidence {i}  {e.get('name')}  {e.get('kind')}  {_bytes(int(e.get('bytes') or 0))}"
              + (f"  — {e['caption']}" if e.get("caption") else ""))
        print(f"      {ed / e['file']}")
    for h in rec.get("history") or []:
        print(f"  · {str(h.get('at'))[:16]}  {h.get('by')}: {h.get('what')}")
    if tkey(rec.get("task")) == OWNER_TASK:
        print(f"\non rank 0's standing task '{OWNER_TASK}': no brief"); return
    bf = Path(pdir) / "briefs" / f"{tkey(rec.get('task'))}.json"
    try:
        b = json.loads(bf.read_text())
    except Exception:
        print(f"\nno brief at {bf}"); return
    print(f"\nbrief {b.get('task')}  for {b.get('node')}  revision {b.get('revision')}  "
          f"by {b.get('written_by')}")
    ap = b.get("approval") or {}
    if ap:
        print(f"  approval  {ap.get('state')}" + (f": {ap['why']}" if ap.get("why") else ""))
    if b.get("after"):
        print(f"  after     {', '.join(b['after'])}")
    for nm in b.get("facts") or []:
        try:
            o = latest(json.loads((Path(pdir) / "facts" / f"{tkey(nm)}.json").read_text()))
            print(f"  fact      {nm} = {o.get('value')}  ({_ago(o.get('at'))} · {o.get('command')})")
        except Exception:
            print(f"  fact      {nm} — not readable here")
    for line in (b.get("text") or "").splitlines():
        print(f"  {line}")
    for c in b.get("comments") or []:
        print(f"  [comment {str(c.get('at'))[:16]}  {c.get('by')}] {c.get('text')}")
    for r in b.get("rulings") or []:
        print(f"  ruled {str(r.get('ruled_at'))[:10]}  {r.get('question')}")
        print(f"           → {r.get('answer')}")
    md = Path(pdir) / "marks"
    for f in (sorted(md.glob("*.json")) if md.is_dir() else []):
        try:
            m = json.loads(f.read_text())
        except Exception:
            continue
        if m.get("_node") == rec.get("asker_node") and not m.get("_closed_at"):
            print(f"\n{rec.get('asker_node')} has {m.get('_task') or f.stem} open"
                  + (f": {m['_note']}" if m.get("_note") else ""))


def intermediary_live(repo):
    """Is this project's intermediary running? True or False from the roster;
    None when it cannot be read."""
    name = intermediary_name(repo)
    try:
        return any(r.get("name") == name for r in live_rows(agents_json()))
    except Exception:
        return None


def cmd_ask(a):
    """T17: a question only the owner can answer, briefed by the intermediary —
    one intermediary session per ask, and every message about the ask in its
    thread."""
    if a.query is not None:             # the old name for an owner's message
        a.msg, a.query = a.query, None
    verbs = [v for v in ("brief", "amend", "draft", "return_why", "merge", "accept",
                         "reject", "show", "evidence", "drop_evidence", "done", "msg", "to",
                         "reply")
             if getattr(a, v) is not None and getattr(a, v) is not False]
    flag = lambda v: "--" + {"return_why": "return"}.get(v, v).replace("_", "-")
    if a.caption is not None and not a.evidence:
        die(REFUSED, "--caption goes with --evidence PATH")
    if len(verbs) > 1:
        die(REFUSED, f"one verb at a time: {', '.join(flag(v) for v in verbs)}")
    if a.run and verbs:
        die(REFUSED, "--run goes with opening an ask: harness ask <task> --kind action --run ...")
    mine = os.environ.get("HARNESS_ASK")      # an item session's own ask
    if a.idle:
        if os.environ.get("HARNESS_INTERMEDIARY") != "1" or not mine:
            die(REFUSED, "--idle is an item session's (HARNESS_ASK unset)")
        b = ask_bound()
        if not b:
            die(REFUSED, "--idle needs HARNESS_PROJECT: the intermediary's own project")
        ask_idle(b[0], mine); return
    if a.list:
        rows = ask_list(a.all)
        if a.json:
            print(json.dumps(rows, indent=2)); return
        if not rows:
            bound = None if a.all else ask_bound()
            print(f"no open asks in {Path(bound[1]).name}" if bound
                  else "no open asks on this machine"); return
        for r in rows:
            print(f"{r['project']} {r['id']} {r.get('kind')} {r.get('state')} "
                  f"{r.get('asker_node')} {human_age(max(0, time.time() - (_epoch(r.get('asked_at')) or time.time())))} "
                  f"{(r.get('question') or '')[:80]}")
        return
    if not a.target:
        die(REFUSED, "harness ask <task> --kind K --question \"...\", or harness ask --list")
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    if not verbs:
        ctx = Ctx(); ctx.require_enrolled()
        me, _ = ctx.node()
        if os.environ.get("HARNESS_DOCUMENTER") == "1":
            me = "documenter"           # not a node: its asks sit on the standing task `docs`
        text = (a.question or "").strip()
        if a.kind == "note":
            # The owner starts a conversation: the first message is the thread's.
            if sid:
                die(REFUSED, "a note is the owner's: the GUI's conversation box, or a shell")
            me = "owner"
            a.question = text if len(text) <= 200 else text[:190].rsplit(" ", 1)[0] + " …"
        rec = ask_open(ctx, a.target, a.kind, a.question, me, sid, a.run)
        path = Path(ctx.state) / "asks" / f"{rec['id']}.json"
        if a.kind == "note":
            ask_msg(path, rec, "owner", text)
        print(f"asked {rec['id']}  ({rec['kind']}, on {rec['task']})")
        asker = me if me in ("documenter", "operator", "owner") else root_session_name(ctx, me)
        item_wake_detached(ctx.state, rec["id"], (
            f"New ask {rec['id']} from {asker}"
            + (f": {len(rec['runs'])} command(s) for the owner to run" if rec.get("runs") else "")
            + (f". The owner says: {text}" if a.kind == "note" else "") + "."))
        print(f"  Its intermediary session ({item_name(ctx.repo, rec['id'])}) is being started.")
        if rec.get("runs"):
            print("  The commands show in the owner's Issues tab now. When the owner clicks "
                  "Done you are\n  rung (harness doorbell); carry on with other work meanwhile.")
        elif a.kind != "note":
            print(f"  Carry on with other work. The ruling lands on {rec['task']}'s brief and "
                  f"you are told. To add\n  to it later: harness ask {rec['id']} --msg \"...\"")
        return
    v = verbs[0]
    im_verbs = ("brief", "amend", "draft", "return_why", "merge", "evidence", "drop_evidence",
                "reply", "to")
    if v in im_verbs and os.environ.get("HARNESS_INTERMEDIARY") != "1":
        die(REFUSED, f"{flag(v)} is the intermediary's, and this is not it "
                     f"(HARNESS_INTERMEDIARY is unset).")
    if v in im_verbs and mine and a.target != mine:
        die(REFUSED, f"you serve {mine}; {a.target} has its own session. To tell it "
                     f"something: harness ask {a.target} --msg \"...\"")
    if v == "msg" and os.environ.get("HARNESS_INTERMEDIARY") == "1" and a.target == mine:
        die(REFUSED, "that is your own ask: --reply to the owner, --to <node> to a node")
    if v in ("accept", "reject", "done") and sid:
        die(REFUSED, "only the owner signs a ruling or marks an action done — the GUI's "
                     "Issues tab, or a shell")
    pdir, repo, path, rec = ask_find(a.target, a.project)
    if v == "show":
        ask_show(pdir, repo, rec); return
    if v == "brief":
        src = a.brief
        if "\n" not in src and not src.lstrip().startswith("#"):
            if not Path(src).is_file():
                die(REFUSED, f"no file '{src}'. --brief FILE, or --brief - with a heredoc")
            src = Path(src).read_text()
        ask_set_brief(path, rec, src)
        print(f"briefed {rec['id']} — ready; it is the owner's move. "
              f"Talk it over, then --draft \"...\"")
    elif v == "amend":
        ask_amend(path, rec, a.amend)
        print(f"amended {rec['id']}: {rec['question']}")
    elif v == "draft":
        ask_draft(path, rec, a.draft)
        print(f"drafted {rec['id']}. The owner signs it in the GUI's Owner page, or:\n"
              f"  harness ask {rec['id']} --accept")
    elif v == "return_why":
        ask_return(path, rec, a.return_why)
        item_close_detached(pdir, rec["id"])
        print(f"returned {rec['id']} to {rec.get('asker_node')}; it is told at its next "
              f"harness command. This session is closed shortly; end your turn.")
    elif v == "merge":
        ask_merge(path, rec, a.merge)
        item_wake_detached(pdir, a.merge, f"{rec['id']} was merged into {a.merge}; read its "
                                          f"thread there: harness ask {a.merge} --show")
        item_close_detached(pdir, rec["id"])
        print(f"merged {rec['id']} into {a.merge}. This session is closed shortly; end your turn.")
    elif v == "evidence":
        e = ask_attach(path, rec, a.evidence, a.caption)
        print(f"attached {e['name']} to {rec['id']} as evidence {len(rec['evidence'])} "
              f"({e['kind']}, {_bytes(e['bytes'])}); the owner sees it under the briefing")
    elif v == "drop_evidence":
        e = ask_drop_evidence(path, rec, a.drop_evidence)
        print(f"dropped {e.get('name')} from {rec['id']}")
    elif v == "accept":
        r = ask_accept(pdir, path, rec, a.text)
        item_close_detached(pdir, rec["id"])
        print(f"ruled {rec['id']} on {rec.get('task')}: {r['answer']}")
        print(f"  {rec.get('asker_node')} and {rec.get('task')}'s lead are told when they "
              f"next orient.")
    elif v == "reject":
        ask_reject(path, rec)
        item_close_detached(pdir, rec["id"])
        print(f"rejected {rec['id']}; {rec.get('asker_node')} is told once not to ask again")
    elif v == "done":
        ask_done(pdir, path, rec, a.text)
        item_close_detached(pdir, rec["id"])
        print(f"closed {rec['id']}" if rec.get("asker_node") in ("owner", "operator", "documenter")
              else f"done {rec['id']}; {rec.get('asker_node')} is rung, and told when it next "
                   f"orients")
    elif v == "msg":
        by = "owner"
        if os.environ.get("HARNESS_DOCUMENTER") == "1":
            by = "documenter"
        elif sid:
            try:
                by, _ = Ctx().node()
            except SystemExit:
                by = f"session {sid[:8]}"
        ask_msg(path, rec, by, a.msg)
        how = ("Answer the owner with `harness ask {i} --reply \"...\"`; it shows under the ask."
               if by == "owner" else
               "Answer it with `harness ask {i} --to " + by + " \"...\"` if it needs one.")
        item_wake_detached(pdir, rec["id"], f"{by} says on {rec['id']}: {a.msg.strip()}\n"
                                            + how.format(i=rec["id"]))
        print(f"sent to {rec['id']}'s intermediary; "
              + ("its answer shows under the ask" if by == "owner" else
                 "an answer rings your doorbell"))
    elif v == "to":
        ask_to(pdir, repo, path, rec, a.to, a.text)
        print(f"sent to {a.to} (its doorbell rang); its answer wakes you. End your turn "
              f"with `harness ask --idle` if there is nothing else to do.")
    elif v == "reply":
        ask_reply(path, rec, a.reply)
        print(f"replied on {rec['id']}; the owner sees it under the ask")


# --restricted ignores the owner's user settings (whose allow rules would
# otherwise let it run anything they allow) and drops every tool --tools does not
# name. Bash is named only for these. Git rules name each repo exactly: a `*`
# before the subcommand would also match `-c ...`, which can run anything.
INTERMEDIARY_TOOLS = ("Read", "Grep", "Glob", "Bash", "SendMessage", "ListAgents")
INTERMEDIARY_GIT = ("log", "show", "diff", "status")
# Writing skills it reads before briefing; the owner's Voice section is in its prompt.
INTERMEDIARY_WRITING = ("humanizer", "sentence-prose", "de-densify", "google-devdocs-style")


def intermediary_prompt(pdir):
    """Its system prompt: its skill, then the owner's own Voice section from the
    global CLAUDE.md, so it writes in the register the owner asked for. Written
    into the project's state, beside the session it starts."""
    home = Path.home() / ".claude"
    parts = [(home / "skills" / INTERMEDIARY / "SKILL.md").read_text()]
    try:
        g = (home / "CLAUDE.md").read_text()
        m = re.search(r"^## Voice\n(.*?)(?=^## |\Z)", g, re.S | re.M)
        if m:
            parts.append("# The owner's voice (from their CLAUDE.md)\n" + m.group(1).strip())
    except Exception:
        pass
    out = Path(pdir) / "intermediary" / "prompt.md"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text("\n\n".join(parts) + "\n")
    return out


def intermediary_project(name=None):
    """The project an intermediary is started for -> (state dir, repo): --project
    (the repo's directory name or its state slug), else the enrolled repo holding
    the current directory. Neither refuses: guessing would start one on the
    wrong project's questions."""
    projs = ask_projects()
    known = ", ".join(Path(r).name for _, r in projs) or "none"
    if name:
        hits = [(p, r) for p, r in projs if name in (Path(r).name, p.name)]
        if len(hits) == 1:
            return hits[0]
        if not hits:
            die(REFUSED, f"no enrolled project '{name}' on this machine (enrolled: {known})")
        die(REFUSED, f"'{name}' names {len(hits)} projects; give the state slug: "
                     f"{', '.join(p.name for p, _ in hits)}")
    rc, common, _ = git("rev-parse", "--path-format=absolute", "--git-common-dir")
    if not rc:
        s_ = slug(Path(common).parent)
        for p, r in projs:
            if p.name == s_:
                return p, r
    die(REFUSED, f"which project? This directory is not in an enrolled repo. Run it from "
                 f"inside one,\n           or name it: harness intermediary --project <name> "
                 f"(enrolled: {known})")


def intermediary_cmd(pdir, repo, model=None, effort=None, bg=False, start=None, ask_id=None):
    """One project's intermediary `claude` line. Its reach is that project: its
    state, its repo and worktrees, its live grants — never another project's.
    Every variadic list (--add-dir, --tools, --allowedTools) is closed by the
    flag after it. Its skill is passed as a system-prompt file: --restricted
    does not load user skills."""
    pdir = Path(pdir)
    dirs, repos = [str(pdir)], []
    cand = [repo]
    try:
        idx = json.loads((pdir / "index.json").read_text())
        cand += [sp.get("worktree") for sp in (idx.get("nodes") or {}).values()]
    except Exception:
        pass
    for d in cand:
        if d and d not in dirs and Path(d).is_dir():
            dirs.append(d); repos.append(d)
    # Read-only on what lanes may write outside the repo: their live grants.
    try:
        g = json.loads((pdir / "grants.json").read_text())
    except Exception:
        g = {}
    for rows in (g.get("nodes") or {}).values():
        for r in rows:
            d = r.get("path")
            if d and not r.get("revoked_at") and d not in dirs and Path(d).is_dir():
                dirs.append(d)
    # Its writing skills, read on demand (--restricted loads no user skills).
    for sk in INTERMEDIARY_WRITING:
        d = str(Path.home() / ".claude" / "skills" / sk)
        if Path(d).is_dir() and d not in dirs:
            dirs.append(d)
    allow = ["Bash(harness ask *)"]
    for d in repos:
        for q in ('"', "'") + (("",) if " " not in d else ()):
            allow += [f"Bash(git -C {q}{d}{q} {g} *)" for g in INTERMEDIARY_GIT]
    skill = intermediary_prompt(pdir)
    # --strict-mcp-config: no MCP servers or connectors, which could write outside.
    name = item_name(repo, ask_id) if ask_id else intermediary_name(repo)
    cmd = ["claude", "-n", name, "--restricted", "--strict-mcp-config"]
    if bg:
        # A background session does not inherit the launcher's environment
        # (measured 2026-10-05), so its identity goes in through --settings.
        cmd[1:1] = ["--bg"]
        env = {"HARNESS_INTERMEDIARY": "1", "HARNESS_PROJECT": pdir.name}
        if ask_id:
            env["HARNESS_ASK"] = ask_id
        cmd += ["--settings", json.dumps({"env": env})]
    cmd += ["--add-dir", *dirs,
           "--tools", *(ITEM_TOOLS if ask_id else INTERMEDIARY_TOOLS),
           "--allowedTools", *allow,
           "--permission-mode", "dontAsk",
           "--append-system-prompt-file", str(skill)]
    if model:
        cmd += ["--model", model]
    if effort:
        cmd += ["--effort", effort]
    # Last, after a non-variadic flag, so no list swallows it: the first turn.
    return cmd + [start or intermediary_start(repo)]


def intermediary_start(repo):
    """The opening prompt, naming the project it answers for."""
    return (f"You are the harness intermediary for {Path(repo).name}; your instructions are "
            f"in your system prompt. Start now: run `harness ask --list`, and tell the owner "
            f"in a few lines what is open in {Path(repo).name} and whose move each one is, "
            f"or that nothing is.")


# ── item sessions: one intermediary per open ask ─────────────────────────────
#
# A decision is about one item, and closes with it, so each open ask gets its
# own intermediary session, named for it, and the session is removed when the
# ask closes. Its context stays the size of one item. A session sleeps after
# INTERMEDIARY_QUIET (inside the one-hour prompt cache, so a wake before then
# re-reads nothing cold) and is resumed when a message for its item arrives.
# `claude --bg --resume` with no flags continues a session under its saved
# options; any flag starts a copy instead (measured 2026-10-05).
#
# Messages are addressed to an ask id, never a session name: `ask <id> --msg`
# into the item from anyone, `--reply` out to the owner, `--to <node>` out to a
# node (its doorbell rings). All of it lands in the ask's thread, so a session
# lost or replaced is rebuilt from the record alone.

ITEM_CAP = 3                    # item sessions running at once; the rest queue
INTERMEDIARY_SETTLE = 90        # seconds from `ask --idle` to the first check
INTERMEDIARY_QUIET = 55 * 60    # quiet this long and it sleeps: inside the 1h cache
CHAT_CAP = 4000                 # chars in one message, either way
# No SendMessage: a message to a sleeping session is lost. It talks through
# `harness ask`, which logs, rings and wakes.
ITEM_TOOLS = ("Read", "Grep", "Glob", "Bash")
ITEM_MODEL = {"action": ("sonnet", "medium"), "note": ("sonnet", "medium"),
              "intent": ("opus", "high"), "judgement": ("opus", "high"),
              "risk": ("opus", "high")}


def item_name(repo, ask_id):
    return f"{intermediary_name(repo)}-{ask_id}"


def item_home(pdir, ask_id):
    return Path(pdir) / "intermediary" / ask_id


def item_inbox(pdir, ask_id, why=None, take=False):
    """Append a reason to an item session's inbox; with take, empty it and
    return what was there. A queued item is one with an inbox and no session."""
    f = item_home(pdir, ask_id) / "inbox.jsonl"
    if why:
        f.parent.mkdir(parents=True, exist_ok=True)
        with open(f, "a") as fh:
            fh.write(json.dumps({"at": _now(), "why": why}) + "\n")
        return []
    if not take:
        return []
    try:
        lines = f.read_text().splitlines()
        f.unlink()
    except OSError:
        return []
    out = []
    for l in lines:
        try:
            out.append(json.loads(l)["why"])
        except Exception:
            pass
    return out


def roster_all():
    """`claude agents --json --all`, raising when it cannot be read."""
    r = subprocess.run(["claude", "agents", "--json", "--all"], capture_output=True,
                       text=True, timeout=20)
    if r.returncode:
        raise RuntimeError(r.stderr.strip()[:120] or "claude agents failed")
    return json.loads(r.stdout)


def item_sessions(repo, rows):
    """{ask id: (live row or None, newest session id)} for this project's item
    sessions on the roster."""
    pre = intermediary_name(repo) + "-"
    live = {r.get("sessionId") for r in live_rows(rows)}
    when = lambda r: r.get("startedAt") if isinstance(r.get("startedAt"), (int, float)) else 0
    out = {}
    for r in sorted(rows, key=when):            # oldest first: the newest wins
        n = r.get("name") or ""
        if not n.startswith(pre) or not r.get("sessionId"):
            continue
        k = n[len(pre):]
        lr = out.get(k, (None, None))[0]
        out[k] = (r if r["sessionId"] in live else lr, r["sessionId"])
    return out


def item_start(repo, rec):
    return (f"You are the harness intermediary for ask {rec['id']} in {Path(repo).name}, and "
            f"for that ask only; your instructions are in your system prompt. Start: "
            f"`harness ask {rec['id']} --show`.")


def _open_ask(pdir, ask_id):
    try:
        rec = json.loads((Path(pdir) / "asks" / f"{ask_id}.json").read_text())
    except Exception:
        return None
    return rec if rec.get("state") in ASK_OPEN else None


def item_wake(pdir, repo, ask_id, why=None):
    """Get `why` (and anything queued) in front of the ask's session: resume it,
    start it, or queue it when ITEM_CAP sessions are running. (ok, message)."""
    pdir = Path(pdir)
    rec = _open_ask(pdir, ask_id)
    if rec is None:
        return False, f"{ask_id} is not open"
    home = item_home(pdir, ask_id)
    home.mkdir(parents=True, exist_ok=True)
    name = item_name(repo, ask_id)
    lock = home / "waking"
    try:
        if time.time() - lock.stat().st_mtime < 60:
            item_inbox(pdir, ask_id, why)
            return True, "it is being woken already; queued for it"
    except OSError:
        pass
    try:
        rows = roster_all()
    except Exception as e:
        item_inbox(pdir, ask_id, why)
        return False, f"cannot read the session list ({e}); queued for it"
    live, sid = item_sessions(repo, rows).get(ask_id, (None, None))
    if live and (live.get("status") == "busy" or live.get("kind") not in (None, "background")):
        # Working, or open in the owner's terminal: never stopped under them.
        item_inbox(pdir, ask_id, why)
        return True, f"{name} is busy; queued for its next stop"
    running = sum(1 for k, (lr, _) in item_sessions(repo, live_rows(rows)).items()
                  if lr and k != ask_id)
    if not live and running >= ITEM_CAP:
        item_inbox(pdir, ask_id, why)
        return True, f"queued: {running} item sessions are running (cap {ITEM_CAP})"
    lock.write_text(_now())
    try:
        whys = item_inbox(pdir, ask_id, take=True) + ([why] if why else [])
        prompt = ("\n\n".join(whys) or "Read your ask and handle it.") + \
                 "\n\nWhen this is handled, run `harness ask --idle`."
        env = {k: v for k, v in os.environ.items()
               if k not in ("CLAUDE_CODE_SESSION_ID", "HARNESS_INTERMEDIARY", "HARNESS_PROJECT",
                            "HARNESS_ASK")}
        if live:
            subprocess.run(["claude", "stop", live["sessionId"][:8]], capture_output=True)
        if sid:
            r = subprocess.run(["claude", "--bg", "--resume", sid, prompt], cwd=str(home),
                               env=env, capture_output=True, text=True)
            if not r.returncode:
                return True, f"woke {name}{_attach_hint(r.stdout, sid)}"
        model, effort = ITEM_MODEL.get(rec.get("kind"), ("opus", "high"))
        start = item_start(repo, rec) + "\n\n" + prompt
        r = subprocess.run(intermediary_cmd(pdir, repo, model, effort, bg=True, start=start,
                                            ask_id=ask_id),
                           cwd=str(home), env=env, capture_output=True, text=True)
        if r.returncode:
            for w in whys:
                item_inbox(pdir, ask_id, w)
            return False, f"{name} did not start: {(r.stderr or r.stdout).strip()[:200]}"
        return True, f"started {name}{_attach_hint(r.stdout)}"
    finally:
        lock.unlink(missing_ok=True)


def _attach_hint(out, sid=None):
    """` — claude attach <id>`, from what `claude --bg` printed (or the id resumed)."""
    m = re.search(r"backgrounded\W+(?:\x1b\[[0-9;]*m)?([0-9a-f]{8})", out or "")
    i = m.group(1) if m else (sid or "")[:8]
    return f" — open it: claude attach {i}" if i else ""


def _intermediary_bg(pdir, args, delay=0):
    """Run `harness intermediary --project=<slug> ARGS` detached: a session's Bash
    call, or the GUI, returns now. With delay, after that many seconds."""
    log = Path(pdir) / "intermediary" / "wake.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    env = {k: v for k, v in os.environ.items()
           if k not in ("CLAUDE_CODE_SESSION_ID", "HARNESS_INTERMEDIARY", "HARNESS_PROJECT",
                        "HARNESS_ASK", "HARNESS_DOCUMENTER")}
    cmd = shlex.join([sys.executable, str(Path(__file__).resolve()), "intermediary",
                      project_arg(pdir), *args])
    with open(log, "a") as fh:
        subprocess.Popen(["sh", "-c", (f"sleep {delay}; " if delay else "") + f"exec {cmd}"],
                         cwd=str(log.parent), env=env, stdout=fh, stderr=subprocess.STDOUT,
                         stdin=subprocess.DEVNULL, start_new_session=True)


def item_wake_detached(pdir, ask_id, why):
    _intermediary_bg(pdir, ["--ask", ask_id, "--wake", why])


def item_close_detached(pdir, ask_id):
    """The ask closed: remove its session once the current turn has ended (the
    closing verb may be the intermediary's own)."""
    _intermediary_bg(pdir, ["--close", ask_id], delay=20)


def item_close(pdir, repo, ask_id):
    """Stop and remove an item's sessions and its folder, then start a queued one."""
    try:
        rows = roster_all()
    except Exception as e:
        print(f"roster unreadable: {e}"); return
    name = item_name(repo, ask_id)
    live = {r.get("sessionId") for r in live_rows(rows)}
    for r in rows:
        if r.get("name") == name and r.get("sessionId"):
            if r["sessionId"] in live:
                subprocess.run(["claude", "stop", r["sessionId"][:8]], capture_output=True)
            claude_rm(r["sessionId"])
    shutil.rmtree(item_home(pdir, ask_id), ignore_errors=True)
    print(f"closed {name}")
    items_next(pdir, repo)


def items_next(pdir, repo):
    """Start queued items while fewer than ITEM_CAP sessions run."""
    d = Path(pdir) / "intermediary"
    for f in sorted(d.glob("*/inbox.jsonl"), key=lambda p: p.stat().st_mtime) if d.is_dir() else []:
        ok, msg = item_wake(pdir, repo, f.parent.name)
        print(msg)
        if msg.startswith("queued"):
            break


def ask_idle(pdir, ask_id):
    """`ask --idle`: an item session's last step on every wake."""
    whys = item_inbox(pdir, ask_id, take=True)
    if whys:
        print("Before you stop — this came in while you worked:\n")
        for w in whys:
            print(f"- {w}")
        print("\nHandle it, then run `harness ask --idle` again.")
        return
    _intermediary_bg(pdir, ["--ask", ask_id, "--settle"], delay=INTERMEDIARY_SETTLE)
    print(f"done for now. This session sleeps after {INTERMEDIARY_QUIET // 60} quiet minutes "
          f"and is woken when a message for {ask_id} arrives; end your turn.")


def item_settle(pdir, repo, ask_id):
    """After `ask --idle`'s delay: wake it for anything that arrived, else stop
    it once it has been quiet INTERMEDIARY_QUIET, then start a queued item."""
    whys = item_inbox(pdir, ask_id, take=True)
    if whys:
        for w in whys[:-1]:
            item_inbox(pdir, ask_id, w)
        print(item_wake(pdir, repo, ask_id, whys[-1])[1]); return
    try:
        live, _ = item_sessions(repo, live_rows(roster_all())).get(ask_id, (None, None))
    except Exception as e:
        print(f"roster unreadable: {e}"); return
    if not live or live.get("status") == "busy" or live.get("kind") not in (None, "background"):
        return              # gone, working (it runs `ask --idle` again), or the owner's
    quiet, _ = last_turn(live["sessionId"])
    if quiet is not None and quiet < INTERMEDIARY_QUIET:
        time.sleep(INTERMEDIARY_QUIET - quiet + 5)
        return item_settle(pdir, repo, ask_id)
    subprocess.run(["claude", "stop", live["sessionId"][:8]], capture_output=True)
    print(f"{item_name(repo, ask_id)} sleeps; a message for {ask_id} wakes it")
    items_next(pdir, repo)


def cmd_intermediary(a):
    """The intermediary is one session per open ask. With --ask, wake that ask's
    session (the GUI's Start button); its attach command is printed."""
    pdir, repo = intermediary_project(a.project)
    if a.close:
        item_close(pdir, repo, a.close); return
    if a.next:
        items_next(pdir, repo); return
    if not a.ask:
        open_ = [r["id"] for r in ask_list() if r.get("slug") == pdir.name] if not ask_bound() \
            else [r["id"] for r in ask_list()]
        die(REFUSED, "the intermediary is one session per open ask: harness intermediary "
                     "--ask <id>" + (f" (open: {', '.join(open_)})" if open_ else
                                     " (nothing is open)"))
    if a.settle:
        item_settle(pdir, repo, a.ask); return
    if a.print_cmd:
        rec = _open_ask(pdir, a.ask) or {"id": a.ask}
        m, e = ITEM_MODEL.get(rec.get("kind"), ("opus", "high"))
        print(shlex.join(intermediary_cmd(pdir, repo, a.model or m, a.effort or e, bg=True,
                                          start=item_start(repo, rec), ask_id=a.ask)))
        return
    ok, msg = item_wake(pdir, repo, a.ask, a.wake or (
        "The owner opened you to talk about this ask in a terminal. Read it, then say in a "
        "few lines where it stands."))
    print(msg)
    sys.exit(0 if ok else 1)


def read_dash_from_stdin(a):
    """`--write -` takes the body from stdin instead of from argv.

    Every long argument this CLI takes is prose, deliberately — a brief, a
    finding, a reason — and prose about code contains backticks and $(). Passed
    as `--write "... the `continue` stays ..."`, bash substitutes them away
    before this process exists: the argument arrives SHORTER, there is no way to
    know it was ever longer, and the command prints its success line over the
    top. Two ranks lost the central clause of a technical instruction that way
    in one night, one of them a defect report that ended up naming no location.
    Both were grammatical afterwards and both would have been acted on.

    So the fix cannot be detection. It is a route that does not pass through a
    shell's expansion at all:

        harness brief x --for y --write - <<'EOF'
        the `continue` stays, and $(anything) survives
        EOF

    The quoted delimiter is what makes the heredoc literal. One `-` per command:
    two would both want the same stdin, and quietly giving it to whichever
    argparse happened to store first is the class of fault this exists to close.
    """
    dashes = [k for k, v in vars(a).items() if isinstance(v, str) and v == "-"]
    if not dashes:
        return
    if len(dashes) > 1:
        die(REFUSED, f"more than one argument is '-' ({', '.join(sorted(dashes))}) "
                     f"and there is one stdin.\n           Pass one from stdin and "
                     f"the rest as arguments.")
    if sys.stdin.isatty():
        die(REFUSED, f"--{dashes[0].replace('_', '-')} is '-', which reads the body "
                     f"from stdin, and stdin is a terminal.\n           Give it "
                     f"something to read:\n\n"
                     f"           harness ... --{dashes[0].replace('_', '-')} - "
                     f"<<'EOF'\n           ...\n           EOF")
    # Exactly one trailing newline, which is the one the heredoc's delimiter
    # contributes and nobody typed. `rstrip("\n")` took ALL of them, so a body
    # deliberately ending in blank lines arrived shorter — the same
    # silent-truncation-under-a-success-line this route exists to prevent, at
    # the other end of the string. `$(cat file)` strips all of them too, so this
    # is now the faithful route as well as the safe one, which it was not
    # before somebody asked whether it was.
    body = sys.stdin.read()
    setattr(a, dashes[0], body[:-1] if body.endswith("\n") else body)


# ── T18: the documenter ──────────────────────────────────────────────────────
#
# Keeps a project's markdown small, current and clear so rank 0 spends its
# context on orchestration (design/documenter.md). A fresh background session per
# run: it measures, picks one improvement, and submits it as T5 pairs, which the
# harness applies at rank 0's next quiet turn end. Everything it measures comes
# from git, transcripts and records, with no model.

DOCUMENTER = "harness-documenter"
DOC_JOBS = ("auto", "budget", "reach", "consolidate", "stale", "clarity")
DOC_DEFAULTS = {"stale": ("sonnet", "medium"), "reach": ("sonnet", "medium")}
DOC_DEFAULT = ("opus", "high")
DOCUMENTER_WRITING = ("schimel-science-writing", "google-devdocs-style")
DOC_TRIGGER_GAP = 24 * 3600         # at most one triggered run a day
DOC_STALE_DAYS = 14
DOC_STOP_AFTER = 90                 # seconds from the closing note to stopping the run
_DOC_READ_CMD = re.compile(r"\b(?:cat|sed|head|tail|less|grep|rg)\b[^\n]*?([\w./~-]+\.md)\b")


def docs_dir(ctx):
    d = ctx.state / "docs"
    d.mkdir(parents=True, exist_ok=True)
    return d


def documenter_batches(pdir):
    """Where the documenter writes its batch files: outside ~/.claude, whose
    paths Claude Code protects from edits whatever the allow rules say
    (measured 2026-10-05: a Write rule on a ~/.claude path was still denied)."""
    d = Path.home() / ".local" / "state" / "harness" / Path(pdir).name / "batches"
    d.mkdir(parents=True, exist_ok=True)
    return d


def documenter_name(repo):
    return f"{DOCUMENTER}-{Path(repo).name}"


def docs_batches(ctx):
    """The documenter's pair batches, newest first: (path, record)."""
    d = ctx.state / "pairs"
    out = []
    for f in (d.glob("*.json") if d.is_dir() else []):
        try:
            r = json.loads(f.read_text())
        except Exception:
            continue
        if r.get("auto"):
            out.append((f, r))
    return sorted(out, key=lambda x: x[1].get("at") or "", reverse=True)


def _transcript_facts(path):
    """Reads and edits one transcript records: {"reads": [...], "edits": [...]},
    paths as the session wrote them."""
    reads, edits = set(), set()
    op = gzip.open if str(path).endswith(".gz") else open
    try:
        fh = op(path, "rt", errors="replace")
    except OSError:
        return {"reads": [], "edits": []}
    with fh:
        for line in fh:
            if '"tool_use"' not in line:
                continue
            try:
                c = (json.loads(line).get("message") or {}).get("content")
            except Exception:
                continue
            for x in (c if isinstance(c, list) else []):
                if not isinstance(x, dict) or x.get("type") != "tool_use":
                    continue
                i, n = x.get("input") or {}, x.get("name")
                if n == "Read" and i.get("file_path"):
                    reads.add(i["file_path"])
                elif n in ("Edit", "Write", "MultiEdit", "NotebookEdit") and i.get("file_path"):
                    edits.add(i["file_path"])
                elif n == "Bash":
                    reads |= set(_DOC_READ_CMD.findall(str(i.get("command") or "")))
    return {"reads": sorted(reads), "edits": sorted(edits)}


def doc_transcripts(ctx):
    """Every transcript of this project's sessions, live and swept, with its
    reads and edits, cached by mtime so a run parses only what is new."""
    enc = re.sub(r"[^A-Za-z0-9]", "-", str(ctx.repo))
    paths = list(PROJECTS.glob(f"{enc}*/*.jsonl")) if PROJECTS.is_dir() else []
    ad = archive_dir(ctx)
    paths += list(ad.glob("*/transcripts/*.jsonl.gz")) if ad.is_dir() else []
    cf = docs_dir(ctx) / "transcripts.json"
    try:
        cache = json.loads(cf.read_text())
    except Exception:
        cache = {}
    out, fresh = {}, {}
    for p in paths:
        k, m = str(p), p.stat().st_mtime
        hit = cache.get(k)
        if not hit or hit.get("mtime") != m:
            hit = dict(_transcript_facts(p), mtime=m)
        fresh[k] = hit
        out[k] = hit
    try:
        cf.write_text(json.dumps(fresh))
    except OSError:
        pass
    return out


def _rel(ctx, p):
    """A path as a session wrote it, relative to the repository: any worktree of
    this repo, live or trimmed, is a root (`<repo>-<node>/`)."""
    p = str(p)
    m = re.match(r".*?/" + re.escape(ctx.repo.name) + r"(?:-[^/]+)?/(.*)", p)
    return m.group(1) if m else p.lstrip("./")


def guard_classify(ctx, paths):
    """{path: "doc"|"code"} from the guard itself (`_guard --classify`). Never a
    reimplementation of its matcher. Empty when the guard is absent."""
    guard = ctx.repo / ".harness/hooks/_guard"
    paths = [p for p in paths if p]
    if not paths or not guard.exists():
        return {}
    r = subprocess.run([str(guard), "--classify"], input="\n".join(paths) + "\n",
                       capture_output=True, text=True, cwd=str(ctx.repo),
                       env=dict(os.environ, HARNESS_BRANCH=getattr(ctx, "branch", "")))
    out = {}
    for l in r.stdout.splitlines():
        k, _, v = l.partition(" ")
        if k in ("doc", "code"):
            out[v] = k
    return out


def doc_files(ctx):
    """The project's markdown documents: tracked .md files the manifest calls docs,
    classified by the guard itself, never a reimplementation of its matcher."""
    rc, out, _ = git("ls-files", "*.md", cwd=ctx.repo)
    paths = [p for p in out.splitlines() if p]
    cls = guard_classify(ctx, paths)
    docs = [p for p in paths if cls.get(p) == "doc"]
    return docs or paths


def docs_areas(ctx):
    try:
        return json.loads((docs_dir(ctx) / "areas.json").read_text())
    except Exception:
        return {}


def docs_ledger(ctx):
    out = []
    try:
        for line in (docs_dir(ctx) / "ledger.jsonl").read_text().splitlines():
            try:
                out.append(json.loads(line))
            except Exception:
                pass
    except OSError:
        pass
    return out


def docs_rulings(ctx):
    try:
        return json.loads((docs_dir(ctx) / "rulings.json").read_text())
    except Exception:
        return []


def docs_measure(ctx):
    """The snapshot a documenter run starts from (design/documenter.md)."""
    docs = doc_files(ctx)
    texts = {}
    for d in docs:
        try:
            texts[d] = (ctx.repo / d).read_text(errors="replace")
        except OSError:
            pass
    runs = sorted((docs_dir(ctx) / "runs").glob("*.json")) if (docs_dir(ctx) / "runs").is_dir() else []
    last = None
    if runs:
        try:
            last = json.loads(runs[-1].read_text())
        except Exception:
            last = None
    since = (last or {}).get("at")
    # Writes: commits per doc since the last snapshot, and when each was last touched.
    writes = {}
    if since:
        _, out, _ = git("log", f"--since={since}", "--name-only", "--format=", "--", *texts,
                        cwd=ctx.repo)
        for l in out.splitlines():
            if l:
                writes[l] = writes.get(l, 0) + 1
    _, out, _ = git("log", "--name-only", "--format=@%ct", "--", *texts, cwd=ctx.repo)
    touched, t = {}, None
    for l in out.splitlines():
        if l.startswith("@"):
            t = int(l[1:])
        elif l and l not in touched:
            touched[l] = t
    # Reads and edits, per session transcript.
    trs = doc_transcripts(ctx)
    reads = {d: 0 for d in texts}
    by_name = {}
    for d in texts:
        by_name.setdefault(Path(d).name, []).append(d)
    sessions = []
    for tr in trs.values():
        rr = {_rel(ctx, p) for p in tr["reads"]}
        got = set()
        for r in rr:
            if r in reads:
                got.add(r)
            elif len(by_name.get(Path(r).name, [])) == 1:
                got.add(by_name[Path(r).name][0])     # read through a relative or partial path
        for d in got:
            reads[d] += 1
        sessions.append((got, {_rel(ctx, p) for p in tr["edits"]}))
    # Pointers: which docs (and open briefs) name each doc.
    briefs = [json.dumps(b) for k, b in all_briefs(ctx).items()
              if not superseded(b) and task_state(ctx, b.get("task") or k) not in ("closed", "superseded")]
    pin, pout = {d: 0 for d in texts}, {d: 0 for d in texts}
    for d in texts:
        for o, t2 in texts.items():
            if o != d and (d in t2 or (len(Path(d).name) >= 8 and Path(d).name in t2)):
                pin[d] += 1; pout[o] += 1
        pin[d] += sum(1 for b in briefs if d in b)
    cites = cited(ctx, [str(ctx.repo / d) for d in texts])
    cited_by = {d: len(cites.get(str(ctx.repo / d)) or []) for d in texts}
    # Reach: of the sessions that edited an area, how many read its doc.
    reach = {}
    for area, doc in docs_areas(ctx).items():
        ed = [got for got, edits in sessions if any(fnmatch.fnmatch(e, area) for e in edits)]
        reach[area] = {"doc": doc, "editors": len(ed), "read": sum(1 for g in ed if doc in g)}
    # Moved text: is it still reached? For each applied documenter move, the
    # sessions that read its destination among transcripts newer than the apply
    # (obs 77: what leaves an always-loaded file is one hop away afterwards).
    moved = []
    for _, r in docs_batches(ctx):
        t0 = _epoch(r.get("applied_at"))
        if not t0:
            continue
        for x in r.get("pairs") or []:
            if x.get("op") != "move":
                continue
            later = [tr for tr in trs.values() if (tr.get("mtime") or 0) > t0]
            hits = sum(1 for tr in later if any(_rel(ctx, p2) == x["to"] or
                                                Path(p2).name == Path(x["to"]).name
                                                for p2 in tr["reads"]))
            moved.append({"to": x["to"], "from": x["file"], "since": r.get("applied_at"),
                          "read": hits, "sessions": len(later),
                          "provenance": x["to"].startswith("provenance/")})
    cap = claude_md_budget(ctx)
    now = time.time()
    snap = {"moved": moved,"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "budget": cap,
            "claude_md": words(texts.get("CLAUDE.md")),
            "transcripts": len(trs), "reach": reach,
            "docs": {d: {"words": words(t2), "reads": reads[d], "writes": writes.get(d, 0),
                         "pointers_in": pin[d], "pointers_out": pout[d],
                         "cited": cited_by[d],
                         "idle_days": (int((now - touched[d]) / 86400) if touched.get(d) else None)}
                     for d, t2 in texts.items()}}
    snap["gaps"] = docs_gaps(snap)
    snap["previous"] = {"at": since, "claude_md": (last or {}).get("claude_md")} if last else None
    return snap


def docs_gaps(snap):
    """The gaps the numbers show, largest first: (job, target, why)."""
    out = []
    cap, cm = snap.get("budget"), snap.get("claude_md") or 0
    if cap and cm > cap:
        out.append(("budget", "CLAUDE.md", f"{cm:,} words, budget {cap:,}", cm - cap))
    for area, r in snap["reach"].items():
        if r["editors"] >= 2 and r["read"] < 0.75 * r["editors"]:
            out.append(("reach", area, f"{r['read']} of {r['editors']} sessions that edited "
                                       f"{area} read {r['doc']}", 5000 * (r["editors"] - r["read"])))
    for d, r in snap["docs"].items():
        if d == "CLAUDE.md":
            continue
        if r["writes"] >= 3 and r["reads"] == 0:
            out.append(("consolidate", d, f"written {r['writes']}x since the last run, never read",
                        r["words"]))
        if (not r["cited"] and not r["pointers_in"] and not r["reads"]
                and (r["idle_days"] or 0) >= DOC_STALE_DAYS):
            out.append(("stale", d, f"{r['words']:,} words; no reads, no pointers, no open record; "
                                    f"untouched {r['idle_days']}d", r["words"]))
        if r["words"] > 15000 and r["reads"]:
            out.append(("clarity", d, f"{r['words']:,} words and read {r['reads']}x: split or trim",
                        r["words"] // 2))
    return [g[:3] for g in sorted(out, key=lambda g: -g[3])]


def cmd_docs(a):
    """`harness docs measure|map|note`: the documenter's instruments (T18)."""
    ctx = Ctx(); ctx.require_enrolled()
    if a.verb == "map":
        m = docs_areas(ctx)
        if not a.args:
            for k, v in sorted(m.items()):
                print(f"  {k:<28} {v}")
            print(f"{len(m)} area(s)" if m else "no areas mapped — harness docs map <area-glob> <doc>")
            return
        if a.remove:
            m.pop(a.args[0], None)
        elif len(a.args) == 2:
            if not (ctx.repo / a.args[1]).is_file():
                die(REFUSED, f"no such doc: {a.args[1]}")
            m[a.args[0]] = a.args[1]
        else:
            die(REFUSED, "harness docs map <area-glob> <doc>, or <area-glob> --remove")
        (docs_dir(ctx) / "areas.json").write_text(json.dumps(m, indent=1) + "\n")
        print(f"{len(m)} area(s) mapped")
        return
    if a.verb == "note":
        text = " ".join(a.args).strip()
        if not text:
            die(REFUSED, 'say what this run did: harness docs note "..."')
        with open(docs_dir(ctx) / "ledger.jsonl", "a") as fh:
            fh.write(json.dumps({"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                                 "job": os.environ.get("HARNESS_DOCUMENTER_JOB") or "",
                                 "note": text}) + "\n")
        print("noted")
        sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
        pend = [r for r in docs_pending(ctx) if r.get("session") in (None, sid)]
        if os.environ.get("HARNESS_DOCUMENTER") == "1" and sid and pend:
            # The run isn't over until rank 0 has decided its batch (owner,
            # 2026-10-05): the session waits, and the decision closes it or, on a
            # decline, wakes it with the reason to fix what it sent.
            print(f"{pend[-1]['task']} waits on rank 0's review. You are woken with the "
                  f"decision; end your turn now with a short summary.")
            return
        # Nothing waits on review: the run is over. Its session would otherwise
        # sit idle until the next run replaced it, reading as still running; stop
        # it once its closing reply has had time to land.
        if os.environ.get("HARNESS_DOCUMENTER") == "1" and sid:
            # Then the next run of a chain, if one is due (`documenter --runs N`).
            env = {k: v for k, v in os.environ.items()
                   if k not in ("CLAUDE_CODE_SESSION_ID", "HARNESS_DOCUMENTER",
                                "HARNESS_DOCUMENTER_JOB")}
            nxt = " ".join(shlex.quote(x) for x in (sys.executable, str(Path(__file__).resolve()),
                                                    "documenter", project_arg(ctx.state),
                                                    "--next"))
            with open(docs_dir(ctx) / "chain.log", "a") as log:
                subprocess.Popen(["sh", "-c", f"sleep {DOC_STOP_AFTER}; claude stop {sid[:8]}; "
                                              f"exec {nxt}"],
                                 stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                                 env=env, start_new_session=True)
            print(f"this session stops in {DOC_STOP_AFTER}s; end your turn with a short summary")
        return
    if a.verb != "measure":
        die(REFUSED, "harness docs measure | map | note")
    snap = docs_measure(ctx)
    rd = docs_dir(ctx) / "runs"
    rd.mkdir(exist_ok=True)
    sf = rd / f"{time.strftime('%Y%m%d-%H%M%S')}.json"
    sf.write_text(json.dumps(snap, indent=1) + "\n")
    if a.json:
        print(json.dumps(snap, indent=1)); return
    prev = snap.get("previous") or {}
    total = sum(r["words"] for r in snap["docs"].values())
    print(f"{len(snap['docs'])} docs, {total:,} words; {snap['transcripts']} transcripts read")
    print(f"CLAUDE.md {snap['claude_md']:,} words"
          + (f" (budget {snap['budget']:,})" if snap["budget"] else " (no budget set)")
          + (f"; was {prev['claude_md']:,} at {prev['at'][:16]}" if prev.get("claude_md") else ""))
    if snap["reach"]:
        print("reach:")
        for area, r in sorted(snap["reach"].items()):
            print(f"  {area:<24} {r['read']}/{r['editors']} editors read {r['doc']}")
    else:
        print("reach: no areas mapped — harness docs map <area-glob> <doc>")
    if snap.get("moved"):
        print("moved text, read since it moved:")
        for m in snap["moved"][:8]:
            print(f"  {m['to']:<40} {m['read']}/{m['sessions']} sessions since "
                  f"{(m['since'] or '')[11:16]}" + ("  (provenance: rarely read by design)"
                                                   if m["provenance"] else ""))
    print("gaps, largest first:")
    for job, target, why in snap["gaps"][:8] or [("-", "none", "")]:
        print(f"  {job:<12} {target}  — {why}")
    ref = [(r["task"], r.get("refused")) for _, r in docs_batches(ctx) if r.get("refused")][:3]
    for t, why in ref:
        print(f"refused  {t}: {why[:120]}")
    for r in docs_rulings(ctx)[-5:]:
        print(f"ruling   {r.get('question', '')[:60]} → {r.get('answer', '')[:80]}")
    led = docs_ledger(ctx)
    if led:
        print(f"last run {led[-1]['at'][:16]}: {led[-1]['note'][:110]}")
    print(f"snapshot {sf}")


def docs_notices(ctx):
    """Rank 0's one-shot lines about the documenter's applied or refused batches."""
    out = {}
    try:
        for f, r in docs_batches(ctx):
            if r.get("told") or not (r.get("applied") or r.get("refused")):
                continue
            if r.get("applied"):
                cm = r.get("claude_md")
                out[f"docs:{r['task']}"] = (
                    f"documenter applied {r['task']} in {r['applied'][:8]}"
                    + (f": CLAUDE.md {cm[0]:,} → {cm[1]:,} words" if cm else ""))
            else:
                out[f"docs:{r['task']}"] = (f"documenter batch {r['task']} was refused: "
                                            f"{r['refused'][:90]}")
    except Exception:
        pass
    return out


def docs_consume(ctx, ids):
    for k in ids:
        if k.startswith("docs:"):
            f = pairs_path(ctx, k.split(":", 1)[1])
            try:
                r = json.loads(f.read_text())
                r["told"] = True
                f.write_text(json.dumps(r, indent=2) + "\n")
            except Exception:
                pass


def _detached(ctx, args, log, cwd):
    env = {k: v for k, v in os.environ.items()
           if k not in ("CLAUDE_CODE_SESSION_ID", "HARNESS_DOCUMENTER")}
    with open(log, "a") as fh:
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), *args], cwd=str(cwd),
                         env=env, stdout=fh, stderr=subprocess.STDOUT,
                         stdin=subprocess.DEVNULL, start_new_session=True)


def docs_pending(ctx):
    """Documenter batches waiting on rank 0's review, oldest first."""
    return sorted((r for _, r in docs_batches(ctx)
                   if not r.get("applied") and not r.get("refused")),
                  key=lambda r: r.get("at") or "")


DOC_REVISIONS = 1          # a declined batch may be fixed and resent this many times per run


def docs_decided(ctx, rec):
    """Rank 0 has decided a documenter batch: the run that sent it is over, or,
    on a decline, it is woken with the reason to fix it (once per run). Over
    means its session is closed and the next run of a chain may start."""
    try:
        sid = rec.get("session")
        declined = [r for _, r in docs_batches(ctx)
                    if sid and r.get("session") == sid and r.get("refused")]
        if rec.get("refused") and sid and len(declined) <= DOC_REVISIONS:
            why = (f"Rank 0 declined {rec['task']}: {rec['refused']}\n\nFix what it names and "
                   f"submit a new batch (then send rank 0 the message submit prints, and "
                   f"`harness docs note` again). If it can't be fixed, `harness docs note` that "
                   f"you are leaving it, and why.")
            _detached(ctx, ["documenter", project_arg(ctx.state), "--wake", why],
                      docs_dir(ctx) / "chain.log", ctx.repo)
            return
        if docs_pending(ctx):
            return                  # another batch of the run still waits
        _detached(ctx, ["documenter", project_arg(ctx.state), "--finish"],
                  docs_dir(ctx) / "chain.log", ctx.repo)
    except Exception:
        pass


def documenter_wake(pdir, repo, why):
    """Resume the run's session with `why` as its next prompt (no flags: a
    background session keeps its saved options; any flag starts a copy)."""
    name = documenter_name(repo)
    try:
        rows = roster_all()
    except Exception as e:
        return False, f"cannot read the session list: {e}"
    mine = [r for r in rows if r.get("name") == name and r.get("sessionId")]
    if not mine:
        return False, "no documenter session to wake"
    when = lambda r: r.get("startedAt") if isinstance(r.get("startedAt"), (int, float)) else 0
    r = max(mine, key=when)
    live = r in live_rows(rows)
    if live and r.get("status") == "busy":
        return False, f"{name} is working"
    env = {k: v for k, v in os.environ.items()
           if k not in ("CLAUDE_CODE_SESSION_ID", "HARNESS_DOCUMENTER", "HARNESS_DOCUMENTER_JOB")}
    if live:
        subprocess.run(["claude", "stop", r["sessionId"][:8]], capture_output=True)
    home = Path(pdir) / "documenter"
    x = subprocess.run(["claude", "--bg", "--resume", r["sessionId"], why], cwd=str(home),
                       env=env, capture_output=True, text=True)
    return (not x.returncode), (f"woke {name}" if not x.returncode
                                else f"did not wake: {(x.stderr or x.stdout).strip()[:200]}")


def documenter_finish(pdir, repo):
    """The run is over: close its session, then start the next run of a chain."""
    name = documenter_name(repo)
    try:
        rows = roster_all()
    except Exception as e:
        print(f"cannot read the session list: {e}"); return
    live = {r.get("sessionId") for r in live_rows(rows)}
    for r in rows:
        if r.get("name") == name and r.get("sessionId") in live:
            if r.get("status") == "busy":
                print(f"{name} is working; it finishes at its next note"); return
            subprocess.run(["claude", "stop", r["sessionId"][:8]], capture_output=True)
            print(f"stopped {name}")


def docs_apply_step(ctx, node):
    """Rank 0's Stop hook: start a documenter run when one is due. It never
    applies a batch: rank 0 reviews each one (owner, 2026-10-05)."""
    if ctx.rank(node) != 0 or docs_pending(ctx):
        return False
    return docs_trigger(ctx)


def docs_due(ctx):
    """Why a documenter run is due now, or None."""
    try:
        man = json.loads((ctx.repo / ".harness" / "manifest.json").read_text())
    except Exception:
        man = {}
    if man.get("documenter") is False:
        return None
    cap = claude_md_budget(ctx)
    try:
        cm = words((ctx.repo / "CLAUDE.md").read_text())
    except OSError:
        cm = 0
    if cap and cm > cap:
        return f"CLAUDE.md is {cm:,} words, over its budget of {cap:,}"
    if any("budget" in (r.get("refused") or "") and not r.get("told")
           for _, r in docs_batches(ctx)):
        return "a batch was refused over the CLAUDE.md budget"
    led = docs_ledger(ctx)
    last = _epoch(led[-1]["at"]) if led else None
    if last and time.time() - last > 7 * 86400 and any(
            (_epoch(e.get("at")) or 0) > last for e in ledger(ctx) if not e.get("kept")):
        return "a week since the last run, and units have been swept since"
    return None


def docs_trigger(ctx):
    """Start a documenter run when one is due: at most once a day, never beside
    a live one."""
    mark = docs_dir(ctx) / "last_trigger"
    try:
        if time.time() - mark.stat().st_mtime < DOC_TRIGGER_GAP:
            return False
    except OSError:
        pass
    why = docs_due(ctx)
    if not why:
        return False
    mark.write_text(json.dumps({"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "why": why}) + "\n")
    _detached(ctx, ["documenter", "--job", "auto", "--why", why],
              docs_dir(ctx) / "launch.log", ctx.repo)
    return True


def documenter_prompt(pdir):
    """Its system prompt: its skill, the owner's Voice section, and the two
    writing skills' own SKILL.md (--restricted loads no user skills)."""
    home = Path.home() / ".claude"
    parts = [(home / "skills" / DOCUMENTER / "SKILL.md").read_text()]
    try:
        g = (home / "CLAUDE.md").read_text()
        m = re.search(r"^## Voice\n(.*?)(?=^## |\Z)", g, re.S | re.M)
        if m:
            parts.append("# The owner's voice (from their CLAUDE.md)\n" + m.group(1).strip())
    except Exception:
        pass
    for sk in DOCUMENTER_WRITING:
        f = home / "skills" / sk / "SKILL.md"
        if f.exists():
            parts.append(f"# Writing skill: {sk} (its other files are in {f.parent})\n"
                         + f.read_text())
    out = Path(pdir) / "documenter" / "prompt.md"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text("\n\n".join(parts) + "\n")
    return out


def documenter_cmd(pdir, repo, job="auto", model=None, effort=None, why=None):
    """One project's documenter `claude --bg` line. Read-only like the
    intermediary; its one write path is `harness pairs submit`."""
    pdir = Path(pdir)
    dirs, repos = [str(pdir)], []
    cand = [repo]
    try:
        idx = json.loads((pdir / "index.json").read_text())
        cand += [sp.get("worktree") for sp in (idx.get("nodes") or {}).values()]
    except Exception:
        pass
    for d in cand:
        if d and d not in dirs and Path(d).is_dir():
            dirs.append(d); repos.append(d)
    for sk in DOCUMENTER_WRITING:
        d = str(Path.home() / ".claude" / "skills" / sk)
        if Path(d).is_dir() and d not in dirs:
            dirs.append(d)
    # A batch goes in as a file it writes into its own folder. Piped in through a
    # heredoc, any JSON object in the body was denied by the permission check
    # (measured 2026-10-05: `[]` passed, `[{"x": "a b"}]` did not), so the first
    # live run could not submit anything. Write is allowed there and nowhere else.
    batches = documenter_batches(pdir)
    dirs.append(str(batches))
    allow = ["Bash(harness docs *)", "Bash(harness pairs submit *)",
             "Bash(harness cited *)", "Bash(harness ask *)",
             f"Write(/{batches}/**)", f"Edit(/{batches}/**)"]
    for d in repos:
        for q in ('"', "'") + (("",) if " " not in d else ()):
            allow += [f"Bash(git -C {q}{d}{q} {g} *)" for g in INTERMEDIARY_GIT]
    model = model or DOC_DEFAULTS.get(job, DOC_DEFAULT)[0]
    effort = effort or DOC_DEFAULTS.get(job, DOC_DEFAULT)[1]
    # Its identity goes in through --settings: a background session does not
    # inherit the launching process's environment (measured 2026-10-05).
    env = {"HARNESS_DOCUMENTER": "1", "HARNESS_PROJECT": pdir.name,
           "HARNESS_DOCUMENTER_JOB": job, "HARNESS_DOCUMENTER_MODEL": model}
    cmd = ["claude", "--bg", "-n", documenter_name(repo), "--restricted", "--strict-mcp-config",
           "--settings", json.dumps({"env": env}),
           "--add-dir", *dirs,
           "--tools", *INTERMEDIARY_TOOLS, "Write",
           "--allowedTools", *allow,
           "--permission-mode", "dontAsk",
           "--append-system-prompt-file", str(documenter_prompt(pdir)),
           "--model", model, "--effort", effort]
    return cmd + [documenter_start(repo, job, why)]


def documenter_start(repo, job, why=None):
    return (f"You are the harness documenter for {Path(repo).name}; your instructions are in "
            f"your system prompt. This run's job: {job}"
            + (f" (started because {why})" if why else "") + ". Start now: run "
            f"`harness docs measure`, pick the one improvement it points to"
            + ("" if job == "auto" else f" within '{job}'")
            + f", write the batch to {documenter_batches(HOME_STATE / slug(Path(repo)))}/"
              "<name>.json and submit it with `harness pairs submit <that path>`, send "
              "rank 0 the SendMessage that submit prints, then `harness docs note` what you did. The last run's note may name a change it "
              "planned and couldn't submit: if so, make that one. "
              "Then end your turn: the run waits for rank 0's review. An applied batch "
              "closes it; a declined one wakes you with the reason to fix it.")


def docs_queue(pdir, **upd):
    """How many more runs follow the current one: {remaining, job, by, at}."""
    f = Path(pdir) / "docs" / "queue.json"
    try:
        q = json.loads(f.read_text())
    except Exception:
        q = {"remaining": 0, "job": "auto"}
    if upd:
        q.update(upd, at=time.strftime("%Y-%m-%dT%H:%M:%S%z"))
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(json.dumps(q) + "\n")
    return q


def project_arg(pdir):
    """`--project=<slug>`: a state slug starts with "-" (the repo path with its
    slashes as dashes), so `--project <slug>` reads it as a flag (2026-10-05:
    the GUI's start button and every chained run failed on this)."""
    return f"--project={Path(pdir).name}"


def documenter_launch(pdir, repo, job, model=None, effort=None, why=None):
    """Start one run. (ok, message). A busy run refuses; an idle one has
    finished (its stop is pending) and is replaced."""
    name = documenter_name(repo)
    try:
        rows = agents_json()
    except Exception as e:
        return False, f"cannot read the session list: {e}"
    mine = [r for r in live_rows(rows) if r.get("name") == name]
    if any(r.get("status") == "busy" for r in mine):
        return False, f"{name} is working; one run at a time per project"
    for r in rows:                  # the last run, off the list: a fresh one replaces it
        if r.get("name") == name and r.get("sessionId"):
            if r in mine:
                subprocess.run(["claude", "stop", r["sessionId"][:8]], capture_output=True)
            claude_rm(r["sessionId"])
    home = Path(pdir) / "documenter"
    home.mkdir(parents=True, exist_ok=True)
    env = {k: v for k, v in os.environ.items()
           if k not in ("CLAUDE_CODE_SESSION_ID", "HARNESS_DOCUMENTER", "HARNESS_DOCUMENTER_JOB")}
    r = subprocess.run(documenter_cmd(pdir, repo, job, model, effort, why), cwd=str(home),
                       env=env, capture_output=True, text=True)
    if r.returncode:
        return False, f"the documenter did not start: {(r.stderr or r.stdout).strip()[:200]}"
    return True, f"started {name} ({job})"


def documenter_pending(pdir):
    """Batches still waiting to apply: the next run must measure the text they
    leave, or its pairs go stale."""
    n = 0
    for f in (Path(pdir) / "pairs").glob("*.json") if (Path(pdir) / "pairs").is_dir() else []:
        try:
            r = json.loads(f.read_text())
        except Exception:
            continue
        n += bool(r.get("auto") and not r.get("applied") and not r.get("refused"))
    return n


def _next_run(pdir, repo):
    """The next run of a `--runs N` chain, once nothing waits on review."""
    q = docs_queue(pdir)
    if (q.get("remaining") or 0) <= 0:
        print("no runs left"); return
    if documenter_pending(pdir):
        print("a batch waits on rank 0's review; the next run starts when it is decided")
        return
    docs_queue(pdir, remaining=q["remaining"] - 1)
    ok, msg = documenter_launch(pdir, repo, q.get("job") or "auto")
    print(msg if ok else f"refused: {msg}")
    if not ok:
        docs_queue(pdir, remaining=q["remaining"])


def cmd_documenter(a):
    """Start documenter runs for a project, in the background (T18). `--runs N`
    chains N runs, each starting once the last one's batches have applied;
    `--stop` lets the current run finish and starts no more."""
    pdir, repo = intermediary_project(a.project)
    if a.print_cmd:
        print(" ".join(shlex.quote(c) for c in documenter_cmd(pdir, repo, a.job, a.model,
                                                              a.effort, a.why))); return
    if a.wake:
        ok, msg = documenter_wake(pdir, repo, a.wake)
        print(msg)
        if not ok:
            documenter_finish(pdir, repo)
            _next_run(pdir, repo)
        return
    if a.finish:
        documenter_finish(pdir, repo)
        _next_run(pdir, repo)
        return
    if a.stop:
        q = docs_queue(pdir)
        docs_queue(pdir, remaining=0, by="stop")
        print(f"no more runs after the current one ({q.get('remaining', 0)} cancelled)")
        return
    if a.next:
        # Launched by a run that ended with nothing to review, detached.
        _next_run(pdir, repo); return
    runs = max(1, min(a.runs or 1, 20))
    ok, msg = documenter_launch(pdir, repo, a.job, a.model, a.effort, a.why)
    if not ok and "is working" in msg:
        # A run is under way: the runs asked for follow it, chained from its note.
        docs_queue(pdir, remaining=runs, job=a.job, by="queued")
        print(f"a run is working; {runs} more run(s) will follow it, each once the last "
              f"one's batches apply")
        return
    if not ok:
        die(REFUSED, msg)
    docs_queue(pdir, remaining=runs - 1, job=a.job, by="start")
    print(msg + (f"; {runs - 1} more run(s) follow, each once the last one's batches apply"
                 if runs > 1 else "") + ". `harness docs measure` shows what it will see")


# ── the doorbell: waking an idle session without a resume ────────────────────
#
# Nothing outside a session can message it, and a resume re-reads its whole
# context. So each node session keeps `harness doorbell` running in the
# background. It sleeps; it exits when something needs the session (a `ring`, or
# a node that has waited on this idle one too long), and Claude Code wakes a
# session when its background command exits (measured 2026-10-05: an idle
# background session took a turn 19s after its shell ended). The session reads
# why with `harness doorbell --read`, acts, and arms it again.

DOORBELL_TICK = 10              # seconds between inbox checks
NUDGE_AFTER = 300               # a wait, and the waited-on node's quiet, before a nudge


def bell_dir(ctx, node):
    d = ctx.state / "doorbell" / node
    (d / "inbox").mkdir(parents=True, exist_ok=True)
    return d


def bell_armed(ctx, node, sid=None):
    """The armed doorbell's record, if its process is alive (and, with `sid`,
    if it belongs to that session)."""
    try:
        a = json.loads((bell_dir(ctx, node) / "armed.json").read_text())
    except Exception:
        return None
    if sid and a.get("session") != sid:
        return None
    try:
        os.kill(int(a.get("pid")), 0)
        if "doorbell" not in Path(f"/proc/{a['pid']}/cmdline").read_text(errors="replace"):
            return None
    except Exception:
        return None
    return a


def cached_roster(ctx, max_age=30):
    """The live roster, shared between doorbells so seven sessions polling do
    not each pay for `claude agents` every minute."""
    f = ctx.state / "doorbell" / "roster.json"
    try:
        if time.time() - f.stat().st_mtime < max_age:
            return json.loads(f.read_text())
    except Exception:
        pass
    rows = live_rows(agents_json())
    try:
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(json.dumps(rows))
    except OSError:
        pass
    return rows


def waiters_on(ctx, node, rows):
    """Nodes waiting on `node`, recorded or read off their transcripts:
    [(waiter, seconds waited, what it said, key)]."""
    idx = load_index(ctx)
    bw = idx.get("byWorktree") or {}
    out = []
    for w, r in open_waits(ctx).items():
        if r.get("parent") == node:
            since = _epoch(r.get("since"))
            out.append((w, time.time() - since if since else 0, r.get("asked") or "",
                        f"rec:{w}:{r.get('since')}"))
    for r in stopped_rows(rows):
        w = bw.get(r.get("cwd", ""))
        if not w or w in open_waits(ctx):
            continue
        st = stop_detail(r, rows)
        if not st or st["kind"] != "reply":
            continue
        on = ((idx.get("nodes") or {}).get(w) or {}).get("parent") if st["on"] == LAUNCHED else \
            next((bw.get(x.get("cwd", "")) for x in rows if x.get("name") == st["on"]), None)
        if on != node:
            continue
        age, _ = last_turn(r.get("sessionId") or "")
        out.append((w, age or 0, st.get("said") or "", f"inf:{w}:{int(time.time() - (age or 0)) // 60}"))
    return out


def bell_nudge(ctx, node, sid):
    """A message when this node's own session is idle and someone has waited on
    it past NUDGE_AFTER, once per wait. None otherwise."""
    rows = cached_roster(ctx)
    me = next((r for r in rows if r.get("sessionId") == sid), None)
    if not me or me.get("status") == "busy":
        return None
    quiet, _ = last_turn(sid)
    if (quiet or 0) < NUDGE_AFTER:
        return None
    tf = bell_dir(ctx, node) / "told.json"
    try:
        told = set(json.loads(tf.read_text()))
    except Exception:
        told = set()
    due = [w for w in waiters_on(ctx, node, rows) if w[1] >= NUDGE_AFTER and w[3] not in told]
    if not due:
        return None
    tf.write_text(json.dumps(sorted(told | {w[3] for w in due})))
    names = {bw: r.get("name") for r in rows
             for bw in [(load_index(ctx).get("byWorktree") or {}).get(r.get("cwd", ""))] if bw}
    return "\n".join(
        f"{w} has been waiting on you for {int(age // 60)}m"
        + (f": {said[:160]}" if said else "")
        + f". Answer it (SendMessage to '{names.get(w, w)}'), or record why it waits."
        for w, age, said, _ in due)


def cmd_doorbell(a):
    """`harness doorbell`: run it in the background (run_in_background). It exits
    when this session is needed; `--read` says why. Arm it again after."""
    ctx = Ctx(); ctx.require_enrolled()
    node, _ = ctx.node()
    d = bell_dir(ctx, node)
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    if a.read:
        f = d / "last.json"
        if not f.exists():
            print("nothing has rung"); return
        for m in json.loads(f.read_text()):
            print(f"{m.get('at', '')[:16]}  from {m.get('from') or '?'}: {m.get('text')}")
        f.unlink()
        print("\nArm it again: harness doorbell  (run_in_background)")
        return
    if a.status:
        arm = bell_armed(ctx, node)
        print(f"armed by session {arm['session'][:8]} since {arm['at'][:16]}" if arm
              else "not armed — harness doorbell, with run_in_background")
        return
    if not sid:
        die(REFUSED, "the doorbell belongs to a session: run it from one, in the background")
    (d / "armed.json").write_text(json.dumps({"pid": os.getpid(), "session": sid,
                                              "at": time.strftime("%Y-%m-%dT%H:%M:%S%z")}))
    last_nudge = 0
    while True:
        try:
            if json.loads((d / "armed.json").read_text()).get("pid") != os.getpid():
                print("replaced by a newer doorbell"); return
        except Exception:
            return
        msgs = []
        for f in sorted((d / "inbox").glob("*.json")):
            try:
                msgs.append(json.loads(f.read_text()))
            except Exception:
                pass
            f.unlink(missing_ok=True)
        if not msgs and time.time() - last_nudge > 60:
            last_nudge = time.time()
            try:
                text = bell_nudge(ctx, node, sid)
            except Exception:
                text = None
            if text:
                msgs.append({"from": "harness", "text": text,
                             "at": time.strftime("%Y-%m-%dT%H:%M:%S%z")})
        if msgs:
            f = d / "last.json"
            old = json.loads(f.read_text()) if f.exists() else []
            f.write_text(json.dumps(old + msgs))
            (d / "armed.json").unlink(missing_ok=True)
            print(f"rang: {len(msgs)} message(s). Read them: harness doorbell --read")
            return
        time.sleep(DOORBELL_TICK)


def ring_inbox(state, node, frm, text):
    """Leave a message at a node's doorbell; an armed one wakes its session."""
    d = Path(state) / "doorbell" / node / "inbox"
    d.mkdir(parents=True, exist_ok=True)
    (d / f"{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}-{time.time_ns() % 10**6}.json"
     ).write_text(json.dumps({"from": frm, "text": text, "at": _now()}))


def cmd_ring(a):
    """`harness ring <node> "..."`: wake a node's session through its doorbell."""
    ctx = Ctx(); ctx.require_enrolled()
    if a.node not in ctx.tree["nodes"]:
        die(REFUSED, f"'{a.node}' is not a node")
    text = " ".join(a.text).strip()
    if not text:
        die(REFUSED, 'say why: harness ring <node> "..."')
    me = None
    try:
        me, _ = ctx.node()
    except SystemExit:
        pass
    me = me or ("documenter" if os.environ.get("HARNESS_DOCUMENTER") == "1" else "operator")
    ring_inbox(ctx.state, a.node, me, text)
    print(f"rang {a.node}" if bell_armed(ctx, a.node) else
          f"{a.node}'s doorbell is not armed; it reads this when it next arms one")



def main():
    # `gui` is handed off before argparse sees anything. The viewer has its own
    # flags and argparse.REMAINDER does not reliably pass a leading `--flag`
    # through a subparser, so the choice is a wrapper that silently drops
    # arguments or one that never inspects them. This never inspects them.
    if len(sys.argv) > 1 and sys.argv[1] == "gui":
        exe = Path(__file__).resolve().with_name("harness-gui")
        if not exe.exists():
            die(CONTRACT, f"{exe} is missing — re-run install.sh")
        os.execv(sys.executable, [sys.executable, str(exe)] + sys.argv[2:])
    p = argparse.ArgumentParser(
        prog="harness", description=__doc__.splitlines()[0],
        epilog="ANY long argument may be '-', which reads it from stdin. Use it "
               "for prose containing backticks or $(): a shell substitutes those "
               "away before this program runs, and the result is a shorter string "
               "that reports success.\n"
               "  harness brief x --for y --write - <<'EOF' ... EOF\n\n"
               "gui  a read-only viewer of every tree on this machine; "
               "its own flags are passed straight through (harness gui --help)")
    sub = p.add_subparsers(dest="cmd", required=True)
    def add(name, fn, roster=False, force=False):
        s = sub.add_parser(name); s.set_defaults(fn=fn)
        if roster: s.add_argument("--roster", metavar="FILE", help="ListAgents output, or - for stdin")
        if force: s.add_argument("--force", action="store_true")
        return s
    add("contract", cmd_contract, roster=True)
    wh = add("whoami", cmd_whoami, roster=True)
    wh.add_argument("--no-check", action="store_true", help="skip the R7 name assertion")
