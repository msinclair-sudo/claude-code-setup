    br.add_argument("--history", action="store_true",
                    help="the revisions this brief replaced, newest first")
    ch = add("charter", cmd_charter)
    ch.add_argument("--feature", metavar="NAME", help="read or write one feature")
    ch.add_argument("--write", metavar="TEXT",
                    help="the project description, or a feature's with --feature. "
                         "'-' reads it from stdin")
    ch.add_argument("--move", choices=["up", "down"],
                    help="reorder a feature among its siblings")
    ch.add_argument("--promote", action="store_true",
                    help="lift a sub-feature to a feature of its own")
