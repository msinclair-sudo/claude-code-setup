def _wait_mins(since):
    try:
        t = time.mktime(time.strptime((since or "")[:19], "%Y-%m-%dT%H:%M:%S"))
    except Exception:
        return 0
    return int(max(0, time.time() - t) // 60)


def read_state():
    rows, roster_error = roster()
    att = []
    # A LIST per worktree, not one session. Two sessions in one worktree is the
    # condition the statusline colours red; a dict keyed on cwd silently kept the
    # last one and reported the breach as normal occupancy.
    by_cwd = {}
    for r in (rows or []):
        by_cwd.setdefault(r.get("cwd"), []).append(r)
    needs = CLI.scan_needs()
    projects = []
    for pdir in sorted(p for p in CLI.HOME_STATE.glob("*") if p.is_dir()):
        b = pdir / "binding.json"
        if not b.exists():
            continue
        try:
            repo = json.loads(b.read_text()).get("repo", "")
        except Exception:
            continue
        # tree.json is the truth; index.json only supplies worktree paths, and a
        # node the index has not caught up with is shown rather than hidden.
        tp = Path(repo) / ".harness" / "tree.json"
        if not tp.exists():
            continue
        try:
            tree = json.loads(tp.read_text()).get("nodes", {})
        except Exception:
            continue
        idx = {}
        ip = pdir / "index.json"
        if ip.exists():
            try:
                idx = json.loads(ip.read_text())
            except Exception:
                idx = {}
        wt_of = {n: s.get("worktree") for n, s in idx.get("nodes", {}).items()}
        locks = {}
        ld = pdir / "locks"
        for lf in (sorted(ld.glob("*.lock")) if ld.is_dir() else []):
            try:
                h = json.loads(lf.read_text()); locks[h.get("node")] = h
            except Exception:
                pass
        tasks, orphans, ever_marked, presented = {}, [], set(), []
        mark_state = {}
        md = pdir / "marks"
        for mf in (sorted(md.glob("*.json")) if md.is_dir() else []):
            try:
                r = json.loads(mf.read_text())
            except Exception:
                continue
            # Every mark, open or closed. A brief whose task was done and signed
            # off is not work waiting to be started, and showing it as such put
            # finished work back on the board.
            ever_marked.add(mf.stem)
            mark_state[mf.stem] = ("closed" if r.get("_closed_at")
                                   else "presented" if r.get("_presented_at")
                                   else "open")
            if r.get("_closed_at"):
                continue
            if r.get("_presented_at") and r.get("_node"):
                presented.append((mf.stem, r["_node"], r.get("_presented_by") or "?"))
            n = r.get("_node")
            # Counted, not dropped: an open record naming no node is a fact about
            # the ledger, and hiding it is how six of them sat there unnoticed.
            if n is None or n not in tree:
                orphans.append({"task": mf.stem, "named": n,
                                "at": (r.get("_at") or "")[:19].replace("T", " ")})
            else:
                tasks.setdefault(n, []).append(
                    {"task": mf.stem, "presented": bool(r.get("_presented_at"))})
        # A brief exists BEFORE its mark: the lead writes it, then the member
        # accepts. Without this the handed-out work is invisible until someone
        # picks it up, which is exactly the window a lead needs to see.
        briefs = {}
        bd = pdir / "briefs"
        for bf in (sorted(bd.glob("*.json")) if bd.is_dir() else []):
            try:
                r = json.loads(bf.read_text())
            except Exception:
                continue
            if r.get("node"):
                # `task` stays the file stem, because that is what every read
                # path here whitelists against; `label` is the id its lead typed.
                # Coupling is matched on the stem too — a brief written as
                # `doi-index` is stored as `doi_index`, and comparing the typed
                # form against the stored one is how a recorded link silently
                # stops matching.
                briefs.setdefault(r["node"], []).append(
                    {"task": bf.stem, "label": r.get("task") or bf.stem,
                     "seq": r.get("seq"), "written_at": r.get("written_at"),
                     "coupled_to": (CLI.tkey(r["coupled_to"])
                                    if r.get("coupled_to") else None),
                     "coupled_why": r.get("coupled_why") or "",
                     "from": r.get("from") or None,
                     "gone": r.get("superseded_why") or None,
                     "gone_for": r.get("superseded_for") or None,
                     "open_suggestions": sum(1 for x in (r.get("suggestions") or [])
                                             if not x.get("resolved_at"))})
        suggestions = {}
        for bf in (sorted(bd.glob("*.json")) if bd.is_dir() else []):
            try:
                r = json.loads(bf.read_text())
            except Exception:
                continue
            openn = [x for x in (r.get("suggestions") or []) if not x.get("resolved_at")]
            if openn and r.get("node"):
                suggestions[bf.stem] = (r["node"], openn)
        # Segments a lead broke up: parent brief -> the briefs derived from it.
        # The CLI drops these from the queue the moment they are split, because
        # splitting IS the discharge and nobody will work on the parent. But it
        # then opens no mark, is never presented and cannot be closed, so it sat
        # on the board as an ordinary pending chip forever. Ready means every
        # part has come back — the only honest completion test, and a fact about
        # the children rather than something somebody has to remember.
        split_of = {}
        for bf in (sorted(bd.glob("*.json")) if bd.is_dir() else []):
            try:
                r = json.loads(bf.read_text())
            except Exception:
                continue
            src = r.get("from")
            if not src:
                continue
            par = split_of.setdefault(CLI.tkey(src), {"node": None, "children": []})
            par["children"].append({"task": bf.stem, "node": r.get("node"),
                                    "state": mark_state.get(bf.stem, "briefed")})
        # The parent's own node, read off its brief rather than guessed.
        for bf in (sorted(bd.glob("*.json")) if bd.is_dir() else []):
            if bf.stem in split_of:
                try:
                    split_of[bf.stem]["node"] = json.loads(bf.read_text()).get("node")
                except Exception:
                    pass
        for t, s in list(split_of.items()):
            if s["node"] is None:
                del split_of[t]; continue
            s["done"] = sum(1 for c in s["children"] if c["state"] == "closed")
            s["total"] = len(s["children"])
            s["ready"] = s["done"] == s["total"]

        waits = {}
        wd = pdir / "waiting"
        for wf in (sorted(wd.glob("*.json")) if wd.is_dir() else []):
            try:
                r = json.loads(wf.read_text())
            except Exception:
                continue
            if r.get("node") in tree:
                waits[r["node"]] = r
        blocks = [x for x in needs if x.get("_repo") == repo]
        nodes = []
        for name, spec in tree.items():
            wt = wt_of.get(name)
            here = by_cwd.get(wt, []) if wt else []
            nodes.append({
                "name": name, "branch": spec.get("branch"), "parent": spec.get("parent"),
                "kind": spec.get("kind"), "rank": _rank(tree, name), "worktree": wt,
                "indexed": name in idx.get("nodes", {}),
                # null, meaning unknown, is deliberately distinct from [] here.
                # Idle age and carried context, so a node you walked away from
                # says what picking it back up would cost. Past the cache
                # lifetime the next turn re-reads all of it at full rate.
                "sessions": (None if rows is None else
                             [dict({"name": r.get("name"), "status": r.get("status"),
                                    "id": (r.get("sessionId") or "")[:8]},
                                   **(lambda a, c: {"idle": a, "carry": c,
                                                    "cold": bool(a and a > CLI.CACHE_TTL)}
                                      )(*CLI.last_turn(r.get("sessionId") or "")))
                              for r in here]),
                "claimed": name in locks,
                "tasks": sorted(tasks.get(name, []), key=lambda x: x["task"]),
                # The QUEUE, in the order its lead set — not alphabetical. What a
                # node does next is a fact about the tree, and sorting it by name
                # would invent an order and show it as though it were the one the
                # lead chose.
                # Queued and delegated are different facts and used to be one
                # chip. A segment this node SPLIT is discharged the moment it is
                # broken up — nobody will ever work on it — so drawing it beside
                # the work that is actually next made a lead look like it was
                # ignoring twelve tasks when seven were real.
                # Withdrawn briefs come out of the queue chips for the same
                # reason the CLI stops offering them: nothing will start one.
                # They are drawn below, struck through, because a brief that
                # vanished entirely has the next lead propose the same thing
                # again and get no answer.
                "gone": [b for b in briefs.get(name, [])
                         if b.get("gone") and b["task"] not in ever_marked],
                "briefed": sorted(
                    (b for b in briefs.get(name, [])
                     if b["task"] not in ever_marked and b["task"] not in split_of
                     and not b.get("gone")),
                    key=lambda b: (b.get("seq") if b.get("seq") is not None else 10**6,
                                   b.get("written_at") or "", b["task"])),
                "split": [dict(s, task=t) for t, s in sorted(split_of.items())
                          if s["node"] == name and t not in ever_marked],
                "blocks": [x for x in blocks if x.get("node") == name
                           and x.get("_kind") != "approval"
                           and not x.get("_answered")],
                # Both ends of it on the same card: what this node is stopped
                # on, and who is stopped on this node. A lead looking at its
                # own card should not have to read its children's to find out
                # that two of them are waiting on it.
                "waiting": (dict(waits[name],
                                 age=CLI.wait_age(waits[name].get("since")))
                            if name in waits else None),
                "awaited_by": sorted(n for n, r in waits.items()
                                     if r.get("parent") == name),
            })
        nodes.sort(key=lambda n: (n["rank"], n["name"]))
        pname = Path(repo).name

        # A wait is its LEAD's to answer, and tree state belongs in the tree —
        # so a wait is drawn on the card and stays out of this panel. The one
        # exception is a wait whose lead is not running: then no session in the
        # tree can answer it, which is exactly the test this panel applies to
        # everything else it shows. Occupancy has to be KNOWN for that; when
        # the roster could not be read, nothing is claimed either way.
        live_of = {n["name"]: n["sessions"] for n in nodes}
        for wn, wr in sorted(waits.items()):
            par = wr.get("parent")
            if rows is None or live_of.get(par) is None or live_of.get(par):
                continue
            if _wait_mins(wr.get("since")) < 20:
                continue
            att.append({
                "kind": "unanswered", "owner": "operator",
                "where": f"{pname} / {wn}",
                "what": f"stopped on {par} for {CLI.wait_age(wr.get('since'))}",
                "why": f"{wn} asked {par} something and stopped waiting for the "
                       f"answer. {par} has no live session, so nothing in the tree "
                       f"is going to give it one.\n\nasked: "
                       f"{wr.get('asked') or '(nothing recorded)'}",
                "still": wr.get("still_moving") or "",
                "rule": "unanswered",
                "do": f"(cd {shlex.quote(repo)} && harness spawn {par})\n"
                      f"(cd {shlex.quote(repo)} && harness waiting --list)",
                "project": pname, "slug": pdir.name, "node": wn,
                "need": None, "comments": []})

        # ONLY what no agent in the tree has the authority to fix. A sign-off is
        # dev's; a node with nothing briefed is its lead's; both were told at
        # orientation, and neither is a fault. Listing them here put four items
        # of somebody else's work-in-progress above the one item that was
        # actually the operator's, which trains a reader to stop looking. Tree
        # state belongs in the tree, where the chips already show it.
        # An approval is squarely what this panel is for: work nobody requested,
        # which no session in the tree may authorise for itself. It carries the
        # brief's own text, because deciding whether a task is worth a session
        # means reading the task.
        for b in [x for x in blocks if x.get("_kind") == "approval"]:
            att.append({
                "kind": "approval", "owner": "operator",
                "where": f"{pname} / {b.get('node')}",
                "what": f"start '{b.get('task')}'?",
                # Only what is different about THIS one. The paragraph
                # explaining why an approval is the operator's at all is the
                # same on every approval, and it now lives in RULES, said once
                # per panel rather than under each item.
                "why": (f"A lane noticed this while doing something else"
                        + (f" — the finding '{b['from_finding']}'"
                           if b.get("from_finding") else "")
                        + f", and {b.get('asked_by')} wrote it up as a task."
                        + ("\n\n" + b["why"] if b.get("why") else "")),
                "rule": "approval",
                "do": f"(cd {shlex.quote(repo)} && harness brief "
                      f"{shlex.quote(b.get('task') or '')} --approve)\n"
                      f"(cd {shlex.quote(repo)} && harness brief "
                      f"{shlex.quote(b.get('task') or '')} --decline \"why\")",
                "project": pname, "slug": pdir.name, "node": b.get("node"),
                "need": b.get("need"), "task": b.get("task"),
                "root": next((n for n, sp in tree.items()
                              if sp.get("parent") is None), "rank 0"),
                "comments": []})
        # One they answered, that the tree came back on. This is the item that
        # was missing entirely: replying to a block used to remove it from every
        # surface the operator reads, permanently, so a lane answering "the
        # reason you gave cannot be the reason" appended to a thread nobody
        # would open again. What they have not seen is the REPLY, so the reply
        # is what this leads with — the request they already read.
        for b in [x for x in blocks if x.get("_reopened")]:
            cs = b.get("comments") or []
            since = [c for c in cs
                     if (c.get("at") or "") > (b.get("_answered_at") or "")]
            mine = [c for c in cs if c.get("by") == "operator"]
            last = since[-1] if since else {}
            att.append({
                "kind": "came back", "owner": "operator",
                "where": f"{pname} / {b.get('node')}",
                "what": b.get("need"),
                "why": (f"You answered this on "
                        f"{(b.get('_answered_at') or '')[:10]} — "
                        f"“{(mine[-1].get('text') or '').strip()[:160]}”\n\n"
                        f"{len(since)} "
                        f"{'reply has' if len(since) == 1 else 'replies have'} come "
                        f"back since, the newest from {last.get('by') or '?'}. It is "
                        f"still open, so whatever they said, it did not settle it."),
                "still": b.get("still_moving") or "",
                "rule": "came back",
                # Only what arrived AFTER their answer. The earlier thread is
                # what they already read, and repeating it is how the two lines
                # that are new get lost in it.
                "comments": since,
                "do": f"(cd {shlex.quote(repo)} && harness blocked "
                      f"{shlex.quote(b.get('need') or '')} --comment \"...\")\n"
                      f"(cd {shlex.quote(repo)} && harness blocked "
                      f"{shlex.quote(b.get('need') or '')} --resolve "
                      f"--no-task \"why it produced none\")",
                "project": pname, "slug": pdir.name, "node": b.get("node"),
                "need": b.get("need"),
                "root": next((n for n, sp in tree.items()
                              if sp.get("parent") is None), "rank 0")})
        # An answered block belongs to rank 0 now. Leaving it here asks the
        # operator to decide something they already decided, and a panel that
        # does that is one they stop reading.
        for b in [x for x in blocks
                  if x.get("_kind") != "approval" and not x.get("_answered")
                  and not x.get("_reopened")]:
            att.append({
                "kind": "grant", "owner": "operator",
                "where": f"{pname} / {b.get('node')}", "what": b.get("need"),
                # The two lines that actually differ between one of these and
                # the next: what this lane wants the path for, and what it is
                # still getting done without it. They used to be a clause and a
                # tail on a five-line invariant that was identical every time,
                # and a reader who has seen that paragraph twice stops reading
                # the item it is attached to.
                "why": (b.get("why")
                        or "A lane needs a path outside its worktree, and the "
                           "block record does not say what for."),
                "still": b.get("still_moving") or "",
                "rule": "grant",
                "do": f"(cd {shlex.quote(repo)} && harness grant {b.get('node')} "
                      f"{shlex.quote(b.get('need') or '')} --reason "
                      f"{shlex.quote((b.get('why') or 'see the block record')[:60])})",
                "project": pname,
                "slug": pdir.name, "node": b.get("node"), "need": b.get("need"),
                "root": next((n for n, sp in tree.items()
                              if sp.get("parent") is None), "rank 0"),
                "comments": b.get("comments") or []})
        ch = {"description": "", "revision": 0, "features": []}
        cf = pdir / "charter.json"
        if cf.exists():
            try:
                raw = json.loads(cf.read_text())
                d = raw.get("description") or {}
                ch = {"description": d.get("text") or "",
                      "revision": d.get("revision") or 0,
                      "written_by": d.get("written_by") or "",
                      # The CLI's ordering, not this file's opinion of one.
                      # Two copies of "what order are the features in" is two
                      # that drift, and nothing compares them.
                      "features": [
                          {"key": k, "name": v.get("name") or k,
                           "text": v.get("text") or "",
                           "revision": v.get("revision") or 0,
                           "parent": v.get("parent") or None,
                           "depth": depth}
                          for k, v, depth in CLI.charter_order(raw)]}
            except Exception:
                ch["error"] = "charter.json is not readable"
        projects.append({"project": pname, "repo": repo, "slug": pdir.name,
                         "charter": ch,
                         "nodes": nodes,
                         "blocks": blocks,
                         "orphan_marks": sorted(orphans, key=lambda o: o["task"]),
                         "indexed_at": idx.get("generated")})
    v = install_drift()
    if v:
        att.append({"kind": "stale install", "owner": "operator", "where": "this machine",
                    "project": None,
                    "what": v,
                    "why": "The harness CLI and the four skills under ~/.claude/skills are "
                           "copies. Their source has moved since they were installed, so "
                           "every session is reading older instructions than the ones that "
                           "were written, silently, because nothing else reports it.",
                    "do": "bash install.sh    # from the source tree"})
    att.sort(key=lambda x: (x["kind"], x["where"]))
    return {"generated": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            "attention": att, "yours": len(att),
            "roster_error": roster_error, "stale_server": stale_server(),
            "started": time.strftime("%H:%M:%S", time.localtime(STARTED)),
            "projects": projects, "needs": needs,
            "rules": RULES, "commands": read_commands()}


