#!/bin/sh
# The index holds what is about to be committed; _guard reads blobs with `:path`
# when HARNESS_REV is empty.
. "$(git rev-parse --path-format=absolute --git-common-dir)/../.harness/hooks/_lib.sh" || exit 1
G="$(harness_guard)" || exit 1
HARNESS_REV="" git diff --cached --name-only | HARNESS_REV="" "$G" || exit 1
exit 0
