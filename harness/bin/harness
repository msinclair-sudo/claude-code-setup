    fd.add_argument("name", nargs="?", help="short name for the thing you noticed")
    fd.add_argument("--what", metavar="TEXT",
                    help="the claim, in full. '-' reads it from stdin, which is the "
                         "only safe route for prose naming code")
    fd.add_argument("--how", metavar="TEXT", help="how you came to it — required")
    fd.add_argument("--fact", metavar="NAME", help="a recorded measurement behind it")
    fd.add_argument("--drop", metavar="WHY", help="the lead declines it, on the record")
    fd.add_argument("--list", action="store_true", help="open findings addressed to you")
    fd.add_argument("--all", action="store_true", help="every open finding in the tree")
    ft = add("fact", cmd_fact)
    ft.add_argument("name", nargs="?", help="what the measurement is called")
    ft.add_argument("--is", dest="is_", metavar="VALUE",
                    help="the value, in the command's own words")
    ft.add_argument("--from", dest="from_", metavar="COMMAND",
                    help="the command that produced it — required")
    ft.add_argument("--what", metavar="TEXT", help="what it measures, in one line")
    ft.add_argument("--recheck", action="store_true",
                    help="re-run the recorded command here and append what it says")
    ft.add_argument("--timeout", type=int, default=120, metavar="SECONDS")
    ft.add_argument("--list", action="store_true", help="every fact, with its age")
    il = add("idle", cmd_idle)
    il.add_argument("--all", action="store_true",
                    help="include busy sessions, not just idle ones")
    il.add_argument("--roster", help="a `claude agents --json` capture, for testing")
    qu = add("queue", cmd_queue)
    qu.add_argument("node", nargs="?", help="one node; every node in the tree if omitted")
    qu.add_argument("--roster", help="a `claude agents --json` capture, for testing")
    qu.add_argument("--why", metavar="TEXT",
                    help="required when rank 0 reorders past a lead")
    qu.add_argument("--order", metavar="A,B,C",
                    help="set the order of a child's queue; unnamed keep their place behind")
    ck = add("check", cmd_check)
    ck.add_argument("--timeout", type=int, default=900, metavar="SEC",
                    help="per-check timeout (default 900)")
    dc = add("decision", cmd_decision)
    dc.add_argument("name", help="short name for the question")
    dc.add_argument("--ask", help="the question, one line")
    dc.add_argument("--turns", help="what is waiting on the answer — required, and "
                                    "it is how the operator judges urgency")
    dc.add_argument("--options", help="candidate answers, e.g. 'a | b | c'. Not "
                                      "required; an open question costs a paragraph")
    dc.add_argument("--gates", action="append", metavar="TASK",
                    help="a brief that may not start until this closes (repeatable)")
    dc.add_argument("--answer", help="the operator's ruling. Records it and leaves "
                                     "the decision OPEN — an answer is not a task")
    add("hook-stop", cmd_hook_stop)
    add("hook-orient", cmd_hook_orient)
    wh.add_argument("--delta", action="store_true",
                    help="print only what has changed since this session was last "
                         "told, and nothing when nothing has")
    nd = add("needs", cmd_needs)
    nd.add_argument("--all", action="store_true",
                    help="every enrolled project on this machine, not just this one")
    nd.add_argument("--roster", metavar="FILE",
                    help="a `claude agents --json` capture, for testing")
    add("index", cmd_index)
    ps = add("position", cmd_position)
    ps.add_argument("--format", choices=["line", "json"], default="line")
    ps.add_argument("--refresh", action="store_true")
    ps.add_argument("--behind", action="store_true")
    ps.add_argument("--quiet", action="store_true",
                    help="print nothing and exit 0 when not enrolled")
    add("unenrol", cmd_unenrol)
    a = p.parse_args()
    read_dash_from_stdin(a)
    # The delta footer. A working session runs `mark`, `brief`, `review`,
    # `integrate` all day, and every one of those is a moment it is already
    # reading output — so orientation rides along for the price of the lines it
    # actually prints, which is none unless something changed. It is the cheap
    # half of the answer to "orient regularly": not a heartbeat the session pays
    # for, but a delta attached to work it was doing anyway.
    #
    # Only on success. After a refusal the reader is dealing with the refusal,
    # and a queue notice underneath it is noise at the worst moment.
    quiet_cmds = {"whoami", "position", "contract", "hook-stop", "hook-orient",
                  "needs", "index", "gui"}
    try:
        a.fn(a)
    except SystemExit as e:
        if (e.code or 0) == 0 and a.cmd not in quiet_cmds:
            print_delta()
        raise
    if a.cmd not in quiet_cmds:
        print_delta()


if __name__ == "__main__":
    main()
