    ck.add_argument("--timeout", type=int, default=900, metavar="SEC",
                    help="per-check timeout (default 900); a check's own \"timeout\" key "
                         "in manifest.json overrides it. Arms run under `sh -c` (dash on "
                         "Debian/Ubuntu), so bashisms such as $SECONDS read empty")
    ck.add_argument("--set-baseline", action="store_true",
                    help="record the failures in the report at HEAD as the known set")
    ck.add_argument("--why", help="with --set-baseline: one line")
    ck.add_argument("--wait", action="store_true",
                    help="block until the queued run finishes and print its report")
    ck.add_argument("--arms", metavar="A,B",
                    help="run only these arms (names from the manifest); your project says "
                         "which a change needs. The report is marked partial")
    ck.add_argument("--priority", action="store_true",
                    help="the priority queue (the default for leads and rank 0: integration)")
    ck.add_argument("--normal", action="store_true",
                    help="the normal queue (the default for lanes)")
    ck.add_argument("--report", metavar="SHA", help="print a finished report for a commit")
    tq = add("test", cmd_test)
    tq.add_argument("command", nargs=argparse.REMAINDER,
                    help="-- <command>: queue it to run in a copy of this commit")
    tq.add_argument("--cancel", metavar="ID|all")
    tq.add_argument("--log", metavar="ID")
    td = add("testd", cmd_testd)
    td.add_argument("--project", metavar="NAME")
    sl = add("slot", cmd_slot)
    sl.add_argument("command", nargs=argparse.REMAINDER,
                    help="-- <command>: run it holding the project's test slot")
    add("hook-stop", cmd_hook_stop)
    add("hook-orient", cmd_hook_orient)
    wh.add_argument("--delta", action="store_true",
                    help="print only what has changed since this session was last "
                         "told, and nothing when nothing has")
    add("index", cmd_index)
    ps = add("position", cmd_position)
    ps.add_argument("--format", choices=["line", "json"], default="line")
    ps.add_argument("--refresh", action="store_true")
    ps.add_argument("--behind", action="store_true")
    ps.add_argument("--quiet", action="store_true",
                    help="print nothing and exit 0 when not enrolled")
    add("unenrol", cmd_unenrol)
    hd = add("hold", cmd_hold)
    hd.add_argument("path", nargs="?", help="a shared resource (file or directory)")
    hd.add_argument("--why", help="one line: what holds it")
    hd.add_argument("--until", metavar="TASK", help="lifts when TASK is signed off")
    hd.add_argument("--release", action="store_true")
    hd.add_argument("--list", action="store_true")
    ct = add("cited", cmd_cited)
    ct.add_argument("paths", nargs="+", metavar="PATH")
    ct.add_argument("--deletable", action="store_true",
                    help="print only the paths no open record needs")
    sw = add("sweep", cmd_sweep)
    sw.add_argument("unit", nargs="?", help="a complete unit (see bare `harness sweep`)")
    sw.add_argument("--dry-run", action="store_true")
    sw.add_argument("--keep", action="store_true", help="decline: keep it, recorded")
    sw.add_argument("--all", action="store_true", help="every complete unit, one decision")
    sw.add_argument("--stale", action="store_true",
                    help="facts and findings no open record needs (closed findings; uncited, old facts)")
    sw.add_argument("--older-than", metavar="DAYS", help="with --stale: fact age, default 14")
    sw.add_argument("--sessions", action="store_true",
                    help="ended sessions on this project's nodes, off Claude Code's list")
    sw.add_argument("--why", help="the decision, one line")
    ar = add("archive", cmd_archive)
    ar.add_argument("unit", nargs="?", help="a swept unit, or a task in one")
    ar.add_argument("task", nargs="?")
    pa = add("pairs", cmd_pairs)
    pa.add_argument("verb", metavar="submit|apply|TASK",
                    help="submit <json> --task T, apply <T>, or a task to show")
    pa.add_argument("target", nargs="?", help="the JSON (path, or - for stdin) or task")
    pa.add_argument("--task", help="with submit: the task the pairs serve")
    pa.add_argument("--auto", action="store_true", help=argparse.SUPPRESS)
    pa.add_argument("--decline", metavar="WHY", help="with a task: decline a documenter batch")
    pa.add_argument("--full", action="store_true", help="with a task: the whole diff")
    ak = add("ask", cmd_ask)
    ak.add_argument("target", nargs="?", metavar="TASK|ID",
                    help="a task, to open an ask; an ask id for every other verb")
    ak.add_argument("--kind", choices=list(ASK_KINDS))
    ak.add_argument("--question", metavar="TEXT", help="one sentence, at most 200 chars")
    ak.add_argument("--run", action="append", metavar="CMD",
                    help="with --kind action: a command for the owner to run (repeat)")
    ak.add_argument("--done", action="store_true",
                    help="owner: the action's commands are run; --text adds a note")
    ak.add_argument("--msg", metavar="TEXT",
                    help="anyone: a message to this ask's intermediary (it is woken for it)")
    ak.add_argument("--query", metavar="TEXT", help=argparse.SUPPRESS)
    ak.add_argument("--to", metavar="NODE",
                    help="intermediary: ask a node about this item, with --text")
    ak.add_argument("--reply", metavar="TEXT",
                    help="intermediary: answer the owner under the ask")
    ak.add_argument("--idle", action="store_true",
                    help="intermediary: its last step on every wake")
    ak.add_argument("--brief", metavar="FILE",
                    help="intermediary: the seven sections as markdown; '-' reads stdin")
    ak.add_argument("--amend", metavar="TEXT", help="intermediary: rewrite the question")
    ak.add_argument("--draft", metavar="TEXT", help="intermediary: the draft ruling")
    ak.add_argument("--return", dest="return_why", metavar="WHY",
                    help="intermediary: not the owner's; back to the asker")
    ak.add_argument("--merge", metavar="ID", help="intermediary: fold into another ask")
    ak.add_argument("--evidence", metavar="PATH",
                    help="intermediary: attach an image or text file for the owner to see")
    ak.add_argument("--caption", metavar="TEXT", help="with --evidence: what it shows")
    ak.add_argument("--drop-evidence", type=int, metavar="N",
                    help="intermediary: remove evidence N (as numbered by --show)")
    ak.add_argument("--accept", action="store_true", help="owner: sign the draft")
    ak.add_argument("--text", metavar="TEXT",
                    help="with --accept: the owner's own wording; with --done: a note; "
                         "with --to: the message")
    ak.add_argument("--reject", action="store_true", help="owner: not a question to answer")
    ak.add_argument("--show", action="store_true",
                    help="the ask, its task's brief, and the asker's open task")
    ak.add_argument("--list", action="store_true",
                    help="open asks on this machine; an intermediary sees its project's")
    ak.add_argument("--all", action="store_true",
                    help="with --list: every project, even inside an intermediary")
    ak.add_argument("--json", action="store_true")
    ak.add_argument("--project", metavar="NAME",
                    help="the repo directory name, when an id is in two projects")
    im = add("intermediary", cmd_intermediary)
    im.add_argument("--project", metavar="NAME",
                    help="the repo directory name or state slug; default: the enrolled "
                         "repo you are in")
    im.add_argument("--print-cmd", action="store_true",
                    help="print the command and exit")
    im.add_argument("--model")
    im.add_argument("--effort", choices=list(EFFORTS))
    im.add_argument("--ask", metavar="ID", help="the ask whose session to wake or start")
    im.add_argument("--wake", metavar="WHY", help=argparse.SUPPRESS)
    im.add_argument("--settle", action="store_true", help=argparse.SUPPRESS)
    im.add_argument("--close", metavar="ID", help=argparse.SUPPRESS)
    im.add_argument("--next", action="store_true", help=argparse.SUPPRESS)
    fo = add("focus", cmd_focus)
    fo.add_argument("task", nargs="*",
                    help="tasks, segments or globs (quote them: 'enrich*') the owner put "
                         "first; replaces the list. Queues are labelled, never filtered.")
    fo.add_argument("--add", nargs="+", metavar="TASK", help="add to the current list")
    fo.add_argument("--remove", nargs="+", metavar="TASK", help="remove from the current list")
    fo.add_argument("--why", help="one line")
    fo.add_argument("--clear", action="store_true")
    a = p.parse_args()
    read_dash_from_stdin(a)
    # No delta footer: nags belong to orientation (whoami, hook-orient), and a
    # command asked a question answers only that question (obs 13).
    a.fn(a)


if __name__ == "__main__":
    main()
