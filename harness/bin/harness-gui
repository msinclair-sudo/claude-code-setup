#!/usr/bin/env python3
"""harness-gui — a read-only window onto every harness tree on this machine.

A VIEWER, not a participant. It never claims, never writes, never decides, and
holds no authority over anything it shows, so [[R4]]'s "no arbiter process" is
untouched: this can be closed at any moment and nothing in the harness notices.
Everything it renders is already on disk; the only thing it adds is that a human
can see all of it at once without running a command per project.

Served on 127.0.0.1 only. Stdlib only, one file, no build step.

    harness-gui               # serve and open a browser
    harness-gui --port 9000   # a port of your own; refused rather than moved
    harness-gui --no-open
    harness-gui --once        # print the JSON it would serve, and exit

The default port is 8791 and it walks upward if that is taken. 8787 is RStudio
Server's, 8888 is Jupyter's, and a viewer that refuses to start because someone
else's long-running service got there first is a viewer nobody opens.
"""
import argparse, importlib.util, json, os, re, subprocess, sys, threading, time, webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from importlib.machinery import SourceFileLoader
from urllib.parse import parse_qs, urlparse
import shlex
from pathlib import Path


# Loading the CLI as a module would otherwise drop a __pycache__ into the install
# directory, on every run, for a file that is never imported twice in a process.
sys.dont_write_bytecode = True


def load_cli():
    """Reuse the CLI's readers rather than restating them.

    `live_rows` and `is_stopped` are the definitions of "actually running" and
    "halted at a prompt". A viewer with its own second copy of either would
    drift, and would drift silently, since nothing compares them.
    """
    p = Path(__file__).resolve().with_name("harness")
    spec = importlib.util.spec_from_loader("harness_cli", SourceFileLoader("harness_cli", str(p)))
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


CLI = load_cli()

# Not 8787 (RStudio Server) and not 8888 (Jupyter). Both are long-running
# services someone starts once and forgets, so losing a coin-toss with either
# means the viewer is the thing that fails to start.
DEFAULT_PORT = 8791

# A long-running server hands out the page it loaded at startup, so editing the
# source and reloading the browser changes nothing at all -- and there is no
# symptom, which is worse. Both files are stat'd on every state read so the page
# can say "the server is older than the code" instead of quietly lying.
STARTED = time.time()
SOURCES = [Path(__file__).resolve(), Path(__file__).resolve().with_name("harness")]


def stale_server():
    try:
        return max(p.stat().st_mtime for p in SOURCES if p.exists()) > STARTED
    except Exception:
        return False


def _rank(tree, name):
    r, seen = 0, set()
    while True:
        p = tree.get(name, {}).get("parent")
        if p is None or p in seen or p not in tree:
            return r
        seen.add(name); name = p; r += 1


_ROSTER = {"at": 0.0, "rows": None, "error": None}
_RLOCK = threading.Lock()


def roster(max_age=2.5):
    """One `claude agents --json` per poll at most, and never two at once.

    Measured: 0.55s of process spawn per read. The page polls every 3s, so
    without this every open tab is a `claude` process every three seconds
    forever, and a slow read has the next one starting on top of it.

    Returns (rows, error). `rows is None` means the roster could not be read —
    which is NOT the same answer as an empty roster, and the difference is the
    whole bug this replaces: a failed read became `rows = []`, every node lost
    its session, and a tree full of working sessions rendered as empty.
    """
    with _RLOCK:
        now = time.time()
        if _ROSTER["rows"] is not None and now - _ROSTER["at"] < max_age:
            return _ROSTER["rows"], _ROSTER["error"]
        try:
            _ROSTER["rows"], _ROSTER["error"] = CLI.live_rows(CLI.agents_json()), None
        except Exception as e:
            _ROSTER["rows"], _ROSTER["error"] = None, f"{type(e).__name__}: {e}"[:200]
        _ROSTER["at"] = now
        return _ROSTER["rows"], _ROSTER["error"]


def install_drift():
    """Whether what is installed is older than what it was installed from."""
    vf = CLI.HOME_STATE / "VERSION"
    if not vf.exists():
        return None
    try:
        v = json.loads(vf.read_text())
        src = Path(v.get("source", ""))
        if not src.is_dir():
            return None
        r = subprocess.run(["git", "-C", str(src), "rev-parse", "HEAD"],
                           capture_output=True, text=True, timeout=10)
        if r.returncode or r.stdout.strip() == v.get("commit"):
            return None
        return (f"installed from {str(v.get('commit'))[:8]}, "
                f"{src.name} is now at {r.stdout.strip()[:8]}")
    except Exception:
        return None


def _wait_mins(since):
    try:
        t = time.mktime(time.strptime((since or "")[:19], "%Y-%m-%dT%H:%M:%S"))
    except Exception:
        return 0
    return int(max(0, time.time() - t) // 60)


# Open asks, and the subset that is the owner's move. `asked` is open but still
# the intermediary's: it has not been briefed yet.
ASK_OPEN = ("asked", "ready", "drafted")
ASK_OWNERS = ("ready", "drafted")


def intermediary(rows, repo, asks=None, pdir=None):
    """A project's item sessions: one intermediary per open ask, found by name
    on the roster. Each open ask gets `session` (working, idle, queued or
    asleep); the summary counts the running ones against the cap.

    `running` is None when the roster could not be read — unknown, not none.
    """
    out = {"running": None, "cap": CLI.ITEM_CAP, "items": []}
    for a in asks or []:
        a["session"] = {"state": "unknown"}
    if rows is None:
        return out
    pre = CLI.intermediary_name(repo) + "-"
    live = {}
    for r in rows:
        n = r.get("name") or ""
        if n.startswith(pre) and r.get("sessionId"):
            live[n[len(pre):]] = r
    for a in asks or []:
        r = live.get(a["id"])
        if r:
            t, c = CLI.last_turn(r["sessionId"])
            a["session"] = {"state": "working" if r.get("status") == "busy" else "idle",
                            "sid": r["sessionId"], "context": c,
                            "idle": None if r.get("status") == "busy" or t is None else int(t)}
        elif pdir and (CLI.item_home(pdir, a["id"]) / "inbox.jsonl").exists():
            a["session"] = {"state": "queued"}
        else:
            a["session"] = {"state": "asleep"}
    out["running"] = len(live)
    out["items"] = sorted(live)
    return out


def tests_queue(pdir, repo):
    """The project's test queue (obs 81): the running job, then the queued ones in
    order, and whether a runner is up."""
    try:
        c = CLI.ProjCtx(pdir, repo)
        jobs = CLI.testq_order(CLI.testq_jobs(c, ("running", "queued")))
        last = (CLI.testq_jobs(c, ("done", "failed", "cancelled")) or [None])[-1]
    except Exception:
        return {"jobs": [], "last": None}
    out = []
    for j in jobs:
        out.append({"id": j["id"], "state": j["state"], "kind": j.get("kind"),
                    "sha": (j.get("sha") or "")[:8], "command": (j.get("command") or "")[:60],
                    "who": [r.get("node") for r in j.get("requested_by") or []],
                    "arm": j.get("arm"), "done": j.get("done_arms"), "total": j.get("total"),
                    "arms": j.get("arms"), "queue": j.get("queue") or "normal",
                    "eta": CLI.testq_wait_estimate(c, j),
                    "since": CLI.wait_age(j.get("started") or j.get("at"))})
    lj = None
    if last:
        lj = {"id": last["id"], "state": last["state"], "sha": (last.get("sha") or "")[:8],
              "at": (last.get("finished") or "")[11:16], "why": last.get("why")}
    return {"jobs": out, "last": lj}


def mark_held(cctx, nodes):
    """Held: nothing in hand, and the next queued task can't start yet — it is
    gated --after another node's task, or --not-before a clock. Not a wait
    (nobody owes it an answer) and not a fault; its lead set it so. Sets each
    node's `held`, and the holder's `holding`."""
    by_name = {n["name"]: n for n in nodes}
    for n in nodes:
        n["held"], n["holding"] = [], []
    for n in nodes:
        if any(not t.get("presented") for t in n["tasks"]):
            continue                        # mid-task: it is working
        q = [b for b in CLI.queue(cctx, n["name"]) if not b.get("coupled_to")]
        if not q or CLI.startable(cctx, n["name"]):
            continue
        for r in CLI.waits_on(cctx, q[0]):
            if r.startswith("until "):
                n["held"].append({"task": q[0]["task"], "until": r[6:]})
                continue
            for h in held_by(cctx, n["name"], r, set()):
                n["held"].append(dict(h, task=q[0]["task"]))
                if h["by"] in by_name:
                    by_name[h["by"]]["holding"].append(dict(
                        {"node": n["name"], "after": h["after"]},
                        **({"signoff": h["worker"]} if h.get("worker") else {})))


def held_by(cctx, me, reason, seen):
    """Who must act before `me` can start, from one `waits_on` reason: always
    another node (owner, 2026-10-06: held by means another node has to do
    something first). A gate on `me`'s own task is followed to whatever holds
    that task, and dropped if nothing outside `me` does. A gate on presented
    work names the worker's lead, who has to sign it off."""
    m = re.match(r"after (\S+) \(([\w ]+) on ([^)]+)\)", reason)
    if not m or m.group(1) in seen:
        return []
    after, state, worker = m.groups()
    seen.add(after)
    if worker == me:
        b = CLI.load_brief(cctx, after)[1] or {}
        return [h for r in CLI.waits_on(cctx, b) if not r.startswith("until ")
                for h in held_by(cctx, me, r, seen)]
    if state == "presented":
        lead = (cctx.tree["nodes"].get(worker) or {}).get("parent")
        if lead and lead != me:
            return [{"after": after, "state": state, "by": lead, "worker": worker}]
    return [{"after": after, "state": state, "by": worker}]


def cli_ctx(pdir, repo, tree):
    """Enough of the CLI's Ctx to ask it about a project's queue and gates,
    without the git calls (and the chdir) its constructor needs."""
    c = CLI.Ctx.__new__(CLI.Ctx)
    c.repo = c.worktree = Path(repo)
    c.branch, c.slug, c.state = "", Path(pdir).name, Path(pdir)
    c.binding_path, c.tree_path = Path(pdir) / "binding.json", Path(repo) / ".harness" / "tree.json"
    c.tree = {"nodes": tree}
    return c


def documenter(rows, pdir, repo, asks, root=None):
    """A project's documenter (T18), for its side card: whether a run is live,
    CLAUDE.md against its budget, the last run's note, and its batches and asks.
    Read off files only; the measurements themselves are `harness docs measure`'s."""
    name = CLI.documenter_name(repo)
    out = {"name": name, "running": None, "words": None, "budget": None, "last": None,
           "queued": 0, "refused": None, "applied": None, "asks": 0}
    if rows is not None:
        # A finished run's session stays up, idle, until the harness stops it:
        # "running" said work was going on when it had ended.
        mine = [r for r in rows if r.get("name") == name]
        out["running"] = ("busy" if any(r.get("status") == "busy" for r in mine)
                          else "idle" if mine else False)
    try:
        out["words"] = len((Path(repo) / "CLAUDE.md").read_text(errors="replace").split())
    except OSError:
        pass
    try:
        out["budget"] = json.loads((Path(repo) / ".harness" / "manifest.json")
                                   .read_text()).get("claude_md_words")
    except Exception:
        pass
    try:
        lines = (Path(pdir) / "docs" / "ledger.jsonl").read_text().splitlines()
        out["last"] = json.loads(lines[-1]) if lines else None
    except Exception:
        pass
    batches = []
    for f in (Path(pdir) / "pairs").glob("*.json") if (Path(pdir) / "pairs").is_dir() else []:
        try:
            r = json.loads(f.read_text())
        except Exception:
            continue
        if r.get("auto"):
            batches.append(r)
    batches.sort(key=lambda r: r.get("at") or "")
    out["review"] = [r["task"] for r in batches if not r.get("applied") and not r.get("refused")]
    # Only the latest batch's outcome: an old decline is history, not news.
    if batches:
        b = batches[-1]
        out["latest"] = {"task": b["task"], "job": b.get("job"),
                         "outcome": ("applied" if b.get("applied") else
                                     "declined" if b.get("refused") else "review"),
                         "sha": (b.get("applied") or "")[:8], "why": b.get("refused"),
                         "claude_md": b.get("claude_md"),
                         "at": b.get("applied_at") or b.get("refused_at") or b.get("at")}
    else:
        out["latest"] = None
    # One state, for the card's status line. A run's session waits, idle, on
    # rank 0's review; the decision closes it or wakes it to fix the batch.
    out["root"] = root
    out["state"] = (None if out["running"] is None else
                    "working" if out["running"] == "busy" else
                    "waiting" if out["running"] and out["review"] else
                    "finishing" if out["running"] else
                    "review" if out["review"] else "between")
    out["asks"] = sum(1 for a in asks if a.get("asker_node") == "documenter")
    try:
        q = json.loads((Path(pdir) / "docs" / "queue.json").read_text())
        out["remaining"] = int(q.get("remaining") or 0)
    except Exception:
        out["remaining"] = 0
    # The doc this run took (`harness docs begin`): a run is one whole doc.
    try:
        out["doc"] = json.loads((Path(pdir) / "docs" / "current.json").read_text())
    except Exception:
        out["doc"] = None
    return out


def read_state():
    rows, roster_error = roster()
    # A LIST per worktree, not one session. Two sessions in one worktree is the
    # condition the statusline colours red; a dict keyed on cwd silently kept the
    # last one and reported the breach as normal occupancy.
    by_cwd = {}
    for r in (rows or []):
        by_cwd.setdefault(r.get("cwd"), []).append(r)
    projects = []
    for pdir in sorted(p for p in CLI.HOME_STATE.glob("*") if p.is_dir()):
        b = pdir / "binding.json"
        if not b.exists():
            continue
        try:
            repo = json.loads(b.read_text()).get("repo", "")
        except Exception:
            continue
        # tree.json is the truth; index.json only supplies worktree paths, and a
        # node the index has not caught up with is shown rather than hidden.
        tp = Path(repo) / ".harness" / "tree.json"
        if not tp.exists():
            continue
        try:
            tree = json.loads(tp.read_text()).get("nodes", {})
        except Exception:
            continue
        idx = {}
        ip = pdir / "index.json"
        if ip.exists():
            try:
                idx = json.loads(ip.read_text())
            except Exception:
                idx = {}
        wt_of = {n: s.get("worktree") for n, s in idx.get("nodes", {}).items()}
        locks = {}
        ld = pdir / "locks"
        for lf in (sorted(ld.glob("*.lock")) if ld.is_dir() else []):
            try:
                h = json.loads(lf.read_text()); locks[h.get("node")] = h
            except Exception:
                pass
        tasks, orphans, ever_marked, presented = {}, [], set(), []
        mark_state = {}
        md = pdir / "marks"
        for mf in (sorted(md.glob("*.json")) if md.is_dir() else []):
            try:
                r = json.loads(mf.read_text())
            except Exception:
                continue
            # Every mark, open or closed. A brief whose task was done and signed
            # off is not work waiting to be started, and showing it as such put
            # finished work back on the board.
            ever_marked.add(mf.stem)
            mark_state[mf.stem] = ("closed" if r.get("_closed_at")
                                   else "presented" if r.get("_presented_at")
                                   else "open")
            if r.get("_closed_at"):
                continue
            if r.get("_presented_at") and r.get("_node"):
                presented.append((mf.stem, r["_node"], r.get("_presented_by") or "?"))
            n = r.get("_node")
            # Counted, not dropped: an open record naming no node is a fact about
            # the ledger, and hiding it is how six of them sat there unnoticed.
            if n is None or n not in tree:
                orphans.append({"task": mf.stem, "named": n,
                                "at": (r.get("_at") or "")[:19].replace("T", " ")})
            else:
                tasks.setdefault(n, []).append(
                    {"task": mf.stem, "presented": bool(r.get("_presented_at"))})
        # A brief exists BEFORE its mark: the lead writes it, then the member
        # accepts. Without this the handed-out work is invisible until someone
        # picks it up, which is exactly the window a lead needs to see.
        briefs = {}
        bd = pdir / "briefs"
        for bf in (sorted(bd.glob("*.json")) if bd.is_dir() else []):
            try:
                r = json.loads(bf.read_text())
            except Exception:
                continue
            if r.get("node"):
                # `task` stays the file stem, because that is what every read
                # path here whitelists against; `label` is the id its lead typed.
                # Coupling is matched on the stem too — a brief written as
                # `doi-index` is stored as `doi_index`, and comparing the typed
                # form against the stored one is how a recorded link silently
                # stops matching.
                briefs.setdefault(r["node"], []).append(
                    {"task": bf.stem, "label": r.get("task") or bf.stem,
                     "seq": r.get("seq"), "written_at": r.get("written_at"),
                     "coupled_to": (CLI.tkey(r["coupled_to"])
                                    if r.get("coupled_to") else None),
                     "coupled_why": r.get("coupled_why") or "",
                     "from": r.get("from") or None,
                     "gone": r.get("superseded_why") or None,
                     "gone_for": r.get("superseded_for") or None,
                     "open_suggestions": sum(1 for x in (r.get("suggestions") or [])
                                             if not x.get("resolved_at"))})
        suggestions = {}
        for bf in (sorted(bd.glob("*.json")) if bd.is_dir() else []):
            try:
                r = json.loads(bf.read_text())
            except Exception:
                continue
            openn = [x for x in (r.get("suggestions") or []) if not x.get("resolved_at")]
            if openn and r.get("node"):
                suggestions[bf.stem] = (r["node"], openn)
        # Segments a lead broke up: parent brief -> the briefs derived from it.
        # The CLI drops these from the queue the moment they are split, because
        # splitting IS the discharge and nobody will work on the parent. But it
        # then opens no mark, is never presented and cannot be closed, so it sat
        # on the board as an ordinary pending chip forever. Ready means every
        # part has come back — the only honest completion test, and a fact about
        # the children rather than something somebody has to remember.
        split_of = {}
        for bf in (sorted(bd.glob("*.json")) if bd.is_dir() else []):
            try:
                r = json.loads(bf.read_text())
            except Exception:
                continue
            src = r.get("from")
            if not src:
                continue
            par = split_of.setdefault(CLI.tkey(src), {"node": None, "children": []})
            par["children"].append(
                {"task": bf.stem, "node": r.get("node"),
                 "state": mark_state.get(bf.stem,
                                         "superseded" if r.get("superseded_at")
                                         else "briefed")})
        # The parent's own node, read off its brief rather than guessed.
        for bf in (sorted(bd.glob("*.json")) if bd.is_dir() else []):
            if bf.stem in split_of:
                try:
                    split_of[bf.stem]["node"] = json.loads(bf.read_text()).get("node")
                except Exception:
                    pass
        for t, s in list(split_of.items()):
            if s["node"] is None:
                del split_of[t]; continue
            # Superseded is terminal: never worked, never signed off. Counting
            # it as outstanding left the segment permanently at 0/N, which reads
            # as work being ignored -- the thing these chips exist to stop.
            s["done"] = sum(1 for c in s["children"]
                            if c["state"] in ("closed", "superseded"))
            s["gone"] = sum(1 for c in s["children"] if c["state"] == "superseded")
            s["total"] = len(s["children"])
            s["ready"] = s["done"] == s["total"]

        waits = {}
        wd = pdir / "waiting"
        for wf in (sorted(wd.glob("*.json")) if wd.is_dir() else []):
            try:
                r = json.loads(wf.read_text())
            except Exception:
                continue
            if r.get("node") in tree:
                waits[r["node"]] = r
        # The owner's channel. An ask is read whole, because the Owner page shows
        # its briefing, and only while open: an accepted ask lives on as a ruling
        # on its brief, and a rejected or returned one is nobody's move.
        asks = []
        ad = pdir / "asks"
        for af in (sorted(ad.glob("*.json")) if ad.is_dir() else []):
            try:
                r = json.loads(af.read_text())
            except Exception:
                continue
            if r.get("state") in ASK_OPEN:
                asks.append(dict(r, id=r.get("id") or af.stem,
                                age=CLI.wait_age(r.get("asked_at"))))
        asks.sort(key=lambda a: a.get("asked_at") or "")
        rulings = []
        for bf in (sorted(bd.glob("*.json")) if bd.is_dir() else []):
            try:
                r = json.loads(bf.read_text())
            except Exception:
                continue
            for ru in (r.get("rulings") or []):
                if isinstance(ru, dict):
                    rulings.append(dict(ru, task=r.get("task") or bf.stem))
        rulings.sort(key=lambda x: x.get("ruled_at") or "", reverse=True)
        # Traffic between nodes goes ON THE NODE, beside the one it is directed
        # at, naming where it came from, in the muted colour the tree already
        # uses for it -- never the warning colour, because it is not a fault.
        sig = {}
        def _sig(node, **kw):
            sig.setdefault(node, []).append(kw)
        # A pending approval, drawn on the node it is FOR, read off the brief
        # itself. A halted session needs no badge: `sessions[].stopped` already
        # paints the card.
        for bf in (sorted(bd.glob("*.json")) if bd.is_dir() else []):
            try:
                r = json.loads(bf.read_text())
            except Exception:
                continue
            ap = r.get("approval") or {}
            if ap.get("state") != "pending" or r.get("superseded_at"):
                continue
            frm = str(ap.get("asked_by") or "").split(" ")[0] or "its lead"
            first = (r.get("text") or "").strip().splitlines()
            task = r.get("task") or bf.stem
            _sig(r.get("node"), kind="approval", frm=frm,
                 text=(first[0][:90] if first else task),
                 task=task, do=f"harness brief {task} --approve")
        nodes = []
        for name, spec in tree.items():
            wt = wt_of.get(name)
            here = by_cwd.get(wt, []) if wt else []
            nodes.append({
                "name": name, "branch": spec.get("branch"), "parent": spec.get("parent"),
                "kind": spec.get("kind"), "rank": _rank(tree, name), "worktree": wt,
                # root is rank 0; a lead has children; everything else is a worker.
                "role": ("root" if not spec.get("parent") else
                         "lead" if any(x.get("parent") == name for x in tree.values())
                         else "worker"),
                "indexed": name in idx.get("nodes", {}),
                # null, meaning unknown, is deliberately distinct from [] here.
                # Idle age and carried context, so a node you walked away from
                # says what picking it back up would cost. Past the cache
                # lifetime the next turn re-reads all of it at full rate.
                "sessions": (None if rows is None else
                             # `stopped` is carried beside `status`, never folded
                             # into it. A halted session reports `status: idle`,
                             # so a card that renders status alone paints the one
                             # node needing a human exactly like the ones needing
                             # nobody.
                             [dict({"name": r.get("name"), "status": r.get("status"),
                                    "stopped": CLI.is_stopped(r),
                                    # Which stop: a permission prompt, or a
                                    # finished turn waiting on someone.
                                    "stop": CLI.stop_detail(r, rows),
                                    "id": (r.get("sessionId") or "")[:8],
                                    "model": CLI.session_model(r.get("sessionId") or ""),
                                    # Uptime: the roster's startedAt is epoch ms.
                                    "up": (int(time.time() - r["startedAt"] / 1000)
                                           if isinstance(r.get("startedAt"), (int, float))
                                           else None)},
                                   **(lambda a, c: {"idle": a, "carry": c,
                                                    "cold": bool(a and a > CLI.CACHE_TTL)}
                                      )(*CLI.last_turn(r.get("sessionId") or "")))
                              for r in here]),
                "signals": sig.get(name, []),
                "claimed": name in locks,
                "tasks": sorted(tasks.get(name, []), key=lambda x: x["task"]),
                # The QUEUE, in the order its lead set — not alphabetical. What a
                # node does next is a fact about the tree, and sorting it by name
                # would invent an order and show it as though it were the one the
                # lead chose.
                # Queued and delegated are different facts and used to be one
                # chip. A segment this node SPLIT is discharged the moment it is
                # broken up — nobody will ever work on it — so drawing it beside
                # the work that is actually next made a lead look like it was
                # ignoring twelve tasks when seven were real.
                # Withdrawn briefs come out of the queue chips for the same
                # reason the CLI stops offering them: nothing will start one.
                # They are drawn below, struck through, because a brief that
                # vanished entirely has the next lead propose the same thing
                # again and get no answer.
                "gone": [b for b in briefs.get(name, [])
                         if b.get("gone") and b["task"] not in ever_marked],
                "briefed": sorted(
                    (b for b in briefs.get(name, [])
                     if b["task"] not in ever_marked and b["task"] not in split_of
                     and not b.get("gone")),
                    key=lambda b: (b.get("seq") if b.get("seq") is not None else 10**6,
                                   b.get("written_at") or "", b["task"])),
                "split": [dict(s, task=t) for t, s in sorted(split_of.items())
                          if s["node"] == name and t not in ever_marked],
                # Both ends of it on the same card: what this node is stopped
                # on, and who is stopped on this node. A lead looking at its
                # own card should not have to read its children's to find out
                # that two of them are waiting on it.
                "waiting": (dict(waits[name],
                                 age=CLI.wait_age(waits[name].get("since")))
                            if name in waits else None),
                "awaited_by": sorted(n for n, r in waits.items()
                                     if r.get("parent") == name),
            })
        # A session that finished its turn and is waiting on someone is a wait
        # the harness never recorded. Draw it as one, on the node it is waiting
        # on, so it reads like a recorded wait and not like a fault. A recorded
        # wait wins: it says what was asked.
        node_of = {r.get("name"): n for n, wt in wt_of.items() for r in by_cwd.get(wt, [])}
        by_name = {n["name"]: n for n in nodes}
        for n in nodes:
            st = next((s["stop"] for s in n["sessions"] or [] if s.get("stop")), None)
            # Waiting means it messaged someone and wants an answer; a turn
            # that just ended is at rest (CLI.stop_wait_on).
            to = CLI.stop_wait_on(st)
            if n["waiting"] or not to:
                continue
            on = node_of.get(to, to)
            idle = next((s.get("idle") for s in n["sessions"] if s.get("stop")), None)
            n["waiting"] = {"parent": on or "you", "asked": st.get("said") or "",
                            "inferred": True,
                            "age": ("" if idle is None else
                                    f"{int(idle // 60)}m" if idle < 3600 else
                                    f"{int(idle // 3600)}h{int(idle % 3600 // 60):02d}")}
            if on in by_name and n["name"] not in by_name[on]["awaited_by"]:
                by_name[on]["awaited_by"] = sorted(by_name[on]["awaited_by"] + [n["name"]])
        # The wait queue, traced: who each waiting node is ultimately held by,
        # and, at the head, every node whose wait runs through it. One link per
        # card left a chain (lane on lead on rank 0) to be pieced together.
        def chain_of(n):
            out, cur, seen = [], n, {n["name"]}
            while cur and cur["waiting"]:
                on = cur["waiting"].get("parent")
                out.append(on)
                cur = by_name.get(on)
                if not cur or cur["name"] in seen:
                    break
                seen.add(cur["name"])
            return out
        for n in nodes:
            if n["waiting"]:
                n["waiting"]["chain"] = chain_of(n)
        for n in nodes:
            # Paths ending here: c ← … ← a, for every a whose chain passes through n.
            n["chains"] = [[m["name"]] + m["waiting"]["chain"][:m["waiting"]["chain"].index(n["name"])]
                         for m in nodes if m["waiting"] and n["name"] in m["waiting"]["chain"]
                         and m["waiting"]["chain"].index(n["name"]) >= 1]   # direct: awaited_by
        try:
            cctx = cli_ctx(pdir, repo, tree)
            mark_held(cctx, nodes)
            for n in nodes:
                n["assigned"] = list(CLI.assignment_for(cctx, n["name"]))
        except Exception:
            pass
        # Doorbell mail not yet shown to the node's session, and whether a
        # waiter is armed to wake it (2026-10-06: a ring to main sat unread).
        bctx = cli_ctx(pdir, repo, tree)
        for n in nodes:
            try:
                n["mail"] = CLI.MAIL().pending(Path(pdir), n["name"])
                n["bell"] = bool(CLI.bell_armed(bctx, n["name"]))
            except Exception:
                n["mail"], n["bell"] = 0, False
        nodes.sort(key=lambda n: (n["rank"], n["name"]))
        pname = Path(repo).name

        # A wait is its LEAD's to answer, and tree state belongs in the tree —
        # so a wait is drawn on the card. A wait whose lead is not running gets
        # one more line saying so, because then no session in the tree can
        # answer it. Occupancy has to be KNOWN for that; when the roster could
        # not be read, nothing is claimed either way.
        live_of = {n["name"]: n["sessions"] for n in nodes}
        for wn, wr in sorted(waits.items()):
            par = wr.get("parent")
            if rows is None or live_of.get(par) is None or live_of.get(par):
                continue
            if _wait_mins(wr.get("since")) < 20:
                continue
            _sig(wn, kind="unanswered", frm=par or "its lead",
                 text=f"asked {par} and stopped — {par} is not running",
                 task="", do=f"harness spawn {par}")
        ch = {"description": "", "revision": 0, "features": []}
        cf = pdir / "charter.json"
        if cf.exists():
            try:
                raw = json.loads(cf.read_text())
                d = raw.get("description") or {}
                ch = {"description": d.get("text") or "",
                      "revision": d.get("revision") or 0,
                      "written_by": d.get("written_by") or "",
                      # The CLI's ordering, not this file's opinion of one.
                      # Two copies of "what order are the features in" is two
                      # that drift, and nothing compares them.
                      "features": [
                          {"key": k, "name": v.get("name") or k,
                           "text": v.get("text") or "",
                           "revision": v.get("revision") or 0,
                           "parent": v.get("parent") or None,
                           "depth": depth}
                          for k, v, depth in CLI.charter_order(raw)]}
            except Exception:
                ch["error"] = "charter.json is not readable"
        projects.append({"project": pname, "repo": repo, "slug": pdir.name,
                         "charter": ch,
                         "nodes": nodes,
                         "orphan_marks": sorted(orphans, key=lambda o: o["task"]),
                         "asks": asks, "rulings": rulings,
                         "intermediary": intermediary(rows, repo, asks, pdir),
                         "tests": tests_queue(pdir, repo),
                         "halt": CLI._read_json(Path(pdir) / "halt.json"),
                         "documenter": documenter(rows, pdir, repo, asks,
                                                  next((n for n, sp in tree.items()
                                                        if not sp.get("parent")), None)),
                         "indexed_at": idx.get("generated")})
    return {"generated": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            # Counted when it is the owner's move, never when an ask merely
            # arrives: the intermediary may still send it back or merge it, and a
            # count that rises and falls on its own is one the owner learns to
            # ignore.
            "owner": {"count": sum(1 for p in projects for a in p["asks"]
                                   if a.get("state") in ASK_OWNERS or a.get("runs"))},
            "roster_error": roster_error, "stale_server": stale_server(),
            # The harness CLI and the skills under ~/.claude/skills are copies;
            # when their source has moved, every session reads older
            # instructions than were written, and nothing else reports it.
            "stale_install": install_drift() or "",
            "started": time.strftime("%H:%M:%S", time.localtime(STARTED)),
            "projects": projects}


