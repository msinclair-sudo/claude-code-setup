                    help="record that the answer produced no work, and why")
    bk.add_argument("--decided", action="store_true",
                    help="answered blocks with no task written yet (rank 0's queue)")
    bk.add_argument("--comment", metavar="TEXT",
                    help="answer or add context; does not clear the block")
    bk.add_argument("--list", action="store_true", help="every open block")
    br = add("brief", cmd_brief, force=True)
    br.add_argument("task", help="task id")
    br.add_argument("--for", dest="for_node", metavar="NODE",
                    help="which node the brief is for (needed on the first write)")
    br.add_argument("--write", metavar="TEXT",
                    help="write or rewrite it; a lead writes its children's, rank 0 "
                         "its own. Use '-' and a quoted heredoc for prose containing "
                         "backticks or $(), which a shell eats before this sees them")
    br.add_argument("--band", metavar="S|M|L",
                    help="the estimated size in new tokens (I10). Written with the "
                         "brief, by the lead that made the estimate; XL is refused here")
    br.add_argument("--suggest", metavar="TEXT",
                    help="propose a change to your own brief; your lead decides")
    br.add_argument("--comment", metavar="TEXT",
                    help="context for whoever works on it; does NOT change the brief")
    br.add_argument("--from-finding", dest="from_finding", metavar="NAME",
                    help="the finding this task comes from; gates it on operator approval")
    br.add_argument("--needs-approval", dest="needs_approval", action="store_true",
                    help="write it, but do not let it be staffed until the operator agrees")
    br.add_argument("--approve", action="store_true",
                    help="operator only: release a gated task into its node's queue")
    br.add_argument("--decline", metavar="WHY",
                    help="operator only: refuse a gated task, on the record")
    br.add_argument("--supersede", metavar="WHY",
                    help="withdraw a brief you wrote — nothing will start it again")
    br.add_argument("--by", dest="superseded_for", metavar="TASK",
                    help="the task that replaces it, if there is one")
    br.add_argument("--fact", action="append", metavar="NAME",
                    help="cite a recorded measurement; resolved live when the brief "
