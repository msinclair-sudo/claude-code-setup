#!/usr/bin/env python3
"""harness-mail: hand a node's doorbell mail to its session, from a hook.

The doorbell used to be read only by a background `harness doorbell` the
session had to keep armed and re-arm after every ring. A session that never
armed one (rank 0, attended, compacted) never read its mail: an owner's note
sat in main's inbox while main was busy in the next window (owner, 2026-10-06).
Hooks need no arming. This script is the PostToolUse half and runs after every
tool call, so it is kept small: stdlib only, no harness import, and silent
unless there is mail. `harness` loads `take`/`render` from here for the Stop
hook, orientation and `harness doorbell --read`, so there is one reader.

Mail goes only to the session holding the node's lock. A second session opened
in the same checkout, or a subagent (its hook payload carries `agent_id`),
gets nothing and leaves the mail where it is.
"""
import json
import os
import re
import sys
import time
from pathlib import Path

HOME_STATE = Path.home() / ".claude" / "harness"


def find_node(cwd):
    """(state dir, node) for the worktree holding `cwd`, from each project's
    index.json; the longest matching worktree wins. None outside every tree."""
    best = None
    for idx in HOME_STATE.glob("*/index.json"):
        try:
            by = json.loads(idx.read_text()).get("byWorktree") or {}
        except Exception:
            continue
        for wt, node in by.items():
            w = wt.rstrip("/")
            if (cwd == w or cwd.startswith(w + "/")) and (not best or len(w) > best[0]):
                best = (len(w), idx.parent, node)
    return (best[1], best[2]) if best else None


def owner(state, node):
    """The session id in the node's lock, or None."""
    f = Path(state) / "locks" / (re.sub(r"[^A-Za-z0-9]", "_", node) + ".lock")
    try:
        return json.loads(f.read_text()).get("session_id")
    except Exception:
        return None


def _pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError):
        return False


def _restore_stale(d):
    """A claim whose process died before it showed the message (a hook killed at
    its timeout, log 120) goes back to the inbox, to be shown again."""
    for c in d.glob("*.taken-*"):
        pid = c.name.rsplit("-", 1)[-1]
        if not _pid_alive(pid):
            try:
                os.rename(c, c.with_name(c.name.split(".taken-")[0] + ".json"))
            except OSError:
                pass


def pending(state, node):
    """How many messages wait unread."""
    d = Path(state) / "doorbell" / node / "inbox"
    if not d.is_dir():
        return 0
    _restore_stale(d)
    return len(list(d.glob("*.json")))


# A message's priority (owner, 2026-10-10, log 134). high interrupts: it is
# shown after the receiver's next tool call, and the ringer wakes an idle one
# at once. low waits until the receiver is idle. fyi asks for nothing and never
# wakes anyone; it is shown with whatever is delivered next.
PRIORITIES = ("high", "low", "fyi")


def prio(m):
    p = (m or {}).get("priority")
    return p if p in PRIORITIES else "high"


def unread(state, node):
    """The unread messages, oldest first, without claiming them (the ringer's
    view: it decides whether to wake, and never takes mail)."""
    d = Path(state) / "doorbell" / node / "inbox"
    if not d.is_dir():
        return []
    _restore_stale(d)
    out = []
    for f in sorted(d.glob("*.json")):
        try:
            out.append(json.loads(f.read_text()))
        except Exception:
            pass
    return out


def claim(state, node, only=None):
    """Claim every unread message, oldest first: [(claim path, message)]. Each
    file is claimed by an atomic rename, so two readers (a tool call and a turn
    end at once) never both deliver it. Nothing is marked delivered until
    commit(): a hook killed between the two leaves the claim, and the next read
    puts it back (log 120: two messages were logged as shown and never seen).
    `only` is a set of priorities: the rest are left in the inbox."""
    d = Path(state) / "doorbell" / node / "inbox"
    if not d.is_dir():
        return []
    _restore_stale(d)
    out = []
    for f in sorted(d.glob("*.json")):
        if only is not None:
            try:
                if prio(json.loads(f.read_text())) not in only:
                    continue
            except Exception:
                continue
        c = f.with_name(f"{f.stem}.taken-{os.getpid()}")
        try:
            os.rename(f, c)
        except OSError:
            continue                        # another reader has it
        try:
            out.append((c, json.loads(c.read_text())))
        except Exception:
            c.unlink(missing_ok=True)
    return out


def commit(state, node, claimed, how):
    """The claimed messages were shown: log them as delivered, drop the claims."""
    if not claimed:
        return []
    at = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    with open(Path(state) / "doorbell" / node / "delivered.jsonl", "a") as log:
        for _, m in claimed:
            log.write(json.dumps(dict(m, delivered=at, how=how)) + "\n")
    for c, _ in claimed:
        c.unlink(missing_ok=True)
    return [m for _, m in claimed]


def take(state, node, how):
    """Claim and commit at once, for a reader whose output cannot be lost
    between the two (a Stop hook's block, `doorbell --read`)."""
    return commit(state, node, claim(state, node), how)


def delivered(state, node, n=5):
    """The last n delivered messages, oldest first (`doorbell --read --again`)."""
    f = Path(state) / "doorbell" / node / "delivered.jsonl"
    try:
        lines = f.read_text().splitlines()[-n:]
    except OSError:
        return []
    out = []
    for line in lines:
        try:
            out.append(json.loads(line))
        except ValueError:
            pass
    return out


def _ago(at):
    """'(1h05m ago)' for a message's timestamp, so a stale one reads as stale
    (log 94: a request to re-file work the owner had already run)."""
    try:
        import datetime
        t = datetime.datetime.strptime(at, "%Y-%m-%dT%H:%M:%S%z").timestamp()
    except Exception:
        return ""
    s = max(0, int(time.time() - t))
    if s < 60:
        return ""
    return f" ({s // 3600}h{s % 3600 // 60:02d}m ago)" if s >= 3600 else f" ({s // 60}m ago)"


def own_note(m, node, sid):
    """A message this node's own session sent itself. The sender's name is not
    enough: a ring from a shell in a node's checkout is signed with that node's
    name, and it is the owner speaking, not a note to self."""
    return bool(node and sid and m.get("from") == node and m.get("session") == sid)


def render(msgs, node=None, sid=None):
    """Mail as the session reads it. Only mail that asks for something carries
    the demand to act: an FYI, or a note the session sent itself, is information
    (log 134: every message, a thanks included, read as an order)."""
    row = lambda m, who: (f"  {(m.get('at') or '')[11:16]}{_ago(m.get('at') or '')}  "
                          f"{who}: {m.get('text')}")
    own = [m for m in msgs if own_note(m, node, sid)]
    fyi = [m for m in msgs if prio(m) == "fyi" and m not in own]
    act = [m for m in msgs if m not in own and m not in fyi]
    lines = []
    if act:
        lines.append(f"Doorbell — {len(act)} message(s) for you:")
        lines += [row(m, f"from {m.get('from') or '?'}") for m in act]
        lines.append("They are marked read: act on them now, or say on the record why not.")
    if fyi:
        lines.append(f"FYI, no action needed — {len(fyi)} message(s):")
        lines += [row(m, f"from {m.get('from') or '?'}") for m in fyi]
    if own:
        lines.append(f"Your own note(s) to yourself — {len(own)}:")
        lines += [row(m, "you wrote") for m in own]
    return "\n".join(lines)


def main():
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except Exception:
        return
    if payload.get("agent_id"):
        return
    if os.environ.get("HARNESS_DESIGN"):
        return                      # a design session is beside a node, never its session
    try:
        hit = find_node(payload.get("cwd") or os.getcwd())
        if not hit:
            return
        state, node = hit
        sid = payload.get("session_id") or os.environ.get("CLAUDE_CODE_SESSION_ID")
        who = owner(state, node)
        if not sid or (who and who != sid) or not pending(state, node):
            return
        # Mid-turn, only what interrupts. Low and FYI mail waits for the turn
        # to end (log 134).
        got = claim(state, node, only={"high"})
        if got:
            print(json.dumps({"hookSpecificOutput": {
                "hookEventName": "PostToolUse",
                "additionalContext": render([m for _, m in got], node, sid)}}), flush=True)
            commit(state, node, got, "tool call")
    except Exception:
        return


if __name__ == "__main__":
    main()
