#!/usr/bin/env python3
"""harness-gui — a read-only window onto every harness tree on this machine.

A VIEWER, not a participant. It never claims, never writes, never decides, and
holds no authority over anything it shows, so [[R4]]'s "no arbiter process" is
untouched: this can be closed at any moment and nothing in the harness notices.
Everything it renders is already on disk; the only thing it adds is that a human
can see all of it at once without running a command per project.

Served on 127.0.0.1 only. Stdlib only, one file, no build step.

    harness-gui               # serve and open a browser
    harness-gui --port 9000   # a port of your own; refused rather than moved
    harness-gui --no-open
    harness-gui --once        # print the JSON it would serve, and exit

The default port is 8791 and it walks upward if that is taken. 8787 is RStudio
Server's, 8888 is Jupyter's, and a viewer that refuses to start because someone
else's long-running service got there first is a viewer nobody opens.
"""
import argparse, importlib.util, json, os, subprocess, sys, threading, time, webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from importlib.machinery import SourceFileLoader
from urllib.parse import parse_qs, urlparse
from pathlib import Path


# Loading the CLI as a module would otherwise drop a __pycache__ into the install
# directory, on every run, for a file that is never imported twice in a process.
sys.dont_write_bytecode = True


def load_cli():
    """Reuse the CLI's readers rather than restating them.

    `live_rows` and `scan_needs` are the definitions of "actually running" and
    "open block". A viewer with its own second copy of either would drift, and
    would drift silently, since nothing compares them.
    """
    p = Path(__file__).resolve().with_name("harness")
    spec = importlib.util.spec_from_loader("harness_cli", SourceFileLoader("harness_cli", str(p)))
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


CLI = load_cli()

# Not 8787 (RStudio Server) and not 8888 (Jupyter). Both are long-running
# services someone starts once and forgets, so losing a coin-toss with either
# means the viewer is the thing that fails to start.
DEFAULT_PORT = 8791

# A long-running server hands out the page it loaded at startup, so editing the
# source and reloading the browser changes nothing at all -- and there is no
# symptom, which is worse. Both files are stat'd on every state read so the page
# can say "the server is older than the code" instead of quietly lying.
STARTED = time.time()
SOURCES = [Path(__file__).resolve(), Path(__file__).resolve().with_name("harness")]


def stale_server():
    try:
        return max(p.stat().st_mtime for p in SOURCES if p.exists()) > STARTED
    except Exception:
        return False


def _rank(tree, name):
    r, seen = 0, set()
    while True:
        p = tree.get(name, {}).get("parent")
        if p is None or p in seen or p not in tree:
            return r
        seen.add(name); name = p; r += 1


_ROSTER = {"at": 0.0, "rows": None, "error": None}
_RLOCK = threading.Lock()


def roster(max_age=2.5):
    """One `claude agents --json` per poll at most, and never two at once.

    Measured: 0.55s of process spawn per read. The page polls every 3s, so
    without this every open tab is a `claude` process every three seconds
    forever, and a slow read has the next one starting on top of it.

    Returns (rows, error). `rows is None` means the roster could not be read —
    which is NOT the same answer as an empty roster, and the difference is the
    whole bug this replaces: a failed read became `rows = []`, every node lost
    its session, and a tree full of working sessions rendered as empty.
    """
    with _RLOCK:
        now = time.time()
        if _ROSTER["rows"] is not None and now - _ROSTER["at"] < max_age:
            return _ROSTER["rows"], _ROSTER["error"]
        try:
            _ROSTER["rows"], _ROSTER["error"] = CLI.live_rows(CLI.agents_json()), None
        except Exception as e:
            _ROSTER["rows"], _ROSTER["error"] = None, f"{type(e).__name__}: {e}"[:200]
        _ROSTER["at"] = now
        return _ROSTER["rows"], _ROSTER["error"]


def read_state():
    rows, roster_error = roster()
    # A LIST per worktree, not one session. Two sessions in one worktree is the
    # condition the statusline colours red; a dict keyed on cwd silently kept the
    # last one and reported the breach as normal occupancy.
    by_cwd = {}
    for r in (rows or []):
        by_cwd.setdefault(r.get("cwd"), []).append(r)
    needs = CLI.scan_needs()
    projects = []
    for pdir in sorted(p for p in CLI.HOME_STATE.glob("*") if p.is_dir()):
        b = pdir / "binding.json"
        if not b.exists():
            continue
        try:
            repo = json.loads(b.read_text()).get("repo", "")
        except Exception:
            continue
        # tree.json is the truth; index.json only supplies worktree paths, and a
        # node the index has not caught up with is shown rather than hidden.
        tp = Path(repo) / ".harness" / "tree.json"
        if not tp.exists():
            continue
        try:
            tree = json.loads(tp.read_text()).get("nodes", {})
        except Exception:
            continue
        idx = {}
        ip = pdir / "index.json"
        if ip.exists():
            try:
                idx = json.loads(ip.read_text())
            except Exception:
                idx = {}
        wt_of = {n: s.get("worktree") for n, s in idx.get("nodes", {}).items()}
        locks = {}
        ld = pdir / "locks"
        for lf in (sorted(ld.glob("*.lock")) if ld.is_dir() else []):
            try:
                h = json.loads(lf.read_text()); locks[h.get("node")] = h
            except Exception:
                pass
        tasks, orphans, ever_marked = {}, [], set()
        md = pdir / "marks"
        for mf in (sorted(md.glob("*.json")) if md.is_dir() else []):
            try:
                r = json.loads(mf.read_text())
            except Exception:
                continue
            # Every mark, open or closed. A brief whose task was done and signed
            # off is not work waiting to be started, and showing it as such put
            # finished work back on the board.
            ever_marked.add(mf.stem)
            if r.get("_closed_at"):
                continue
            n = r.get("_node")
            # Counted, not dropped: an open record naming no node is a fact about
            # the ledger, and hiding it is how six of them sat there unnoticed.
            if n is None or n not in tree:
                orphans.append({"task": mf.stem, "named": n,
                                "at": (r.get("_at") or "")[:19].replace("T", " ")})
            else:
                tasks.setdefault(n, []).append(
                    {"task": mf.stem, "presented": bool(r.get("_presented_at"))})
        # A brief exists BEFORE its mark: the lead writes it, then the member
        # accepts. Without this the handed-out work is invisible until someone
        # picks it up, which is exactly the window a lead needs to see.
        briefs = {}
        bd = pdir / "briefs"
        for bf in (sorted(bd.glob("*.json")) if bd.is_dir() else []):
            try:
                r = json.loads(bf.read_text())
            except Exception:
                continue
            if r.get("node"):
                briefs.setdefault(r["node"], []).append(
                    {"task": bf.stem,
                     "open_suggestions": sum(1 for x in (r.get("suggestions") or [])
                                             if not x.get("resolved_at"))})
        blocks = [x for x in needs if x.get("_repo") == repo]
        nodes = []
        for name, spec in tree.items():
            wt = wt_of.get(name)
            here = by_cwd.get(wt, []) if wt else []
            nodes.append({
                "name": name, "branch": spec.get("branch"), "parent": spec.get("parent"),
                "kind": spec.get("kind"), "rank": _rank(tree, name), "worktree": wt,
                "indexed": name in idx.get("nodes", {}),
                # null, meaning unknown, is deliberately distinct from [] here.
                "sessions": (None if rows is None else
                             [{"name": r.get("name"), "status": r.get("status"),
                               "id": (r.get("sessionId") or "")[:8]} for r in here]),
                "claimed": name in locks,
                "tasks": sorted(tasks.get(name, []), key=lambda x: x["task"]),
                # Briefed but not yet marked: handed out, not started.
                "briefed": sorted((b for b in briefs.get(name, [])
                                   if b["task"] not in ever_marked),
                                  key=lambda b: b["task"]),
                "blocks": [x for x in blocks if x.get("node") == name],
            })
        nodes.sort(key=lambda n: (n["rank"], n["name"]))
        projects.append({"project": Path(repo).name, "repo": repo, "slug": pdir.name,
                         "nodes": nodes,
                         "blocks": blocks,
                         "orphan_marks": sorted(orphans, key=lambda o: o["task"]),
                         "indexed_at": idx.get("generated")})
    return {"generated": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            "roster_error": roster_error, "stale_server": stale_server(),
            "started": time.strftime("%H:%M:%S", time.localtime(STARTED)),
            "projects": projects, "needs": needs}


