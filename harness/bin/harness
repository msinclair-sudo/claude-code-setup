                    help="review against REF instead of the parent (read work already merged)")
    rv.add_argument("--last", type=int, default=10, metavar="N",
                    help="when nothing is pending, show the last N commits (default 10)")
    ig = add("integrate", cmd_integrate)
    ig.add_argument("node", nargs="*", help="children to integrate, in the order given")
    ig.add_argument("--children", action="store_true",
                    help="every child of this node that has presented")
    ig.add_argument("--dry-run", action="store_true")
    ig.add_argument("--roster", metavar="FILE",
                    help="a `claude agents --json` capture, for testing")
    rcy = add("recycle", cmd_recycle)
    rcy.add_argument("node", nargs="*", help="nodes to restart with fresh context")
    rcy.add_argument("--children", action="store_true", help="every child of this node")
    rcy.add_argument("--roster", help="a `claude agents --json` capture, for testing")
    rcy.add_argument("--cold", action="store_true",
                     help="children whose sessions are past the cache lifetime, so "
                          "resuming them costs a full context re-read")
    rcy.add_argument("--idle", action="store_true",
                     help="every child with no OPEN task record — the sweep at subtree close")
    rcy.add_argument("--dry-run", action="store_true")
