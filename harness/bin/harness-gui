color:var(--none);margin:0 9px 0 0;flex:none}
.cbgrp{display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 7px}
.cbgrp>b{color:var(--dim);font-weight:400;font-size:10px;letter-spacing:.05em;
text-transform:uppercase}
.cbcmd{color:var(--busy);cursor:help;border-bottom:1px dotted transparent}
.cbcmd:hover{color:#b6e37f;border-bottom-color:#4a6b30}

/* The charter is an outline: features carry an order the operator set and may
   sit under one another. Same controls as the tree it describes. */
.chead{display:flex;align-items:baseline;gap:5px;cursor:pointer;padding:1px 0}
.tri{color:var(--none);flex:none;font-size:9px;width:8px}
/* Present but faint, full strength under the pointer. Hidden until hover the
   panel reads as having no controls at all, and a control nobody finds is one
   that is not there. */
.cacts{margin-left:auto;display:flex;gap:1px;flex:none;opacity:.3;
transition:opacity .12s}
.chead:hover .cacts,.cacts.live{opacity:1}
.cact{color:var(--none);cursor:pointer;padding:0 3px;border-radius:4px;
font-size:10px;line-height:1.6}
.cact:hover{color:var(--ink);background:#00000050}
.cact.del:hover{color:var(--warn)}
.cact.armed{color:var(--warn);background:var(--warnbg);opacity:1}
.sub{margin-left:11px;border-left:1px solid var(--line);padding-left:9px}
.cmsg2{color:var(--warn);font-size:11px;line-height:1.45;margin:5px 0 7px}
</style></head><body>
<header><h1>harness</h1><span id="ct"></span><span id="age"></span></header>
<main id="root"><div class="empty">loading...</div></main>
<div id="modal"></div>
<script>
// No inline onclick anywhere. Nested quoting inside an HTML attribute inside a
// JS string inside a Python string is three levels of escaping, and it silently
// produced a script that would not parse at all -- a blank page, served 200.
// One delegated listener removes the whole class of fault.
const esc = s => String(s ?? '').replace(/[&<>"]/g, c =>
  ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

const EDITING = new Set();

// What is open, and what has been folded away, kept in localStorage rather
// than in the DOM: the page redraws every three seconds, and a panel that
// remembers its state only in the markup closes itself while you are reading
// it.
const FKEY = 'harness.featopen', RULEKEY = 'harness.ruleopen';
const load = k => { try { return JSON.parse(localStorage.getItem(k) || '[]'); }
                    catch (e) { return []; } };
const save = (k, s) => { try { localStorage.setItem(k, JSON.stringify([...s])); }
                         catch (e) {} };
const RULEOPEN = new Set(load(RULEKEY));

// ── the command bar ────────────────────────────────────────────────────────
// What to type, packed into as few rows as it will go, with the detail on
// hover. It is a reference, not a workspace: the outline controls live on the
// charter, which is the thing that actually changes.
//
// The list is still ~/.claude/harness/commands.json and still hand-editable.
// Delete the file to get the defaults back.
function cmdbar(groups) {
  if (!groups.length) return '';
  const flat = g => (g.cmd ? [g] : []).concat(g.items || []);
  return '<div class="cmdbar"><h3>slash commands</h3>' +
    groups.map(g =>
      '<span class="cbgrp"><b title="' + esc(g.note || '') + '">' +
      esc(g.name || '') + '</b>' +
      flat(g).map(it =>
        '<span class="cbcmd" title="' +
        esc((it.what || '') + (it.when ? '\n\n' + it.when : '')) + '">' +
        esc(it.cmd || it.name || '') + '</span>').join('') +
      '</span>').join('') +
    '</div>';
}

// ── the charter outline ────────────────────────────────────────────────────
// Collapse state by feature key, the one destructive click waiting for its
// second, and the refusal the CLI last gave. Kept out of the poll's way: the
// page redraws every three seconds and state that lives only in the DOM is
// state that resets itself while you are reading it.
const OPENF = new Set(load(FKEY));
let FSEEDED = localStorage.getItem(FKEY) !== null;
let ARMED = null;
let CHMSG = '';

// Slug and feature stay two attributes rather than one packed id. There is no
// separator that a feature name cannot contain, and picking one that "probably
// won't appear" is a bug waiting for the first feature called "read/write".
function cact(slug, feat, act, glyph, title, cls) {
  const armed = ARMED === act + '\n' + slug + '\n' + feat;
  return '<span class="cact ' + (cls || '') + (armed ? ' armed' : '') +
    '" data-cact="' + act + '" data-cslug2="' + esc(slug) + '" data-cfeat="' +
    esc(feat) + '" title="' + esc(title) + '">' + (armed ? '?' : glyph) + '</span>';
}

// Why a whole CLASS of item is the operator's to decide -- once, under the
// heading, folded away. It is identical on every grant, and printed under each
// one it pushed the two lines that differ off the bottom of the box.
function rulesFor(items, rules) {
  const kinds = [...new Set(items.map(a => a.rule).filter(Boolean))];
  return kinds.map(k => {
    const r = (rules || {})[k] || {};
    const open = RULEOPEN.has(k);
    return '<div class="rule" data-ruletog="' + esc(k) + '">' +
      '<span class="tri">' + (open ? '&#9660;' : '&#9654;') + '</span>' +
      esc(r.title || k) + '</div>' +
      (open ? '<div class="ruletext">' + esc(r.text || '') + '</div>' : '');
  }).join('');
}

// The swap happens in the DOM rather than through a re-render, so the textarea
// is created once and keeps its cursor, its selection and its scroll. Cancel
// puts back exactly what was there, which is why the original HTML is stashed
// rather than rebuilt.
function beginEdit(el, opts) {
  const box = opts.cnew ? null : el;
  const raw = box ? (box.dataset.raw || '') : '';
  const key = opts.slug + ':' + (opts.feature || '');
  if (EDITING.has(key)) return;
  EDITING.add(key);
  const host = opts.cnew ? el : box;
  host.dataset.stash = host.innerHTML;
  host.classList.add('editing');
  const nameField = opts.cnew
    ? '<input class="cname" placeholder="feature name" />' : '';
  const ph = opts.cnew ? 'what this feature is, in plain prose'
                       : 'what this is, written to be understood';
  host.innerHTML = nameField +
    '<textarea class="cta" placeholder="' + ph + '">' +
    esc(raw) + '</textarea>' +
    '<div class="crow"><span class="cbtn csave">save</span>' +
    '<span class="cbtn ccancel">cancel</span><span class="cmsg"></span></div>';
  host.dataset.ckey = key;
  host.dataset.cslug = opts.slug;
  host.dataset.cfeature = opts.feature || '';
  host.dataset.cnew = opts.cnew ? '1' : '';
  const ta = host.querySelector('.cta');
  ta.focus();
  ta.setSelectionRange(ta.value.length, ta.value.length);
}

function endEdit(host) {
  EDITING.delete(host.dataset.ckey);
  host.classList.remove('editing');
  host.innerHTML = host.dataset.stash || '';
  // Every marker goes, not just the stash. A left-behind data-ckey makes an
  // element that is no longer being edited answer a query for one that is.
  ['stash', 'ckey', 'cslug', 'cfeature', 'cnew']
    .forEach(k => delete host.dataset[k]);
}

document.addEventListener('click', e => {
  const ca = e.target.closest('.cact');
  if (ca) {
    e.stopPropagation();
    const act = ca.dataset.cact;
    const slug = ca.dataset.cslug2, feature = ca.dataset.cfeat;
    const k = act + '\n' + slug + '\n' + feature;
    // Deleting is absolute, which is the whole reason it takes two clicks. The
    // warning says what does NOT happen, because everything else the harness
    // removes leaves a closed row behind and this leaves nothing.
    if (act === 'delete' && ARMED !== k) {
      ARMED = k;
      CHMSG = 'Click the ? again to delete "' + feature + '". Nothing is kept — ' +
              'no record, no reason, no way back — and any sub-features under it ' +
              'go too.';
      LAST = ''; tick(); return;
    }
    ARMED = null; CHMSG = '';
    fetch('/api/charter', { method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Harness-Local': '1' },
      body: JSON.stringify({ slug: slug, feature: feature, action: act }) })
      .then(r => r.json())
      .then(j => { CHMSG = j.ok ? '' : (j.message || 'refused'); LAST = ''; tick(); })
      .catch(() => { CHMSG = 'could not reach the server'; LAST = ''; tick(); });
    return;
  }
  const ct = e.target.closest('[data-ftog]');
  if (ct) {
    e.stopPropagation();
    const id = ct.dataset.ftog;
    OPENF.has(id) ? OPENF.delete(id) : OPENF.add(id);
    save(FKEY, OPENF); ARMED = null; CHMSG = ''; LAST = ''; tick(); return;
  }
  const rt = e.target.closest('[data-ruletog]');
  if (rt) {
    e.stopPropagation();
    const k = rt.dataset.ruletog;
    RULEOPEN.has(k) ? RULEOPEN.delete(k) : RULEOPEN.add(k);
    save(RULEKEY, RULEOPEN); LAST = ''; tick(); return;
  }
  // An armed delete disarms itself the moment you look somewhere else.
  if (ARMED) { ARMED = null; CHMSG = ''; LAST = ''; tick(); }
  const ce = e.target.closest('.cedit');
  if (ce) {
    e.stopPropagation();
    const cnew = ce.dataset.cnew === '1';
    const host = cnew ? ce.closest('.feats')
                      : ce.closest('.charter').querySelector(
                          ce.dataset.cfeature
                            ? '.feat .cbody[data-raw]' : '.ctext.cbody');
    // A feature's box is the one in its own .feat block, not the first on the page.
    const target = (!cnew && ce.dataset.cfeature)
      ? ce.closest('.feat').querySelector('.cbody') : host;
    beginEdit(target, { slug: ce.dataset.cslug, feature: ce.dataset.cfeature,
                        cnew: cnew });
    return;
  }
  const cc = e.target.closest('.ccancel');
  if (cc) { e.stopPropagation(); endEdit(cc.closest('[data-ckey]')); return; }
  const cs = e.target.closest('.csave');
  if (cs) {
    e.stopPropagation();
    const host = cs.closest('[data-ckey]');
    const ta = host.querySelector('.cta'), msg = host.querySelector('.cmsg');
    const nm = host.querySelector('.cname');
    const text = ta.value.trim();
    const feature = host.dataset.cnew === '1'
      ? (nm ? nm.value.trim() : '') : host.dataset.cfeature;
    if (!text) { msg.textContent = 'nothing to save'; return; }
    if (host.dataset.cnew === '1' && !feature) {
      msg.textContent = 'name it first'; return; }
    msg.textContent = 'saving...';
    fetch('/api/charter', { method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Harness-Local': '1' },
      body: JSON.stringify({ slug: host.dataset.cslug, feature: feature,
                             text }) })
      .then(r => r.json())
      .then(j => {
        if (!j.ok) { msg.textContent = 'refused: ' + (j.message || ''); return; }
        EDITING.delete(host.dataset.ckey);
        host.classList.remove('editing');
        ['stash', 'ckey', 'cslug', 'cfeature', 'cnew']
          .forEach(k => delete host.dataset[k]);
        LAST = ''; tick();
      })
      .catch(() => { msg.textContent = 'could not reach the server'; });
    return;
  }
  const cp = e.target.closest('.cp');
  if (cp) {
    e.stopPropagation();
    const el = document.getElementById(cp.dataset.c);
    navigator.clipboard.writeText(el.textContent).then(
      () => { cp.textContent = 'copied'; },
      () => { cp.textContent = 'select and copy'; });
    return;
  }
  if (e.target.closest('.bell')) {
    const n = document.querySelector('.needs');
    if (n) n.scrollIntoView({ behavior: 'smooth' });
    return;
  }
  if (e.target.dataset.close) { closeModal(); return; }
  const tk = e.target.closest('[data-task]');
  if (tk) { openTask(tk.dataset.slug, tk.dataset.task); return; }
  const col = e.target.closest('.collapse');
  if (col) {
    e.stopPropagation();
    // Scoped to the column it sits in, so collapsing one project leaves the
    // others as you left them.
    col.closest('.attncol').querySelectorAll('.need').forEach(nd => {
      nd.querySelector('.detail').classList.remove('on');
      if (nd.dataset.key) OPEN.delete(nd.dataset.key);
    });
    return;
  }
  const bs = e.target.closest('.bsend');
  if (bs) {
    e.stopPropagation();
    const wrap = bs.closest('.detail');
    const box = wrap.querySelector('.bbox'), msg = wrap.querySelector('.bmsg');
    const text = box.value.trim();
    if (!text) return;
    msg.textContent = 'saving...';
    fetch('/api/comment', { method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Harness-Local': '1' },
      body: JSON.stringify({ kind: 'block', slug: box.dataset.slug,
                             node: box.dataset.node, need: box.dataset.need, text }) })
      .then(r => r.json())
      .then(j => { msg.textContent = j.ok ? 'sent' : 'refused: ' + (j.message || '');
                   if (j.ok) { box.value = ''; delete DRAFT[boxKey(box)];
                               LAST = ''; tick(); } })
      .catch(err => { msg.textContent = 'failed: ' + err; });
    return;
  }
  if (e.target.closest('.bbox')) { e.stopPropagation(); return; }
  const need = e.target.closest('.need');
  if (need) {
    const on = need.querySelector('.detail').classList.toggle('on');
    // Remembered by key, not by position. The poll rebuilds this panel every
    // three seconds, and an expansion that lives only in the DOM is an
    // expansion that closes itself two seconds after you open it.
    if (need.dataset.key) on ? OPEN.add(need.dataset.key) : OPEN.delete(need.dataset.key);
  }
});
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

// ── task modal ─────────────────────────────────────────────────────────────
let MODAL = null;   // {slug, task}
const OPEN = new Set();   // expanded attention items, by key
const DRAFT = {};         // half-typed comments, by box identity
let LAST = '';            // last payload rendered, to avoid pointless redraws

const boxKey = b => b.dataset.slug + '|' + b.dataset.node + '|' + b.dataset.need;

// Only the shape-changed rebuild can reach a box, and that path restores these.
document.addEventListener('input', e => {
  const b = e.target.closest && e.target.closest('.bbox');
  if (b) DRAFT[boxKey(b)] = b.value;
});

function reopen() {
  document.querySelectorAll('[data-key]').forEach(el => {
    if (OPEN.has(el.dataset.key)) el.querySelector('.detail').classList.add('on');
  });
  document.querySelectorAll('.bbox').forEach(b => {
    const d = DRAFT[boxKey(b)];
    if (d) b.value = d;
  });
}

function closeModal() { MODAL = null; document.getElementById('modal').innerHTML = ''; }

async function openTask(slug, task) {
  MODAL = { slug, task };
  const d = await (await fetch('/api/task?p=' + encodeURIComponent(slug) +
                              '&t=' + encodeURIComponent(task))).json();
  if (d.error) { closeModal(); return; }
  const cs = (d.brief_comments || []).concat(d.comments || []).map(c =>
    '<div class="cmt"><div class="cmt-h">' + esc(c.by) + ' &middot; ' +
    esc(String(c.at || '').slice(0, 16).replace('T', ' ')) + '</div>' +
    '<div class="cmt-b">' + esc(c.text) + '</div></div>').join('')
    || '<div class="ln q">no comments yet</div>';
  document.getElementById('modal').innerHTML =
    '<div class="veil" data-close="1"><div class="sheet">' +
      '<div class="sheet-h"><b>' + esc(d.task) + '</b>' +
        '<span class="x" data-close="1">close</span></div>' +
      '<dl>' +
        '<dt>node</dt><dd>' + (d.node ? esc(d.node) +
            (d.branch ? ' <span class="q">(' + esc(d.branch) + ')</span>' : '')
          : '<span class="dup">names no node &mdash; it predates the field</span>') + '</dd>' +
        '<dt>state</dt><dd>' + (
            d.closed ? '<b>signed off</b> <span class="q">by ' + esc(d.closed_by || '?') +
              ' &middot; ' + esc(String(d.closed).slice(0, 19).replace('T', ' ')) + '</span>'
          : d.presented_at ? '<b class="dup">presented &mdash; waiting on its lead</b> ' +
              '<span class="q">by ' + esc(d.presented_by || '?') + ' &middot; ' +
              esc(String(d.presented_at).slice(0, 19).replace('T', ' ')) + '</span>'
          : d.marked ? 'open' : '<span class="q">briefed, not started</span>') + '</dd>' +
        (d.opened ? '<dt>opened</dt><dd>' +
          esc(String(d.opened).slice(0, 19).replace('T', ' ')) +
          ' <span class="q">session ' + esc(d.session) + '</span></dd>' : '') +
        '<dt>brief' + (d.brief_rev ? ' <span class="q">rev ' + esc(d.brief_rev) +
            '</span>' : '') + '</dt><dd>' +
          (d.brief ? '<div class="brief">' + esc(d.brief) + '</div>' +
             '<div class="ln q">' + esc(d.brief_by) + ' &middot; ' +
             esc(String(d.brief_at || '').slice(0, 19).replace('T', ' ')) + '</div>'
           : '<span class="q">no brief written &mdash; its lead writes one with ' +
             'harness brief ' + esc(d.task) + ' --for &lt;node&gt; --write</span>') + '</dd>' +
        (d.suggestions.length ? '<dt>suggestions</dt><dd>' + d.suggestions.map((sg, i) =>
          '<div class="cmt"><div class="cmt-h">#' + (i + 1) + ' ' +
          (sg.resolved_at ? 'resolved' : '<b class="dup">open</b>') + ' &middot; ' +
          esc(sg.by) + ' &middot; against rev ' + esc(sg.against_revision) + '</div>' +
          '<div class="cmt-b">' + esc(sg.text) + '</div></div>').join('') + '</dd>' : '') +
        '<dt>comments</dt><dd>' + cs + '</dd>' +
      '</dl>' +
      '<textarea id="cbox" placeholder="context for whoever works on this..."></textarea>' +
      '<div class="row"><button id="csend">comment</button>' +
      '<span class="ln q" id="cmsg">' + (d.brief_rev
        ? 'appended to the brief, never edited. It does not change the instruction: '
          + 'the node and its lead see it at their next harness command, and the lead '
          + 'rewrites the brief if it should change.'
        : 'appended to the task record, never edited') + '</span></div>' +
    '</div></div>';
  document.getElementById('csend').onclick = sendComment;
}

async function sendComment() {
  const box = document.getElementById('cbox');
  const msg = document.getElementById('cmsg');
  const text = box.value.trim();
  if (!text || !MODAL) return;
  msg.textContent = 'saving...';
  try {
    const r = await fetch('/api/comment', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Harness-Local': '1' },
      body: JSON.stringify({ slug: MODAL.slug, task: MODAL.task, text })
    });
    const j = await r.json();
    if (!j.ok) { msg.textContent = 'refused: ' + (j.message || r.status); return; }
    box.value = '';
    openTask(MODAL.slug, MODAL.task);
  } catch (e) { msg.textContent = 'failed: ' + e; }
}

// Each item carries its own explanation, because a queue you have to reason
// about before you can act on it is a queue that does not get cleared.
function attnItem(a, i) {
  const key = a.kind + '|' + a.where + '|' + a.what;
  const n = (a.comments || []).length;
  const cs = (a.comments || []).map(c =>
    '<div class="cmt"><div class="cmt-h">' + esc(c.by) + ' &middot; ' +
    esc(String(c.at || '').slice(0, 16).replace('T', ' ')) + '</div>' +
    '<div class="cmt-b">' + esc(c.text) + '</div></div>').join('');
  // The box lives on the item, because this is what the operator is looking at.
  // An affordance one click away on another surface is one that is not found.
  const box = a.need ? '<div class="ln q" style="margin-top:12px">think out loud here ' +
      '&mdash; this goes to <b>' + esc(a.root || 'rank 0') + '</b>, not to ' +
      esc(a.node) + '. It reaches the lane rewritten: as a grant, a ruling, or a ' +
      'brief revision. Nothing here is an instruction.</div>' +
      '<textarea class="bbox" data-slug="' + esc(a.slug) + '" data-node="' + esc(a.node) +
      '" data-need="' + esc(a.need) + '" placeholder="reasoning for ' +
      esc(a.root || 'rank 0') + '..."></textarea>' +
      '<div class="row"><button class="bsend">send to lead</button>' +
      '<span class="ln q bmsg"></span></div>' : '';
  // data-live marks the parts a poll may replace. Everything else -- the
  // textarea above all -- is rendered once and never touched again.
  return '<div class="need" data-key="' + esc(key) + '">' +
    '<div class="hd" data-live="hd:' + esc(key) + '">' +
      '<span class="who mine">' + esc(a.kind) + '</span>' +
      '<span class="wh">' + esc(a.where) + ' &middot; ' + esc(a.what) + '</span>' +
      (n ? '<span class="cct">' + n + ' comment' + (n === 1 ? '' : 's') + '</span>' : '') +
    '</div>' +
    '<div class="detail">' +
      '<div data-live="body:' + esc(key) + '">' +
        '<div class="why">' + esc(a.why) + '</div>' +
        // Its own line, in its own colour. Glued to the end of a paragraph it
        // read as more of the same boilerplate, and it is the opposite: the
        // measure of how much this block is actually costing you.
        (a.still ? '<div class="still"><b>still moving without it:</b> ' +
                   esc(a.still) + '</div>' : '') + cs +
        '<pre id="a' + i + '">' + esc(a.do) + '</pre>' +
        '<button class="cp" data-c="a' + i + '">copy</button>' +
      '</div>' + box +
    '</div></div>';
}

function needBlock(n, i) {
  const g = "(cd " + n._repo + " && harness grant " + n.node + " '" + n.need +
            "' --reason '" + (n.why || 'see the block record').replace(/'/g, '') + "')";
  const r = "(cd " + n._repo + " && harness recycle " + n.node + ")";
  return '<div class="need" data-key="block|' + esc(n._project) + '|' + esc(n.node) +
    '|' + esc(n.need) + '">' +
    '<div class="hd"><span class="who">' + esc(n._project) + ' / ' + esc(n.node) + '</span>' +
    '<span class="wh">' + esc(n.why || n.need) + '</span></div>' +
    '<div class="detail"><dl>' +
      '<dt>needs</dt><dd>' + esc(n.need) + '</dd>' +
      '<dt>for</dt><dd>' + esc(n.why || '-') + '</dd>' +
      (n.still_moving ? '<dt>still moving</dt><dd>' + esc(n.still_moving) + '</dd>' : '') +
      '<dt>raised</dt><dd>' + esc((n.raised_at || '').slice(0, 19).replace('T', ' ')) + '</dd>' +
      '<dt>grant, then recycle</dt>' +
      '<dd><pre id="c' + i + '">' + esc(g) + '\n' + esc(r) + '</pre>' +
      '<button class="cp" data-c="c' + i + '">copy</button></dd>' +
    '</dl></div></div>';
}

// null sessions means the roster could not be read. That is a THIRD state, and
// rendering it as an empty node is the bug this view had.
// Briefed but not marked: work its lead has handed down that it has not picked
// up. A separate line, because "assigned" and "under way" are different facts.
// The queue in the lead's order, with the head named. A coupled task is drawn
// hanging off the one it runs with rather than as a queue position of its own,
// because it has none: it is reached through its predecessor or not at all.
function briefedChips(n) {
  if (!n.briefed || !n.briefed.length) return '';
  const head = n.briefed.filter(b => !b.coupled_to);
  const chip = (b, cls) =>
    '<span class="chip ' + cls + '" data-task="' + esc(b.task) + '" data-slug="' +
    esc(n._slug) + '" title="' + esc(b.coupled_why || '') + '">' + esc(b.label || b.task) +
    (b.open_suggestions ? ' <b class="dup">!' + b.open_suggestions + '</b>' : '') +
    '</span>';
  const chain = t => n.briefed.filter(b => b.coupled_to === t)
    .map(b => ' <span class="q">+</span> ' + chip(b, 'pending coupled')).join('');
  const open = (n.tasks || []).some(t => !t.presented);
  return '<div class="ln q">' +
    head.map((b, i) => (i === 0 && !open ? '<b class="nextlbl">next</b> ' : '') +
                       chip(b, 'pending') + chain(b.task)).join(' ') +
    '</div>';
}

// Segments this node broke up. Drawn apart from the queue and never as a
// pending chip, because they are opposite facts: a queued task is work about to
// happen and a split one is work that already left. Ticked when every part has
// come back, which is the moment it can finally be marked off.
// Withdrawn, and kept visible. A brief that disappeared entirely has the next
// lead propose the same thing and get the same silence back.
function goneChips(n) {
  if (!n.gone || !n.gone.length) return '';
  return '<div class="ln q"><span class="splitlbl">gone</span> ' +
    n.gone.map(g =>
      '<span class="chip out" data-task="' + esc(g.task) + '" data-slug="' +
      esc(n._slug) + '" title="' + esc('superseded: ' + (g.gone || '') +
        (g.gone_for ? '\nreplaced by ' + g.gone_for : '')) + '">' +
      esc(g.label || g.task) + '</span>').join(' ') + '</div>';
}

function splitChips(n) {
  if (!n.split || !n.split.length) return '';
  return '<div class="ln q"><span class="splitlbl">split</span> ' +
    n.split.map(s =>
      '<span class="chip sp' + (s.ready ? ' ready' : '') + '" data-task="' +
      esc(s.task) + '" data-slug="' + esc(n._slug) + '" title="' +
      esc(s.ready
          ? 'every part closed — harness mark ' + s.task + ' --close'
          : s.children.map(c => c.task + ' (' + c.node + ') ' + c.state).join('\n')) +
      '">' + (s.ready ? '&#10003; ' : '') + esc(s.task) +
      ' <b>' + s.done + '/' + s.total + '</b></span>').join(' ') + '</div>';
}

// How long since this session did anything, and what picking it back up would
// cost. Idle is free; RESUMING is not. Past the cache lifetime the next turn
// re-reads the whole conversation at full rate, so a cold node carrying 340k is
// a bill waiting for you to say hello to it.
function tokf(n) {
  if (!n) return '';
  return n >= 1e6 ? (n / 1e6).toFixed(1) + 'M' : n >= 1e3 ? Math.round(n / 1e3) + 'k' : n;
}
function age(s) {
  if (s.status === 'busy' || !s.idle) return '';
  const m = Math.floor(s.idle / 60);
  const t = m < 60 ? m + 'm' : Math.floor(m / 60) + 'h' + String(m % 60).padStart(2, '0');
  return s.cold
    ? ' &middot; <span class="cold">idle ' + t + ' &middot; COLD' +
      (s.carry ? ' &middot; ' + tokf(s.carry) + ' to re-read' : '') + '</span>'
    : ' &middot; idle ' + t;
}

function card(n) {
  const unknown = n.sessions === null;
  const ss = n.sessions || [];
  const cls = unknown ? 'unknown'
            : (ss.some(s => s.status === 'busy') ? 'busy' : (ss.length ? 'idle' : ''));
  let who;
  if (unknown)            who = '<div class="ln u">occupancy unknown</div>';
  else if (ss.length > 1) who = '<div class="ln dup">' + ss.length +
      ' sessions in one worktree</div>';
  else if (ss.length)     who = '<div class="ln">' + esc(ss[0].name) + ' &middot; ' +
      esc(ss[0].status) + age(ss[0]) + '</div>';
  else if (n.claimed)     who = '<div class="ln dup">claimed, no session</div>';
  else                    who = '<div class="ln q">no session</div>';
  // "unassigned" read as "nothing is there", which is the opposite of what it
  // means: the session is working, the HARNESS just has no record of on what.
  const task = n.tasks.length ? '<div class="ln">' + n.tasks.map(x =>
                 '<span class="chip' + (x.presented ? ' presented' : '') +
                 '" data-task="' + esc(x.task) + '" data-slug="' + esc(n._slug) +
                 '" title="' + (x.presented ? 'presented — waiting on its lead to sign off'
                                            : 'open') + '">' +
                 (x.presented ? '&#10003; ' : '') + esc(x.task) + '</span>').join(' ') +
                 '</div>' + briefedChips(n)
             : (!unknown && ss.length
                ? '<div class="ln q" title="no harness mark — run harness mark ' +
                  '&lt;task&gt; in that session">no task record</div>' + briefedChips(n)
                : briefedChips(n));
  const coldc = ss.some(s => s.cold) ? ' coldc' : '';
  // Asked and stopped. Drawn on the node because it is the node's state and
  // its lead's to clear -- not in the operator's panel, which is for what no
  // session in the tree can fix. The count of children stopped on THIS node
  // sits on the same card, so a lead can see what it owes without reading its
  // children's cards one at a time.
  const w = n.waiting;
  const wait = w
    ? '<div class="wt">stopped on <b>' + esc(w.parent || 'its lead') + '</b> &middot; ' +
      esc(w.age || '') + '</div>' +
      '<div class="wt q">' + esc(w.asked || 'nothing recorded') + '</div>' +
      (w.still_moving ? '<div class="wt s">still moving: ' + esc(w.still_moving) +
                        '</div>' : '')
    : '';
  const owes = (n.awaited_by || []).length
    ? '<div class="wt o">' + n.awaited_by.length + ' waiting on you: ' +
      esc(n.awaited_by.join(', ')) + '</div>' : '';
  return '<div class="card ' + cls + coldc + (w ? ' waitc' : '') +
    (n.blocks.length ? ' blocked' : '') +
    '" data-live="card:' + esc(n._slug + ':' + n.name) + '">' +
    '<div class="hdr"><span class="dot"></span><span class="nm">' + esc(n.name) +
    '</span><span class="kd">' + esc(n.kind || '') + '</span></div>' +
    '<div class="ln q">' + esc(n.branch || '') + (n.indexed ? '' : ' (not indexed)') + '</div>' +
    who + wait + owes + task + splitChips(n) + goneChips(n) +
    (n.blocks.length ? '<span class="bell">' + n.blocks.length + ' needs you</span>' : '') +
    '</div>';
}

function tree(nodes) {
  const by = {}, kids = {}, roots = [];
  nodes.forEach(n => by[n.name] = n);
  nodes.slice().sort((a, b) => a.name.localeCompare(b.name)).forEach(n => {
    if (n.parent && by[n.parent]) (kids[n.parent] = kids[n.parent] || []).push(n);
    else roots.push(n);
  });
  const li = n => '<li>' + card(n) +
    (kids[n.name] ? '<ul>' + kids[n.name].map(li).join('') + '</ul>' : '') + '</li>';
  return '<div class="scroll"><div class="tree"><ul>' +
         roots.map(li).join('') + '</ul></div></div>';
}

async function tick() {
  let raw, d;
  try {
    raw = await (await fetch('/api/state')).text();
    d = JSON.parse(raw);
  }
  catch (e) { document.getElementById('age').textContent = 'disconnected'; return; }
  document.getElementById('age').textContent = new Date().toLocaleTimeString();
  // First visit: the project description is open, its features shut. That is
  // what this panel looked like before it could fold at all, so nobody arrives
  // to find their charter apparently empty.
  if (!FSEEDED) {
    (d.projects || []).forEach(p => OPENF.add(p.slug + '::'));
    FSEEDED = true; save(FKEY, OPENF);
  }
  // `generated` changes every poll and nothing else usually does, so it is
  // excluded from the comparison: redrawing identical content is what loses a
  // text selection mid-copy.
  const sig = raw.replace(/"generated":"[^"]*",/, '');
  if (sig === LAST) return;
  LAST = sig;
  document.getElementById('ct').innerHTML = d.yours
    ? '<span style="color:#ffd08a">' + d.yours + ' waiting on you</span>' : '';
  // Above everything, including the banners: it is the same reference whatever
  // state the trees are in, and one row of it is cheaper than looking it up.
  let h = cmdbar(d.commands || []);
  if (d.stale_server) {
    h += '<div class="banner"><b>This server is older than the code on disk</b> ' +
         '&mdash; it started at ' + esc(d.started) + ' and the page you are looking ' +
         'at was loaded then. Reloading the browser will not change it.<br>' +
         'Stop it (ctrl-c) and run <code>harness gui</code> again.</div>';
  }
  if (d.roster_error) {
    h += '<div class="banner"><b>Occupancy unknown</b> &mdash; the session roster ' +
         'could not be read, so every node below is shown as unknown rather than ' +
         'empty.<br><code>' + esc(d.roster_error) + '</code></div>';
  }
  const att = d.attention || [];
  // Machine-level items belong to no project, so they sit above all of them.
  const machine = att.filter(a => !a.project);
  if (machine.length) {
    h += '<div class="needs"><h3>' + machine.length + ' waiting on you &middot; ' +
      'this machine</h3>' +
      '<div data-live="rules:machine">' + rulesFor(machine, d.rules) + '</div>' +
      machine.map((a, i) => attnItem(a, 'x' + i)).join('') + '</div>';
  }
  h += d.projects.map((p, pi) => {
    p.nodes.forEach(n => n._slug = p.slug);
    const mine = att.filter(a => a.project === p.project);
    const col = mine.length
      ? '<div class="needs"><h3>' + mine.length + ' waiting on you' +
        '<span class="collapse" data-collapse="' + esc(p.project) + '">collapse all</span>' +
        '</h3><div class="ln q" style="margin:-4px 0 8px">only what no session can ' +
        'fix itself &mdash; click one for why it matters and the command that clears ' +
        'it</div>' +
        '<div data-live="rules:' + esc(p.project) + '">' + rulesFor(mine, d.rules) +
        '</div>' +
        mine.map((a, i) => attnItem(a, 'p' + pi + '-' + i)).join('') + '</div>'
      : '<div class="clear">nothing is waiting on you here</div>';
    return '<div class="proj"><h2>' + esc(p.project) + '</h2>' +
      '<div class="repo">' + esc(p.repo) + '</div>' +
      '<div class="cols"><div class="chartercol">' + charter(p) + '</div>' +
      '<div class="treecol">' +
      '<div class="ln q" style="margin:0 0 6px">click a task chip to read its brief ' +
      'and comment on it</div>' +
      (p.orphan_marks.length ? '<div class="ln dup">' + p.orphan_marks.length +
        ' open task record(s) name no node in this tree</div><ul class="orph">' +
        p.orphan_marks.map(o => '<li><span class="chip" data-task="' + esc(o.task) +
          '" data-slug="' + esc(p.slug) + '">' + esc(o.task) + '</span>' +
          (o.named ? ' <span class="q">named ' + esc(o.named) + ', trimmed</span>'
                   : ' <span class="q">names no node</span>') +
          (o.at ? ' <span class="q">&middot; ' + esc(o.at) + '</span>' : '') +
          '</li>').join('') + '</ul>' : '') +
      tree(p.nodes) + '</div><div class="attncol">' + col + '</div></div></div>';
  }).join('');
  if (!d.projects.length) h += '<div class="empty">no enrolled projects on this machine</div>';
  paint(h);
}

// The charter: what the project is, and the features in scope. Read by every
// node and required of none -- a member does not need the purpose to execute a
// complete brief, and handing it one would be giving back the context its task
// was scoped to exclude. It is here so that "why are we doing this" has an
// answer that does not depend on a lead being awake.
//
// It is also the only thing on this page the operator EDITS rather than
// comments on, and that is the point of it: the charter exists to be argued
// with by the person who knows what the project is for. A description that can
// only be corrected somewhere else is one that goes stale where nobody looks.
// A feature is a dropdown: its name always, its prose when you open it. The
// controls indent, reorder and delete it, and they are the same four you would
// use on any outline -- up and down stay among siblings, promote and demote are
// the only way a feature crosses between one heading and another.
function feat(p, f) {
  const key = p.slug + '::' + f.key;
  const open = OPENF.has(key);
  return '<div class="feat' + (f.depth ? ' sub' : '') + '">' +
    '<div class="chead fname" data-ftog="' + esc(key) + '">' +
      '<span class="tri">' + (open ? '&#9660;' : '&#9654;') + '</span>' +
      '<b>' + esc(f.name) + '</b>' +
      '<span class="cacts">' +
        cact(p.slug, f.name, 'up', '&#9650;', 'move up') +
        cact(p.slug, f.name, 'down', '&#9660;', 'move down') +
        (f.depth ? cact(p.slug, f.name, 'promote', '&#9664;',
                        'promote to a feature of its own')
                 : cact(p.slug, f.name, 'demote', '&#9654;',
                        'demote — file it under the feature above')) +
        cact(p.slug, f.name, 'delete', '&#10005;',
             'delete — nothing is kept', 'del') +
      '</span></div>' +
    (open
      ? '<div class="frow"><span class="cedit" data-cslug="' + esc(p.slug) +
        '" data-cfeature="' + esc(f.name) + '">edit</span></div>' +
        '<div class="ftext cbody" data-raw="' + esc(f.text) + '">' +
        esc(f.text) + '</div>'
      : '') +
    '</div>';
}

function charter(p) {
  const c = p.charter || { description: '', features: [] };
  const dkey = p.slug + '::';
  const dopen = OPENF.has(dkey);
  // "Project" rather than "what this project is". The panel is plainly about
  // the project; saying so twice is a heading spent on nothing.
  const head = '<h3 class="chead" data-ftog="' + esc(dkey) + '">' +
    '<span class="tri">' + (dopen ? '&#9660;' : '&#9654;') + '</span>Project' +
    '<span class="cedit" data-cslug="' + esc(p.slug) + '" data-cfeature="">edit</span>' +
    '</h3>';
  const body = !dopen ? ''
    : c.description
      ? '<div class="ctext cbody" data-raw="' + esc(c.description) + '">' +
        esc(c.description) + '</div>'
      : '<div class="ctext cbody none" data-raw="">Nothing states what this project ' +
        'is for. Until something does, the only work visible to the head lead is ' +
        'whatever happens to be broken — and a backlog is not a plan.</div>';
  const fs = (c.features || []);
  const list = fs.length
    ? fs.map(f => feat(p, f)).join('')
    : '<div class="ln q">no features listed</div>';
  return '<div class="charter" data-live="charter:' + esc(p.slug) + '">' + head + body +
    (CHMSG ? '<div class="cmsg2">' + esc(CHMSG) + '</div>' : '') +
    '<div class="feats"><h3>features in scope' +
    '<span class="cedit" data-cslug="' + esc(p.slug) + '" data-cnew="1">+ add</span>' +
    '</h3>' + list + '</div></div>';
}

// Targeted update, not a repaint. The page is built once; after that a poll may
// only replace elements that carry data-live, and only when their content has
// actually changed. Anything not on that list -- a textarea mid-sentence, an
// expanded panel, a text selection, the scroll position -- survives by
// construction rather than by being remembered and put back.
//
// An include list is the maintainable direction: a new volatile field is opted
// IN by tagging it, and forgetting to tag one shows up as a stale number, which
// is visible. The exclude list it replaces failed the other way -- forgetting to
// exempt something ate your work silently.
function paint(h) {
  // Nothing is replaced while prose is being written into this page. The
  // include list protects a textarea that the poll knows about; it cannot
  // protect one against the shape-change rebuild, and losing a paragraph
  // someone was halfway through writing is not a fault worth risking to keep a
  // busy dot current for three more seconds.
  if (EDITING.size) return;
  const root = document.getElementById('root');
  const tpl = document.createElement('div');
  tpl.innerHTML = h;
  const keys = el => Array.prototype.map.call(
    el.querySelectorAll('[data-live]'), e => e.dataset.live).join(',');

  // The shape changed -- a node appeared, an item cleared -- so there is nothing
  // to patch into. This is the only path that rebuilds, and it is rare.
  if (keys(tpl) !== keys(root)) {
    root.innerHTML = h;
    reopen();
    return;
  }
  Array.prototype.forEach.call(tpl.querySelectorAll('[data-live]'), fresh => {
    const cur = root.querySelector('[data-live="' + fresh.dataset.live + '"]');
    if (!cur) return;
    if (cur.className !== fresh.className) cur.className = fresh.className;
    if (cur.innerHTML !== fresh.innerHTML) cur.innerHTML = fresh.innerHTML;
  });
}
tick(); setInterval(tick, 3000);
</script></body></html>"""


def _project_dir(slug):
    """Whitelist, not sanitise. The slug must BE one of the directories that
    exist; nothing is joined from user input, so there is no path to traverse."""
    for p in CLI.HOME_STATE.glob("*"):
        if p.is_dir() and p.name == slug and (p / "binding.json").exists():
            return p
    return None


def task_detail(slug, task):
    pdir = _project_dir(slug)
    if pdir is None:
        return None
    md, bd = pdir / "marks", pdir / "briefs"
    # Same whitelist: the file must already be in the listing.
    hit = next((f for f in md.glob("*.json") if f.stem == task), None) if md.is_dir() else None
    bhit = next((f for f in bd.glob("*.json") if f.stem == task), None) if bd.is_dir() else None
    if hit is None and bhit is None:
        return None
    rec, brief = {}, None
    for src, into in ((hit, "rec"), (bhit, "brief")):
        if src is None:
            continue
        try:
            v = json.loads(src.read_text())
        except Exception:
            continue
        if into == "rec":
            rec = v
        else:
            brief = v
    repo = ""
    try:
        repo = json.loads((pdir / "binding.json").read_text()).get("repo", "")
    except Exception:
        pass
    return {"task": task, "slug": slug, "repo": repo,
            "node": rec.get("_node") or (brief or {}).get("node"),
            "branch": rec.get("_branch"),
            "opened": rec.get("_at"), "closed": rec.get("_closed_at"),
            "session": (rec.get("_session") or "")[:8],
            "marked": hit is not None,
            "presented_at": rec.get("_presented_at"),
            "presented_by": rec.get("_presented_by"),
            "closed_by": rec.get("_closed_by"),
            "brief": (brief or {}).get("text") or "",
            "brief_by": (brief or {}).get("written_by") or "",
            "brief_rev": (brief or {}).get("revision"),
            "brief_at": (brief or {}).get("written_at"),
            "suggestions": (brief or {}).get("suggestions") or [],
            "brief_comments": (brief or {}).get("comments") or [],
            "mark_note": rec.get("_note") or "",
            "comments": rec.get("_comments") or []}


def add_comment(slug, task, text):
    """The one write, and it is delegated.

    The server runs `harness note --add` in the project rather than editing the
    record itself, so the viewer gains no ability the CLI does not already grant
    and there is exactly one implementation of what a comment is. If the CLI
    refuses, so does this.
    """
    d = task_detail(slug, task)
    if d is None or not d["repo"]:
        return False, "no such task"
    exe = Path(__file__).resolve().with_name("harness")
    # A comment typed into this page was typed by a PERSON. The server may have
    # been launched from inside a session and would otherwise inherit its id and
    # sign the comment with it, which is a false attribution in the one record
    # that exists to be trusted.
    env = {k: v for k, v in os.environ.items() if k != "CLAUDE_CODE_SESSION_ID"}
    # The BRIEF when there is one: it is what gets rewritten, so the reasoning
    # belongs beside it, and its unread cursor is what makes a lane look. The
    # mark is the fallback for tasks that predate briefs.
    argv = ([str(exe), "brief", task, "--comment", text] if d.get("brief_rev")
            else [str(exe), "note", task, "--add", text])
    r = subprocess.run([sys.executable] + argv,
                       cwd=d["repo"], capture_output=True, text=True, timeout=20, env=env)
    return r.returncode == 0, (r.stdout or r.stderr).strip()[:300]


def add_block_comment(slug, node, need, text):
    """Delegated exactly like a task comment: the CLI defines what a comment is
    and this only calls it, with the session id stripped so a human's reply is
    attributed to a human."""
    pdir = _project_dir(slug)
    if pdir is None:
        return False, "no such project"
    try:
        repo = json.loads((pdir / "binding.json").read_text()).get("repo", "")
    except Exception:
        return False, "unreadable binding"
    wt = repo
    try:
        idx = json.loads((pdir / "index.json").read_text())
        wt = idx.get("nodes", {}).get(node, {}).get("worktree") or repo
    except Exception:
        pass
    exe = Path(__file__).resolve().with_name("harness")
    env = {k: v for k, v in os.environ.items() if k != "CLAUDE_CODE_SESSION_ID"}
    r = subprocess.run([sys.executable, str(exe), "blocked", need, "--comment", text],
                       cwd=wt, capture_output=True, text=True, timeout=20, env=env)
    return r.returncode == 0, (r.stdout or r.stderr).strip()[:300]


def shape_charter(slug, feature, action):
    """Reorder, nest or delete a feature — delegated, like every other write.

    The viewer does not open charter.json. What a charter is, what may change
    it, and what an order even means all live in the CLI; a second
    implementation here would be a second answer to those questions, and the
    one the operator sees would be whichever they happened to use last.
    """
    flag = {"up": ["--move", "up"], "down": ["--move", "down"],
            "promote": ["--promote"], "demote": ["--demote"],
            "delete": ["--delete"]}.get(action)
    if not flag:
        return False, f"unknown action {action!r}"
    if not feature:
        return False, "which feature?"
    return _charter_cli(slug, ["--feature", feature] + flag)


def _charter_cli(slug, args):
    pdir = _project_dir(slug)
    if pdir is None:
        return False, "no such project"
    try:
        repo = json.loads((pdir / "binding.json").read_text()).get("repo", "")
    except Exception:
        return False, "unreadable binding"
    exe = Path(__file__).resolve().with_name("harness")
    # The session id is stripped because prose typed into a page, and a button
    # clicked on one, were both done by a person — and the CLI gates charter
    # writes on rank, which a person does not have.
    env = {k: v for k, v in os.environ.items() if k != "CLAUDE_CODE_SESSION_ID"}
    r = subprocess.run([sys.executable, str(exe), "charter"] + args, cwd=repo,
                       capture_output=True, text=True, timeout=20, env=env)
    return r.returncode == 0, (r.stdout or r.stderr).strip()[:300]


def save_charter(slug, feature, text):
    """This is the one object the operator is expected to EDIT rather than
    comment on, which is why it is the one place the viewer offers a full text
    box. The charter is the artefact whose whole purpose is to be argued with by
    the person who knows what the project is for, and a description nobody can
    correct in the place they read it is one that goes stale silently."""
    return _charter_cli(slug, (["--feature", feature] if feature else []) +
                        ["--write", text])


class H(BaseHTTPRequestHandler):
    def _send(self, body, ctype):
        # A page polling every 3s abandons requests routinely: navigate away, or
        # reload, and the socket is gone before the response lands. That is the
        # CLIENT's business, not an error here. Swallowing it also stops the
        # second, uglier failure -- the old handler caught the write error and
        # then tried to report it down the same dead socket, so one closed tab
        # printed two tracebacks.
        b = body.encode()
        try:
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            # The page is a prototype that changes often; a cached copy of it is
            # a bug report waiting to happen.
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(b)))
            self.end_headers()
            self.wfile.write(b)
        except (BrokenPipeError, ConnectionResetError):
            self.close_connection = True

    def do_GET(self):
        if self.path.startswith("/api/state"):
            # Built before it is sent, so a failure to READ the state and a
            # failure to WRITE the response stay distinguishable.
            try:
                body = json.dumps(read_state())
            except Exception as e:
                body = json.dumps({"error": f"{type(e).__name__}: {e}",
                                   "projects": [], "needs": []})
            self._send(body, "application/json")
        elif self.path.startswith("/api/task?"):
            q = parse_qs(urlparse(self.path).query)
            d = task_detail((q.get("p") or [""])[0], (q.get("t") or [""])[0])
            self._send(json.dumps(d or {"error": "not found"}), "application/json")
        elif self.path in ("/", "/index.html"):
            self._send(PAGE, "text/html; charset=utf-8")
        else:
            self.send_error(404)

    def do_POST(self):
        # This server has no authentication, so a page you merely VISIT could POST
        # here. A custom header forces a CORS preflight cross-origin, and no OPTIONS
        # is answered, so a browser blocks it before it is sent; Origin is checked
        # too, for anything that is not a browser following the rules.
        if self.headers.get("X-Harness-Local") != "1":
            self.send_error(403, "missing X-Harness-Local"); return
        origin = self.headers.get("Origin")
        if origin and not origin.startswith(("http://127.0.0.1:", "http://localhost:")):
            self.send_error(403, "cross-origin"); return
        if not self.path.startswith(("/api/comment", "/api/charter")):
            self.send_error(404); return
        try:
            n = int(self.headers.get("Content-Length") or 0)
            body = json.loads(self.rfile.read(min(n, 64_000)) or b"{}")
        except Exception:
            self.send_error(400, "bad JSON"); return
        text = (body.get("text") or "").strip()
        if self.path.startswith("/api/charter"):
            # Shaping and writing go down the same route because they are the
            # same object; an action arrives instead of text, never as well as.
            act = (body.get("action") or "").strip()
            if act:
                ok, msg = shape_charter(body.get("slug", ""),
                                        body.get("feature") or "", act)
            elif not text:
                self.send_error(400, "empty charter"); return
            else:
                ok, msg = save_charter(body.get("slug", ""),
                                       body.get("feature") or "", text)
            self._send(json.dumps({"ok": ok, "message": msg}), "application/json")
            return
        if not text:
            self.send_error(400, "empty comment"); return
        if body.get("kind") == "block":
            ok, msg = add_block_comment(body.get("slug", ""), body.get("node", ""),
                                        body.get("need", ""), text)
        else:
            ok, msg = add_comment(body.get("slug", ""), body.get("task", ""), text)
        self._send(json.dumps({"ok": ok, "message": msg}), "application/json")

    def log_message(self, *a):
        pass          # a poll every 3 seconds would bury anything worth reading


def open_browser(url):
    """Under WSL the browser is on the other side of the kernel.

    `webbrowser` resolves to xdg-open, which finds no Linux browser on a headless
    WSL install and either fails or opens nothing at all. Windows reaches
    127.0.0.1 in the VM directly, so handing the URL to the Windows shell is both
    correct and the only thing that works. `explorer.exe` exits non-zero on
    success, so its return code is deliberately not consulted.
    """
    wsl = False
    try:
        wsl = "microsoft" in Path("/proc/version").read_text().lower()
    except Exception:
        pass
    if wsl:
        for exe in ("wslview", "explorer.exe"):
            try:
                subprocess.run([exe, url], timeout=10,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return
            except Exception:
                continue
        print("  (could not reach a Windows browser — open the URL yourself)")
        return
    try:
        webbrowser.open(url)
    except Exception:
        pass


def main():
    ap = argparse.ArgumentParser(prog="harness-gui", description=__doc__.splitlines()[0])
    ap.add_argument("--port", type=int, default=DEFAULT_PORT,
                    help=f"default {DEFAULT_PORT}, walking upward if taken; "
                         f"an explicit --port is honoured exactly or refused")
    # Opt-in, not opt-out. A viewer that seizes the browser every time it starts
    # is one that interrupts whatever was on screen, and it starts often — from
    # `harness gui`, from a restart after an edit, from a second port when the
    # first is taken. The URL is printed; that is enough to click.
    ap.add_argument("--open", dest="open_browser", action="store_true",
                    help="also open it in a browser")
    ap.add_argument("--no-open", action="store_true",
                    help=argparse.SUPPRESS)      # accepted and ignored; now the default
    ap.add_argument("--once", action="store_true", help="print the JSON and exit")
    a = ap.parse_args()
    if a.once:
        print(json.dumps(read_state(), indent=2)); return
    # An explicit --port is honoured exactly: if you named one, being quietly
    # moved somewhere else is worse than being told. Only the DEFAULT wanders.
    wander = a.port == DEFAULT_PORT
    srv, port = None, a.port
    for cand in range(a.port, a.port + (12 if wander else 1)):
        try:
            # 127.0.0.1, never 0.0.0.0: this exposes worktree paths, session names
            # and every open block, and it is a prototype with no authentication.
            srv, port = ThreadingHTTPServer(("127.0.0.1", cand), H), cand
            break
        except OSError:
            continue
    if srv is None:
        where = (f"127.0.0.1:{a.port}-{a.port + 11}" if wander else f"127.0.0.1:{a.port}")
        print(f"harness-gui: nothing free on {where}.\n"
              f"             `ss -ltn` will show what has it; --port picks another.",
              file=sys.stderr)
        sys.exit(4)
    # flush: the next call blocks forever in serve_forever, and stdout to a pipe
    # or a log file is block-buffered, so without this the URL never appears at
    # all for anyone who redirected it.
    if port != a.port:
        print(f"harness-gui: {a.port} was taken, using {port}", flush=True)
    url = f"http://127.0.0.1:{port}/"
    print(f"harness-gui  {url}   (read-only; ctrl-c to stop)", flush=True)
    if a.open_browser:
        open_browser(url)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")


if __name__ == "__main__":
    main()
