def _ids(groups):
    """Give every entry a stable id.

    The page addresses an entry by id and never by position, because a position
    is a fact about the list at the moment it was drawn, and the whole point of
    this panel is that the list moves.
    """
    changed = False
    for g in groups:
        if not g.get("id"):
            g["id"] = uuid.uuid4().hex[:8]; changed = True
        for it in g.get("items") or []:
            if not it.get("id"):
                it["id"] = uuid.uuid4().hex[:8]; changed = True
    return groups, changed


def write_commands(groups):
    COMMANDS_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = COMMANDS_FILE.with_name(COMMANDS_FILE.name + ".tmp")
    tmp.write_text(json.dumps({"version": COMMANDS_VERSION, "groups": groups},
                              indent=2) + "\n")
    tmp.replace(COMMANDS_FILE)


def read_commands():
    """The file if there is a current one, the defaults if there is not."""
    try:
        if COMMANDS_FILE.exists():
            raw = json.loads(COMMANDS_FILE.read_text())
            g = raw.get("groups")
            if isinstance(g, list) and raw.get("version") == COMMANDS_VERSION:
                g, changed = _ids(g)
                if changed:
                    write_commands(g)
                return g
    except Exception:
        pass
    g, _ = _ids(json.loads(json.dumps(DEFAULT_COMMANDS)))
    write_commands(g)
    return g


# Why a whole CLASS of item is the operator's to decide. This does not vary
# between two grants, or between two approvals, so it is said once under the
# panel heading and folded away, instead of under every item — where, repeated,
# it pushed the one or two lines that differ off the bottom of the box.
RULES = {
    "grant": {
        "title": "why a grant is yours and nobody else's",
        "text": "A member writes inside its own worktree and nowhere else, "
                "because anything outside it has no owner, no scope, and no "
                "check that can go red on it. Only you can widen that: a lead "
                "doing the write instead would be routing your decision around "
                "rather than making it, and the CLI refuses that by rank."},
    "approval": {
        "title": "why an approval is yours and nobody else's",
        "text": "Nobody asked for this, so no session in the tree may put a "
                "session on it. It is not queued, harness mark refuses it, and "
                "nothing is idle waiting — the lane carried on with its queue."},
    "came back": {
        "title": "why something you answered is here again",
        "text": "Answering a block used to remove it from every surface you "
